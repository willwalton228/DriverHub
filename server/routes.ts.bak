  // Create user invitation (admin/super_user only)
  app.post("/api/admin/invitations", isAuthenticated, requireAdmin, async (req: any, res: Response) => {
    try {
      const { email, role } = req.body;

      if (!email || !role) {
        return res.status(400).json({ message: "Email and role are required" });
      }

      // Check if email already exists
      const existingInvitation = await storage.getInvitationByEmail(email);
      if (existingInvitation && !existingInvitation.usedAt) {
        return res.status(400).json({ message: "An active invitation already exists for this email" });
      }

      // Generate unique invite code
      const inviteCode = Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);
      
      // Set expiration to 7 days from now
      const expiresAt = new Date();
      expiresAt.setDate(expiresAt.getDate() + 7);

      const invitation = await storage.createUserInvitation({
        email,
        role,
        invitedBy: req.adminUser.id,
        inviteCode,
        expiresAt,
      });

      res.json(invitation);
    } catch (error) {
      console.error("Error creating invitation:", error);
      res.status(500).json({ message: "Failed to create invitation" });
    }
  });

  // Delete invitation (admin/super_user only)
  app.delete("/api/admin/invitations/:id", isAuthenticated, requireAdmin, async (req: any, res: Response) => {
    try {
      await storage.deleteInvitation(req.params.id);
      res.json({ success: true });
    } catch (error) {
      console.error("Error deleting invitation:", error);
      res.status(500).json({ message: "Failed to delete invitation" });
    }
  });

  // GET /api/admin/abuse-events - List abuse events (admin only)
  app.get("/api/admin/abuse-events", isAuthenticated, requireAdmin, async (req: any, res: Response) => {
    try {
      const { type, severity, ip, route: routeFilter, limit: limitParam, offset: offsetParam, startDate, endDate } = req.query;
      const conditions: any[] = [];

      if (type) conditions.push(eq(abuseEvents.type, type as string));
      if (severity) conditions.push(eq(abuseEvents.severity, severity as string));
      if (ip) conditions.push(eq(abuseEvents.ip, ip as string));
      if (routeFilter) conditions.push(ilike(abuseEvents.route, `%${routeFilter}%`));
      if (startDate) conditions.push(gte(abuseEvents.createdAt, new Date(startDate as string)));
      if (endDate) conditions.push(lte(abuseEvents.createdAt, new Date(endDate as string)));

      const whereClause = conditions.length > 0 ? and(...conditions) : undefined;
      const queryLimit = Math.min(parseInt(limitParam as string) || 50, 200);
      const queryOffset = parseInt(offsetParam as string) || 0;

      const events = await db.select()
        .from(abuseEvents)
        .where(whereClause)
        .orderBy(desc(abuseEvents.createdAt))
        .limit(queryLimit)
        .offset(queryOffset);

      const [countResult] = await db.select({ count: sql<number>`count(*)::int` })
        .from(abuseEvents)
        .where(whereClause);

      res.json({ events, total: countResult?.count || 0, limit: queryLimit, offset: queryOffset });
    } catch (err) {
      console.error("[Admin] Failed to fetch abuse events:", err);
      res.status(500).json({ message: "Failed to fetch abuse events" });
    }
  });

  // GET /api/admin/abuse-events/summary - Abuse events summary stats (admin only)
  app.get("/api/admin/abuse-events/summary", isAuthenticated, requireAdmin, async (req: any, res: Response) => {
    try {
      const last24h = new Date(Date.now() - 24 * 60 * 60 * 1000);
      const results = await db.select({
        type: abuseEvents.type,
        severity: abuseEvents.severity,
        count: sql<number>`count(*)::int`,
      })
        .from(abuseEvents)
        .where(gte(abuseEvents.createdAt, last24h))
        .groupBy(abuseEvents.type, abuseEvents.severity);

      const topIps = await db.select({
        ip: abuseEvents.ip,
        count: sql<number>`count(*)::int`,
      })
        .from(abuseEvents)
        .where(gte(abuseEvents.createdAt, last24h))
        .groupBy(abuseEvents.ip)
        .orderBy(sql`count(*) DESC`)
        .limit(10);

      res.json({ last24h: results, topIps });
    } catch (err) {
      console.error("[Admin] Failed to fetch abuse events summary:", err);
      res.status(500).json({ message: "Failed to fetch abuse events summary" });
    }
  });

  // Validate invitation code (public - used during onboarding)
  app.get("/api/invitations/:code", async (req: Request, res: Response) => {
    try {
      const invitation = await storage.getInvitationByCode(req.params.code);
      
      if (!invitation) {
        return res.status(404).json({ message: "Invitation not found" });
      }

      if (invitation.usedAt) {
        return res.status(400).json({ message: "This invitation has already been used" });
      }

      if (new Date() > invitation.expiresAt) {
        return res.status(400).json({ message: "This invitation has expired" });
      }

      res.json({ email: invitation.email, role: invitation.role });
    } catch (error) {
      console.error("Error validating invitation:", error);
      res.status(500).json({ message: "Failed to validate invitation" });
    }
  });

  // ONE-TIME SEED ENDPOINT - Call this in production to populate sample data
  // Visit /api/seed-database in your browser after publishing to seed production
  app.get("/api/seed-database", isAuthenticated, async (req: any, res: Response) => {
    try {
      const firstNames = ["James", "Maria", "Robert", "Patricia", "Michael", "Jennifer", "William", "Linda", "David", "Elizabeth"];
      const lastNames = ["Smith", "Johnson", "Williams", "Brown", "Jones", "Garcia", "Miller", "Davis", "Rodriguez", "Martinez"];
      const cities = ["Miami", "Fort Lauderdale", "Dallas", "Houston", "Tulsa", "Raleigh"];
      const states = ["FL", "FL", "TX", "TX", "OK", "NC"];
      const markets = ["Miami", "Fort Lauderdale", "Dallas/Ft Worth", "Houston", "Tulsa", "Raleigh"];
      
      const randomElement = <T>(arr: T[]): T => arr[Math.floor(Math.random() * arr.length)];
      const generatePhone = () => `${Math.floor(Math.random() * 900) + 100}-${Math.floor(Math.random() * 900) + 100}-${Math.floor(Math.random() * 9000) + 1000}`;
      const generateAddress = () => {
        const num = Math.floor(Math.random() * 9999) + 1;
        const streets = ["Main St", "Oak Ave", "Maple Dr", "Cedar Ln", "Pine Rd"];
        return `${num} ${randomElement(streets)}`;
      };
      const formatDate = (date: Date) => date.toISOString().split('T')[0];
      const randomDate = (start: Date, end: Date) => new Date(start.getTime() + Math.random() * (end.getTime() - start.getTime()));

      const results = { drivers: 0, employees: 0, customers: 0, trips: 0, skipped: [] as string[] };

      // Check existing data
      const existingDrivers = await storage.getAllDriversWithUsers();
      const existingEmployees = await storage.getAllEmployees();
      const existingCustomers = await storage.getAllCustomers();
      const existingTrips = await storage.getAllTrips();

      // Create 10 Drivers (if needed)
      const createdDrivers: any[] = existingDrivers.map(d => ({ id: d.id }));
      if (existingDrivers.length >= 5) {
        results.skipped.push("drivers (already have " + existingDrivers.length + ")");
        results.drivers = existingDrivers.length;
      } else {
        for (let i = 0; i < 10; i++) {
          const firstName = randomElement(firstNames);
          const lastName = randomElement(lastNames);
          const cityIndex = i % cities.length;
          const uniqueId = `seed-driver-${Date.now()}-${i}`;
          
          const user = await storage.upsertUser({
            id: uniqueId,
            email: `driver${i + 1}@test.com`,
            firstName,
            lastName,
            role: "Driver",
            roleSelectedAt: new Date(),
          });

          const driver = await storage.createDriver({
            userId: user.id,
            phoneNumber: generatePhone(),
            address: generateAddress(),
            city: cities[cityIndex],
            state: states[cityIndex],
            zipCode: `${30000 + Math.floor(Math.random() * 50000)}`,
            driverNumber: `DRV${String(i + 1).padStart(4, '0')}`,
            driverType: randomElement(["DriverShift", "DriverDash", "Hybrid"]),
            driverClassification: randomElement(["Employee", "Independent Contractor"]),
            market: markets[cityIndex],
            hireDate: formatDate(randomDate(new Date(2020, 0, 1), new Date(2024, 0, 1))),
            licenseNumber: `DL${Math.floor(Math.random() * 900000000) + 100000000}`,
            licenseState: states[cityIndex],
            licenseExpiration: formatDate(randomDate(new Date(2025, 0, 1), new Date(2028, 0, 1))),
            status: "active",
            safetyScore: randomElement(["Green", "Yellow", "Red"]),
            lifetimeMoveCount: Math.floor(Math.random() * 500) + 50,
          });
          createdDrivers.push(driver);
          results.drivers++;
        }
      }

      // Create 10 Employees (if needed)
      if (existingEmployees.length >= 5) {
        results.skipped.push("employees (already have " + existingEmployees.length + ")");
        results.employees = existingEmployees.length;
      } else {
        for (let i = 0; i < 10; i++) {
          const firstName = randomElement(firstNames);
          const lastName = randomElement(lastNames);
          const cityIndex = i % cities.length;
          const uniqueId = `seed-emp-${Date.now()}-${i}`;
          
          const user = await storage.upsertUser({
            id: uniqueId,
            email: `employee${i + 1}@test.com`,
            firstName,
            lastName,
            role: "Employee",
            roleSelectedAt: new Date(),
          });

          await storage.createEmployee({
            userId: user.id,
            firstName,
            lastName,
            email: `employee${i + 1}@test.com`,
            phoneNumber: generatePhone(),
            address: generateAddress(),
            city: cities[cityIndex],
            state: states[cityIndex],
            zipCode: `${30000 + Math.floor(Math.random() * 50000)}`,
            employeeId: `EMP${String(i + 1).padStart(4, '0')}`,
            title: randomElement(["Operations Coordinator", "Dispatch Manager", "Fleet Supervisor", "HR Specialist", "Account Manager"]),
            employeeType: randomElement(["Exempt", "Non-Exempt"]),
            employmentType: randomElement(["Full Time", "Part Time"]),
            hireDate: formatDate(randomDate(new Date(2020, 0, 1), new Date(2024, 0, 1))),
            status: "active",
          });
          results.employees++;
        }
      }

      // Create 10 Customers (if needed)
      const customerNames = [
        "AutoNation Miami", "Sunrise Auto Group", "DFW Motors", "Houston Fleet Services",
        "Tulsa Transport Co", "Carolina Auto Sales", "Premier Dealership Group", 
        "Metro Car Exchange", "Sunbelt Auto Logistics", "Southeast Vehicle Partners"
      ];
      const createdCustomers: any[] = existingCustomers;
      if (existingCustomers.length >= 5) {
        results.skipped.push("customers (already have " + existingCustomers.length + ")");
        results.customers = existingCustomers.length;
      } else {
        for (let i = 0; i < 10; i++) {
          const cityIndex = i % cities.length;
          const customer = await storage.createCustomer({
            customerName: customerNames[i],
            customerNumber: `CUST${String(i + 1).padStart(4, '0')}`,
            status: "active",
            customerType: randomElement(["DriverShift", "DriverDash", "Hybrid"]),
            customerLegalName: `${customerNames[i]} LLC`,
            customerAddress: generateAddress(),
            customerCity: cities[cityIndex],
            customerState: states[cityIndex],
            customerZip: `${30000 + Math.floor(Math.random() * 50000)}`,
            implementationDate: formatDate(randomDate(new Date(2021, 0, 1), new Date(2024, 0, 1))),
            primaryContactName: `${randomElement(firstNames)} ${randomElement(lastNames)}`,
            primaryContactNumber: generatePhone(),
            primaryContactEmail: `contact@${customerNames[i].toLowerCase().replace(/\s+/g, '')}.com`,
          });
          createdCustomers.push(customer);
          results.customers++;
        }
      }

      // Create 50 Trips (if needed)
      const moveTypes = ["Delivery", "Pickup", "Transfer", "Relocation"];
      const vehicleTypes = ["Sedan", "SUV", "Van", "Truck", "Pickup"];
      const origins = ["Miami, FL", "Fort Lauderdale, FL", "Dallas, TX", "Houston, TX", "Tulsa, OK", "Raleigh, NC"];
      const destinations = ["Atlanta, GA", "Jacksonville, FL", "New Orleans, LA", "Nashville, TN", "Charlotte, NC"];
      
      if (existingTrips.length >= 20) {
        results.skipped.push("trips (already have " + existingTrips.length + ")");
        results.trips = existingTrips.length;
      } else if (createdDrivers.length > 0 && createdCustomers.length > 0) {
        for (let i = 0; i < 50; i++) {
          const driver = randomElement(createdDrivers);
          const customer = randomElement(createdCustomers);
          const tripDate = randomDate(new Date(2024, 0, 1), new Date());
          const distance = (Math.random() * 300 + 20).toFixed(2);
          const billRate = (Math.random() * 200 + 50).toFixed(2);
          const payRate = (parseFloat(billRate) * 0.65).toFixed(2);
          
          await storage.createTrip({
            moveNumber: `MV${String(Date.now())}-${i}`,
            driverId: driver.id,
            customerId: customer.id,
            tripDate,
            origin: randomElement(origins),
            destination: randomElement(destinations),
            distance,
            duration: `${Math.floor(Math.random() * 5) + 1}h ${Math.floor(Math.random() * 59)}m`,
            status: randomElement(["completed", "completed", "completed", "in-progress"]),
            moveType: randomElement(moveTypes),
            vehicleType: randomElement(vehicleTypes),
            billRate,
            payRate,
            grossProfit: (parseFloat(billRate) - parseFloat(payRate)).toFixed(2),
          });
          results.trips++;
        }
      }

      res.json({ 
        message: `Successfully seeded database!`,
        ...results
      });
    } catch (error) {
      console.error("Error seeding database:", error);
      res.status(500).json({ message: "Failed to seed database", error: String(error) });
    }
  });

  // Import claims from Excel file (admin-only)
  app.post("/api/corporate/accidents/import", isAuthenticated, async (req: any, res: Response) => {
    const user = await storage.getUser(req.user.claims.sub);
    if (!user || !hasCorporateAccess(user.role)) {
      return res.status(403).json({ message: "Forbidden: Admin access required" });
    }

    try {
      // Helper functions for parsing
      const excelDateToJS = (serial: any): Date | null => {
        if (serial === null || serial === undefined || serial === '') return null;
        if (typeof serial === 'number') {
          const utc_days = Math.floor(serial - 25569);
          const utc_value = utc_days * 86400;
          return new Date(utc_value * 1000);
        }
        if (typeof serial === 'string') {
          const trimmed = serial.trim();
          const parsed = new Date(trimmed);
          if (!isNaN(parsed.getTime())) return parsed;
          const mmddyyyy = trimmed.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
          if (mmddyyyy) {
            return new Date(parseInt(mmddyyyy[3]), parseInt(mmddyyyy[1]) - 1, parseInt(mmddyyyy[2]));
          }
        }
        return null;
      };

      const parseDecimal = (val: any): string | null => {
        if (val === null || val === undefined || val === '') return null;
        const str = String(val).trim().replace(/[$,]/g, '');
        const num = parseFloat(str);
        return isNaN(num) ? null : num.toFixed(2);
      };

      const parseBoolean = (val: any): boolean => {
        if (typeof val === 'boolean') return val;
        const str = String(val).toLowerCase().trim();
        return ['yes', 'true', '1', 'y'].includes(str);
      };

      // Column name aliases for flexible matching
      const COLUMN_ALIASES: Record<string, string[]> = {
        'RC ID': ['RC ID', 'RCID', 'RC_ID', 'Claim ID', 'ClaimID', 'claim_id'],
        'DATE': ['DATE', 'Date', 'INCIDENT_DATE', 'Incident Date', 'date'],
        'STATUS': ['STATUS', 'Status', 'status'],
        'DRIVER': ['DRIVER', 'Driver', 'driver', 'Driver Name'],
        'Dealer': ['Dealer', 'DEALER', 'Location', 'LOCATION', 'location'],
        'INCIDENT TYPE': ['INCIDENT TYPE', 'Incident Type', 'incident_type', 'Type'],
      };

      const getColumnValue = (row: any, columnName: string): any => {
        const aliases = COLUMN_ALIASES[columnName] || [columnName];
        for (const alias of aliases) {
          if (row[alias] !== undefined) return row[alias];
        }
        return undefined;
      };

      // Check for available import files
      const importDir = 'attached_assets';
      let filePath: string | null = null;
      
      if (fs.existsSync(importDir)) {
        const files = fs.readdirSync(importDir).filter(f => 
          f.endsWith('.xlsx') || f.endsWith('.xls')
        );
        if (files.length > 0) {
          filePath = path.join(importDir, files[files.length - 1]);
        }
      }

      if (!filePath || !fs.existsSync(filePath)) {
        return res.status(400).json({ 
          message: "No Excel file found for import",
          guidance: "Please upload an Excel file (.xlsx or .xls) to the attached_assets folder before importing.",
          missingFile: true
        });
      }

      const fileBuffer = fs.readFileSync(filePath);
      const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
      
      // Try multiple sheet names
      const sheetNames = ['Dealer Claim Data', 'Claims', 'Sheet1', workbook.SheetNames[0]];
      let sheet = null;
      let usedSheetName = '';
      for (const name of sheetNames) {
        if (workbook.Sheets[name]) {
          sheet = workbook.Sheets[name];
          usedSheetName = name;
          break;
        }
      }
      
      if (!sheet) {
        return res.status(400).json({ 
          message: "Could not find a valid sheet in the Excel file",
          availableSheets: workbook.SheetNames,
          guidance: "Expected sheet names: 'Dealer Claim Data', 'Claims', or 'Sheet1'"
        });
      }

      const data = XLSX.utils.sheet_to_json(sheet);
      
      if (data.length === 0) {
        return res.status(400).json({ 
          message: "Excel file is empty or has no data rows",
          sheetUsed: usedSheetName
        });
      }

      // Validate required columns
      const firstRow = data[0] as Record<string, any>;
      const availableColumns = Object.keys(firstRow);
      const requiredColumns = ['DATE', 'DRIVER'];
      const missingColumns: string[] = [];
      
      for (const col of requiredColumns) {
        if (getColumnValue(firstRow, col) === undefined) {
          missingColumns.push(col);
        }
      }

      if (missingColumns.length > 0) {
        return res.status(400).json({ 
          message: "Missing required columns in Excel file",
          missingColumns,
          availableColumns,
          guidance: `Required columns: ${requiredColumns.join(', ')}. Available: ${availableColumns.slice(0, 10).join(', ')}${availableColumns.length > 10 ? '...' : ''}`
        });
      }

      // Get default driver if needed
      const allDrivers = await db.select().from(drivers).limit(1);
      if (allDrivers.length === 0) {
        return res.status(400).json({ message: "No drivers found. Please create at least one driver first." });
      }
      const defaultDriverId = allDrivers[0].id;
      const defaultUserId = allDrivers[0].userId;

      const existingAccidents = await db.select({ redcapId: accidents.redcapId }).from(accidents);
      const existingRedcapIds = new Set(existingAccidents.map(a => a.redcapId).filter(Boolean));

      let imported = 0;
      let skipped = 0;
      const rowErrors: Array<{ row: number; column?: string; message: string }> = [];

      for (let i = 0; i < data.length; i++) {
        const row = data[i] as Record<string, any>;
        const rowNum = i + 2; // Excel rows are 1-indexed, +1 for header
        
        const redcapId = getColumnValue(row, 'RC ID') ? String(getColumnValue(row, 'RC ID')).trim() : null;
        
        if (redcapId && existingRedcapIds.has(redcapId)) {
          skipped++;
          continue;
        }

        try {
          const dateVal = getColumnValue(row, 'DATE');
          const parsedDate = excelDateToJS(dateVal);
          
          if (!parsedDate) {
            rowErrors.push({ row: rowNum, column: 'DATE', message: `Invalid date format: ${dateVal}` });
            continue;
          }

          const accidentData = {
            driverId: defaultDriverId,
            reportedBy: defaultUserId,
            redcapId,
            accidentDate: parsedDate,
            incidentDate: parsedDate,
            monthOfIncident: row['ME'] || null,
            yearOfIncident: row['Year'] ? String(row['Year']) : null,
            location: getColumnValue(row, 'Dealer') || 'Unknown Location',
            damageEst1: parseDecimal(row['EST 1']),
            damageEst2: parseDecimal(row['EST 2']),
            propertyDamage: parseDecimal(row['PROPERTY']),
            injuries: null,
            totalEstimate: parseDecimal(row['TOTAL EST']),
            probableCost: parseDecimal(row['PROBABLE']),
            actualCost: parseDecimal(row['ACTUAL']),
            status: 'open',
            paidNotClosed: row['PAID NOT CLOSED'] ? true : false,
            dodAtFault: row['DNS At Fault'] || null,
            driverPaymentPercent: null,
            notesReceived: row['NOTES/RECEIVED'] || null,
            vehicleInvolved: row['Vehicle_Involved'] || null,
            incidentType: getColumnValue(row, 'INCIDENT TYPE') || null,
            zendeskTicketNumber: row['ZD TICKET #'] ? String(row['ZD TICKET #']) : null,
            insuranceClaimSubmitted: parseBoolean(row['Ins Claim Submitted']),
            insuranceClaimNumber: row['Ins Claim #'] || null,
            subrogationClaim: row['Sobrogation Claim'] || null,
            insuranceReserve: parseDecimal(row['Ins Reserve']),
            insurancePaid: parseDecimal(row['Ins Paid']),
            insuranceTotal: parseDecimal(row['Ins Total']),
            insuranceDate: row['Ins Date'] ? excelDateToJS(row['Ins Date']) : null,
            insuranceFault: row['Ins Fault'] || null,
            insuranceComments: row['Ins Comments'] || null,
            description: `Driver: ${getColumnValue(row, 'DRIVER') || 'Unknown'} - ${getColumnValue(row, 'INCIDENT TYPE') || 'No type specified'}`,
          };

          await db.insert(accidents).values(accidentData);
          imported++;
          if (redcapId) existingRedcapIds.add(redcapId);
        } catch (error: any) {
          rowErrors.push({ 
            row: rowNum, 
            message: error.message || String(error)
          });
        }
      }

      res.json({
        message: imported > 0 ? "Import completed successfully" : "Import completed with issues",
        fileUsed: path.basename(filePath),
        sheetUsed: usedSheetName,
        total: data.length,
        imported,
        skipped,
        errorCount: rowErrors.length,
        rowErrors: rowErrors.slice(0, 10),
        hasMoreErrors: rowErrors.length > 10
      });
    } catch (error: any) {
      console.error("Error importing claims:", error);
      res.status(500).json({ 
        message: "Failed to import claims", 
        error: error.message || String(error),
        guidance: "Please check the Excel file format and try again. Ensure the file has valid headers and data."
      });
    }
  });

  // ==========================================
  // SCHEDULING & TIME MANAGEMENT ROUTES
  // ==========================================

  const SCHEDULING_PERMISSION_HIERARCHY: Record<string, number> = {
    'view': 1, 'edit': 2, 'approve': 3, 'publish': 4
  };

  async function resolveSchedulingPermission(userId: string, userRole: string | undefined, locationId?: string, teamId?: string): Promise<string> {
    if (userRole === 'super_user' || userRole === 'admin') return 'publish';
    
    const perms = await db.select().from(schedulingPermissions)
      .where(and(
        eq(schedulingPermissions.userId, userId),
        eq(schedulingPermissions.isActive, true)
      ));
    
    if (perms.length === 0) {
      return hasCorporateAccess(userRole) ? 'view' : 'none';
    }
    
    let highestLevel = 0;
    for (const perm of perms) {
      const locationMatch = !perm.locationId || perm.locationId === locationId;
      const teamMatch = !perm.teamId || perm.teamId === teamId;
      if (locationMatch && teamMatch) {
        const level = SCHEDULING_PERMISSION_HIERARCHY[perm.permissionLevel] || 0;
        if (level > highestLevel) highestLevel = level;
      }
    }
    
    const levelToName: Record<number, string> = { 1: 'view', 2: 'edit', 3: 'approve', 4: 'publish' };
    return levelToName[highestLevel] || 'none';
  }

  function hasSchedulingPermission(userPermLevel: string, requiredLevel: string): boolean {
    const hierarchy = SCHEDULING_PERMISSION_HIERARCHY;
    return (hierarchy[userPermLevel] || 0) >= (hierarchy[requiredLevel] || 0);
  }

  async function logSchedulingAudit(params: {
    actorUserId: string;
    actionType: string;
    entityType: string;
    entityId: string;
    locationId?: string | null;
    previousData?: any;
    newData?: any;
    metadata?: any;
    ipAddress?: string;
    userAgent?: string;
  }) {
    try {
      await db.insert(schedulingAuditLog).values({
        actorUserId: params.actorUserId,
        actionType: params.actionType,
        entityType: params.entityType,
        entityId: params.entityId,
        locationId: params.locationId || null,
        previousData: params.previousData || null,
        newData: params.newData || null,
        metadata: params.metadata || null,
        ipAddress: params.ipAddress || null,
        userAgent: params.userAgent || null,
      });
    } catch (error) {
      console.error('Failed to write scheduling audit log:', error);
    }
  }

  async function resolveSchedulingUserId(req) {
    if (req.session?.userId) return req.session.userId;
    if (req.user?.claims?.sub) {
      const sub = req.user.claims.sub;
      const email = req.user.claims.email;
      let dbUser = await db.select({ id: users.id }).from(users).where(eq(users.id, sub)).limit(1);
      if (dbUser.length === 0 && email) {
        dbUser = await db.select({ id: users.id }).from(users).where(eq(users.email, email)).limit(1);
      }
      return dbUser[0]?.id || null;
    }
    return null;
  }

  // Scheduling Analytics Dashboard
  app.get('/api/corporate/scheduling/analytics', isAuthenticated, async (req: any, res: Response) => {
    try {
      const { startDate, endDate, locationId, role } = req.query;
      
      if (!startDate || !endDate) {
        return res.status(400).json({ message: 'startDate and endDate are required' });
      }

      const locationFilter = locationId && locationId !== 'all' ? locationId : null;
      const roleFilter = role && role !== 'all' ? role : null;

      // 1. Fill Rate: % of shifts filled (assignedStaff / requiredStaff)
      // Apply location filter; apply role filter by checking if shift has assignments with that role
      const fillRateResult = await db.execute(sql`
        SELECT 
          COALESCE(SUM(s.required_staff), 0) as total_required,
          COALESCE(SUM(s.assigned_staff), 0) as total_assigned
        FROM shifts s
        WHERE s.date >= ${startDate} AND s.date <= ${endDate}
          AND s.status != 'cancelled'
          ${locationFilter ? sql`AND s.location_id = ${locationFilter}` : sql``}
          ${roleFilter ? sql`AND s.template_id IN (SELECT st2.id FROM shift_templates st2 WHERE st2.role = ${roleFilter})` : sql``}
      `);
      
      const totalRequired = Number(fillRateResult.rows[0]?.total_required) || 0;
      const totalAssigned = Number(fillRateResult.rows[0]?.total_assigned) || 0;
      const fillRate = totalRequired > 0 ? Math.round((totalAssigned / totalRequired) * 100) : 0;

      // 2. Overtime Hours from shift assignments (more granular with location/role filters)
      const overtimeResult = await db.execute(sql`
        SELECT 
          COALESCE(SUM(CASE WHEN sa.is_overtime THEN CAST(sa.scheduled_hours AS numeric) ELSE 0 END), 0) as assignment_ot_hours,
          COALESCE(SUM(CASE WHEN sa.is_overtime THEN CAST(sa.actual_hours AS numeric) ELSE 0 END), 0) as assignment_ot_actual
        FROM shift_assignments sa
        JOIN shifts s ON sa.shift_id = s.id
        LEFT JOIN shift_templates st ON s.template_id = st.id
        WHERE s.date >= ${startDate} AND s.date <= ${endDate}
          AND sa.status NOT IN ('declined', 'cancelled')
          AND s.status != 'cancelled'
          ${locationFilter ? sql`AND s.location_id = ${locationFilter}` : sql``}
          ${roleFilter ? sql`AND st.role = ${roleFilter}` : sql``}
      `);
      
      const overtimeHoursFromAssignments = Number(overtimeResult.rows[0]?.assignment_ot_hours) || 0;
      const overtimeActualFromAssignments = Number(overtimeResult.rows[0]?.assignment_ot_actual) || 0;

      // Also get timesheet OT for the period (filtered by users who have assignments matching filters)
      const timesheetOtResult = await db.execute(sql`
        SELECT 
          COALESCE(SUM(CAST(t.overtime_hours AS numeric)), 0) as ts_overtime,
          COALESCE(SUM(CAST(t.double_time_hours AS numeric)), 0) as ts_double_time
        FROM timesheets t
        WHERE t.period_start <= ${endDate} AND t.period_end >= ${startDate}
          ${(locationFilter || roleFilter) ? sql`AND t.user_id IN (
            SELECT DISTINCT sa3.user_id FROM shift_assignments sa3
            JOIN shifts s3 ON sa3.shift_id = s3.id
            LEFT JOIN shift_templates st3 ON s3.template_id = st3.id
            WHERE s3.date >= ${startDate} AND s3.date <= ${endDate}
              AND s3.status != 'cancelled'
              ${locationFilter ? sql`AND s3.location_id = ${locationFilter}` : sql``}
              ${roleFilter ? sql`AND st3.role = ${roleFilter}` : sql``}
          )` : sql``}
      `);
      
      const timesheetOt = Number(timesheetOtResult.rows[0]?.ts_overtime) || 0;
      const timesheetDt = Number(timesheetOtResult.rows[0]?.ts_double_time) || 0;
      const totalOvertimeHours = Math.max(timesheetOt + timesheetDt, overtimeActualFromAssignments);
      const projectedOtHours = overtimeHoursFromAssignments;

      // 3. Missed shifts (no_show) and late starts - deduplicated by assignment
      const missedShiftsResult = await db.execute(sql`
        SELECT DISTINCT ON (sa.id)
          sa.id as assignment_id,
          sa.user_id,
          sa.status as assignment_status,
          sa.scheduled_hours,
          st.role as role,
          s.id as shift_id,
          s.date as shift_date,
          s.start_time as shift_start_time,
          s.location_id,
          CONCAT(u.first_name, ' ', u.last_name) as driver_name,
          u.email as driver_email,
          wl.name as location_name,
          tce.event_time as clock_in_time
        FROM shift_assignments sa
        JOIN shifts s ON sa.shift_id = s.id
        LEFT JOIN shift_templates st ON s.template_id = st.id
        LEFT JOIN users u ON sa.user_id = u.id
        LEFT JOIN work_locations wl ON s.location_id = wl.id
        LEFT JOIN time_clock_events tce ON tce.shift_assignment_id = sa.id AND tce.event_type = 'clock_in'
        WHERE s.date >= ${startDate} AND s.date <= ${endDate}
          AND (sa.status = 'no_show' OR (tce.event_time IS NOT NULL AND tce.event_time > s.start_time + interval '10 minutes'))
          AND s.status != 'cancelled'
          ${locationFilter ? sql`AND s.location_id = ${locationFilter}` : sql``}
          ${roleFilter ? sql`AND st.role = ${roleFilter}` : sql``}
        ORDER BY sa.id, tce.event_time ASC
        LIMIT 200
      `);

      const noShowCount = missedShiftsResult.rows.filter((r: any) => r.assignment_status === 'no_show').length;
      const lateStartCount = missedShiftsResult.rows.filter((r: any) => r.assignment_status !== 'no_show').length;

      // 4. Utilization by driver
      const utilizationResult = await db.execute(sql`
        SELECT 
          sa.user_id,
          CONCAT(u.first_name, ' ', u.last_name) as driver_name,
          u.email as driver_email,
          st.role as role,
          COALESCE(SUM(CAST(sa.scheduled_hours AS numeric)), 0) as total_scheduled_hours,
          COALESCE(SUM(CAST(sa.actual_hours AS numeric)), 0) as total_actual_hours,
          COALESCE(SUM(CASE WHEN sa.is_overtime THEN CAST(sa.scheduled_hours AS numeric) ELSE 0 END), 0) as overtime_hours,
          COUNT(*) as total_shifts,
          COUNT(CASE WHEN sa.status = 'no_show' THEN 1 END) as no_show_count,
          COUNT(CASE WHEN sa.status IN ('assigned', 'confirmed', 'completed') THEN 1 END) as completed_shifts
        FROM shift_assignments sa
        JOIN shifts s ON sa.shift_id = s.id
        LEFT JOIN shift_templates st ON s.template_id = st.id
        LEFT JOIN users u ON sa.user_id = u.id
        WHERE s.date >= ${startDate} AND s.date <= ${endDate}
          AND sa.status NOT IN ('declined', 'cancelled')
          AND s.status != 'cancelled'
          ${locationFilter ? sql`AND s.location_id = ${locationFilter}` : sql``}
          ${roleFilter ? sql`AND st.role = ${roleFilter}` : sql``}
        GROUP BY sa.user_id, u.first_name, u.last_name, u.email, st.role
        ORDER BY total_scheduled_hours DESC
        LIMIT 200
      `);

      // Calculate utilization % based on working days in range (8h per weekday as baseline)
      const startD = new Date(startDate as string);
      const endD = new Date(endDate as string);
      const totalDays = Math.max(1, Math.ceil((endD.getTime() - startD.getTime()) / (1000 * 60 * 60 * 24)) + 1);
      const workingDays = Math.ceil(totalDays * 5 / 7);
      const maxHoursPerDriver = workingDays * 8;

      const utilizationByDriver = utilizationResult.rows.map((row: any) => ({
        userId: row.user_id,
        driverName: row.driver_name || row.driver_email || 'Unknown',
        role: row.role || 'Unassigned',
        scheduledHours: Number(row.total_scheduled_hours),
        actualHours: Number(row.total_actual_hours),
        overtimeHours: Number(row.overtime_hours),
        totalShifts: Number(row.total_shifts),
        noShowCount: Number(row.no_show_count),
        completedShifts: Number(row.completed_shifts),
        utilizationPercent: maxHoursPerDriver > 0 
          ? Math.min(100, Math.round((Number(row.total_scheduled_hours) / maxHoursPerDriver) * 100))
          : 0,
      }));

      const missedShifts = missedShiftsResult.rows.map((row: any) => {
        const lateMinutes = row.clock_in_time && row.shift_start_time 
          ? Math.round((new Date(row.clock_in_time).getTime() - new Date(row.shift_start_time).getTime()) / 60000)
          : null;
        return {
          assignmentId: row.assignment_id,
          userId: row.user_id,
          driverName: row.driver_name || row.driver_email || 'Unknown',
          shiftDate: row.shift_date,
          shiftStartTime: row.shift_start_time,
          locationName: row.location_name || 'Unassigned',
          role: row.role || 'Unassigned',
          type: row.assignment_status === 'no_show' ? 'no_show' : 'late_start',
          lateMinutes,
        };
      });

      // 5. Filter options
      const locationsResult = await db.execute(sql`
        SELECT id, name FROM work_locations WHERE is_active = true ORDER BY name
      `);

      const rolesResult = await db.execute(sql`
        SELECT DISTINCT role FROM shift_templates WHERE role IS NOT NULL AND role != '' AND is_active = true ORDER BY role
      `);

      // 6. Total shifts count
      const totalShiftsResult = await db.execute(sql`
        SELECT COUNT(*) as count FROM shifts 
        WHERE date >= ${startDate} AND date <= ${endDate}
          AND status != 'cancelled'
          ${locationFilter ? sql`AND location_id = ${locationFilter}` : sql``}
      `);

      const totalShifts = Number(totalShiftsResult.rows[0]?.count) || 0;

      const avgUtilization = utilizationByDriver.length > 0
        ? Math.round(utilizationByDriver.reduce((sum: number, d: any) => sum + d.utilizationPercent, 0) / utilizationByDriver.length)
        : 0;

      res.json({
        summary: {
          fillRate,
          totalRequired,
          totalAssigned,
          totalShifts,
          overtimeHours: totalOvertimeHours,
          projectedOvertimeHours: projectedOtHours,
          noShowCount,
          lateStartCount,
          avgUtilization,
          driverCount: utilizationByDriver.length,
        },
        utilizationByDriver,
        missedShifts,
        filters: {
          locations: locationsResult.rows.map((r: any) => ({ id: r.id, name: r.name })),
          roles: rolesResult.rows.map((r: any) => r.role).filter(Boolean),
        },
      });
    } catch (error) {
      console.error('Error fetching scheduling analytics:', error);
      res.status(500).json({ message: 'Failed to fetch scheduling analytics' });
    }
  });

  // iCal helper functions
  function formatICalDate(date: Date): string {
    return date.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
  }

  function escapeICalText(text: string): string {
    return text.replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\n/g, '\\n');
  }

    // Calendar Sync - iCal Feed Management
  // Generate or get existing feed token for current user
  app.post('/api/scheduling/calendar-feed/token', isAuthenticated, async (req: any, res: Response) => {
    try {
      let userId = (req.session as any)?.userId;
      if (!userId && req.user?.claims?.sub) {
        // OIDC: resolve actual user ID from DB by sub or email
        const sub = req.user.claims.sub;
        const email = req.user.claims.email;
        let dbUser = await db.execute(sql`SELECT id FROM users WHERE id = ${sub} LIMIT 1`);
        if (dbUser.rows.length === 0 && email) {
          dbUser = await db.execute(sql`SELECT id FROM users WHERE email = ${email} LIMIT 1`);
        }
        userId = dbUser.rows[0]?.id as string || null;
      }
      if (!userId) return res.status(401).json({ message: 'Unauthorized' });

      const label = req.body.label || 'My Schedule';

      // Check for existing active token
      const existing = await db.execute(sql`
        SELECT * FROM calendar_feed_tokens WHERE user_id = ${userId} AND is_active = true LIMIT 1
      `);

      if (existing.rows.length > 0) {
        return res.json({ token: existing.rows[0] });
      }

      // Generate new token (crypto-safe random)
      const crypto = await import('crypto');
      const token = crypto.randomBytes(32).toString('hex');

      const result = await db.execute(sql`
        INSERT INTO calendar_feed_tokens (user_id, token, label)
        VALUES (${userId}, ${token}, ${label})
        RETURNING *
      `);

      res.json({ token: result.rows[0] });
    } catch (error) {
      console.error('Error creating calendar feed token:', error);
      res.status(500).json({ message: 'Failed to create calendar feed token' });
    }
  });

  // Get current user's feed tokens
  app.get('/api/scheduling/calendar-feed/tokens', isAuthenticated, async (req: any, res: Response) => {
    try {
      let userId = (req.session as any)?.userId;
      if (!userId && req.user?.claims?.sub) {
        // OIDC: resolve actual user ID from DB by sub or email
        const sub = req.user.claims.sub;
        const email = req.user.claims.email;
        let dbUser = await db.execute(sql`SELECT id FROM users WHERE id = ${sub} LIMIT 1`);
        if (dbUser.rows.length === 0 && email) {
          dbUser = await db.execute(sql`SELECT id FROM users WHERE email = ${email} LIMIT 1`);
        }
        userId = dbUser.rows[0]?.id as string || null;
      }
      if (!userId) return res.status(401).json({ message: 'Unauthorized' });

      const tokens = await db.execute(sql`
        SELECT id, token, label, is_active, last_accessed_at, access_count, created_at
        FROM calendar_feed_tokens WHERE user_id = ${userId} ORDER BY created_at DESC
      `);

      res.json({ tokens: tokens.rows });
    } catch (error) {
      console.error('Error fetching calendar feed tokens:', error);
      res.status(500).json({ message: 'Failed to fetch calendar feed tokens' });
    }
  });

  // Revoke a feed token
  app.delete('/api/scheduling/calendar-feed/token/:tokenId', isAuthenticated, async (req: any, res: Response) => {
    try {
      let userId = (req.session as any)?.userId;
      if (!userId && req.user?.claims?.sub) {
        // OIDC: resolve actual user ID from DB by sub or email
        const sub = req.user.claims.sub;
        const email = req.user.claims.email;
        let dbUser = await db.execute(sql`SELECT id FROM users WHERE id = ${sub} LIMIT 1`);
        if (dbUser.rows.length === 0 && email) {
          dbUser = await db.execute(sql`SELECT id FROM users WHERE email = ${email} LIMIT 1`);
        }
        userId = dbUser.rows[0]?.id as string || null;
      }
      if (!userId) return res.status(401).json({ message: 'Unauthorized' });

      await db.execute(sql`
        UPDATE calendar_feed_tokens SET is_active = false
        WHERE id = ${req.params.tokenId} AND user_id = ${userId}
      `);

      res.json({ success: true });
    } catch (error) {
      console.error('Error revoking calendar feed token:', error);
      res.status(500).json({ message: 'Failed to revoke token' });
    }
  });

  // Public iCal feed endpoint (no auth - uses token)
  app.get('/api/calendar-feed/:token.ics', async (req: any, res: Response) => {
    try {
      const { token } = req.params;

      // Validate token
      const tokenResult = await db.execute(sql`
        SELECT cft.*, u.first_name, u.last_name, u.email
        FROM calendar_feed_tokens cft
        JOIN users u ON cft.user_id = u.id
        WHERE cft.token = ${token} AND cft.is_active = true
      `);

      if (tokenResult.rows.length === 0) {
        return res.status(404).send('Calendar feed not found or expired');
      }

      const feedToken = tokenResult.rows[0];
      const userId = feedToken.user_id as string;

      // Update access tracking
      await db.execute(sql`
        UPDATE calendar_feed_tokens
        SET last_accessed_at = NOW(), access_count = access_count + 1
        WHERE token = ${token}
      `);

      // Fetch upcoming shifts for this user (next 90 days + past 7 days)
      const now = new Date();
      const pastDate = new Date(now);
      pastDate.setDate(pastDate.getDate() - 7);
      const futureDate = new Date(now);
      futureDate.setDate(futureDate.getDate() + 90);
      const pastStr = pastDate.toISOString().split('T')[0];
      const futureStr = futureDate.toISOString().split('T')[0];

      const shifts = await db.execute(sql`
        SELECT 
          sa.id as assignment_id,
          s.id as shift_id,
          s.date,
          s.start_time,
          s.end_time,
          s.notes as shift_notes,
          s.status as shift_status,
          st.name as template_name,
          st.role,
          wl.name as location_name,
          wl.address as location_address,
          sa.status as assignment_status,
          sa.notes as assignment_notes
        FROM shift_assignments sa
        JOIN shifts s ON sa.shift_id = s.id
        LEFT JOIN shift_templates st ON s.template_id = st.id
        LEFT JOIN work_locations wl ON s.location_id = wl.id
        WHERE sa.user_id = ${userId}
          AND s.date >= ${pastStr} AND s.date <= ${futureStr}
          AND sa.status NOT IN ('declined', 'cancelled')
          AND s.status != 'cancelled'
        ORDER BY s.start_time ASC
      `);

      // Generate iCal content
      const driverName = [feedToken.first_name, feedToken.last_name].filter(Boolean).join(' ') || feedToken.email;
      const hostname = req.get('host') || 'driverhub360.replit.app';

      let ical = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//DriverHub 360//Scheduling//EN',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH',
        'X-WR-CALNAME:DriverHub Schedule - ' + driverName.replace(/[,;\\]/g, ''),
        'X-WR-TIMEZONE:America/Chicago',
        'REFRESH-INTERVAL;VALUE=DURATION:PT30M',
        'X-PUBLISHED-TTL:PT30M',
      ];

      for (const shift of shifts.rows) {
        const startTime = new Date(shift.start_time as string);
        const endTime = new Date(shift.end_time as string);
        const uid = (shift.assignment_id as string) + '@' + hostname;

        const summary = [
          shift.template_name || 'Shift',
          shift.role ? '(' + shift.role + ')' : '',
        ].filter(Boolean).join(' ');

        const location = [
          shift.location_name,
          shift.location_address,
        ].filter(Boolean).join(', ');

        const description = [
          shift.role ? 'Role: ' + shift.role : '',
          shift.location_name ? 'Location: ' + shift.location_name : '',
          shift.assignment_status ? 'Status: ' + (shift.assignment_status as string).charAt(0).toUpperCase() + (shift.assignment_status as string).slice(1) : '',
          shift.shift_notes ? 'Notes: ' + shift.shift_notes : '',
          shift.assignment_notes ? 'Assignment Notes: ' + shift.assignment_notes : '',
        ].filter(Boolean).join('\\n');

        ical.push('BEGIN:VEVENT');
        ical.push('UID:' + uid);
        ical.push('DTSTART:' + formatICalDate(startTime));
        ical.push('DTEND:' + formatICalDate(endTime));
        ical.push('DTSTAMP:' + formatICalDate(now));
        ical.push('SUMMARY:' + escapeICalText(summary));
        if (location) ical.push('LOCATION:' + escapeICalText(location));
        if (description) ical.push('DESCRIPTION:' + escapeICalText(description));

        // Status mapping
        if (shift.assignment_status === 'confirmed') {
          ical.push('STATUS:CONFIRMED');
        } else if (shift.assignment_status === 'assigned') {
          ical.push('STATUS:TENTATIVE');
        }

        ical.push('END:VEVENT');
      }

      ical.push('END:VCALENDAR');

      res.setHeader('Content-Type', 'text/calendar; charset=utf-8');
      res.setHeader('Content-Disposition', 'inline; filename="schedule.ics"');
      res.setHeader('Cache-Control', 'no-cache, no-store, must-revalidate');
      res.send(ical.join('\r\n'));
    } catch (error) {
      console.error('Error generating calendar feed:', error);
      res.status(500).send('Error generating calendar feed');
    }
  });

  // Labor Forecasting (Advisory Stub)
  app.get('/api/corporate/scheduling/labor-forecast', isAuthenticated, async (req: any, res: Response) => {
    try {
      const { forecastDays = '7', locationId } = req.query;
      const days = Math.min(Math.max(parseInt(forecastDays as string) || 7, 1), 30);
      const locationFilter = locationId && locationId !== 'all' ? locationId : null;

      const today = new Date();
      const todayStr = today.toISOString().split('T')[0];

      const forecastStart = new Date(today);
      forecastStart.setDate(forecastStart.getDate() + 1);
      const forecastEnd = new Date(today);
      forecastEnd.setDate(forecastEnd.getDate() + days);
      const forecastStartStr = forecastStart.toISOString().split('T')[0];
      const forecastEndStr = forecastEnd.toISOString().split('T')[0];

      const historicalStart = new Date(today);
      historicalStart.setDate(historicalStart.getDate() - 90);
      const historicalStartStr = historicalStart.toISOString().split('T')[0];

      const historicalStaffing = await db.execute(sql`
        SELECT 
          EXTRACT(DOW FROM s.date::date) as day_of_week,
          ROUND(AVG(s.required_staff), 1) as avg_required,
          ROUND(AVG(s.assigned_staff), 1) as avg_assigned,
          COUNT(DISTINCT s.date) as sample_days,
          COUNT(*) as shift_count
        FROM shifts s
        WHERE s.date >= ${historicalStartStr} AND s.date <= ${todayStr}
          AND s.status NOT IN ('cancelled', 'draft')
          ${locationFilter ? sql`AND s.location_id = ${locationFilter}` : sql``}
        GROUP BY EXTRACT(DOW FROM s.date::date)
        ORDER BY day_of_week
      `);

      const historicalVolume = await db.execute(sql`
        SELECT 
          EXTRACT(DOW FROM t.trip_date) as day_of_week,
          COUNT(*) as total_moves,
          COUNT(DISTINCT t.trip_date::date) as sample_days,
          ROUND(COUNT(*)::numeric / GREATEST(COUNT(DISTINCT t.trip_date::date), 1), 1) as avg_moves_per_day
        FROM trips t
        WHERE t.trip_date >= ${historicalStartStr}::timestamp AND t.trip_date <= ${todayStr}::timestamp
          AND t.status != 'cancelled'
        GROUP BY EXTRACT(DOW FROM t.trip_date)
        ORDER BY day_of_week
      `);

      const scheduledShifts = await db.execute(sql`
        SELECT 
          s.date,
          SUM(s.required_staff) as required_staff,
          SUM(s.assigned_staff) as assigned_staff,
          COUNT(*) as shift_count
        FROM shifts s
        WHERE s.date >= ${forecastStartStr} AND s.date <= ${forecastEndStr}
          AND s.status != 'cancelled'
          ${locationFilter ? sql`AND s.location_id = ${locationFilter}` : sql``}
        GROUP BY s.date
        ORDER BY s.date
      `);

      const hourlyPatterns = await db.execute(sql`
        SELECT 
          EXTRACT(HOUR FROM s.start_time) as hour_of_day,
          ROUND(AVG(s.required_staff), 1) as avg_required,
          COUNT(*) as shift_count
        FROM shifts s
        WHERE s.date >= ${historicalStartStr} AND s.date <= ${todayStr}
          AND s.status NOT IN ('cancelled', 'draft')
          ${locationFilter ? sql`AND s.location_id = ${locationFilter}` : sql``}
        GROUP BY EXTRACT(HOUR FROM s.start_time)
        ORDER BY hour_of_day
      `);

      const staffByDow: Record<number, any> = {};
      for (const row of historicalStaffing.rows) {
        staffByDow[Number(row.day_of_week)] = {
          avgRequired: Number(row.avg_required) || 0,
          avgAssigned: Number(row.avg_assigned) || 0,
          sampleDays: Number(row.sample_days) || 0,
          shiftCount: Number(row.shift_count) || 0,
        };
      }

      const volumeByDow: Record<number, any> = {};
      for (const row of historicalVolume.rows) {
        volumeByDow[Number(row.day_of_week)] = {
          avgMovesPerDay: Number(row.avg_moves_per_day) || 0,
          totalMoves: Number(row.total_moves) || 0,
          sampleDays: Number(row.sample_days) || 0,
        };
      }

      const scheduledByDate: Record<string, any> = {};
      for (const row of scheduledShifts.rows) {
        scheduledByDate[String(row.date)] = {
          requiredStaff: Number(row.required_staff) || 0,
          assignedStaff: Number(row.assigned_staff) || 0,
          shiftCount: Number(row.shift_count) || 0,
        };
      }

      let movesToStaffRatio = 5;
      let totalHistMoves = 0;
      let totalHistStaff = 0;
      for (let dow = 0; dow <= 6; dow++) {
        const vol = volumeByDow[dow];
        const staff = staffByDow[dow];
        if (vol && staff && staff.avgRequired > 0) {
          totalHistMoves += vol.avgMovesPerDay;
          totalHistStaff += staff.avgRequired;
        }
      }
      if (totalHistStaff > 0 && totalHistMoves > 0) {
        movesToStaffRatio = totalHistMoves / totalHistStaff;
      }

      const dailyForecast: any[] = [];
      const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

      for (let i = 1; i <= days; i++) {
        const forecastDate = new Date(today);
        forecastDate.setDate(forecastDate.getDate() + i);
        const dateStr = forecastDate.toISOString().split('T')[0];
        const dow = forecastDate.getDay();

        const histStaff = staffByDow[dow];
        const histVolume = volumeByDow[dow];
        const scheduled = scheduledByDate[dateStr];

        let recommendedMin = 0;
        let recommendedMax = 0;
        let confidence: 'high' | 'medium' | 'low' | 'none' = 'none';

        if (histStaff && histStaff.sampleDays >= 4) {
          recommendedMin = Math.max(1, Math.floor(histStaff.avgRequired * 0.8));
          recommendedMax = Math.ceil(histStaff.avgRequired * 1.2);
          confidence = histStaff.sampleDays >= 8 ? 'high' : 'medium';
        } else if (histVolume && histVolume.sampleDays >= 3) {
          const volumeBasedEstimate = Math.ceil(histVolume.avgMovesPerDay / movesToStaffRatio);
          recommendedMin = Math.max(1, Math.floor(volumeBasedEstimate * 0.8));
          recommendedMax = Math.ceil(volumeBasedEstimate * 1.3);
          confidence = histVolume.sampleDays >= 6 ? 'medium' : 'low';
        }

        let status: string = 'unscheduled';
        const currentStaff = scheduled?.assignedStaff || 0;
        const currentRequired = scheduled?.requiredStaff || 0;

        if (scheduled) {
          if (recommendedMin > 0) {
            if (currentStaff < recommendedMin) status = 'understaffed';
            else if (currentStaff > recommendedMax) status = 'overstaffed';
            else status = 'adequate';
          } else {
            if (currentRequired > 0 && currentStaff < currentRequired) status = 'understaffed';
            else if (currentRequired > 0 && currentStaff >= currentRequired) status = 'adequate';
          }
        }

        dailyForecast.push({
          date: dateStr,
          dayOfWeek: dow,
          dayName: dayNames[dow],
          historicalAvgStaff: histStaff?.avgRequired || 0,
          historicalAvgVolume: histVolume?.avgMovesPerDay || 0,
          recommendedMin,
          recommendedMax,
          confidence,
          currentScheduled: currentStaff,
          currentRequired,
          shiftCount: scheduled?.shiftCount || 0,
          status,
        });
      }

      const hourlyForecastArr = [];
      for (let h = 0; h < 24; h++) {
        const pattern = hourlyPatterns.rows.find((r: any) => Number(r.hour_of_day) === h);
        hourlyForecastArr.push({
          hour: h,
          label: h.toString().padStart(2, '0') + ':00',
          avgRequired: pattern ? Number(pattern.avg_required) : 0,
          shiftCount: pattern ? Number(pattern.shift_count) : 0,
        });
      }

      const understaffedDays = dailyForecast.filter(d => d.status === 'understaffed').length;
      const overstaffedDays = dailyForecast.filter(d => d.status === 'overstaffed').length;
      const unscheduledDays = dailyForecast.filter(d => d.status === 'unscheduled').length;
      const adequateDays = dailyForecast.filter(d => d.status === 'adequate').length;

      const locationsResult = await db.execute(sql`
        SELECT id, name FROM work_locations WHERE is_active = true ORDER BY name
      `);

      res.json({
        forecastWindow: { start: forecastStartStr, end: forecastEndStr, days },
        summary: {
          understaffedDays,
          overstaffedDays,
          adequateDays,
          unscheduledDays,
          historicalDataAvailable: Object.keys(staffByDow).length > 0 || Object.keys(volumeByDow).length > 0,
          movesToStaffRatio: Math.round(movesToStaffRatio * 10) / 10,
        },
        dailyForecast,
        hourlyPattern: hourlyForecastArr,
        locations: locationsResult.rows.map((r: any) => ({ id: r.id, name: r.name })),
        advisory: "This forecast is advisory only. No automated scheduling changes will be made.",
      });
    } catch (error) {
      console.error('Error fetching labor forecast:', error);
      res.status(500).json({ message: 'Failed to fetch labor forecast' });
    }
  });


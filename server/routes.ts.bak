  // =========================================================================
  // APPLICATION LOCKING & CONCURRENCY CONTROL
  // =========================================================================

  // POST /api/recruiting/applications/:id/lock - Acquire or refresh lock
  app.post("/api/recruiting/applications/:id/lock", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }
      const user = await db.query.users.findFirst({ where: eq(users.id, userId) });
      if (!user) return res.status(401).json({ message: "User not found" });

      const { acquireApplicationLock } = await import("./recruitingService");
      const result = await acquireApplicationLock(req.params.id, userId, user.email || "", user.role);

      if (!result.success) {
        return res.status(409).json({
          message: "Application is locked by another user",
          conflict: result.conflict,
        });
      }

      res.json({ lock: result.lock });
    } catch (error) {
      console.error("[Recruiting] Error acquiring lock:", error);
      res.status(500).json({ message: "Failed to acquire lock" });
    }
  });

  // PUT /api/recruiting/applications/:id/lock - Refresh an existing lock
  app.put("/api/recruiting/applications/:id/lock", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { refreshApplicationLock } = await import("./recruitingService");
      const result = await refreshApplicationLock(req.params.id, userId);

      if (!result.success) {
        if (result.conflict) {
          return res.status(409).json({
            message: "Lock is held by another user",
            conflict: result.conflict,
          });
        }
        return res.status(404).json({ message: "No active lock found" });
      }

      res.json({ lock: result.lock });
    } catch (error) {
      console.error("[Recruiting] Error refreshing lock:", error);
      res.status(500).json({ message: "Failed to refresh lock" });
    }
  });

  // DELETE /api/recruiting/applications/:id/lock - Release lock
  app.delete("/api/recruiting/applications/:id/lock", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }
      const user = await db.query.users.findFirst({ where: eq(users.id, userId) });
      if (!user) return res.status(401).json({ message: "User not found" });

      const { releaseApplicationLock } = await import("./recruitingService");
      const released = await releaseApplicationLock(req.params.id, userId, user.email || "", user.role);

      if (!released) {
        return res.status(404).json({ message: "No active lock found for this user" });
      }

      res.json({ released: true });
    } catch (error) {
      console.error("[Recruiting] Error releasing lock:", error);
      res.status(500).json({ message: "Failed to release lock" });
    }
  });


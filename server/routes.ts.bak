  // Create a new saved view
  app.post("/api/corporate/account-views", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      // Validate request body
      const createViewSchema = z.object({
        name: z.string().min(1, "Name is required").max(100),
        filterStatus: z.string().nullable().optional(),
        filterHealth: z.string().nullable().optional(),
        filterOwner: z.string().nullable().optional(),
        filterAccountType: z.string().nullable().optional(),
        filterParentAccount: z.string().nullable().optional(),
        filterNeedsContact: z.boolean().nullable().optional(),
      });

      const validatedData = createViewSchema.parse(req.body);
      
      const viewData = {
        ...validatedData,
        userId,
        isSystemDefault: false,
      };
      
      const created = await storage.createSavedAccountView(viewData);
      res.json(created);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error creating saved view:", error);
      res.status(500).json({ message: "Failed to create saved view" });
    }
  });

  // Update a saved view (only user-created views)
  app.patch("/api/corporate/account-views/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      // Validate request body
      const updateViewSchema = z.object({
        name: z.string().min(1, "Name is required").max(100).optional(),
        filterStatus: z.string().nullable().optional(),
        filterHealth: z.string().nullable().optional(),
        filterOwner: z.string().nullable().optional(),
        filterAccountType: z.string().nullable().optional(),
        filterParentAccount: z.string().nullable().optional(),
        filterNeedsContact: z.boolean().nullable().optional(),
      });

      const validatedData = updateViewSchema.parse(req.body);

      const updated = await storage.updateSavedAccountView(req.params.id, userId, validatedData);
      if (!updated) {
        return res.status(404).json({ message: "View not found or cannot be modified" });
      }
      res.json(updated);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error updating saved view:", error);
      res.status(500).json({ message: "Failed to update saved view" });
    }
  });


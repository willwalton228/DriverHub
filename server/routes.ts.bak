  // PATCH /api/retention/policies/:id - Update a retention policy
  app.patch("/api/retention/policies/:id", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);
      let actualUserId = userId;
      if (!user) {
        const [userByEmail] = await db.select().from(users)
          .where(eq(users.email, (req as any).user?.claims?.email || ''))
          .limit(1);
        if (!userByEmail || !['admin', 'super_user'].includes(userByEmail.role || '')) {
          return res.status(403).json({ message: "Admin access required" });
        }
        actualUserId = userByEmail.id;
      } else if (!['admin', 'super_user'].includes(user.role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { id } = req.params;
      const { retentionDays, legalHoldEnabled, legalHoldReason } = req.body;

      const [updated] = await db.update(retentionPolicies)
        .set({
          ...(retentionDays !== undefined && { retentionDays }),
          ...(legalHoldEnabled !== undefined && { legalHoldEnabled }),
          ...(legalHoldReason !== undefined && { legalHoldReason }),
          updatedAt: new Date(),
          updatedBy: actualUserId,
        })
        .where(eq(retentionPolicies.id, id))
        .returning();

      if (!updated) {
        return res.status(404).json({ message: "Policy not found" });
      }

      console.log(`[Retention] Policy ${updated.policyName} updated by ${actualUserId}`);
      res.json({ policy: updated });
    } catch (error) {
      console.error("[Retention] Error updating policy:", error);
      res.status(500).json({ message: "Failed to update retention policy" });
    }
  });

  // GET /api/retention/purge-runs - Get purge run history
  app.get("/api/retention/purge-runs", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);
      if (!user) {
        const [userByEmail] = await db.select().from(users)
          .where(eq(users.email, (req as any).user?.claims?.email || ''))
          .limit(1);
        if (!userByEmail || !['admin', 'super_user'].includes(userByEmail.role || '')) {
          return res.status(403).json({ message: "Admin access required" });
        }
      } else if (!['admin', 'super_user'].includes(user.role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { limit: limitParam } = req.query;
      const limit = Math.min(parseInt(limitParam as string) || 50, 200);

      const runs = await db.select({
        run: purgeRuns,
        policy: retentionPolicies,
      })
        .from(purgeRuns)
        .leftJoin(retentionPolicies, eq(purgeRuns.policyId, retentionPolicies.id))
        .orderBy(desc(purgeRuns.startedAt))
        .limit(limit);

      res.json({ runs });
    } catch (error) {
      console.error("[Retention] Error fetching purge runs:", error);
      res.status(500).json({ message: "Failed to fetch purge runs" });
    }
  });


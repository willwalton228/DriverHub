  // ============================================
  // INVOICING EXPORTS API (TICKET 25)
  // Audit/Compliance Export Endpoints
  // ============================================

  // Export Invoice Ledger
  app.get("/api/corporate/invoicing/exports/invoice-ledger", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { format = 'csv', startDate, endDate, customerId, billingEntityId, locationId } = req.query;
      const filters: ExportFilters = { startDate, endDate, customerId, billingEntityId, locationId };

      // Fetch invoices with filters
      const allInvoices = await storage.getAllInvoices();
      
      // Apply filters
      let filteredInvoices = allInvoices.filter(inv => {
        if (startDate && new Date(inv.invoiceDate) < new Date(startDate as string)) return false;
        if (endDate && new Date(inv.invoiceDate) > new Date(endDate as string)) return false;
        if (customerId && inv.customerId !== customerId) return false;
        if (billingEntityId && inv.billingEntityId !== billingEntityId) return false;
        if (locationId && inv.locationId !== locationId) return false;
        return true;
      });

      // Get billing entities and customers for display names
      const billingEntities = await storage.getAllBillingEntities();
      const billingLocations = await storage.getAllBillingLocations();
      const entityMap = new Map(billingEntities.map(e => [e.id, e.name]));
      const locationMap = new Map(billingLocations.map(l => [l.id, l.name]));

      // Transform to ledger rows
      const ledgerRows: InvoiceLedgerRow[] = filteredInvoices.map(inv => {
        const aging = calculateAgingBucket(inv.dueDate);
        const totalAmount = Number(inv.totalAmount || 0);
        const amountPaid = Number(inv.amountPaid || 0);
        return {
          invoiceNumber: inv.invoiceNumber,
          invoiceDate: formatDate(inv.invoiceDate),
          dueDate: formatDate(inv.dueDate),
          customerName: inv.customerName || '',
          billingEntity: entityMap.get(inv.billingEntityId || '') || '',
          location: locationMap.get(inv.locationId || '') || '',
          status: inv.status || 'draft',
          totalAmount,
          amountPaid,
          balance: totalAmount - amountPaid,
          agingDays: aging.days,
          agingBucket: aging.bucket,
          createdBy: inv.createdBy || '',
          createdAt: formatDate(inv.createdAt),
        };
      });

      // Calculate totals
      const totals = {
        totalInvoiced: ledgerRows.reduce((sum, r) => sum + r.totalAmount, 0),
        totalPaid: ledgerRows.reduce((sum, r) => sum + r.amountPaid, 0),
        totalBalance: ledgerRows.reduce((sum, r) => sum + r.balance, 0),
      };

      if (format === 'pdf') {
        const pdf = generateInvoiceLedgerPDF(ledgerRows, filters, totals);
        res.setHeader('Content-Type', 'application/pdf');
        res.setHeader('Content-Disposition', `attachment; filename="invoice_ledger_${Date.now()}.pdf"`);
        pdf.pipe(res);
        pdf.end();
      } else {
        const csv = generateInvoiceLedgerCSV(ledgerRows);
        res.setHeader('Content-Type', 'text/csv');
        res.setHeader('Content-Disposition', `attachment; filename="invoice_ledger_${Date.now()}.csv"`);
        res.send(csv);
      }
    } catch (error) {
      console.error("Error exporting invoice ledger:", error);
      res.status(500).json({ message: "Failed to export invoice ledger" });
    }
  });

  // Export Payment Ledger
  app.get("/api/corporate/invoicing/exports/payment-ledger", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { format = 'csv', startDate, endDate, customerId, billingEntityId, locationId } = req.query;
      const filters: ExportFilters = { startDate, endDate, customerId, billingEntityId, locationId };

      // Fetch all payments
      const allPayments = await storage.getAllPayments();
      const allInvoices = await storage.getAllInvoices();
      const invoiceMap = new Map(allInvoices.map(i => [i.id, i]));

      // Apply filters (including entity/location via invoice)
      let filteredPayments = allPayments.filter(pmt => {
        if (startDate && new Date(pmt.paymentDate) < new Date(startDate as string)) return false;
        if (endDate && new Date(pmt.paymentDate) > new Date(endDate as string)) return false;
        if (customerId && pmt.customerId !== customerId) return false;
        // Filter by billing entity/location via the associated invoice
        const invoice = invoiceMap.get(pmt.invoiceId || '');
        if (billingEntityId && invoice?.billingEntityId !== billingEntityId) return false;
        if (locationId && invoice?.locationId !== locationId) return false;
        return true;
      });
      // Transform to ledger rows
      const ledgerRows: PaymentLedgerRow[] = filteredPayments.map(pmt => {
        const invoice = invoiceMap.get(pmt.invoiceId || '');
        return {
          paymentId: pmt.id,
          paymentDate: formatDate(pmt.paymentDate),
          invoiceNumber: invoice?.invoiceNumber || pmt.invoiceId || '',
          customerName: pmt.customerName || '',
          paymentMethod: pmt.paymentMethod || '',
          referenceNumber: pmt.referenceNumber || pmt.checkNumber || pmt.stripePaymentIntentId || '',
          amount: Number(pmt.amount || 0),
          appliedAmount: Number(pmt.appliedAmount || pmt.amount || 0),
          status: pmt.status || 'completed',
          recordedBy: pmt.recordedBy || '',
          recordedAt: formatDate(pmt.createdAt),
        };
      });

      // Calculate totals
      const totals = {
        totalPayments: ledgerRows.reduce((sum, r) => sum + r.amount, 0),
        totalApplied: ledgerRows.reduce((sum, r) => sum + r.appliedAmount, 0),
      };

      if (format === 'pdf') {
        const pdf = generatePaymentLedgerPDF(ledgerRows, filters, totals);
        res.setHeader('Content-Type', 'application/pdf');
        res.setHeader('Content-Disposition', `attachment; filename="payment_ledger_${Date.now()}.pdf"`);
        pdf.pipe(res);
        pdf.end();
      } else {
        const csv = generatePaymentLedgerCSV(ledgerRows);
        res.setHeader('Content-Type', 'text/csv');
        res.setHeader('Content-Disposition', `attachment; filename="payment_ledger_${Date.now()}.csv"`);
        res.send(csv);
      }
    } catch (error) {
      console.error("Error exporting payment ledger:", error);
      res.status(500).json({ message: "Failed to export payment ledger" });
    }
  });

  // Export Credits/Voids Report
  app.get("/api/corporate/invoicing/exports/credits-voids", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { format = 'csv', startDate, endDate, customerId, billingEntityId, locationId } = req.query;
      const filters: ExportFilters = { startDate, endDate, customerId, billingEntityId, locationId };

      // Fetch voided and credited invoices
      const allInvoices = await storage.getAllInvoices();
      
      // Filter for voided/credited invoices
      let filteredInvoices = allInvoices.filter(inv => {
        if (inv.status !== 'voided' && inv.status !== 'credited') return false;
        if (startDate && inv.voidedAt && new Date(inv.voidedAt) < new Date(startDate as string)) return false;
        if (endDate && inv.voidedAt && new Date(inv.voidedAt) > new Date(endDate as string)) return false;
        if (customerId && inv.customerId !== customerId) return false;
        if (billingEntityId && inv.billingEntityId !== billingEntityId) return false;
        if (locationId && inv.locationId !== locationId) return false;
        return true;
      });

      // Get users for display names
      const users = await storage.getUsers();
      const userMap = new Map(users.map(u => [u.id, u.email || u.username || u.id]));

      // Transform to report rows
      const reportRows: CreditVoidRow[] = filteredInvoices.map(inv => ({
        invoiceNumber: inv.invoiceNumber,
        type: inv.status === 'voided' ? 'void' : 'credit',
        originalAmount: Number(inv.totalAmount || 0),
        creditAmount: inv.status === 'credited' ? Number(inv.totalAmount || 0) : undefined,
        reason: inv.voidReason || inv.status || '',
        performedBy: userMap.get(inv.voidedBy || '') || inv.voidedBy || '',
        performedAt: formatDate(inv.voidedAt),
        approvedBy: undefined,
        notes: inv.internalNotes || '',
      }));

      if (format === 'pdf') {
        const pdf = generateCreditsVoidsPDF(reportRows, filters);
        res.setHeader('Content-Type', 'application/pdf');
        res.setHeader('Content-Disposition', `attachment; filename="credits_voids_${Date.now()}.pdf"`);
        pdf.pipe(res);
        pdf.end();
      } else {
        const csv = generateCreditsVoidsCSV(reportRows);
        res.setHeader('Content-Type', 'text/csv');
        res.setHeader('Content-Disposition', `attachment; filename="credits_voids_${Date.now()}.csv"`);
        res.send(csv);
      }
    } catch (error) {
      console.error("Error exporting credits/voids:", error);
      res.status(500).json({ message: "Failed to export credits/voids report" });
    }
  });

  // Export Collections Activity Log
  app.get("/api/corporate/invoicing/exports/collections-activity", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { format = 'csv', startDate, endDate, customerId, billingEntityId, locationId } = req.query;
      const filters: ExportFilters = { startDate, endDate, customerId, billingEntityId, locationId };

      // Fetch invoice activities (reminders, collections actions)
      const allInvoices = await storage.getAllInvoices();
      
      // Get users for display names
      const users = await storage.getUsers();
      const userMap = new Map(users.map(u => [u.id, u.email || u.username || u.id]));

      // Collect activities from invoices (reminders sent, status changes, etc.)
      const activities: CollectionsActivityRow[] = [];
      
      for (const inv of allInvoices) {
        // Apply base filters
        if (customerId && inv.customerId !== customerId) continue;
        if (billingEntityId && inv.billingEntityId !== billingEntityId) continue;
        if (locationId && inv.locationId !== locationId) continue;

        // Add reminder activities (with date filter)
        if (inv.lastReminderSentAt) {
          const reminderDate = new Date(inv.lastReminderSentAt);
          const passesDateFilter = (!startDate || reminderDate >= new Date(startDate as string)) &&
                                   (!endDate || reminderDate <= new Date(endDate as string));
          if (passesDateFilter) {
            activities.push({
              invoiceNumber: inv.invoiceNumber,
              customerName: inv.customerName || '',
              activityType: 'Reminder Sent',
              activityDate: formatDate(inv.lastReminderSentAt),
              performedBy: 'System',
              details: `Reminder #${inv.reminderCount || 1} sent`,
              outcome: undefined,
            });
          }
        }

        // Add collections stage changes (with date filter)
        if (inv.collectionsStage && inv.collectionsStage !== 'none') {
          const stageDate = new Date(inv.collectionsStageUpdatedAt || inv.createdAt);
          const passesDateFilter = (!startDate || stageDate >= new Date(startDate as string)) &&
                                   (!endDate || stageDate <= new Date(endDate as string));
          if (passesDateFilter) {
            activities.push({
              invoiceNumber: inv.invoiceNumber,
              customerName: inv.customerName || '',
              activityType: 'Collections Stage',
              activityDate: formatDate(inv.collectionsStageUpdatedAt || inv.createdAt),
              performedBy: userMap.get(inv.collectionsAssignedTo || '') || 'System',
              details: `Stage: ${inv.collectionsStage}`,
              outcome: inv.status,
            });
          }
        }
      }

      // Sort by date descending
      activities.sort((a, b) => new Date(b.activityDate).getTime() - new Date(a.activityDate).getTime());

      // Sort by date descending
      activities.sort((a, b) => new Date(b.activityDate).getTime() - new Date(a.activityDate).getTime());

      if (format === 'pdf') {
        const pdf = generateCollectionsActivityPDF(activities, filters);
        res.setHeader('Content-Type', 'application/pdf');
        res.setHeader('Content-Disposition', `attachment; filename="collections_activity_${Date.now()}.pdf"`);
        pdf.pipe(res);
        pdf.end();
      } else {
        const csv = generateCollectionsActivityCSV(activities);
        res.setHeader('Content-Type', 'text/csv');
        res.setHeader('Content-Disposition', `attachment; filename="collections_activity_${Date.now()}.csv"`);
        res.send(csv);
      }
    } catch (error) {
      console.error("Error exporting collections activity:", error);
      res.status(500).json({ message: "Failed to export collections activity" });
    }
  });

  // Bundle Download - Compliance Package (ZIP)
  app.get("/api/corporate/invoicing/exports/compliance-bundle", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { startDate, endDate, customerId, billingEntityId, locationId } = req.query;
      const filters: ExportFilters = { startDate, endDate, customerId, billingEntityId, locationId };
      
      // Generate period label
      const periodLabel = startDate && endDate 
        ? `${startDate}_to_${endDate}`.replace(/-/g, '')
        : new Date().toISOString().slice(0, 7).replace('-', '');

      // Fetch all data
      const allInvoices = await storage.getAllInvoices();
      const allPayments = await storage.getAllPayments();
      const billingEntities = await storage.getAllBillingEntities();
      const billingLocations = await storage.getAllBillingLocations();
      const users = await storage.getUsers();

      const entityMap = new Map(billingEntities.map(e => [e.id, e.name]));
      const locationMap = new Map(billingLocations.map(l => [l.id, l.name]));
      const invoiceMap = new Map(allInvoices.map(i => [i.id, i]));
      const userMap = new Map(users.map(u => [u.id, u.email || u.username || u.id]));

      // Apply filters to invoices for INVOICE LEDGER (uses invoiceDate)
      const filteredInvoicesForLedger = allInvoices.filter(inv => {
        if (startDate && new Date(inv.invoiceDate) < new Date(startDate as string)) return false;
        if (endDate && new Date(inv.invoiceDate) > new Date(endDate as string)) return false;
        if (customerId && inv.customerId !== customerId) return false;
        if (billingEntityId && inv.billingEntityId !== billingEntityId) return false;
        if (locationId && inv.locationId !== locationId) return false;
        return true;
      });

      // Base filtered invoices (no date filter on invoiceDate) - for credits/voids and collections
      const baseFilteredInvoices = allInvoices.filter(inv => {
        if (customerId && inv.customerId !== customerId) return false;
        if (billingEntityId && inv.billingEntityId !== billingEntityId) return false;
        if (locationId && inv.locationId !== locationId) return false;
        return true;
      });

      // Apply filters to payments (including entity/location via invoice)
      const filteredPayments = allPayments.filter(pmt => {
        if (startDate && new Date(pmt.paymentDate) < new Date(startDate as string)) return false;
        if (endDate && new Date(pmt.paymentDate) > new Date(endDate as string)) return false;
        if (customerId && pmt.customerId !== customerId) return false;
        // Filter by billing entity/location via the associated invoice
        const invoice = invoiceMap.get(pmt.invoiceId || '');
        if (billingEntityId && invoice?.billingEntityId !== billingEntityId) return false;
        if (locationId && invoice?.locationId !== locationId) return false;
        return true;
      });

      // Transform invoice ledger (uses filteredInvoicesForLedger)
      const invoiceLedgerRows: InvoiceLedgerRow[] = filteredInvoicesForLedger.map(inv => {
        const aging = calculateAgingBucket(inv.dueDate);
        const totalAmount = Number(inv.totalAmount || 0);
        const amountPaid = Number(inv.amountPaid || 0);
        return {
          invoiceNumber: inv.invoiceNumber,
          invoiceDate: formatDate(inv.invoiceDate),
          dueDate: formatDate(inv.dueDate),
          customerName: inv.customerName || '',
          billingEntity: entityMap.get(inv.billingEntityId || '') || '',
          location: locationMap.get(inv.locationId || '') || '',
          status: inv.status || 'draft',
          totalAmount,
          amountPaid,
          balance: totalAmount - amountPaid,
          agingDays: aging.days,
          agingBucket: aging.bucket,
          createdBy: inv.createdBy || '',
          createdAt: formatDate(inv.createdAt),
        };
      });

      const invoiceTotals = {
        totalInvoiced: invoiceLedgerRows.reduce((sum, r) => sum + r.totalAmount, 0),
        totalPaid: invoiceLedgerRows.reduce((sum, r) => sum + r.amountPaid, 0),
        totalBalance: invoiceLedgerRows.reduce((sum, r) => sum + r.balance, 0),
      };

      // Transform payment ledger
      const paymentLedgerRows: PaymentLedgerRow[] = filteredPayments.map(pmt => {
        const invoice = invoiceMap.get(pmt.invoiceId || '');
        return {
          paymentId: pmt.id,
          paymentDate: formatDate(pmt.paymentDate),
          invoiceNumber: invoice?.invoiceNumber || pmt.invoiceId || '',
          customerName: pmt.customerName || '',
          paymentMethod: pmt.paymentMethod || '',
          referenceNumber: pmt.referenceNumber || pmt.checkNumber || pmt.stripePaymentIntentId || '',
          amount: Number(pmt.amount || 0),
          appliedAmount: Number(pmt.appliedAmount || pmt.amount || 0),
          status: pmt.status || 'completed',
          recordedBy: pmt.recordedBy || '',
          recordedAt: formatDate(pmt.createdAt),
        };
      });

      const paymentTotals = {
        totalPayments: paymentLedgerRows.reduce((sum, r) => sum + r.amount, 0),
        totalApplied: paymentLedgerRows.reduce((sum, r) => sum + r.appliedAmount, 0),
      };

      // Transform credits/voids (with date filtering based on voidedAt, not invoiceDate)
      const creditsVoidsRows: CreditVoidRow[] = baseFilteredInvoices
        .filter(inv => {
          // Must be voided or credited
          if (inv.status !== 'voided' && inv.status !== 'credited') return false;
          // Apply date filters based on voidedAt (the event date for credits/voids)
          if (startDate && inv.voidedAt && new Date(inv.voidedAt) < new Date(startDate as string)) return false;
          if (endDate && inv.voidedAt && new Date(inv.voidedAt) > new Date(endDate as string)) return false;
          return true;
        })
        .map(inv => ({
          invoiceNumber: inv.invoiceNumber,
          type: inv.status === 'voided' ? 'void' as const : 'credit' as const,
          originalAmount: Number(inv.totalAmount || 0),
          creditAmount: inv.status === 'credited' ? Number(inv.totalAmount || 0) : undefined,
          reason: inv.voidReason || inv.status || '',
          performedBy: userMap.get(inv.voidedBy || '') || inv.voidedBy || '',
          performedAt: formatDate(inv.voidedAt),
          approvedBy: undefined,
          notes: inv.internalNotes || '',
        }));
      // Transform collections activities (with date filtering)
      const collectionsActivities: CollectionsActivityRow[] = [];
      for (const inv of baseFilteredInvoices) {
        // Add reminder activities (with date filter)
        if (inv.lastReminderSentAt) {
          const reminderDate = new Date(inv.lastReminderSentAt);
          const passesDateFilter = (!startDate || reminderDate >= new Date(startDate as string)) &&
                                   (!endDate || reminderDate <= new Date(endDate as string));
          if (passesDateFilter) {
            collectionsActivities.push({
              invoiceNumber: inv.invoiceNumber,
              customerName: inv.customerName || '',
              activityType: 'Reminder Sent',
              activityDate: formatDate(inv.lastReminderSentAt),
              performedBy: 'System',
              details: `Reminder #${inv.reminderCount || 1} sent`,
              outcome: undefined,
            });
          }
        }
        // Add collections stage changes (with date filter)
        if (inv.collectionsStage && inv.collectionsStage !== 'none') {
          const stageDate = new Date(inv.collectionsStageUpdatedAt || inv.createdAt);
          const passesDateFilter = (!startDate || stageDate >= new Date(startDate as string)) &&
                                   (!endDate || stageDate <= new Date(endDate as string));
          if (passesDateFilter) {
            collectionsActivities.push({
              invoiceNumber: inv.invoiceNumber,
              customerName: inv.customerName || '',
              activityType: 'Collections Stage',
              activityDate: formatDate(inv.collectionsStageUpdatedAt || inv.createdAt),
              performedBy: userMap.get(inv.collectionsAssignedTo || '') || 'System',
              details: `Stage: ${inv.collectionsStage}`,
              outcome: inv.status,
            });
          }
        }
      }

      // Generate CSVs
      const invoiceLedgerCSV = generateInvoiceLedgerCSV(invoiceLedgerRows);
      const paymentLedgerCSV = generatePaymentLedgerCSV(paymentLedgerRows);
      const creditsVoidsCSV = generateCreditsVoidsCSV(creditsVoidsRows);
      const collectionsActivityCSV = generateCollectionsActivityCSV(collectionsActivities);

      // Generate PDFs
      const invoiceLedgerPDF = generateInvoiceLedgerPDF(invoiceLedgerRows, filters, invoiceTotals);
      const paymentLedgerPDF = generatePaymentLedgerPDF(paymentLedgerRows, filters, paymentTotals);
      const creditsVoidsPDF = generateCreditsVoidsPDF(creditsVoidsRows, filters);
      const collectionsActivityPDF = generateCollectionsActivityPDF(collectionsActivities, filters);

      // Create bundle
      const archive = await createComplianceBundle(
        invoiceLedgerCSV,
        invoiceLedgerPDF,
        paymentLedgerCSV,
        paymentLedgerPDF,
        creditsVoidsCSV,
        creditsVoidsPDF,
        collectionsActivityCSV,
        collectionsActivityPDF,
        periodLabel
      );

      res.setHeader('Content-Type', 'application/zip');
      res.setHeader('Content-Disposition', `attachment; filename="compliance_bundle_${periodLabel}.zip"`);
      
      archive.pipe(res);
      archive.finalize();
    } catch (error) {
      console.error("Error creating compliance bundle:", error);
      res.status(500).json({ message: "Failed to create compliance bundle" });
    }
  });

  // Get invoice payments
  app.get("/api/corporate/invoicing/invoices/:id/payments", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      // Get payments applied to this invoice
      const appliedPayments = await db.select({
        id: payments.id,
        paymentNumber: payments.paymentNumber,
        amount: paymentApplications.amount,
        paymentDate: payments.paymentDate,
        paymentMethod: payments.paymentMethod,
        status: payments.status,
        cardLast4: payments.cardLast4,
        cardBrand: payments.cardBrand,
        achAccountLast4: payments.achAccountLast4,
        stripePaymentIntentId: payments.stripePaymentIntentId,
        referenceNumber: payments.referenceNumber,
        isManualEntry: payments.isManualEntry,
        enteredBy: payments.enteredBy,
        enteredAt: payments.enteredAt,
        attachmentUrl: payments.attachmentUrl,
      })
      .from(paymentApplications)
      .leftJoin(payments, eq(paymentApplications.paymentId, payments.id))
      .where(eq(paymentApplications.invoiceId, req.params.id));

      // Enrich with entered-by user name for manual entries
      const enrichedPayments = await Promise.all(appliedPayments.map(async (p: any) => {
        if (p.isManualEntry && p.enteredBy) {
          const enteredByUser = await storage.getUser(p.enteredBy);
          return { ...p, enteredByName: enteredByUser ? `${enteredByUser.firstName || ''} ${enteredByUser.lastName || ''}`.trim() || enteredByUser.email : undefined };
        }
        return p;
      }));
      res.json(enrichedPayments);
    } catch (error) {
      console.error("Error getting invoice payments:", error);
      res.status(500).json({ message: "Failed to get invoice payments" });
    }
  });

  // Get invoice line items
  app.get("/api/corporate/invoicing/invoices/:id/line-items", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const items = await db.select()
        .from(invoiceLineItems)
        .where(eq(invoiceLineItems.invoiceId, req.params.id));

      res.json(items);
    } catch (error) {
      console.error("Error getting invoice line items:", error);
      res.status(500).json({ message: "Failed to get invoice line items" });
    }
  });

  
  // Void invoice
  app.post("/api/corporate/invoicing/invoices/:id/void", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const invoice = await storage.voidInvoice(
        req.params.id,
        req.user.claims.sub,
        req.body.reason
      );
      res.json(invoice);
    } catch (error) {
      console.error("Error voiding invoice:", error);
      res.status(500).json({ message: "Failed to void invoice" });
    }
  });

  // Write off invoice (bad debt)
  app.post("/api/corporate/invoicing/invoices/:id/write-off", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { amount, reason, notes } = req.body;
      if (!amount || !reason || !notes) {
        return res.status(400).json({ message: "Amount, reason, and notes are required" });
      }

      const writeOffAmount = parseFloat(amount);
      if (isNaN(writeOffAmount) || writeOffAmount <= 0) {
        return res.status(400).json({ message: "Amount must be a positive number" });
      }

      const invoice = await storage.writeOffInvoice(
        req.params.id,
        amount,
        reason,
        notes,
        req.user.claims.sub
      );

      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }

      res.json(invoice);
    } catch (error: any) {
      console.error("Error writing off invoice:", error);
      res.status(400).json({ message: error.message || "Failed to write off invoice" });
    }
  });

  // Delete invoice
  app.delete("/api/corporate/invoicing/invoices/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      await storage.deleteInvoice(req.params.id);
      res.json({ success: true });
    } catch (error) {
      console.error("Error deleting invoice:", error);
      res.status(500).json({ message: "Failed to delete invoice" });
    }
  });

  // ==========================================
  // INVOICE LINE ITEM ROUTES
  // ==========================================

  // Get line items for invoice
  app.get("/api/corporate/invoicing/invoices/:invoiceId/line-items", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const lineItems = await storage.getInvoiceLineItems(req.params.invoiceId);
      res.json(lineItems);
    } catch (error) {
      console.error("Error fetching line items:", error);
      res.status(500).json({ message: "Failed to fetch line items" });
    }
  });

  // Add line item to invoice
  app.post("/api/corporate/invoicing/invoices/:invoiceId/line-items", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      // Validate required category field
      const validCategories = ['service', 'mileage', 'fee', 'surcharge', 'late_fee', 'other'];
      const category = req.body.category || 'service';
      if (!validCategories.includes(category)) {
        return res.status(400).json({ message: `Invalid category. Must be one of: ${validCategories.join(', ')}` });
      }
      
      // Check invoice status - only draft invoices can have line items added
      const invoice = await storage.getInvoice(req.params.invoiceId);
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }
      if (invoice.status !== 'draft') {
        return res.status(400).json({ message: "Cannot add line items to non-draft invoices" });
      }
      
      const lineItem = await storage.createInvoiceLineItem({
        ...req.body,
        invoiceId: req.params.invoiceId,
      });
      
      // Update invoice total after adding line item
      const lineItems = await storage.getInvoiceLineItems(req.params.invoiceId);
      const newTotal = lineItems.reduce((sum, item) => sum + parseFloat(item.totalPrice || '0'), 0);
      await storage.updateInvoice(req.params.invoiceId, { 
        subtotalAmount: newTotal.toFixed(2),
        totalAmount: newTotal.toFixed(2),
        balanceDue: newTotal.toFixed(2)
      });
      
      res.json(lineItem);
    } catch (error) {
      console.error("Error creating line item:", error);
      res.status(500).json({ message: "Failed to create line item" });
    }
  });

  // Update line item
  app.patch("/api/corporate/invoicing/line-items/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      // Validate category if provided
      const validCategories = ['service', 'mileage', 'fee', 'surcharge', 'late_fee', 'other'];
      if (req.body.category && !validCategories.includes(req.body.category)) {
        return res.status(400).json({ message: `Invalid category. Must be one of: ${validCategories.join(', ')}` });
      }
      
      // Get line item to check invoice status
      const existingLineItem = await storage.getInvoiceLineItem(req.params.id);
      if (!existingLineItem) {
        return res.status(404).json({ message: "Line item not found" });
      }
      
      // Check invoice status - only draft invoices can be modified
      const invoice = await storage.getInvoice(existingLineItem.invoiceId);
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }
      if (invoice.status !== 'draft') {
        return res.status(400).json({ message: "Cannot modify line items on non-draft invoices" });
      }
      
      const lineItem = await storage.updateInvoiceLineItem(req.params.id, req.body);
      
      // Update invoice total after modifying line item
      const lineItems = await storage.getInvoiceLineItems(existingLineItem.invoiceId);
      const newTotal = lineItems.reduce((sum, item) => sum + parseFloat(item.totalPrice || '0'), 0);
      await storage.updateInvoice(existingLineItem.invoiceId, { 
        subtotalAmount: newTotal.toFixed(2),
        totalAmount: newTotal.toFixed(2),
        balanceDue: newTotal.toFixed(2)
      });
      
      res.json(lineItem);
    } catch (error) {
      console.error("Error updating line item:", error);
      res.status(500).json({ message: "Failed to update line item" });
    }
  });

  // Delete line item

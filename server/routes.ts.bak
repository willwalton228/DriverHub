  // EMPLOYEE ROUTES (corporate only)

  // Get all employees (corporate only)
  app.get("/api/corporate/employees", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const employees = await storage.getAllEmployees();
      // Mask SSN based on user role
      const maskedEmployees = employees.map(emp => storage.maskEmployeeSsn(emp, user?.role || ''));
      res.json(maskedEmployees);
    } catch (error) {
      console.error("Error fetching employees:", error);
      res.status(500).json({ message: "Failed to fetch employees" });
    }
  });


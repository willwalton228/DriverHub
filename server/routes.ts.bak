// Idempotency helper functions
function hashRequestBody(body) {
  return crypto.createHash('sha256').update(JSON.stringify(body || {})).digest('hex');
}

async function checkIdempotency(scope, key, requestHash, userId) {
  const existing = await storage.getIdempotencyKey(scope, key);
  
  if (existing) {
    if (existing.status === 'completed' && existing.responseBody) {
      return { isNew: false, cachedResponse: { status: existing.responseStatus || 200, body: existing.responseBody } };
    }
    if (existing.status === 'processing') {
      return { isNew: false, cachedResponse: { status: 409, body: { message: 'Request is already being processed', code: 'IDEMPOTENCY_CONFLICT' } } };
    }
  }

  try {
    await storage.createIdempotencyKey({
      scope,
      key,
      requestHash,
      status: 'processing',
      entityType: scope.split(':')[0],
      createdBy: userId || null,
      expiresAt: new Date(Date.now() + 24 * 60 * 60 * 1000),
    });
  } catch (err) {
    if (err.code === '23505') {
      const retry = await storage.getIdempotencyKey(scope, key);
      if (retry && retry.status === 'completed' && retry.responseBody) {
        return { isNew: false, cachedResponse: { status: retry.responseStatus || 200, body: retry.responseBody } };
      }
      return { isNew: false, cachedResponse: { status: 409, body: { message: 'Request is already being processed', code: 'IDEMPOTENCY_CONFLICT' } } };
    }
    throw err;
  }

  return { isNew: true };
}



// Role-based access helper functions
function hasFinanceAccess(role?: string | null): boolean {
  return role === 'super_user' || role === 'admin' || role === 'finance';

  // ===== READINESS REGRESSION EVENTS API =====

  // GET /api/recruiting/regression-events - List regression events with filters
  app.get("/api/recruiting/regression-events", async (req: any, res: Response) => {
    try {
      const userId = req.session?.userId || req.user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });

      const user = await storage.getUser(userId);
      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden" });
      }

      const { applicationId, candidateId, unresolvedOnly, limit, offset } = req.query;
      const { getRegressionEvents } = await import("./services/readinessRegressionService");
      const result = await getRegressionEvents({
        applicationId: applicationId as string,
        candidateId: candidateId as string,
        unresolvedOnly: unresolvedOnly === "true",
        limit: limit ? parseInt(limit as string) : 50,
        offset: offset ? parseInt(offset as string) : 0,
      });

      res.json(result);
    } catch (error: any) {
      console.error("[Regression] Error fetching events:", error);
      res.status(500).json({ message: "Failed to fetch regression events" });
    }
  });

  // POST /api/recruiting/regression-events/:id/resolve - Resolve a regression event
  app.post("/api/recruiting/regression-events/:id/resolve", async (req: any, res: Response) => {
    try {
      const userId = req.session?.userId || req.user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });

      const user = await storage.getUser(userId);
      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden" });
      }

      const { resolveRegressionEvent } = await import("./services/readinessRegressionService");
      const event = await resolveRegressionEvent(req.params.id, user.id, user.email || "");

      if (!event) {
        return res.status(404).json({ message: "Regression event not found or already resolved" });
      }

      res.json(event);
    } catch (error: any) {
      console.error("[Regression] Error resolving event:", error);
      res.status(500).json({ message: "Failed to resolve regression event" });
    }
  });

  // POST /api/recruiting/regression-sweep - Manually trigger regression sweep (admin only)
  app.post("/api/recruiting/regression-sweep", async (req: any, res: Response) => {
    try {
      const userId = req.session?.userId || req.user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });

      const user = await storage.getUser(userId);
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { sweepExpiredDocuments, sweepExpiredConsents, sweepStaleReadiness } = await import("./services/readinessRegressionService");
      const [docResult, consentResult, staleResult] = await Promise.all([
        sweepExpiredDocuments(),
        sweepExpiredConsents(),
        sweepStaleReadiness(),
      ]);

      res.json({
        documents: docResult,
        consents: consentResult,
        staleReadiness: staleResult,
      });
    } catch (error: any) {
      console.error("[Regression] Error running sweep:", error);
      res.status(500).json({ message: "Failed to run regression sweep" });
    }
  });

  return app;
}

function hasAdminAccess(role?: string | null): boolean {
  return role === 'super_user' || role === 'admin';

  return app;
}

// Customer notification helper - checks preferences before sending
async function sendCustomerNotificationIfEnabled(
  customerUserId: string,
  eventType: CustomerNotificationEventType,
  sendFn: () => Promise<{ success: boolean; error?: string }>
): Promise<void> {
  try {
    const isEnabled = await storage.isNotificationEnabled(customerUserId, eventType);
    if (isEnabled) {
      const result = await sendFn();
      if (!result.success) {
        console.warn(`Failed to send ${eventType} notification:`, result.error);
      }
    } else {
      console.log(`Notification ${eventType} disabled for user ${customerUserId}, skipping`);
    }
  } catch (error) {
    console.error(`Error checking/sending ${eventType} notification:`, error);
  }

  return app;
}

export async function registerRoutes(app: Express): Promise<Express> {
  // Auth middleware - wrapped in try-catch to ensure routes register even if auth fails
  try {
    await setupAuth(app);
  } catch (error) {
    console.error("WARNING: Authentication setup failed:", error);
    console.error("App will continue without authentication");
    
    // Provide stub auth routes
    app.get("/api/login", (_req, res) => {
      res.status(503).json({ 
        error: "Authentication not configured", 
        message: "Auth setup failed. Check server logs for details." 
      });
    });
    
    app.get("/api/callback", (_req, res) => {
      res.redirect("/");
    });
    
    app.get("/api/logout", (_req, res) => {
      res.redirect("/");
    });
    
    app.get('/api/auth/user', (_req, res) => {
      res.status(401).json({ message: "Unauthorized - Auth not configured" });
    });
  }

  // Health Check Endpoint - Read-only, returns backend status
  app.get("/api/health", async (req: any, res: Response) => {
    const startTime = Date.now();
    let dbStatus: 'ok' | 'fail' = 'fail';
    let authenticated = false;
    
    // Check authentication status
    try {
      authenticated = !!(req.user?.claims?.sub);
    } catch {
      authenticated = false;
    }
    
    // Check database connectivity using pool
    try {
      await pool.query('SELECT 1');
      dbStatus = 'ok';
    } catch (error) {
      console.error('[Health Check] Database connectivity failed:', error);
      dbStatus = 'fail';
    }
    
    const responseTime = Date.now() - startTime;
    
    res.json({
      app_version: process.env.npm_package_version || '1.0.0',
      authenticated,
      db_status: dbStatus,
      timestamp: new Date().toISOString(),
      response_time_ms: responseTime,
    });
  });

  // ============================================
  // PUBLIC JOB FEED API - External job board integration
  // ============================================

  // GET /api/public/job-feed - Public job board feed (Bearer token auth)
  app.get("/api/public/job-feed", PUBLIC_RATE_LIMITS.jobFeed, async (req: Request, res: Response) => {
    // Check for Bearer token authentication
    const authHeader = req.headers.authorization;
    
    if (!authHeader) {
      return res.status(401).json({ 
        error: 'API_KEY_REQUIRED', 
        message: 'Authorization header with Bearer token is required' 
      });
    }
    
    const [scheme, token] = authHeader.split(' ');
    
    if (scheme?.toLowerCase() !== 'bearer' || !token) {
      return res.status(401).json({ 
        error: 'INVALID_AUTH_FORMAT', 
        message: 'Authorization header must be: Bearer <api_key>' 
      });
    }
    
    const DRIVERHUB_API_KEY = process.env.DRIVERHUB_API_KEY;
    
    if (!DRIVERHUB_API_KEY) {
      console.error('[Job Feed] DRIVERHUB_API_KEY not configured');
      return res.status(500).json({ 
        error: 'API_KEY_NOT_CONFIGURED', 
        message: 'API key authentication not configured on server' 
      });
    }
    
    if (token !== DRIVERHUB_API_KEY) {
      return res.status(403).json({ 
        error: 'INVALID_API_KEY', 
        message: 'Invalid API key' 
      });
    }
    
    try {
      const format = req.query.format?.toString()?.toLowerCase() || 'json';
      const generated = new Date().toISOString();
      
      // Query open requisitions (status = 'open' or 'approved')
      const openRequisitions = await db.select()
        .from(jobRequisitions)
        .where(
          or(
            eq(jobRequisitions.status, 'open'),
            eq(jobRequisitions.status, 'approved')
          )
        )
        .orderBy(desc(jobRequisitions.postedAt));
      
      // Build the base URL for apply links
      const baseUrl = `${req.protocol}://${req.get('host')}`;
      
      // Transform requisitions to job feed format
      const jobs = openRequisitions.map(req => ({
        id: req.id,
        title: req.title,
        description: req.description || '',
        location: req.location || '',
        department: req.department || '',
        employmentType: req.employmentType || 'full_time',
        salaryMin: req.salaryMin?.toString() || null,
        salaryMax: req.salaryMax?.toString() || null,
        salaryType: req.salaryType || 'hourly',
        isRemote: req.isRemote ?? false,
        openings: (req.openings ?? 1) - (req.filledCount ?? 0),
        postedAt: req.postedAt?.toISOString() || req.createdAt?.toISOString() || generated,
        applyUrl: `${baseUrl}/apply/${req.id}`
      }));
      
      const feedData = {
        feed: {
          version: '1.0',
          generated,
          totalJobs: jobs.length,
          jobs
        }
      };
      
      if (format === 'xml') {
        // Build XML response manually
        const escapeXml = (str: string | null | undefined): string => {
          if (!str) return '';
          return str
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&apos;');
        };
        
        let xml = '<?xml version="1.0" encoding="UTF-8"?>\n';
        xml += '<jobFeed>\n';
        xml += `  <version>1.0</version>\n`;
        xml += `  <generated>${generated}</generated>\n`;
        xml += `  <totalJobs>${jobs.length}</totalJobs>\n`;
        xml += '  <jobs>\n';
        
        for (const job of jobs) {
          xml += '    <job>\n';
          xml += `      <id>${escapeXml(job.id)}</id>\n`;
          xml += `      <title>${escapeXml(job.title)}</title>\n`;
          xml += `      <description>${escapeXml(job.description)}</description>\n`;
          xml += `      <location>${escapeXml(job.location)}</location>\n`;
          xml += `      <department>${escapeXml(job.department)}</department>\n`;
          xml += `      <employmentType>${escapeXml(job.employmentType)}</employmentType>\n`;
          xml += `      <salaryMin>${job.salaryMin || ''}</salaryMin>\n`;
          xml += `      <salaryMax>${job.salaryMax || ''}</salaryMax>\n`;
          xml += `      <salaryType>${escapeXml(job.salaryType)}</salaryType>\n`;
          xml += `      <isRemote>${job.isRemote}</isRemote>\n`;
          xml += `      <openings>${job.openings}</openings>\n`;
          xml += `      <postedAt>${job.postedAt}</postedAt>\n`;
          xml += `      <applyUrl>${escapeXml(job.applyUrl)}</applyUrl>\n`;
          xml += '    </job>\n';
        }
        
        xml += '  </jobs>\n';
        xml += '</jobFeed>';
        
        res.set('Content-Type', 'application/xml');
        return res.send(xml);
      }
      
      // Default JSON response
      res.json(feedData);
    } catch (error) {
      console.error('[Job Feed] Error fetching job feed:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to fetch job feed' });
    }
  });

  // GET /api/public/jobs/:requisitionId - Public job details (no auth required)
  app.get("/api/public/jobs/:requisitionId", PUBLIC_RATE_LIMITS.jobDetail, async (req: Request, res: Response) => {
    try {
      const { requisitionId } = req.params;
      
      const [requisition] = await db.select()
        .from(jobRequisitions)
        .where(eq(jobRequisitions.id, requisitionId))
        .limit(1);
      
      if (!requisition) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Job requisition not found' });
      }
      
      if (requisition.status !== 'open' && requisition.status !== 'approved') {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Job requisition not available' });
      }

      // Kill switch check - disable public job viewing when intake is paused
      const { isKillSwitchActive, KILL_SWITCH_KEYS } = await import("./services/recruitingKillSwitch");
      const intakePaused = await isKillSwitchActive(KILL_SWITCH_KEYS.PUBLIC_APPLY, requisition.market);
      if (intakePaused) {
        return res.status(503).json({ 
          error: 'INTAKE_PAUSED', 
          message: 'We are not currently accepting applications. Please check back later.',
          isPaused: true,
        });
      }
      
      const response = {
        id: requisition.id,
        title: requisition.title,
        description: requisition.description || '',
        location: requisition.location || '',
        department: requisition.department || '',
        employmentType: requisition.employmentType || 'full_time',
        salaryMin: requisition.salaryMin?.toString() || null,
        salaryMax: requisition.salaryMax?.toString() || null,
        salaryType: requisition.salaryType || 'hourly',
        isRemote: requisition.isRemote ?? false,
        requirements: requisition.requirements || '',
        responsibilities: requisition.responsibilities || '',
        openings: (requisition.openings ?? 1) - (requisition.filledCount ?? 0),
        postedAt: requisition.postedAt?.toISOString() || requisition.createdAt?.toISOString() || null,
      };
      
      res.json(response);
    } catch (error) {
      console.error('[Public Jobs] Error fetching job details:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to fetch job details' });
    }
  });

  // POST /api/public/jobs/:requisitionId/apply - Public job application (no auth required)
  app.post("/api/public/jobs/:requisitionId/apply", PUBLIC_RATE_LIMITS.jobApply, async (req: Request, res: Response) => {
    try {
      const { requisitionId } = req.params;
      const { firstName, lastName, email, phone, coverLetter } = req.body;
      
      // Validate required fields
      if (!firstName || !lastName || !email) {
        return res.status(400).json({ 
          error: 'VALIDATION_ERROR', 
          message: 'firstName, lastName, and email are required' 
        });
      }
      
      // Validate email format
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        return res.status(400).json({ 
          error: 'VALIDATION_ERROR', 
          message: 'Invalid email format' 
        });
      }
      
      // Check if requisition exists and is open
      const [requisition] = await db.select()
        .from(jobRequisitions)
        .where(eq(jobRequisitions.id, requisitionId))
        .limit(1);
      
      if (!requisition) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Job requisition not found' });
      }
      
      if (requisition.status !== 'open' && requisition.status !== 'approved') {
        return res.status(400).json({ error: 'REQUISITION_CLOSED', message: 'This job is no longer accepting applications' });
      }

      // Kill switch check - block application submissions when intake is paused
      const { isKillSwitchActive, KILL_SWITCH_KEYS } = await import("./services/recruitingKillSwitch");
      const intakePaused = await isKillSwitchActive(KILL_SWITCH_KEYS.PUBLIC_APPLY, requisition.market);
      if (intakePaused) {
        return res.status(503).json({ 
          error: 'INTAKE_PAUSED', 
          message: 'Applications are temporarily paused. Please try again later.',
          isPaused: true,
        });
      }
      
      // Find or create candidate by email
      let [candidate] = await db.select()
        .from(candidates)
        .where(eq(candidates.email, email.toLowerCase().trim()))
        .limit(1);
      
      if (!candidate) {
        // Create new candidate
        [candidate] = await db.insert(candidates).values({
          firstName: firstName.trim(),
          lastName: lastName.trim(),
          email: email.toLowerCase().trim(),
          phone: phone?.trim() || null,
          source: 'job_board',
        }).returning();
      }
      
      // Create application
      const [application] = await db.insert(applications).values({
        candidateId: candidate.id,
        requisitionId: requisitionId,
        status: 'new',
        stage: 'applied',
        coverLetter: coverLetter?.trim() || null,
        appliedAt: new Date(),
      }).returning();
      
      res.status(201).json({
        success: true,
        applicationId: application.id,
        message: 'Application submitted successfully',
      });
    } catch (error) {
      console.error('[Public Jobs] Error submitting application:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to submit application' });
    }
  });

  // ============================================

  // ============================================
  // PUBLIC INVOICE PAYMENT ENDPOINTS
  // ============================================

  // GET /api/public/invoices/:token - Get invoice by payment access token (no auth required)
  app.get("/api/public/invoices/:token", PUBLIC_RATE_LIMITS.invoicePortal, TOKEN_THROTTLE, async (req: Request, res: Response) => {
    try {
      const { token } = req.params;
      
      if (!token) {
        return res.status(400).json({ error: 'MISSING_TOKEN', message: 'Payment token is required' });
      }

      // Find invoice by payment access token
      const [invoice] = await db.select()
        .from(invoices)
        .where(eq(invoices.paymentAccessToken, token))
        .limit(1);

      if (!invoice) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Invoice not found or link has expired' });
      }

      // Check if payment link has expired
      if (invoice.paymentLinkExpiresAt && new Date(invoice.paymentLinkExpiresAt) < new Date()) {
        return res.status(410).json({ 
          error: 'LINK_EXPIRED', 
          message: 'This payment link has expired. Please contact the sender for a new link.' 
        });
      }

      // Get line items
      const lineItems = await db.select()
        .from(invoiceLineItems)
        .where(eq(invoiceLineItems.invoiceId, invoice.id))
        .orderBy(asc(invoiceLineItems.lineNumber));

      // Get billing profile to check allowed payment methods
      let allowedPaymentMethods = { creditCard: true, ach: true, check: true, wire: true, enforcePrepay: false };
      if (invoice.customerId) {
        const billingProfile = await storage.getCustomerBillingProfile(invoice.customerId);
        if (billingProfile) {
          allowedPaymentMethods = {
            creditCard: billingProfile.acceptsCreditCard ?? true,
            ach: billingProfile.acceptsAch ?? true,
            check: billingProfile.acceptsCheck ?? true,
            wire: billingProfile.acceptsWire ?? true,
            enforcePrepay: billingProfile.enforcePrepay ?? false,
          };
        }
      }

      // Return public invoice data (limited fields for security)
      res.json({
        id: invoice.id,
        invoiceNumber: invoice.invoiceNumber,
        customerName: invoice.customerName,
        invoiceDate: invoice.invoiceDate,
        dueDate: invoice.dueDate,
        subtotalAmount: invoice.subtotalAmount || '0.00',
        taxAmount: invoice.taxAmount || '0.00',
        totalAmount: invoice.totalAmount,
        paidAmount: invoice.paidAmount || '0.00',
        balanceDue: invoice.balanceDue || invoice.totalAmount,
        status: invoice.status,
        customerMemo: invoice.customerMemo,
        allowedPaymentMethods,
        lineItems: lineItems.map(item => ({
          id: item.id,
          description: item.description,
          quantity: item.quantity,
          unitPrice: item.unitPrice,
          totalPrice: item.totalPrice,
          dateOfService: item.dateOfService,
        })),
      });
    } catch (error) {
      console.error('[Public Invoice] Error fetching invoice:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to load invoice' });
    }
  });


  // GET /api/public/invoices/:token/pdf - Download invoice as PDF (no auth required)
  app.get("/api/public/invoices/:token/pdf", PUBLIC_RATE_LIMITS.invoicePortal, TOKEN_THROTTLE, async (req: Request, res: Response) => {
    try {
      const { token } = req.params;
      
      if (!token) {
        return res.status(400).json({ error: 'MISSING_TOKEN', message: 'Payment token is required' });
      }

      // Find invoice by payment access token
      const [invoice] = await db.select()
        .from(invoices)
        .where(eq(invoices.paymentAccessToken, token))
        .limit(1);

      if (!invoice) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Invoice not found' });
      }
      
      // Check if payment link has expired
      if (invoice.paymentLinkExpiresAt && new Date(invoice.paymentLinkExpiresAt) < new Date()) {
        return res.status(410).json({ 
          error: 'LINK_EXPIRED', 
          message: 'This payment link has expired. Please contact the sender for a new link.' 
        });
      }

      // Get line items
      const lineItems = await db.select()
        .from(invoiceLineItems)
        .where(eq(invoiceLineItems.invoiceId, invoice.id))
        .orderBy(asc(invoiceLineItems.lineNumber));

      // Get billing entity if assigned
      let billingEntity = null;
      if (invoice.billingEntityId) {
        billingEntity = await storage.getBillingEntity(invoice.billingEntityId);
      }
      
      // Get location if assigned
      let location = null;
      if (invoice.locationId) {
        location = await storage.getBillingLocation(invoice.locationId);
      }

      // Use entity branding or fallback to default
      const companyName = billingEntity?.dbaName || billingEntity?.legalName || 'DriverHub 360';
      const primaryColor = billingEntity?.primaryColor || '#FF6B35';
      const logoUrl = billingEntity?.logoUrl || '';
      
      // Remit-to address (use remit address if set, otherwise physical address)
      const remitAddress = billingEntity ? {
        line1: billingEntity.remitAddressLine1 || billingEntity.addressLine1 || '',
        line2: billingEntity.remitAddressLine2 || billingEntity.addressLine2 || '',
        city: billingEntity.remitCity || billingEntity.city || '',
        state: billingEntity.remitState || billingEntity.state || '',
        postalCode: billingEntity.remitPostalCode || billingEntity.postalCode || '',
        country: billingEntity.remitCountry || billingEntity.country || 'US',
        phone: billingEntity.phone || '',
        email: billingEntity.email || '',
      } : null;

      // Generate simple HTML invoice for PDF with entity branding
      const html = `
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="UTF-8">
          <title>Invoice ${invoice.invoiceNumber}</title>
          <style>
            body { font-family: Arial, sans-serif; margin: 40px; color: #333; }
            .header { display: flex; justify-content: space-between; margin-bottom: 40px; }
            .company { font-size: 24px; font-weight: bold; color: ${primaryColor}; }
            .company-logo { max-height: 60px; max-width: 200px; margin-bottom: 10px; }
            .invoice-title { font-size: 28px; color: #666; }
            .invoice-details { margin-bottom: 30px; }
            .invoice-details p { margin: 5px 0; }
            .customer { margin-bottom: 30px; }
            .customer h3 { margin-bottom: 10px; color: #666; }
            .remit-to { margin-bottom: 30px; padding: 15px; background: #f9f9f9; border-radius: 4px; }
            .remit-to h3 { margin-bottom: 10px; color: #666; font-size: 14px; }
            .remit-to p { margin: 3px 0; font-size: 13px; }
            table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
            th { background: #f5f5f5; padding: 12px; text-align: left; border-bottom: 2px solid #ddd; }
            td { padding: 12px; border-bottom: 1px solid #eee; }
            .amount { text-align: right; }
            .totals { margin-left: auto; width: 300px; }
            .totals table { margin-bottom: 0; }
            .totals td { border: none; padding: 8px 12px; }
            .totals .total-row { font-size: 18px; font-weight: bold; border-top: 2px solid #333; }
            .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 12px; color: #666; }
            .location-info { font-size: 12px; color: #666; margin-top: 5px; }
          </style>
        </head>
        <body>
          <div class="header">
            <div>
              ${logoUrl ? `<img src="${logoUrl}" alt="${companyName}" class="company-logo" />` : ''}
              <div class="company">${companyName}</div>
              ${location ? `<div class="location-info">Location: ${location.locationName}</div>` : ''}
            </div>
            <div class="invoice-title">INVOICE</div>
          </div>
          
          <div class="invoice-details">
            <p><strong>Invoice #:</strong> ${invoice.invoiceNumber}</p>
            <p><strong>Date:</strong> ${new Date(invoice.invoiceDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            <p><strong>Due Date:</strong> ${new Date(invoice.dueDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            <p><strong>Terms:</strong> ${invoice.paymentTerms || 'Net 30'}</p>
          </div>
          
          <div class="customer">
            <h3>Bill To:</h3>
            <p><strong>${invoice.customerName}</strong></p>
          </div>
          
          ${remitAddress ? `
          <div class="remit-to">
            <h3>REMIT PAYMENT TO:</h3>
            <p><strong>${companyName}</strong></p>
            ${remitAddress.line1 ? `<p>${remitAddress.line1}</p>` : ''}
            ${remitAddress.line2 ? `<p>${remitAddress.line2}</p>` : ''}
            <p>${remitAddress.city}${remitAddress.city && remitAddress.state ? ', ' : ''}${remitAddress.state} ${remitAddress.postalCode}</p>
            ${remitAddress.phone ? `<p>Phone: ${remitAddress.phone}</p>` : ''}
            ${remitAddress.email ? `<p>Email: ${remitAddress.email}</p>` : ''}
          </div>
          ` : ''}
          
          <table>
            <thead>
              <tr>
                <th>Description</th>
                <th class="amount">Qty</th>
                <th class="amount">Rate</th>
                <th class="amount">Amount</th>
              </tr>
            </thead>
            <tbody>
              ${lineItems.map(item => `
                <tr>
                  <td>${item.description}${item.dateOfService ? ` (${new Date(item.dateOfService).toLocaleDateString()})` : ''}</td>
                  <td class="amount">${parseFloat(item.quantity || '1').toFixed(2)}</td>
                  <td class="amount">$${parseFloat(item.unitPrice || '0').toFixed(2)}</td>
                  <td class="amount">$${parseFloat(item.totalPrice || '0').toFixed(2)}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
          
          <div class="totals">
            <table>
              <tr>
              <tr>
                <td>Subtotal:</td>
                <td class="amount">$${parseFloat(invoice.subtotalAmount || invoice.totalAmount).toFixed(2)}</td>
              </tr>
              ${parseFloat(invoice.taxAmount || '0') > 0 ? `
              <tr>
                <td>Tax:</td>
                <td class="amount">$${parseFloat(invoice.taxAmount || '0').toFixed(2)}</td>
              </tr>
              ` : ''}
              <tr>
                <td><strong>Total:</strong></td>
                <td class="amount"><strong>$${parseFloat(invoice.totalAmount).toFixed(2)}</strong></td>
              </tr>
              ${parseFloat(invoice.paidAmount || '0') > 0 ? `
              <tr>
                <td>Paid:</td>
                <td class="amount" style="color: green;">-$${parseFloat(invoice.paidAmount || '0').toFixed(2)}</td>
              </tr>
              ` : ''}
              <tr class="total-row">
                <td>Balance Due:</td>
                <td class="amount">$${parseFloat(invoice.balanceDue || invoice.totalAmount).toFixed(2)}</td>
              </tr>
            </table>
          </div>
          
          ${invoice.customerMemo ? `
          <div style="margin-top: 30px;">
            <h3>Notes:</h3>
            <p>${invoice.customerMemo}</p>
          </div>
          ` : ''}
          
          <div class="footer">
            <p>Thank you for your business!</p>
            <p>Generated by DriverHub 360</p>
          </div>
        </body>
        </html>
      `;

      // Return HTML for now (can be converted to PDF with a library like puppeteer)
      res.setHeader('Content-Type', 'text/html');
      res.setHeader('Content-Disposition', `attachment; filename="Invoice-${invoice.invoiceNumber}.html"`);
      res.send(html);
    } catch (error) {
      console.error('[Public Invoice PDF] Error generating PDF:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to generate invoice PDF' });
    }
  });
  // POST /api/public/invoices/:token/mark-viewed - Mark invoice as viewed (no auth required)
  app.post("/api/public/invoices/:token/mark-viewed", PUBLIC_RATE_LIMITS.invoicePortal, TOKEN_THROTTLE, async (req, res) => {
    try {
      const { token } = req.params;
      
      if (!token) {
        return res.status(400).json({ error: 'MISSING_TOKEN', message: 'Payment token is required' });
      }

      // Find invoice by payment access token
      const [invoice] = await db.select()
        .from(invoices)
        .where(eq(invoices.paymentAccessToken, token))
        .limit(1);

      if (!invoice) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Invoice not found' });
      }

      // Get IP and user agent for tracking
      const ipAddress = req.ip || req.headers['x-forwarded-for']?.toString() || 'unknown';
      const userAgent = req.headers['user-agent'] || 'unknown';

      // Mark invoice as viewed
      const result = await storage.markInvoiceViewed(invoice.id, ipAddress, userAgent);

      res.json({ 
        success: true, 
        viewedAt: result?.viewedAt,
        viewCount: result?.viewCount,
        status: result?.status,
      });
    } catch (error) {
      console.error('Error marking invoice viewed:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to mark invoice as viewed' });
    }
  });

  // GET /api/public/invoices/:token/attachments - List customer-visible attachments (no auth)
  app.get("/api/public/invoices/:token/attachments", PUBLIC_RATE_LIMITS.invoicePortal, TOKEN_THROTTLE, async (req: Request, res: Response) => {
    try {
      const { token } = req.params;
      if (!token) {
        return res.status(400).json({ error: 'MISSING_TOKEN', message: 'Payment token is required' });
      }

      const [invoice] = await db.select()
        .from(invoices)
        .where(eq(invoices.paymentAccessToken, token))
        .limit(1);

      if (!invoice) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Invoice not found' });
      }

      const attachments = await storage.getCustomerVisibleAttachments(invoice.id);
      res.json(attachments.map(a => ({
        id: a.id,
        fileName: a.fileName,
        fileSize: a.fileSize,
        mimeType: a.mimeType,
        attachmentType: a.attachmentType,
        createdAt: a.createdAt,
      })));
    } catch (error) {
      console.error('Error listing public attachments:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to list attachments' });
    }
  });

  // GET /api/public/invoices/:token/attachments/:attachmentId/download - Download customer-visible attachment (no auth)
  app.get("/api/public/invoices/:token/attachments/:attachmentId/download", PUBLIC_RATE_LIMITS.invoicePortal, TOKEN_THROTTLE, async (req: Request, res: Response) => {
    try {
      const { token, attachmentId } = req.params;
      if (!token) {
        return res.status(400).json({ error: 'MISSING_TOKEN', message: 'Payment token is required' });
      }

      const [invoice] = await db.select()
        .from(invoices)
        .where(eq(invoices.paymentAccessToken, token))
        .limit(1);

      if (!invoice) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Invoice not found' });
      }

      const attachment = await storage.getInvoiceAttachment(attachmentId);
      if (!attachment || attachment.invoiceId !== invoice.id || !attachment.customerVisible) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Attachment not found' });
      }

      const client = new (await import("@replit/object-storage")).Client({
        bucketId: process.env.DEFAULT_OBJECT_STORAGE_BUCKET_ID!,
      });

      const objectName = attachment.objectPath.replace('/objects/', '');
      const result = await client.downloadAsBytes(objectName);
      
      if (!result.ok || !result.value) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'File not found in storage' });
      }

      res.set({
        'Content-Type': attachment.mimeType,
        'Content-Disposition': `attachment; filename="${attachment.fileName}"`,
        'Content-Length': String(result.value.length),
      });
      res.send(Buffer.from(result.value));
    } catch (error) {
      console.error('Error downloading public attachment:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to download attachment' });
    }
  });

  // POST /api/public/invoices/:token/payment-intent - Create payment intent for invoice
  app.post("/api/public/invoices/:token/payment-intent", PUBLIC_RATE_LIMITS.invoicePortal, TOKEN_THROTTLE, async (req: Request, res: Response) => {
    try {
      const { token } = req.params;
      
      if (!token) {
        return res.status(400).json({ error: 'MISSING_TOKEN', message: 'Payment token is required' });
      }

      // Find invoice by payment access token
      const [invoice] = await db.select()
        .from(invoices)
        .where(eq(invoices.paymentAccessToken, token))
        .limit(1);

      if (!invoice) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Invoice not found' });
      }

      // Validate invoice status
      if (invoice.status === 'paid') {
        return res.status(400).json({ error: 'ALREADY_PAID', message: 'This invoice has already been paid' });
      }
      if (invoice.status === 'cancelled' || invoice.status === 'void') {
        return res.status(400).json({ error: 'CANCELLED', message: 'This invoice has been cancelled' });
      }
      if (invoice.status === 'written_off') {
        return res.status(400).json({ error: 'WRITTEN_OFF', message: 'This invoice has been written off and is no longer accepting payments' });
      }

      // Calculate balance due
      const balanceDue = parseFloat(invoice.balanceDue || invoice.totalAmount);
      if (balanceDue <= 0) {
        return res.status(400).json({ error: 'NO_BALANCE', message: 'No balance due on this invoice' });
      }

      // Check if Stripe is configured
      if (!isStripeConfigured()) {
        return res.status(503).json({ error: 'PAYMENTS_UNAVAILABLE', message: 'Online payments are not configured' });
      }

      // Determine allowed payment method types from billing profile
      let allowedStripeTypes: string[] | undefined;
      if (invoice.customerId) {
        const billingProfile = await storage.getCustomerBillingProfile(invoice.customerId);
        if (billingProfile) {
          const types: string[] = [];
          if (billingProfile.acceptsCreditCard) types.push('card');
          if (billingProfile.acceptsAch) types.push('us_bank_account');
          if (types.length > 0) allowedStripeTypes = types;
        }
      }

      // Create payment intent
      const result = await createPaymentIntent({
        amount: balanceDue,
        currency: 'usd',
        customerId: invoice.customerId || undefined,
        invoiceId: invoice.id,
        description: `Payment for Invoice #${invoice.invoiceNumber}`,
        allowedPaymentMethodTypes: allowedStripeTypes,
        metadata: {
          invoiceNumber: invoice.invoiceNumber,
          draftSequence,
          invoiceNumberFinalized: false,
          customerName: invoice.customerName,
        },
      });

      res.json({
        clientSecret: result.clientSecret,
        paymentIntentId: result.paymentIntentId,
      });
    } catch (error) {
      console.error('[Public Invoice] Error creating payment intent:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to create payment' });
    }
  });

  // POST /api/public/invoices/:token/payment-complete - Handle payment completion
  app.post("/api/public/invoices/:token/payment-complete", PUBLIC_RATE_LIMITS.invoicePortal, TOKEN_THROTTLE, async (req: Request, res: Response) => {
    try {
      const { token } = req.params;
      const { paymentIntentId } = req.body;
      
      if (!token || !paymentIntentId) {
        return res.status(400).json({ error: 'MISSING_DATA', message: 'Token and payment intent ID are required' });
      }

      // Find invoice by payment access token
      const [invoice] = await db.select()
        .from(invoices)
        .where(eq(invoices.paymentAccessToken, token))
        .limit(1);

      if (!invoice) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'Invoice not found' });
      }

      // Verify payment intent status with Stripe
      if (!isStripeConfigured()) {
        return res.status(503).json({ error: 'PAYMENTS_UNAVAILABLE', message: 'Online payments are not configured' });
      }

      const paymentIntent = await getPaymentIntent(paymentIntentId);
      
      if (paymentIntent.status !== 'succeeded') {
        return res.status(400).json({ 
          error: 'PAYMENT_NOT_COMPLETE', 
          message: 'Payment has not been completed',
          status: paymentIntent.status,
        });
      }

      // Calculate payment amount
      const paymentAmount = paymentIntent.amount / 100; // Convert from cents
      const currentPaid = parseFloat(invoice.paidAmount || '0');
      const newPaidAmount = currentPaid + paymentAmount;
      const totalAmount = parseFloat(invoice.totalAmount);
      const newBalanceDue = Math.max(0, totalAmount - newPaidAmount);
      
      // Determine new status
      let newStatus = invoice.status;
      if (newBalanceDue <= 0) {
        newStatus = 'paid';
      } else if (newPaidAmount > 0) {
        newStatus = 'partially_paid';
      }

      // Generate payment number
      const paymentCount = await db.select({ count: sql<number>`count(*)` })
        .from(payments);
      const paymentNumber = `PAY-${String((paymentCount[0]?.count || 0) + 1).padStart(6, '0')}`;

      // Create payment record
      const [payment] = await db.insert(payments).values({
        paymentNumber,
        customerId: invoice.customerId || '',
        paymentDate: new Date().toISOString().split('T')[0],
        amount: String(paymentAmount),
        paymentMethod: paymentIntent.payment_method_types?.[0] || 'card',
        status: 'completed',
        stripePaymentIntentId: paymentIntentId,
        stripeChargeId: paymentIntent.latest_charge as string || null,
        appliedAmount: String(paymentAmount),
        unappliedAmount: '0',
        referenceNumber: invoice.invoiceNumber,
          draftSequence,
          invoiceNumberFinalized: false,
        memo: `Online payment for Invoice #${invoice.invoiceNumber}`,
      }).returning();

      // Create payment application
      await db.insert(paymentApplications).values({
        paymentId: payment.id,
        invoiceId: invoice.id,
        amount: String(paymentAmount),
        matchMethod: 'online_payment',
        matchConfidence: '100',
      });

      // Update invoice
      await db.update(invoices)
        .set({
          paidAmount: String(newPaidAmount),
          balanceDue: String(newBalanceDue),
          status: newStatus,
          updatedAt: new Date(),
        })
        .where(eq(invoices.id, invoice.id));

      // Create AR ledger entry
      await db.insert(arLedgerEntries).values({
        customerId: invoice.customerId || '',
        entryType: 'payment',
        referenceType: 'payment',
        referenceId: payment.id,
        entryDate: new Date().toISOString().split('T')[0],
        description: `Online payment for Invoice #${invoice.invoiceNumber}`,
        amount: String(-paymentAmount), // Negative for payments (decreases AR)
        invoiceId: invoice.id,
      });

      res.json({
        success: true,
        paymentId: payment.id,
        invoiceStatus: newStatus,
        balanceDue: newBalanceDue,
      });
    } catch (error) {
      console.error('[Public Invoice] Error completing payment:', error);
      res.status(500).json({ error: 'INTERNAL_ERROR', message: 'Failed to record payment' });
    }
  });

  // AUTH ENDPOINTS - User provisioning state
  // ============================================

  // GET /api/auth/me - Returns user provisioning state for routing decisions
  // Supports both OIDC (via isAuthenticated) and session-based (password) auth
  app.get("/api/auth/me", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let claims: any = null;
      
      // Check for session-based auth first (password login)
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      }
      // Check for OIDC auth
      else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        claims = req.user.claims;
      }
      
      if (!userId) {
        return res.status(401).json({ error: "UNAUTHORIZED", message: "Not authenticated" });
      }
      
      // Get or create user (only for OIDC flow)
      let user = await storage.getUser(userId);
      // Also try to find by email for OIDC users matched to existing accounts
      if (!user && claims?.email) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, claims.email));
        user = userByEmail;
      }
      if (!user && claims) {
        user = await storage.createUser({
          id: userId,
          email: claims.email || null,
          firstName: claims.first_name || claims.given_name || null,
          lastName: claims.last_name || claims.family_name || null,
          profileImageUrl: claims.profile_image || claims.picture || null,
        });
      }
      
      if (!user) {
        return res.status(404).json({ error: "USER_NOT_FOUND", message: "User not found" });
      }
      
      // Check if user is disabled
      if ((user as any).status === "DISABLED") {
        return res.status(403).json({ error: "ACCOUNT_DISABLED", message: "Your account has been disabled" });
      }
      
      // Get organization name if user has one
      let orgName: string | null = null;
      if (user.orgId) {
        const [org] = await db.select().from(organizations).where(eq(organizations.id, user.orgId)).limit(1);
        orgName = org?.name || null;
      }
      
      // MVP BYPASS: Authenticated users with a role are considered provisioned
      // Original logic: user.isProvisioned && user.orgId && user.role
      // MVP: If user exists and has a role, they're in (password auth = trusted)
      const authMethod = (req.session as any)?.authMethod;
      const isMvpBypass = authMethod === "password" && !!user.role;
      const isProvisioned = isMvpBypass || !!(user.isProvisioned && user.orgId && user.role);
      
      res.json({
        userId: user.id,
        email: user.email,
        firstName: user.firstName,
        lastName: user.lastName,
        role: user.role,
        orgId: user.orgId,
        orgName,
        isProvisioned,
        hasSelectedRole: !!user.roleSelectedAt,
        status: (user as any).status || 'ACTIVE',
      });
    } catch (error) {
      console.error("[Auth] /api/auth/me error:", error);
      res.status(500).json({ error: "INTERNAL_ERROR", message: "Failed to get user info" });
    }
  });

  // ============================================
  // ONBOARDING ENDPOINTS - Provisioning gate
  // ============================================

  // GET /api/onboarding/status - Check if user needs onboarding
  app.get("/api/onboarding/status", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);
      
      if (!user) {
        return res.status(404).json({ error: "USER_NOT_FOUND", message: "User not found" });
      }
      
      // Check if any organization exists in the system
      const orgs = await db.select().from(organizations).limit(1);
      const hasOrganization = orgs.length > 0;
      
      // User is provisioned if they have orgId and isProvisioned flag
      const isProvisioned = user.isProvisioned && user.orgId;
      
      res.json({
        user_id: userId,
        is_provisioned: !!isProvisioned,
        has_organization: hasOrganization,
        org_id: user.orgId || null,
        role: user.role,
        needs_onboarding: !isProvisioned,
      });
    } catch (error) {
      console.error("[Onboarding] Status check error:", error);
      res.status(500).json({ error: "INTERNAL_ERROR", message: "Failed to check onboarding status" });
    }
  });

  // GET /api/session/context - Get current user context for routing decisions
  app.get("/api/session/context", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);
      
      if (!user) {
        return res.status(404).json({ error: "USER_NOT_FOUND", message: "User not found" });
      }
      
      // Use centralized driver resolution
      const { getDriverContext } = await import('./utils/driverResolution');
      const driverContext = await getDriverContext(userId);
      
      const context = {
        userId: user.id,
        orgId: user.orgId || null,
        roles: user.role ? [user.role] : [],
        employeeId: user.employeeId || null,
        driverId: driverContext.driverId,
        isDriver: driverContext.isDriver,
        isProvisioned: user.isProvisioned ?? false,
      };
      
      res.json(context);
    } catch (error) {
      console.error("[Session] Context error:", error);
      res.status(500).json({ error: "INTERNAL_ERROR", message: "Failed to get session context" });
    }
  });

  // Valid roles for onboarding
  const EMPLOYEE_ROLES = ['admin', 'ops_manager', 'payroll_admin', 'dispatcher'];
  const DRIVER_ROLE = 'driver';

  // Helper: Ensure organization exists or create one
  async function ensureOrg(userId: string, orgName: string, orgSlug?: string): Promise<string> {
    const existingOrgs = await db.select().from(organizations).limit(1);
    
    if (existingOrgs.length > 0) {
      return existingOrgs[0].id;
    }
    
    const slug = orgSlug || orgName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const [newOrg] = await db.insert(organizations).values({
      name: orgName,
      slug: slug,
      isActive: true,
    }).returning();
    
    return newOrg.id;
  }

  // Helper: Ensure employee record exists or create one
  async function ensureEmployee(
    userId: string, 
    orgId: string, 
    profile: { firstName: string; lastName: string; email: string; jobTitle?: string; phone?: string; department?: string }
  ): Promise<string> {
    const existingEmployee = await db.select().from(employees).where(eq(employees.userId, userId)).limit(1);
    
    if (existingEmployee.length > 0) {
      return existingEmployee[0].id;
    }
    
    const [employee] = await db.insert(employees).values({
      userId: userId,
      firstName: profile.firstName,
      lastName: profile.lastName,
      email: profile.email,
      jobTitle: profile.jobTitle || 'Staff',
      department: profile.department || 'Operations',
      phoneNumber: profile.phone || null,
      employmentType: 'Full-Time (Exempt)',
      status: 'active',
      hireDate: new Date().toISOString().split('T')[0],
    }).returning();
    
    return employee.id;
  }

  // Helper: Ensure driver record exists or create one
  async function ensureDriver(
    userId: string,
    orgId: string,
    profile: { firstName: string; lastName: string; email: string; phone?: string }
  ): Promise<string> {
    const existingDriver = await db.select().from(drivers).where(eq(drivers.userId, userId)).limit(1);
    
    if (existingDriver.length > 0) {
      return existingDriver[0].id;
    }
    
    const driverId = `DRV-${Date.now()}-${Math.random().toString(36).substr(2, 5).toUpperCase()}`;
    const [driver] = await db.insert(drivers).values({
      id: driverId,
      userId: userId,
      firstName: profile.firstName,
      lastName: profile.lastName,
      email: profile.email,
      phone: profile.phone || null,
      status: 'active',
      tier: 'standard',
      safetyState: 'ACTIVE',
    }).returning();
    
    return driver.id;
  }

  // Helper: Assign role to user
  async function assignRole(userId: string, orgId: string, role: string): Promise<void> {
    await db.update(users)
      .set({ role, orgId, updatedAt: new Date() })
      .where(eq(users.id, userId));
  }

  // Helper: Get user context
  async function getUserContext(userId: string) {
    const user = await storage.getUser(userId);
    return {
      userId: user?.id,
      orgId: user?.orgId || null,
      roles: user?.role ? [user.role] : [],
      employeeId: user?.employeeId || null,
      driverId: user?.driverId || null,
      isProvisioned: user?.isProvisioned ?? false,
    };
  }

  // POST /api/onboarding/initialize - Complete onboarding with role-based provisioning
  const onboardingInitializeSchema = z.object({
    org_name: z.string().min(2, "Organization name must be at least 2 characters"),
    org_slug: z.string().optional(),
    selected_role: z.enum(['admin', 'ops_manager', 'payroll_admin', 'dispatcher', 'driver']),
    profile: z.object({
      first_name: z.string().min(1, "First name is required"),
      last_name: z.string().min(1, "Last name is required"),
      job_title: z.string().optional(),
      phone: z.string().optional(),
      department: z.string().optional(),
    }),
  });

  app.post("/api/onboarding/initialize", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);
      
      if (!user) {
        return res.status(404).json({ error: "USER_NOT_FOUND", message: "User not found" });
      }
      
      // Check if already provisioned
      if (user.isProvisioned && user.orgId) {
        const context = await getUserContext(userId);
        return res.status(400).json({ 
          error: "ALREADY_PROVISIONED", 
          message: "User is already provisioned",
          context
        });
      }
      
      // Validate request body with Zod
      const parseResult = onboardingInitializeSchema.safeParse(req.body);
      if (!parseResult.success) {
        return res.status(400).json({ 
          error: "VALIDATION_ERROR", 
          message: "Invalid request data",
          details: parseResult.error.flatten().fieldErrors
        });
      }
      
      const { org_name, org_slug, selected_role, profile } = parseResult.data;
      
      // Transaction-like operations
      const orgId = await ensureOrg(userId, org_name, org_slug);
      
      let employeeId: string | null = null;
      let driverId: string | null = null;
      let assignedRole: string;
      
      const profileData = {
        firstName: profile.first_name,
        lastName: profile.last_name,
        email: user.email || `${userId}@placeholder.local`,
        jobTitle: profile.job_title,
        phone: profile.phone,
        department: profile.department,
      };
      
      if (EMPLOYEE_ROLES.includes(selected_role)) {
        // Employee roles: ADMIN, OPS_MANAGER, PAYROLL_ADMIN, DISPATCHER
        employeeId = await ensureEmployee(userId, orgId, profileData);
        assignedRole = selected_role;
        
        // For MVP: ADMIN also gets payroll access by default
        // (handled via role check in payroll permissions)
      } else if (selected_role === DRIVER_ROLE) {
        // Driver role
        driverId = await ensureDriver(userId, orgId, profileData);
        assignedRole = 'driver';
      } else {
        return res.status(400).json({ 
          error: "INVALID_ROLE", 
          message: "Invalid role selected" 
        });
      }
      
      // Assign role and update user
      await assignRole(userId, orgId, assignedRole);
      
      // Update user with employee/driver link and provisioned status
      await db.update(users)
        .set({
          employeeId: employeeId,
          driverId: driverId,
          isProvisioned: true,
          firstName: profile.first_name,
          lastName: profile.last_name,
          updatedAt: new Date(),
        })
        .where(eq(users.id, userId));
      
      // Get final context and assert provisioned
      const context = await getUserContext(userId);
      
      if (!context.isProvisioned) {
        throw new Error("Provisioning assertion failed: user not marked as provisioned");
      }
      
      res.json({
        success: true,
        context,
        message: "Onboarding completed successfully"
      });
    } catch (error) {
      console.error("[Onboarding] Initialize error:", error);
      res.status(500).json({ error: "INTERNAL_ERROR", message: "Failed to complete onboarding" });
    }
  });

  // Object Storage Routes - Protected file uploading for profile photos
  app.get("/objects/:objectPath(*)", isAuthenticated, async (req, res) => {
    const userId = req.user?.claims?.sub;
    const objectStorageService = new ObjectStorageService();
    try {
      const objectFile = await objectStorageService.getObjectEntityFile(
        req.path,
      );
      const canAccess = await objectStorageService.canAccessObjectEntity({
        objectFile,
        userId: userId,
        requestedPermission: "read" as any,
      });
      if (!canAccess) {
        return res.sendStatus(401);
      }
      objectStorageService.downloadObject(objectFile, res);
    } catch (error) {
      console.error("Error checking object access:", error);
      if (error instanceof ObjectNotFoundError) {
        return res.sendStatus(404);
      }
      return res.sendStatus(500);
    }
  });

  app.post("/api/objects/upload", isAuthenticated, async (req, res) => {
    const objectStorageService = new ObjectStorageService();
    const uploadURL = await objectStorageService.getObjectEntityUploadURL();
    res.json({ uploadURL });
  });

  // Server-side file upload endpoint (bypasses signed URL issues)
  app.post("/api/objects/upload-file", isAuthenticated, express.raw({ type: ['image/*', 'application/pdf', 'application/octet-stream'], limit: '15mb' }), async (req, res) => {
    try {
      const contentType = req.headers['content-type'] || 'application/octet-stream';
      const filename = req.headers['x-filename'] as string | undefined;
      
      console.log(`[Upload] Received upload request`);
      console.log(`[Upload] contentType: ${contentType}`);
      console.log(`[Upload] filename: ${filename || 'unknown'}`);
      console.log(`[Upload] body type: ${typeof req.body}`);
      console.log(`[Upload] body is Buffer: ${Buffer.isBuffer(req.body)}`);
      console.log(`[Upload] body length: ${req.body?.length || 0}`);
      
      // Handle case where body might be an ArrayBuffer or raw object
      let fileBuffer: Buffer;
      if (Buffer.isBuffer(req.body)) {
        fileBuffer = req.body;
      } else if (req.body instanceof ArrayBuffer) {
        fileBuffer = Buffer.from(req.body);
      } else if (req.body && typeof req.body === 'object') {
        // Try to convert from raw bytes object
        fileBuffer = Buffer.from(Object.values(req.body) as number[]);
      } else {
        console.error("[Upload] No file data received in request body");
        return res.status(400).json({ error: "No file data received" });
      }
      
      if (fileBuffer.length === 0) {
        console.error("[Upload] Empty file buffer");
        return res.status(400).json({ error: "Empty file received" });
      }

      console.log(`[Upload] Processed buffer size: ${fileBuffer.length}`);

      const objectStorageService = new ObjectStorageService();
      console.log(`[Upload] Starting file upload to object storage...`);
      const result = await objectStorageService.uploadFile(fileBuffer, contentType, filename);
      console.log(`[Upload] Upload successful - objectPath: ${result.objectPath}`);
      
      res.json(result);
    } catch (error: any) {
      console.error("[Upload] Server-side upload error:", error);
      console.error("[Upload] Error details:", {
        message: error?.message,
        code: error?.code,
        stack: error?.stack?.substring(0, 500)
      });
      // Include more detailed error info for debugging
      const errorMessage = error?.message || "Unknown error";
      const errorCode = error?.code || error?.originalError?.code || "undefined";
      res.status(500).json({ 
        error: "Failed to upload file", 
        details: `${errorMessage} (code: ${errorCode})`,
        code: errorCode
      });
    }
  });

  // Helper function to sync photos across User, Driver, and Employee records
  async function syncProfilePhoto(photoUrl: string, userId: string, objectStorageService: ObjectStorageService) {
    // Get the normalized object path
    const objectPath = await objectStorageService.trySetObjectEntityAclPolicy(
      photoUrl,
      {
        owner: userId,
        visibility: "public",
      },
    );

    // Update user record
    await storage.updateUser(userId, { profileImageUrl: objectPath });

    // Check if user has a driver record and update it
    const driver = await storage.getDriverByUserId(userId);
    if (driver) {
      await storage.updateDriver(driver.id, { profilePhotoUrl: objectPath });
    }

    // Check if user has an employee record and update it
    const employee = await storage.getEmployeeByUserId(userId);
    if (employee) {
      await storage.updateEmployee(employee.id, { profilePhotoUrl: objectPath });
    }

    return objectPath;
  }

  // Driver profile photo upload - for drivers themselves
  app.put("/api/drivers/profile-photo", isAuthenticated, async (req: any, res: Response) => {
    if (!req.body.profilePhotoUrl) {
      return res.status(400).json({ error: "profilePhotoUrl is required" });
    }

    const userId = req.user.claims.sub;
    const user = await storage.getUser(userId);

    if (user?.role !== "driver") {
      return res.status(403).json({ message: "Forbidden: Driver access only" });
    }

    try {
      const objectStorageService = new ObjectStorageService();
      
      // Sync photo across all linked records
      const objectPath = await syncProfilePhoto(req.body.profilePhotoUrl, userId, objectStorageService);

      const updatedDriver = await storage.getDriverByUserId(userId);

      res.status(200).json({
        objectPath: objectPath,
        driver: updatedDriver,
      });
    } catch (error) {
      console.error("Error setting profile photo:", error);
      res.status(500).json({ error: "Internal server error" });
    }
  });

  // User profile photo upload - for any authenticated user
  app.put("/api/users/profile-photo", isAuthenticated, async (req: any, res: Response) => {
    if (!req.body.profileImageUrl) {
      return res.status(400).json({ error: "profileImageUrl is required" });
    }

    const userId = req.user.claims.sub;
    const user = await storage.getUser(userId);

    if (!user) {
      return res.status(404).json({ error: "User not found" });
    }

    try {
      const objectStorageService = new ObjectStorageService();

      // Sync photo across all linked records
      const objectPath = await syncProfilePhoto(req.body.profileImageUrl, userId, objectStorageService);

      const updatedUser = await storage.getUser(userId);

      res.status(200).json({
        objectPath: objectPath,
        user: updatedUser,
      });
    } catch (error) {
      console.error("Error setting user profile photo:", error);
      res.status(500).json({ error: "Internal server error" });
    }
  });

  // Corporate route - update driver profile photo (by driver ID)
  app.put("/api/corporate/drivers/:driverId/photo", isAuthenticated, async (req: any, res: Response) => {
    if (!req.body.profilePhotoUrl) {
      return res.status(400).json({ error: "profilePhotoUrl is required" });
    }

    const currentUserId = req.user.claims.sub;
    const currentUser = await storage.getUser(currentUserId);
    const corporateRoles = ["super_user", "admin", "regional_cl", "network_cl", "dealer_cl", "certification_liaison", "custom_user_list", "testing"];

    if (!currentUser || !corporateRoles.includes(currentUser.role)) {
      return res.status(403).json({ message: "Forbidden: Corporate access only" });
    }

    const { driverId } = req.params;
    const driver = await storage.getDriver(driverId);

    if (!driver) {
      return res.status(404).json({ error: "Driver not found" });
    }

    try {
      const objectStorageService = new ObjectStorageService();
      const objectPath = await objectStorageService.trySetObjectEntityAclPolicy(
        req.body.profilePhotoUrl,
        {
          owner: driver.userId || currentUserId,
          visibility: "public",
        },
      );

      // Update driver record
      const updatedDriver = await storage.updateDriver(driverId, { profilePhotoUrl: objectPath });

      // Sync to user record if driver has a linked user
      if (driver.userId) {
        await storage.updateUser(driver.userId, { profileImageUrl: objectPath });
      }

      res.status(200).json({
        objectPath: objectPath,
        driver: updatedDriver,
      });
    } catch (error) {
      console.error("Error setting driver profile photo:", error);
      res.status(500).json({ error: "Internal server error" });
    }
  });

  // Corporate route - update employee profile photo (by employee ID)
  app.put("/api/corporate/employees/:employeeId/photo", isAuthenticated, async (req: any, res: Response) => {
    if (!req.body.profilePhotoUrl) {
      return res.status(400).json({ error: "profilePhotoUrl is required" });
    }

    const currentUserId = req.user.claims.sub;
    const currentUser = await storage.getUser(currentUserId);
    const corporateRoles = ["super_user", "admin", "regional_cl", "network_cl", "dealer_cl", "certification_liaison", "custom_user_list", "testing"];

    if (!currentUser || !corporateRoles.includes(currentUser.role)) {
      return res.status(403).json({ message: "Forbidden: Corporate access only" });
    }

    const { employeeId } = req.params;
    const employee = await storage.getEmployee(employeeId);

    if (!employee) {
      return res.status(404).json({ error: "Employee not found" });
    }

    try {
      const objectStorageService = new ObjectStorageService();
      const objectPath = await objectStorageService.trySetObjectEntityAclPolicy(
        req.body.profilePhotoUrl,
        {
          owner: employee.userId || currentUserId,
          visibility: "public",
        },
      );

      // Update employee record
      const updatedEmployee = await storage.updateEmployee(employeeId, { profilePhotoUrl: objectPath });

      // Sync to user record if employee has a linked user
      if (employee.userId) {
        await storage.updateUser(employee.userId, { profileImageUrl: objectPath });
      }

      res.status(200).json({
        objectPath: objectPath,
        employee: updatedEmployee,
      });
    } catch (error) {
      console.error("Error setting employee profile photo:", error);
      res.status(500).json({ error: "Internal server error" });
    }
  });

  // Auth routes - returns user with full context
  app.get('/api/auth/user', isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const claims = req.user.claims;
      
      // Upsert user with auth provider data
      let user = await storage.getUser(userId);
      if (!user) {
        // Create user if doesn't exist
        user = await storage.createUser({
          id: userId,
          email: claims.email || null,
          firstName: claims.first_name || claims.given_name || null,
          lastName: claims.last_name || claims.family_name || null,
          profileImageUrl: claims.profile_image || claims.picture || null,
        });
      } else {
        // Update user info if changed
        const updates: any = {};
        if (claims.email && claims.email !== user.email) updates.email = claims.email;
        if ((claims.first_name || claims.given_name) && (claims.first_name || claims.given_name) !== user.firstName) {
          updates.firstName = claims.first_name || claims.given_name;
        }
        if ((claims.last_name || claims.family_name) && (claims.last_name || claims.family_name) !== user.lastName) {
          updates.lastName = claims.last_name || claims.family_name;
        }
        if (Object.keys(updates).length > 0) {
          user = await storage.updateUser(userId, updates);
        }
      }
      
      // Build context object
      const context = {
        userId: user?.id,
        orgId: user?.orgId || null,
        roles: user?.role ? [user.role] : [],
        employeeId: user?.employeeId || null,
        driverId: user?.driverId || null,
        isProvisioned: user?.isProvisioned ?? false,
      };
      
      // Determine redirect based on provisioning status
      const needsOnboarding = !context.isProvisioned && 
        context.roles.length > 0 && 
        !context.roles.includes('driver');
      
      const redirect = needsOnboarding ? '/onboarding' : '/dashboard';
      
      res.json({
        ...user,
        context,
        redirect,
        needsOnboarding,
      });
    } catch (error) {
      console.error("Error fetching user:", error);
      res.status(500).json({ message: "Failed to fetch user" });
    }
  });

  // User onboarding route - allows users to set their role
  // Only driver and employee roles are self-selectable
  // Other roles must be assigned via invitation by super_user or admin
  app.post('/api/admin/set-role', isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const { role, inviteCode } = req.body;
      const user = await storage.getUser(userId);

      if (!user) {
        return res.status(404).json({ message: "User not found" });
      }

      // Get user's email from Replit Auth claims
      const userEmail = req.user.claims.email;

      // Check if user has an invitation
      let invitation;
      if (inviteCode) {
        invitation = await storage.getInvitationByCode(inviteCode);
        if (!invitation) {
          return res.status(404).json({ message: "Invalid invitation code" });
        }
      } else {
        // Check if there's an invitation for this email
        invitation = await storage.getInvitationByEmail(userEmail);
      }

      // If user has an invitation, validate and use the invited role
      if (invitation) {
        // Validate invitation regardless of how it was found (code or email)
        if (invitation.usedAt) {
          return res.status(400).json({ message: "This invitation has already been used" });
        }
        if (new Date() > invitation.expiresAt) {
          return res.status(400).json({ message: "This invitation has expired" });
        }
        if (invitation.email.toLowerCase() !== userEmail?.toLowerCase()) {
          return res.status(403).json({ message: "This invitation is for a different email address" });
        }

        // All validations passed - assign the invited role
        const updatedUser = await storage.updateUserRole(userId, invitation.role);
        await storage.markInvitationAsUsed(invitation.id, userId);
        return res.json(updatedUser);
      }

      // No invitation - only allow self-selectable roles (driver, employee)
      if (role !== "driver" && role !== "employee") {
        return res.status(403).json({ 
          message: "This role requires an administrator invitation. Only Driver and Employee roles can be self-selected." 
        });
      }

      const updatedUser = await storage.updateUserRole(userId, role);

      // Auto-create driver profile when user selects driver role
      if (role === "driver") {
        const existingDriver = await storage.getDriverByUserId(userId);
        if (!existingDriver) {
          await storage.createDriver({
            userId: userId,
          });
        }
      }

      res.json(updatedUser);
    } catch (error: any) {
      console.error("Error updating role:", error);
      const statusCode = error.message.includes("already been selected") ? 400 : 500;
      res.status(statusCode).json({ message: error.message || "Failed to update role" });
    }
  });

  // MVP: Admin endpoint to link a user to a driver profile
  app.post('/api/admin/link-driver', async (req: any, res: Response) => {
    try {
      const userId = (req.session as any)?.userId;
      if (!userId) {
        return res.status(401).json({ error: "UNAUTHORIZED", message: "Not authenticated" });
      }
      
      const adminUser = await storage.getUser(userId);
      if (!adminUser || !['super_user', 'admin'].includes(adminUser.role || '')) {
        return res.status(403).json({ error: "FORBIDDEN", message: "Admin access required" });
      }
      
      const { targetUserId, driverId } = req.body;
      if (!targetUserId || !driverId) {
        return res.status(400).json({ error: "VALIDATION_ERROR", message: "targetUserId and driverId are required" });
      }
      
      // Verify driver exists
      const driver = await storage.getDriver(driverId);
      if (!driver) {
        return res.status(404).json({ error: "NOT_FOUND", message: "Driver not found" });
      }
      
      // Verify target user exists
      const targetUser = await storage.getUser(targetUserId);
      if (!targetUser) {
        return res.status(404).json({ error: "NOT_FOUND", message: "User not found" });
      }
      
      // Update driver's userId
      await db.update(drivers).set({ userId: targetUserId, updatedAt: new Date() }).where(eq(drivers.id, driverId));
      
      // Update user's driverId and role
      await db.update(users).set({ 
        driverId: driverId, 
        role: 'driver',
        isProvisioned: true,
        updatedAt: new Date() 
      }).where(eq(users.id, targetUserId));
      
      console.log(`[Admin] Linked user ${targetUserId} to driver ${driverId}`);
      res.json({ success: true, message: `User ${targetUser.email} linked to driver ${driverId}` });
    } catch (error: any) {
      console.error("[Admin] Link driver error:", error);
      res.status(500).json({ error: "INTERNAL_ERROR", message: error.message || "Failed to link driver" });
    }
  });


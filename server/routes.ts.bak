      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      if (!user || !['admin', 'recruiter', 'corporate'].includes(user.role || '')) {
        return res.status(403).json({ message: "Only recruiters and admins can delete availability" });
      }

      await db.delete(recruitingAvailability)
        .where(eq(recruitingAvailability.candidateId, req.params.id));

      res.json({ success: true });
    } catch (error) {
      console.error("[Recruiting] Error deleting availability:", error);
      res.status(500).json({ message: "Failed to delete availability" });
    }
  });


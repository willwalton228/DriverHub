  app.put('/api/corporate/scheduling/integrity/config', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Admin access required' });
      }

      const { enabled, scanHourUtc, lookbackDays, checksEnabled } = req.body;
      const updateData: any = { updatedBy: resolvedId, updatedAt: new Date() };
      if (typeof enabled === 'boolean') updateData.enabled = enabled;
      if (typeof scanHourUtc === 'number' && scanHourUtc >= 0 && scanHourUtc <= 23) updateData.scanHourUtc = scanHourUtc;
      if (typeof lookbackDays === 'number' && lookbackDays >= 1 && lookbackDays <= 90) updateData.lookbackDays = lookbackDays;
      if (checksEnabled && typeof checksEnabled === 'object') updateData.checksEnabled = checksEnabled;

      let [config] = await db.select().from(schedulingIntegrityConfig).limit(1);
      if (!config) {
        [config] = await db.insert(schedulingIntegrityConfig).values({
          ...updateData,
          enabled: updateData.enabled ?? true,
          scanHourUtc: updateData.scanHourUtc ?? 6,
          lookbackDays: updateData.lookbackDays ?? 7,
        }).returning();
      } else {
        [config] = await db.update(schedulingIntegrityConfig)
          .set(updateData)
          .where(eq(schedulingIntegrityConfig.id, config.id))
          .returning();
      }

      res.json({ config });
    } catch (error) {
      console.error('Error updating integrity config:', error);
      res.status(500).json({ message: 'Failed to update config' });
    }
  });

  // ============================================
  // MISSED SHIFT & NO-SHOW DETECTION
  // ============================================

  // Route 1: POST /api/corporate/scheduling/noshow/detect - Detection scan engine
  app.post('/api/corporate/scheduling/noshow/detect', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can run no-show detection' });
      }

      let [config] = await db.select().from(schedulingNoshowConfig).limit(1);
      if (!config) {
        [config] = await db.insert(schedulingNoshowConfig).values({
          enabled: true,
          lateGracePeriodMinutes: 15,
          noshowGracePeriodMinutes: 30,
          managementEscalationMinutes: 60,
          updatedBy: resolvedId,
        }).returning();
      }

      if (!config.enabled) {
        return res.json({ detected: 0, escalated: 0, incidents: [], message: 'No-show detection is disabled' });
      }

      const lateGrace = config.lateGracePeriodMinutes;
      const noshowGrace = config.noshowGracePeriodMinutes;
      const escalationMinutes = config.managementEscalationMinutes;

      const results = await db.execute(sql`
        SELECT 
          sa.id as assignment_id,
          sa.shift_id,
          sa.user_id,
          s.start_time as scheduled_start,
          s.location_id,
          (SELECT MIN(tce.event_time) FROM time_clock_events tce 
           WHERE tce.shift_assignment_id = sa.id AND tce.event_type = 'clock_in') as clock_in_time
        FROM shift_assignments sa
        JOIN shifts s ON sa.shift_id = s.id
        WHERE s.status IN ('published', 'completed')
          AND s.start_time >= NOW() - INTERVAL '24 hours'
          AND s.start_time <= NOW()
          AND sa.status IN ('assigned', 'confirmed')
          AND NOT EXISTS (
            SELECT 1 FROM scheduling_noshow_incidents sni
            WHERE sni.shift_assignment_id = sa.id
            AND sni.status IN ('open', 'acknowledged')
          )
      `);

      const rows = results.rows || [];
      const incidentValues: any[] = [];
      const now = new Date();

      for (const row of rows) {
        const scheduledStart = new Date(row.scheduled_start as string);
        const clockInTime = row.clock_in_time ? new Date(row.clock_in_time as string) : null;

        if (!clockInTime) {
          const noshowThreshold = new Date(scheduledStart.getTime() + noshowGrace * 60000);
          if (now > noshowThreshold) {
            incidentValues.push({
              shiftId: row.shift_id as string,
              shiftAssignmentId: row.assignment_id as string,
              userId: row.user_id as string,
              incidentType: 'no_show',
              scheduledStart: scheduledStart,
              gracePeriodUsed: noshowGrace,
              escalationLevel: 'dispatch',
              status: 'open',
              locationId: (row.location_id as string) || null,
            });
          }
        } else {
          const lateThreshold = new Date(scheduledStart.getTime() + lateGrace * 60000);
          if (clockInTime > lateThreshold) {
            const lateMinutes = Math.round((clockInTime.getTime() - scheduledStart.getTime()) / 60000);
            incidentValues.push({
              shiftId: row.shift_id as string,
              shiftAssignmentId: row.assignment_id as string,
              userId: row.user_id as string,
              incidentType: 'late_clock_in',
              scheduledStart: scheduledStart,
              clockInTime: clockInTime,
              lateMinutes: lateMinutes,
              gracePeriodUsed: lateGrace,
              escalationLevel: 'dispatch',
              status: 'open',
              locationId: (row.location_id as string) || null,
            });
          }
        }
      }

      let newIncidents: any[] = [];
      if (incidentValues.length > 0) {
        newIncidents = await db.insert(schedulingNoshowIncidents).values(incidentValues).returning();
      }

      const escalationResult = await db.execute(sql`
        UPDATE scheduling_noshow_incidents
        SET escalation_level = 'management',
            escalated_to_management_at = NOW()
        WHERE status = 'open'
          AND escalation_level = 'dispatch'
          AND detected_at + (${escalationMinutes} * INTERVAL '1 minute') < NOW()
        RETURNING id
      `);
      const escalatedCount = escalationResult.rows?.length || 0;

      res.json({ detected: newIncidents.length, escalated: escalatedCount, incidents: newIncidents });
    } catch (error) {
      console.error('Error running no-show detection:', error);
      res.status(500).json({ message: 'Failed to run no-show detection' });
    }
  });

  // Route 2: GET /api/corporate/scheduling/noshow/incidents - List/filter incidents
  app.get('/api/corporate/scheduling/noshow/incidents', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can view no-show incidents' });
      }

      const { incidentType, escalationLevel, status, limit: limitParam } = req.query;
      const queryLimit = Math.min(Math.max(parseInt(limitParam as string) || 100, 1), 500);

      const conditions: any[] = [];
      if (incidentType) conditions.push(eq(schedulingNoshowIncidents.incidentType, incidentType as string));
      if (escalationLevel) conditions.push(eq(schedulingNoshowIncidents.escalationLevel, escalationLevel as string));
      if (status) conditions.push(eq(schedulingNoshowIncidents.status, status as string));

      const whereClause = conditions.length > 0 ? and(...conditions) : undefined;

      const [incidents, countResult] = await Promise.all([
        db.select().from(schedulingNoshowIncidents)
          .where(whereClause)
          .orderBy(desc(schedulingNoshowIncidents.detectedAt))
          .limit(queryLimit),
        db.select({ count: sql<number>`count(*)::int` }).from(schedulingNoshowIncidents)
          .where(whereClause),
      ]);

      res.json({ incidents, total: countResult[0]?.count || 0 });
    } catch (error) {
      console.error('Error fetching no-show incidents:', error);
      res.status(500).json({ message: 'Failed to fetch no-show incidents' });
    }
  });

  // Route 3: PATCH /api/corporate/scheduling/noshow/incidents/:id - Update incident status
  app.patch('/api/corporate/scheduling/noshow/incidents/:id', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can update no-show incidents' });
      }

      const { id } = req.params;
      const { status, resolutionReason } = req.body;

      if (!status || !['acknowledged', 'resolved'].includes(status)) {
        return res.status(400).json({ message: 'Status must be acknowledged or resolved' });
      }

      if (status === 'resolved' && (!resolutionReason || !resolutionReason.trim())) {
        return res.status(400).json({ message: 'Resolution reason is required' });
      }

      const [existing] = await db.select().from(schedulingNoshowIncidents)
        .where(eq(schedulingNoshowIncidents.id, id)).limit(1);
      if (!existing) {
        return res.status(404).json({ message: 'Incident not found' });
      }

      const updateData: any = { status };
      if (status === 'acknowledged') {
        updateData.acknowledgedBy = resolvedId;
        updateData.acknowledgedAt = new Date();
      } else if (status === 'resolved') {
        updateData.resolvedBy = resolvedId;
        updateData.resolvedAt = new Date();
        updateData.resolutionReason = resolutionReason;
      }

      const [incident] = await db.update(schedulingNoshowIncidents)
        .set(updateData)
        .where(eq(schedulingNoshowIncidents.id, id))
        .returning();

      res.json({ incident });
    } catch (error) {
      console.error('Error updating no-show incident:', error);
      res.status(500).json({ message: 'Failed to update incident' });
    }
  });

  // Route 4: GET /api/corporate/scheduling/noshow/summary - Summary stats
  app.get('/api/corporate/scheduling/noshow/summary', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can view no-show summary' });
      }

      const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);

      const [summaryResult] = await db.select({
        totalOpen: sql<number>`count(*) FILTER (WHERE ${schedulingNoshowIncidents.status} = 'open')::int`,
        totalNoShow: sql<number>`count(*) FILTER (WHERE ${schedulingNoshowIncidents.incidentType} = 'no_show' AND ${schedulingNoshowIncidents.status} IN ('open', 'acknowledged'))::int`,
        totalLate: sql<number>`count(*) FILTER (WHERE ${schedulingNoshowIncidents.incidentType} = 'late_clock_in' AND ${schedulingNoshowIncidents.status} IN ('open', 'acknowledged'))::int`,
        totalEscalatedToManagement: sql<number>`count(*) FILTER (WHERE ${schedulingNoshowIncidents.escalationLevel} = 'management' AND ${schedulingNoshowIncidents.status} IN ('open', 'acknowledged'))::int`,
        totalResolved: sql<number>`count(*) FILTER (WHERE ${schedulingNoshowIncidents.status} = 'resolved' AND ${schedulingNoshowIncidents.resolvedAt} >= ${sevenDaysAgo})::int`,
      }).from(schedulingNoshowIncidents);

      res.json({
        totalOpen: summaryResult?.totalOpen || 0,
        totalNoShow: summaryResult?.totalNoShow || 0,
        totalLate: summaryResult?.totalLate || 0,
        totalEscalatedToManagement: summaryResult?.totalEscalatedToManagement || 0,
        totalResolved: summaryResult?.totalResolved || 0,
      });
    } catch (error) {
      console.error('Error fetching no-show summary:', error);
      res.status(500).json({ message: 'Failed to fetch summary' });
    }
  });


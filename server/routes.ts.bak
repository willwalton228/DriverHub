  // POST /api/recruiting/tasks - Create a manual task
  app.post("/api/recruiting/tasks", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });

      const { entityType, entityId, ownerId, title, description, dueDate, priority } = req.body;
      if (!entityType || !entityId || !title) {
        return res.status(400).json({ message: "entityType, entityId, and title are required" });
      }

      const { createManualTask } = await import("./services/recruitingTaskService");
      const task = await createManualTask(
        {
          entityType,
          entityId,
          ownerId: ownerId || userId,
          title,
          description,
          dueDate: dueDate ? new Date(dueDate) : undefined,
          priority,
        },
        userId,
      );
      res.status(201).json(task);
    } catch (error: any) {
      console.error("[Recruiting Tasks] Error creating task:", error);
      res.status(500).json({ message: "Failed to create task" });
    }
  });


      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const schedPerm = await resolveSchedulingPermission(user!.id, user?.role);
      if (!hasSchedulingPermission(schedPerm, 'publish')) return res.status(403).json({ message: 'Insufficient scheduling permission: publish required' });
      const { shiftIds } = req.body;
      if (!shiftIds || !Array.isArray(shiftIds)) {
        return res.status(400).json({ message: "shiftIds array is required" });
      }
      await storage.publishShifts(shiftIds, req.user.claims.sub);
      await logSchedulingAudit({ actorUserId: user!.id, actionType: 'shift_published', entityType: 'shift', entityId: shiftIds.join(','), newData: { shiftIds }, ipAddress: req.ip, userAgent: req.get('user-agent') });
      res.json({ success: true, published: shiftIds.length });
    } catch (error) {
      console.error("Error publishing shifts:", error);
      res.status(500).json({ message: "Failed to publish shifts" });
    }
  });


  // Manually trigger playbook evaluation for an account (admin only)
  app.post("/api/accounts/:id/evaluate-playbooks", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser || currentUser.role !== 'admin') {
        return res.status(403).json({ message: "Admin access required" });
      }

      const accountId = req.params.id;
      const triggeredPlaybooks = await storage.evaluatePlaybookTriggers(accountId);
      
      const results = [];
      for (const { playbook, incidentKey } of triggeredPlaybooks) {
        const execution = await storage.executePlaybookActions(playbook, accountId, incidentKey, currentUserId);
        results.push({
          playbookName: playbook.name,
          incidentKey,
          status: execution.status,
        });
      }

      res.json({
        accountId,
        playbooksTriggered: results.length,
        results,
      });
    } catch (error) {
      console.error("Error evaluating playbooks:", error);
      res.status(500).json({ message: "Failed to evaluate playbooks" });
    }
  });


      res.status(500).json({ message: "Failed to generate explanation packet" });
    }
  });

  // Get multiplier tier reference (public reference for drivers)
  app.get("/api/pay/multiplier-tiers", isAuthenticated, async (_req: any, res: Response) => {
    try {
      const { VOLUME_MULTIPLIER_TIERS, SAFETY_MULTIPLIER_TIERS } = await import("./services/transparencyEngine");
      

  // GET /api/screening/:token - Public route to get screening form for candidate (NO AUTH)
  app.get("/api/screening/:token", async (req: Request, res: Response) => {
    try {
      const { getScreeningTokenByToken, getScreeningFormTemplate } = await import("./recruitingService");
      const tokenRecord = await getScreeningTokenByToken(req.params.token);
      
      if (!tokenRecord) {
        return res.status(404).json({ message: "Invalid or expired screening link" });
      }

      if (tokenRecord.status !== 'pending') {
        return res.status(400).json({ message: "This screening form has already been completed" });
      }

      if (tokenRecord.expiresAt && new Date(tokenRecord.expiresAt) < new Date()) {
        return res.status(400).json({ message: "This screening link has expired" });
      }

      const template = await getScreeningFormTemplate(tokenRecord.formTemplateId);
      if (!template) {
        return res.status(404).json({ message: "Screening form not found" });
      }

      res.json({
        formTemplate: template,
        applicationId: tokenRecord.applicationId,
        expiresAt: tokenRecord.expiresAt,
      });
    } catch (error) {
      console.error("[Recruiting] Error getting screening form:", error);
      res.status(500).json({ message: "Failed to get screening form" });
    }
  });

  // POST /api/screening/:token/submit - Public route to submit screening form (NO AUTH)
  app.post("/api/screening/:token/submit", async (req: Request, res: Response) => {
    try {
      const { submitScreeningForm } = await import("./recruitingService");
      const { responses } = req.body;
      
      if (!responses || typeof responses !== 'object') {
        return res.status(400).json({ message: "Responses are required" });
      }

      const result = await submitScreeningForm(req.params.token, responses);
      res.json(result);
    } catch (error: any) {
      console.error("[Recruiting] Error submitting screening form:", error);
      res.status(500).json({ message: error.message || "Failed to submit screening form" });
    }
  });

  // ============================================================================
  // REFERRAL PORTAL API
  // ============================================================================

  // POST /api/recruiting/referrals - Submit a new referral
  app.post("/api/recruiting/referrals", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      const { createReferral } = await import("./recruitingService");
      
      const { referral, isDuplicate } = await createReferral({
        referrerId: userId,
        referredFirstName: req.body.referredFirstName,
        referredLastName: req.body.referredLastName,
        referredEmail: req.body.referredEmail,
        referredPhone: req.body.referredPhone,
        requisitionId: req.body.requisitionId,
        market: req.body.market,
        roleType: req.body.roleType,
        notes: req.body.notes,
        relationship: req.body.relationship,
      }, userId, user?.email || null);

      if (isDuplicate) {
        return res.status(409).json({
          message: "A referral for this candidate already exists in the current period",
          referral,
          isDuplicate: true,
        });
      }

      res.status(201).json({ referral, isDuplicate: false });
    } catch (error) {
      console.error("[Recruiting] Error creating referral:", error);
      res.status(500).json({ message: "Failed to create referral" });
    }
  });

  // GET /api/recruiting/referrals - Get referrals (my referrals or all for admin)
  app.get("/api/recruiting/referrals", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      const { getReferralsByReferrer, getAllReferrals } = await import("./recruitingService");
      
      const { status, market, all, limit, offset, includeArchived } = req.query;
      
      if (all === 'true' && user?.role === 'admin') {
        const result = await getAllReferrals({
          status: status as any,
          market: market as string,
          limit: limit ? parseInt(limit as string) : undefined,
          offset: offset ? parseInt(offset as string) : undefined,
        includeArchived: includeArchived === 'true',
        });
        res.json(result);
      } else {
        const result = await getReferralsByReferrer(userId, {
          limit: limit ? parseInt(limit as string) : undefined,
          offset: offset ? parseInt(offset as string) : undefined,
        includeArchived: includeArchived === 'true',
        });
        res.json(result);
      }
    } catch (error) {
      console.error("[Recruiting] Error fetching referrals:", error);
      res.status(500).json({ message: "Failed to fetch referrals" });
    }
  });

  // GET /api/recruiting/referrals/:id - Get single referral with history
  app.get("/api/recruiting/referrals/:id", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { getReferral, getReferralStatusHistory } = await import("./recruitingService");
      
      const referral = await getReferral(req.params.id);
      if (!referral) {
        return res.status(404).json({ message: "Referral not found" });
      }

      const history = await getReferralStatusHistory(req.params.id);
      
      res.json({ referral, history });
    } catch (error) {
      console.error("[Recruiting] Error fetching referral:", error);
      res.status(500).json({ message: "Failed to fetch referral" });
    }
  });

  // PATCH /api/recruiting/referrals/:id/status - Update referral status (admin)
  app.patch("/api/recruiting/referrals/:id/status", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      if (user?.role !== 'admin' && user?.role !== 'recruiting_admin') {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { updateReferralStatus } = await import("./recruitingService");
      
      const { status, reason, notes } = req.body;
      if (!status) {
        return res.status(400).json({ message: "Status is required" });
      }

      const updated = await updateReferralStatus(
        req.params.id,
        status,
        userId,
        user?.email || null,
        reason,
        notes
      );

      if (!updated) {
        return res.status(404).json({ message: "Referral not found" });
      }

      res.json(updated);
    } catch (error) {
      console.error("[Recruiting] Error updating referral status:", error);
      res.status(500).json({ message: "Failed to update referral status" });
    }
  });

  // POST /api/recruiting/referrals/:id/link-candidate - Link referral to candidate
  app.post("/api/recruiting/referrals/:id/link-candidate", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      const { linkReferralToCandidate } = await import("./recruitingService");
      
      const { candidateId } = req.body;
      if (!candidateId) {
        return res.status(400).json({ message: "candidateId is required" });
      }

      const updated = await linkReferralToCandidate(
        req.params.id,
        candidateId,
        userId,
        user?.email || null
      );

      if (!updated) {
        return res.status(404).json({ message: "Referral not found" });
      }

      res.json(updated);
    } catch (error) {
      console.error("[Recruiting] Error linking referral to candidate:", error);
      res.status(500).json({ message: "Failed to link referral to candidate" });
    }

  // GET /api/moves/:moveId/audit-reference - Get execution audit references for claims/disputes/traceability
  // DriverHub points to the truth — it does not duplicate raw audit logs
  app.get("/api/moves/:moveId/audit-reference", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { moveId } = req.params;
      
      const move = await storage.getTrip(moveId);
      if (!move) {
        return res.status(404).json({ message: "Move not found" });
      }

      // Return only the audit reference fields - no raw audit data
      res.json({
        moveId: move.id,
        moveNumber: move.moveNumber,
        executionAuditId: move.executionAuditId || null,
        slaBreachIndicator: move.slaBreachIndicator ?? null,
        blockerSummary: move.blockerSummary || null,
        executionAuditReceivedAt: move.executionAuditReceivedAt || null,
        hasAuditReference: !!move.executionAuditId,
      });
    } catch (error) {
      console.error("[Audit Reference] Error fetching audit reference:", error);
      res.status(500).json({ message: "Failed to fetch audit reference for move" });
    }
  });


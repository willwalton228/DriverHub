  // Get driver pay breakdown for a specific pay period (read-only)
  app.get("/api/drivers/:driverId/pay/breakdown/:payPeriodId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;
      const { driverId, payPeriodId } = req.params;
      
      // Import transparency engine
      const { 
        buildDriverPayBreakdown, 
        buildPayMetricInputs, 
        buildPolicyProvenance,
        checkReadOnlyAccess 
      } = await import("./services/transparencyEngine");
      
      // Get current user and verify access
      const user = await storage.getUser(userId);
      const driver = await storage.getDriver(driverId);
      
      if (!driver) {
        return res.status(404).json({ message: "Driver not found" });
      }
      
      // Drivers can only view their own pay; corporate users can view all
      const isOwnDriver = driver.userId === userId;
      const isCorporate = hasCorporateAccess(user?.role);
      
      if (!isOwnDriver && !isCorporate) {
        return res.status(403).json({ message: "Forbidden: Cannot access other driver's pay data" });
      }
      
      // TODO: Replace with storage.getPayPeriod(payPeriodId) when pay_periods table exists
      const payPeriod = {
        id: payPeriodId,
        payGroup: 'weekly',
        periodStart: '2026-01-20',
        periodEnd: '2026-01-26',
        status: 'LOCKED' as const,
        lockedAt: new Date(),
      };
      
      // Check read-only access status (enforces LOCKED immutability)
      const accessResult = checkReadOnlyAccess(payPeriod);
      
      // TODO: Replace with actual driver metrics from trips/safety tables
      // const trips = await storage.getTripsForPeriod(driverId, periodStart, periodEnd);
      // const weeklyVolume = trips.length;
      // const safetyScore = await storage.getDriverSafetyScore30Day(driverId);
      const metricInputs = buildPayMetricInputs(15, 85);
      
      // TODO: Replace with actual policy resolution from compensationEngine
      // const policyResult = resolvePolicy({marketId, workType, executionMode, policies});
      const policyProvenance = buildPolicyProvenance(
        'pv-default',
        'Standard Driver Compensation Policy',
        'exact',
        '2026-01-01',
        null,
        null, null, null,
        null, null, null
      );
      
      // TODO: Replace with storage.getPayLinesForDriverPeriod(driverId, payPeriodId)
      const payLines = [{
        id: `pl-${driverId}-${payPeriodId}`,
        payPeriodId,
        driverId,
        workerType: 'W2_DRIVER' as const,
        paidMinutes: 480,
        baseRateCents: 2500,
        basePayCents: 20000,
        volumeMultiplier: metricInputs.volumeMultiplier,
        safetyMultiplier: metricInputs.safetyMultiplier,
        effectiveMultiplier: metricInputs.clampedCombinedMultiplier,
        adjustedPayCents: 20000,
        finalPayCents: 20000,
        floorApplied: false,
        capApplied: false,
      }];
      
      // Build the complete breakdown using transparency engine
      const breakdown = buildDriverPayBreakdown(
        driverId,
        `${driver.firstName} ${driver.lastName}`,
        'W2_DRIVER',
        payPeriod,
        payLines,
        metricInputs,
        policyProvenance
      );
      
      res.json({
        breakdown,
        accessStatus: accessResult,
        _note: 'Pay period data is placeholder pending pay_periods/pay_lines tables',
      });
    } catch (error) {
      console.error("Error getting driver pay breakdown:", error);
      res.status(500).json({ message: "Failed to get pay breakdown" });
    }
  });

  // Get pay explanation packet in specified format (json, markdown, html)
  // Supports ?format=json|markdown|html query parameter
  app.get("/api/drivers/:driverId/pay/explanation/:payPeriodId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;
      const { driverId, payPeriodId } = req.params;
      const format = (req.query.format as 'json' | 'markdown' | 'html') || 'json';
      
      // Import transparency engine
      const { 
        buildDriverPayBreakdown, 
        buildPayMetricInputs, 
        buildPolicyProvenance,
        generatePayExplanationPacket 
      } = await import("./services/transparencyEngine");
      
      // Get current user and verify access
      const user = await storage.getUser(userId);
      const driver = await storage.getDriver(driverId);
      
      if (!driver) {
        return res.status(404).json({ message: "Driver not found" });
      }
      
      // Drivers can only view their own pay; corporate users can view all
      const isOwnDriver = driver.userId === userId;
      const isCorporate = hasCorporateAccess(user?.role);
      
      if (!isOwnDriver && !isCorporate) {
        return res.status(403).json({ message: "Forbidden: Cannot access other driver's pay data" });
      }
      
      // TODO: Replace with storage.getPayPeriod(payPeriodId) when pay_periods table exists
      const payPeriod = {
        id: payPeriodId,
        payGroup: 'weekly',
        periodStart: '2026-01-20',
        periodEnd: '2026-01-26',
        status: 'LOCKED' as const,
        lockedAt: new Date(),
      };
      
      // TODO: Replace with actual metrics when trips/safety tables wired
      const metricInputs = buildPayMetricInputs(15, 85);
      
      // TODO: Replace with actual policy resolution
      const policyProvenance = buildPolicyProvenance(
        'pv-default',
        'Standard Driver Compensation Policy',
        'exact',
        '2026-01-01',
        null,
        null, null, null,
        null, null, null
      );
      
      // TODO: Replace with storage.getPayLinesForDriverPeriod(driverId, payPeriodId)
      const payLines = [{
        id: `pl-${driverId}-${payPeriodId}`,
        payPeriodId,
        driverId,
        workerType: 'W2_DRIVER' as const,
        paidMinutes: 480,
        baseRateCents: 2500,
        basePayCents: 20000,
        volumeMultiplier: metricInputs.volumeMultiplier,
        safetyMultiplier: metricInputs.safetyMultiplier,
        effectiveMultiplier: metricInputs.clampedCombinedMultiplier,
        adjustedPayCents: 20000,
        finalPayCents: 20000,
        floorApplied: false,
        capApplied: false,
      }];
      
      // Build breakdown using transparency engine
      const breakdown = buildDriverPayBreakdown(
        driverId,
        `${driver.firstName} ${driver.lastName}`,
        'W2_DRIVER',
        payPeriod,
        payLines,
        metricInputs,
        policyProvenance
      );
      
      // Generate explanation packet in requested format
      const packet = generatePayExplanationPacket(breakdown, format);
      
      // Set content type based on format
      if (format === 'html') {
        res.setHeader('Content-Type', 'text/html');
        res.send(packet.content);
      } else if (format === 'markdown') {
        res.setHeader('Content-Type', 'text/markdown');
        res.send(packet.content);
      } else {
        res.json(packet);
      }
    } catch (error) {

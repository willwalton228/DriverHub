  // POST /api/recruiting/decommission/workflow/:id/retire
  app.post("/api/recruiting/decommission/workflow/:id/retire", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });
      const user = await storage.getUser(userId);
      if (!user || (user.role !== "admin" && user.role !== "super_user")) {
        return res.status(403).json({ message: "Admin access required" });
      }
      const { reason } = req.body;
      if (!reason || typeof reason !== "string" || reason.trim().length === 0) {
        return res.status(400).json({ message: "A reason is required for retirement" });
      }
      const { retireWorkflow } = await import("./recruitingService");
      const result = await retireWorkflow(req.params.id, userId, user.email || "", reason.trim());
      if (!result.success) return res.status(409).json({ message: result.error });
      res.json({ success: true });
    } catch (error: any) {
      console.error("[Decommission] Error retiring workflow:", error);
      res.status(500).json({ message: "Failed to retire workflow" });

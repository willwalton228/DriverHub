  app.post("/api/recruiting/archives/run", async (req: Request, res: Response) => {
    try {
      const user = await storage.getUser((req as any).userId);
      if (!user || (user.role !== "admin" && user.role !== "super_user")) {
        return res.status(403).json({ message: "Admin access required" });
      }
      const userId = (req as any).userId;
      const { thresholdDays, dryRun } = req.body || {};
      const parsedThreshold = thresholdDays ? parseInt(String(thresholdDays), 10) : 90;
      if (isNaN(parsedThreshold) || parsedThreshold < 1 || parsedThreshold > 3650) {
        return res.status(400).json({ message: "thresholdDays must be between 1 and 3650" });
      }
      const { runBatchArchive } = await import("./services/recruitingArchiveService");
      const result = await runBatchArchive(
        parsedThreshold,
        userId,
        user?.email || "",
        dryRun === true
      );
      res.json(result);
    } catch (error: any) {
      console.error("[Archive] Error running batch archive:", error);
      res.status(500).json({ message: "Failed to run batch archive" });
    }
  });


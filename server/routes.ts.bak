  // Calculate and update AI score for a specific customer
  app.post("/api/customers/:id/ai-score", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { id } = req.params;
      const customer = await storage.getCustomer(id);
      if (!customer) {
        return res.status(404).json({ message: "Customer not found" });
      }
      
      const updatedCustomer = await storage.updateCustomerAIScore(id);
      res.json({
        success: true,
        customer: updatedCustomer,
        score: updatedCustomer?.paymentTimelinessScore,
        tier: updatedCustomer?.collectionsRiskTier,
        explanation: updatedCustomer?.scoreExplanation ? JSON.parse(updatedCustomer.scoreExplanation) : [],
        lastScoredAt: updatedCustomer?.lastScoredAt,
      });
    } catch (error) {
      console.error("Error calculating AI score:", error);
      res.status(500).json({ message: "Failed to calculate AI score" });
    }
  });

  // Get AI score details for a customer (without recalculating)
  app.get("/api/customers/:id/ai-score", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { id } = req.params;
      const customer = await storage.getCustomer(id);
      if (!customer) {
        return res.status(404).json({ message: "Customer not found" });
      }
      
      res.json({
        customerId: id,
        score: customer.paymentTimelinessScore,
        tier: customer.collectionsRiskTier,
        explanation: customer.scoreExplanation ? JSON.parse(customer.scoreExplanation) : [],
        lastScoredAt: customer.lastScoredAt,
        hasScore: customer.lastScoredAt !== null,
      });
    } catch (error) {
      console.error("Error fetching AI score:", error);
      res.status(500).json({ message: "Failed to fetch AI score" });
    }
  });

  // Batch recalculate AI scores for all customers
  app.post("/api/customers/ai-scores/recalculate-all", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!user || user.role !== 'admin') {
        return res.status(403).json({ message: "Forbidden: Admin access only" });
      }
      
      const customers = await storage.getCustomers();
      const results = {
        total: customers.length,
        success: 0,
        failed: 0,
        errors: [] as string[],
      };
      
      for (const customer of customers) {
        try {
          await storage.updateCustomerAIScore(customer.id);
          results.success++;
        } catch (err) {
          results.failed++;
          results.errors.push(`Customer ${customer.id}: ${(err as Error).message}`);
        }
      }
      
      res.json({
        message: `Recalculated scores for ${results.success}/${results.total} customers`,
        ...results,
      });
    } catch (error) {
      console.error("Error batch recalculating AI scores:", error);
      res.status(500).json({ message: "Failed to recalculate AI scores" });
    }
  });


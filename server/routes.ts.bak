  // Driver self-service: get own tier and safety info
  app.get("/api/drivers/my-status", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      const driver: any = await storage.getDriverByUserId(userId);
      if (!driver) {
        return res.status(404).json({ message: "Driver profile not found" });
      }
      
      // Get pay records for tier info
      const payRecords = await storage.getPayRecordsByDriverId(driver.id);
      const latestPay = payRecords[0];
      
      // Get accidents for safety state
      const accidents = await storage.getAccidentsByDriverId(driver.id);
      const atFaultCount = accidents.filter((a: any) => a.dodAtFault === 'Yes').length;
      
      // Calculate safety state
      let safetyState: string = 'ACTIVE';
      let safetyMultiplier = 1.0;
      if (atFaultCount >= 3) {
        safetyState = 'SUSPENDED';
        safetyMultiplier = 0.0;
      } else if (atFaultCount >= 2) {
        safetyState = 'RESTRICTED';
        safetyMultiplier = 0.85;
      }
      
      // Calculate tier info
      const currentTier = latestPay?.tier || 1;
      const tierMultipliers: Record<number, number> = { 1: 1.0, 2: 1.05, 3: 1.10, 4: 1.15 };
      
      // Calculate safety score (0-100, deduct 25 per at-fault claim)
      const safetyScore = Math.max(0, 100 - (atFaultCount * 25));
      
      // Calculate tier progress (percentage to next tier, max at tier 4)
      const tierProgress = currentTier >= 4 ? 100 : Math.round((currentTier / 4) * 100);
      
      res.json({
        driverId: driver.id,
        name: driver.fullName || driver.user?.firstName + ' ' + driver.user?.lastName || 'Unknown',
        tier: {
          current: currentTier,
          multiplier: tierMultipliers[currentTier] || 1.0,
          description: `Tier ${currentTier} Driver`,
          progress: tierProgress,
        },
        safety: {
          state: safetyState,
          multiplier: safetyMultiplier,
          atFaultClaimsCount: atFaultCount,
          claimsInWindow: accidents.length,
          score: safetyScore,
        },
        recentPayPeriods: payRecords.slice(0, 5).map((pr: any) => ({
          startDate: pr.payPeriodStart,
          endDate: pr.payPeriodEnd,
          grossPay: pr.grossPay,
          netPay: pr.netPay,
          totalTrips: pr.totalTrips,
          tier: pr.tier,
        })),
      });
    } catch (error) {
      console.error("Error fetching driver status:", error);
      res.status(500).json({ message: "Failed to fetch status" });
    }
  });

  // Dashboard Market Metrics: aggregates market profit/loss scores, throttles, hiring gate
  app.get("/api/dashboard/market-metrics", isAuthenticated, async (req: any, res: Response) => {
    try {
      // Look up user's role from database (not just claims metadata)
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      // Get all drivers to aggregate market data
      const drivers = await storage.getAllDriversWithUsers();
      const markets = new Set(drivers.map((d: any) => d.market).filter(Boolean));
      
      // Calculate aggregate scores (simplified - uses mock data structure)
      let totalProfitScore = 0;
      let totalLossScore = 0;
      let marketCount = 0;
      
      // Get accidents for loss score calculation and active claims count
      const allAccidents = await storage.getAllAccidents();
      const isAtFault = (a: any) => a.dodAtFault?.toLowerCase() === 'yes';
      const atFaultAccidents = allAccidents.filter(isAtFault);
      
      // Count active/open claims (last 30 days by default)
      const last30Days = new Date();
      last30Days.setDate(last30Days.getDate() - 30);
      const activeClaimsCount = allAccidents.filter((a: any) => 
        (a.caseStatus === 'open' || a.caseStatus === 'investigating' || a.status === 'open' || a.status === 'pending') &&
        (!a.incidentDate || new Date(a.incidentDate) >= last30Days)
      ).length;
      
      // Get current pay period status
      const payPeriods = await storage.getAllPayPeriods();
      const now = new Date();
      const currentPayPeriod = payPeriods.find((p: any) => {
        const start = new Date(p.periodStart);
        const end = new Date(p.periodEnd);
        return now >= start && now <= end;
      });
      
      let payPeriodStatus: 'OPEN' | 'CLOSED' | 'PENDING' = 'CLOSED';
      let currentPayPeriodName = 'No active period';
      
      if (currentPayPeriod) {
        payPeriodStatus = currentPayPeriod.status === 'open' ? 'OPEN' : 
                          currentPayPeriod.status === 'pending' ? 'PENDING' : 'CLOSED';
        currentPayPeriodName = currentPayPeriod.payGroup || `Period ${currentPayPeriod.id}`;
      }
      
      for (const market of markets) {
        marketCount++;
        const marketDrivers = drivers.filter((d: any) => d.market === market);
        const activeDrivers = marketDrivers.filter((d: any) => d.status === 'active').length;
        const totalDrivers = marketDrivers.length;
        
        // Simple profit score based on utilization (active/total ratio * 100)
        const utilizationRate = totalDrivers > 0 ? activeDrivers / totalDrivers : 0;
        const marketProfitScore = Math.round(utilizationRate * 100);
        totalProfitScore += marketProfitScore;
        
        // Loss score based on claims per driver
        const marketAccidents = atFaultAccidents.filter((a: any) => {
          const driver = drivers.find((d: any) => d.id === a.driverId);
          return driver?.market === market;
        });
        const claimsPerDriver = totalDrivers > 0 ? marketAccidents.length / totalDrivers : 0;
        const marketLossScore = Math.min(100, Math.round(claimsPerDriver * 50));
        totalLossScore += marketLossScore;
      }
      
      // Calculate averages
      const avgProfitScore = marketCount > 0 ? Math.round(totalProfitScore / marketCount) : 0;
      const avgLossScore = marketCount > 0 ? Math.round(totalLossScore / marketCount) : 0;
      
      res.json({
        marketProfitScore: avgProfitScore,
        marketLossScore: avgLossScore,
        activeClaimsCount,
        payPeriodStatus,
        currentPayPeriodName,
      });
    } catch (error) {
      console.error("Error fetching market metrics:", error);
      res.status(500).json({ message: "Failed to fetch market metrics" });
    }
  });

  // Driver Loss Score: individual driver risk score with breakdown
  app.get("/api/drivers/:id/loss-score", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const driverId = req.params.id;
      const driver = await storage.getDriverWithUser(driverId);
      if (!driver) {
        return res.status(404).json({ message: "Driver not found" });
      }
      
      // Get driver's accidents/claims (case-insensitive at-fault matching)
      const accidents = await storage.getAccidentsByDriverId(driverId);
      const atFaultAccidents = accidents.filter((a: any) => a.dodAtFault?.toLowerCase() === 'yes');
      
      // Get safety incidents
      const safetyIncidents = await storage.getSafetyIncidents(driverId);
      
      // Get driver's trips for late/failed move calculations
      const trips = await storage.getTripsByDriverId(driverId);
      const last90Days = new Date();
      last90Days.setDate(last90Days.getDate() - 90);
      const recentTrips = trips.filter((t: any) => new Date(t.tripDate) >= last90Days);
      const lateTrips = recentTrips.filter((t: any) => t.status === 'late' || t.status === 'failed');
      
      // Calculate score components
      const claims90Days = atFaultAccidents.filter((a: any) => {
        if (!a.incidentDate) return false;
        return new Date(a.incidentDate) >= last90Days;
      }).length;
      
      const violations90Days = safetyIncidents.filter((i: any) => {
        if (!i.incidentDate) return false;
        return new Date(i.incidentDate) >= last90Days && i.incidentType === 'violation';
      }).length;
      
      const preventableIncidents90Days = safetyIncidents.filter((i: any) => {
        if (!i.incidentDate) return false;
        return new Date(i.incidentDate) >= last90Days && 
               (i.incidentType === 'accident' || i.severity === 'high' || i.severity === 'critical');
      }).length;
      
      // Calculate total incurred from accidents (in cents) - includes paid + reserves
      const totalIncurredCents = atFaultAccidents.reduce((sum: number, a: any) => {
        const paid = parseFloat(a.amtPaid || '0') * 100;
        const reserve = parseFloat(a.totalIncurred || a.totalReserve || '0') * 100;
        return sum + paid + reserve;
      }, 0);
      
      // Calculate score components (0-100 each)
      const frequencyScore = Math.min(100, claims90Days * 25);
      const severityScore = Math.min(100, Math.round((totalIncurredCents / 2000000) * 100));
      const incidentScore = Math.min(100, (preventableIncidents90Days * 30) + (lateTrips.length * 10));
      const violationScore = Math.min(100, violations90Days * 25);
      
      // Weighted total: Frequency 40% + Severity 25% + Incidents 20% + Violations 15%
      const totalScore = Math.min(100, Math.round(
        (frequencyScore * 0.40) + 
        (severityScore * 0.25) + 
        (incidentScore * 0.20) + 
        (violationScore * 0.15)
      ));
      
      // Determine tier
      let tier: 'LOW' | 'MODERATE' | 'HIGH' | 'SEVERE' | 'CRITICAL';
      if (totalScore <= 29) tier = 'LOW';
      else if (totalScore <= 49) tier = 'MODERATE';
      else if (totalScore <= 69) tier = 'HIGH';
      else if (totalScore <= 84) tier = 'SEVERE';
      else tier = 'CRITICAL';
      
      const lateMovePercent = recentTrips.length > 0 
        ? (lateTrips.length / recentTrips.length) * 100 
        : 0;
      
      res.json({
        driverId,
        driverName: `${driver.firstName || ''} ${driver.lastName || ''}`.trim() || 'Unknown',
        calculatedAt: new Date().toISOString(),
        score: totalScore,
        tier,
        frequencyScore,
        severityScore,
        incidentScore,
        violationScore,
        inputs: {
          claimsHistory90Days: claims90Days,
          preventableIncidents90Days,
          safetyViolations90Days: violations90Days,
          lateOrFailedMoves90Days: lateTrips.length,
          totalMoves90Days: recentTrips.length,
          lateMovePercent: Math.round(lateMovePercent * 10) / 10,
          totalIncurredCents,
        },
        usage: {
          eligibilityGating: tier === 'SEVERE' || tier === 'CRITICAL',
          tieringVisibility: true,
          futurePayModifiers: false, // Phase 2
        },
      });
    } catch (error) {
      console.error("Error fetching driver loss score:", error);
      res.status(500).json({ message: "Failed to fetch driver loss score" });
    }
  });

  // Claims Loss Impact Summary: aggregate claims metrics for dashboard
  app.get("/api/claims/loss-impact-summary", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      // Get all accidents and drivers
      const allAccidents = await storage.getAllAccidents();
      const allDrivers = await storage.getAllDriversWithUsers();
      const activeDrivers = allDrivers.filter((d: any) => d.status === 'active');
      
      // Calculate time windows
      const now = new Date();
      const last30Days = new Date();
      last30Days.setDate(last30Days.getDate() - 30);
      const last90Days = new Date();
      last90Days.setDate(last90Days.getDate() - 90);
      
      // Filter accidents by time
      const accidents30Days = allAccidents.filter((a: any) => {
        if (!a.incidentDate) return false;
        return new Date(a.incidentDate) >= last30Days;
      });
      const accidents90Days = allAccidents.filter((a: any) => {
        if (!a.incidentDate) return false;
        return new Date(a.incidentDate) >= last90Days;
      });
      
      // At-fault counts (case-insensitive matching)
      const isAtFault = (a: any) => a.dodAtFault?.toLowerCase() === 'yes';
      const atFaultAccidents = allAccidents.filter(isAtFault);
      const atFault30Days = accidents30Days.filter(isAtFault).length;
      const atFault90Days = accidents90Days.filter(isAtFault).length;
      
      // Financial calculations (convert to cents)
      const totalReserveCents = allAccidents
        .filter((a: any) => a.caseStatus === 'open' || a.caseStatus === 'investigating')
        .reduce((sum: number, a: any) => {
          const reserve = parseFloat(a.totalIncurred || a.totalReserve || '0') * 100;
          return sum + reserve;
        }, 0);
      
      const totalPaidCents = allAccidents.reduce((sum: number, a: any) => {
        const paid = parseFloat(a.amtPaid || '0') * 100;
        return sum + paid;
      }, 0);
      
      const openClaimsCount = allAccidents.filter((a: any) => 
        a.caseStatus === 'open' || a.caseStatus === 'investigating'
      ).length;
      
      // Calculate high-risk driver count based on claims
      const driverClaimCounts = new Map<string, number>();
      atFaultAccidents.forEach((a: any) => {
        const count = driverClaimCounts.get(a.driverId) || 0;
        driverClaimCounts.set(a.driverId, count + 1);
      });
      const highRiskDriverCount = Array.from(driverClaimCounts.values())
        .filter(count => count >= 2).length;
      
      // Calculate total moves and late moves for the period (from trips)
      const allTrips = await storage.getAllTrips();
      const trips90Days = allTrips.filter((t: any) => {
        if (!t.createdAt) return false;
        return new Date(t.createdAt) >= last90Days;
      });
      const totalMoves = trips90Days.length || 1;
      const lateOrFailedMoves = trips90Days.filter((t: any) => 
        t.status === 'late' || t.status === 'failed' || t.status === 'missed'
      ).length;
      const lateMovePercent = Math.round((lateOrFailedMoves / totalMoves) * 100 * 10) / 10;
      
      // Get safety incidents for driver incident rate
      const safetyIncidents = await storage.getSafetyIncidents();
      const incidents90Days = safetyIncidents.filter((i: any) => {
        if (!i.incidentDate) return false;
        return new Date(i.incidentDate) >= last90Days;
      });
      
      const totalDrivers = activeDrivers.length || 1;
      const driverIncidentRate = Math.round((incidents90Days.length / totalDrivers) * 100 * 10) / 10;
      
      // Calculate market loss score with correct weights:
      // Frequency 35% (claims per 100 moves), Severity 25% (incurred $ + reserves), LateMoves 20% (missed SLA %), IncidentRate 20% (incidents per 100 drivers)
      const claimsPer100Moves = (atFault90Days / totalMoves) * 100;
      const frequencyScore = Math.min(100, claimsPer100Moves * 10); // Scale claims per 100 moves
      const severityScore = Math.min(100, ((totalReserveCents + totalPaidCents) / 10000000) * 100); // Scale to $100k
      const lateMoveScore = Math.min(100, lateMovePercent * 2); // Scale late move %
      const incidentRateScore = Math.min(100, driverIncidentRate * 2); // Scale incident rate
      
      const marketLossScore = Math.min(100, Math.round(
        (frequencyScore * 0.35) + 
        (severityScore * 0.25) +
        (lateMoveScore * 0.20) +
        (incidentRateScore * 0.20)
      ));
      
      // Driver loss score is average of all individual driver risk
      let totalDriverLossScore = 0;
      driverClaimCounts.forEach((count, driverId) => {
        totalDriverLossScore += Math.min(100, count * 25);
      });
      const avgDriverLossScore = driverClaimCounts.size > 0 
        ? Math.round(totalDriverLossScore / driverClaimCounts.size) 
        : 0;
      
      // Claims per 100 drivers
      const claimsPer100Drivers = totalDrivers > 0 
        ? Math.round((atFaultAccidents.length / totalDrivers) * 100 * 10) / 10
        : 0;
      
      res.json({
        calculatedAt: new Date().toISOString(),
        marketLossScore,
        driverLossScore: avgDriverLossScore,
        highRiskDriverCount,
        atFaultClaimsCount: atFaultAccidents.length,
        atFaultClaims30Days: atFault30Days,
        atFaultClaims90Days: atFault90Days,
        openClaimsCount,
        totalReserveCents,
        totalPaidCents,
        totalCostsCents: totalReserveCents + totalPaidCents,
        claimsPer100Drivers,
        claimsPer100Moves: Math.round(claimsPer100Moves * 10) / 10,
        totalDrivers,
        totalMoves,
        inputs: {
          openClaimsCount,
          totalReserveDollars: Math.round(totalReserveCents / 100),
          lateMovePercent,
          driverIncidentRate,
          frequencyScore: Math.round(frequencyScore),
          severityScore: Math.round(severityScore),
          lateMoveScore: Math.round(lateMoveScore),
          incidentRateScore: Math.round(incidentRateScore),
        },
        weights: {
          frequency: 0.35,
          severity: 0.25,
          lateMoves: 0.20,
          incidentRate: 0.20,
        },
        usage: 'Reporting + throttling decisions. No automatic pay penalties in v1.',
      });
    } catch (error) {
      console.error("Error fetching claims loss impact summary:", error);
      res.status(500).json({ message: "Failed to fetch claims summary" });
    }
  });

  // ============================================
  // CLAIMS DASHBOARD SCORECARD METRICS
  // ============================================
  
  app.get("/api/claims/dashboard-scorecard", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const now = new Date();
      const last30Days = new Date();
      last30Days.setDate(last30Days.getDate() - 30);
      const last90Days = new Date();
      last90Days.setDate(last90Days.getDate() - 90);
      
      // Fetch all data
      const allAccidents = await storage.getAllAccidents();
      const allDrivers = await storage.getAllDriversWithUsers();
      const allTrips = await storage.getAllTrips();
      const activeDrivers = allDrivers.filter((d: any) => d.status === 'active');
      
      // ============ 1) DRIVER CLAIMS SCORECARD ============
      
      // Filter by time periods
      const claims30Days = allAccidents.filter((a: any) => {
        const date = a.incidentDate || a.accidentDate;
        if (!date) return false;
        return new Date(date) >= last30Days;
      });
      const claims90Days = allAccidents.filter((a: any) => {
        const date = a.incidentDate || a.accidentDate;
        if (!date) return false;
        return new Date(date) >= last90Days;
      });
      
      // Moves in 30/90 day windows
      const moves30Days = allTrips.filter((t: any) => {
        if (!t.createdAt) return false;
        return new Date(t.createdAt) >= last30Days;
      });
      const moves90Days = allTrips.filter((t: any) => {
        if (!t.createdAt) return false;
        return new Date(t.createdAt) >= last90Days;
      });
      
      // Claims per 1,000 moves
      const claimsPer1k30Days = moves30Days.length > 0 
        ? Math.round((claims30Days.length / moves30Days.length) * 1000 * 10) / 10 
        : 0;
      const claimsPer1k90Days = moves90Days.length > 0 
        ? Math.round((claims90Days.length / moves90Days.length) * 1000 * 10) / 10 
        : 0;
      
      // Severity-weighted loss score (0-100 index)
      // Minor=1, Moderate=3, Severe=5
      const getSeverityWeight = (severity: string | null): number => {
        switch ((severity || '').toLowerCase()) {
          case 'low': case 'minor': return 1;
          case 'medium': case 'moderate': return 3;
          case 'high': case 'severe': case 'critical': return 5;
          default: return 2; // Default moderate
        }
      };
      
      let totalSeverityWeight = 0;
      let maxPossibleWeight = 0;
      claims90Days.forEach((a: any) => {
        totalSeverityWeight += getSeverityWeight(a.claimSeverity);
        maxPossibleWeight += 5; // Max weight per claim
      });
      const severityWeightedLossScore = maxPossibleWeight > 0 
        ? Math.round((totalSeverityWeight / maxPossibleWeight) * 100)
        : 0;
      
      // Repeat incident drivers (>1 claim in 90 days)
      const driverClaim90DayCounts = new Map<string, number>();
      claims90Days.forEach((a: any) => {
        if (!a.driverId) return;
        const count = driverClaim90DayCounts.get(a.driverId) || 0;
        driverClaim90DayCounts.set(a.driverId, count + 1);
      });
      const repeatIncidentDrivers: string[] = [];
      driverClaim90DayCounts.forEach((count, driverId) => {
        if (count > 1) repeatIncidentDrivers.push(driverId);
      });
      
      // Preventable claims % (from dodAtFault field - yes=preventable)
      const isPreventable = (a: any) => a.dodAtFault?.toLowerCase() === 'yes';
      const preventableCount = claims90Days.filter(isPreventable).length;
      const preventablePercent = claims90Days.length > 0 
        ? Math.round((preventableCount / claims90Days.length) * 100)
        : 0;
      
      // ============ 2) MOVE-LEVEL RISK SIGNALS ============
      
      // Calculate risk score for moves
      // Inputs: tenure<60d (+20), after-hours (+15), urban ZIP (+15), high-value vehicle (+20)
      const calculateMoveRisk = (trip: any, driver: any): number => {
        let score = 0;
        
        // Driver tenure < 60 days (+20)
        if (driver?.hireDate) {
          const tenureDays = Math.floor((now.getTime() - new Date(driver.hireDate).getTime()) / (1000 * 60 * 60 * 24));
          if (tenureDays < 60) score += 20;
        }
        
        // After-hours move (+15) - between 8pm and 6am
        if (trip.tripDate) {
          const hour = new Date(trip.tripDate).getHours();
          if (hour >= 20 || hour < 6) score += 15;
        }
        
        // Urban/high-density based on origin (simple heuristic - NYC, LA, CHI zips)
        const urbanPatterns = ['100', '101', '102', '103', '104', '900', '901', '902', '606', '607'];
        const originZip = (trip.origin || '').match(/\d{5}/)?.[0] || '';
        if (urbanPatterns.some(p => originZip.startsWith(p))) score += 15;
        
        // High vehicle value (estimate based on vehicleType)
        const highValueTypes = ['luxury', 'exotic', 'premium', 'suv', 'truck'];
        if (highValueTypes.some(t => (trip.vehicleType || '').toLowerCase().includes(t))) score += 20;
        
        return Math.min(100, score);
      };
      
      // Calculate risk for 90-day moves
      let totalRiskScore = 0;
      let highRiskMoveCount = 0;
      const highRiskMoveIds: string[] = [];
      
      moves90Days.forEach((trip: any) => {
        const driver = allDrivers.find((d: any) => d.id === trip.driverId);
        const risk = calculateMoveRisk(trip, driver);
        totalRiskScore += risk;
        if (risk >= 35) { // Threshold for high-risk
          highRiskMoveCount++;
          highRiskMoveIds.push(trip.id);
        }
      });
      
      const avgRiskScore = moves90Days.length > 0 
        ? Math.round(totalRiskScore / moves90Days.length)
        : 0;
      
      // Claims from high-risk moves
      const claimsFromHighRiskMoves = claims90Days.filter((a: any) => 
        a.moveId && highRiskMoveIds.includes(a.moveId)
      ).length;
      const claimsFromHighRiskPercent = claims90Days.length > 0
        ? Math.round((claimsFromHighRiskMoves / claims90Days.length) * 100)
        : 0;
      
      // ============ 3) PHOTO & EVIDENCE COMPLIANCE ============
      
      // Calculate move photo compliance from trips table
      const movesWithPickupComplete = moves90Days.filter((t: any) => t.pickupPhotoComplianceStatus === 'complete').length;
      const movesWithDropoffComplete = moves90Days.filter((t: any) => t.dropoffPhotoComplianceStatus === 'complete').length;
      const movesWithBothComplete = moves90Days.filter((t: any) => 
        t.pickupPhotoComplianceStatus === 'complete' && t.dropoffPhotoComplianceStatus === 'complete'
      ).length;
      
      const pickupCompliancePercent = moves90Days.length > 0
        ? Math.round((movesWithPickupComplete / moves90Days.length) * 100)
        : 0;
      const dropoffCompliancePercent = moves90Days.length > 0
        ? Math.round((movesWithDropoffComplete / moves90Days.length) * 100)
        : 0;
      const fullCompliancePercent = moves90Days.length > 0
        ? Math.round((movesWithBothComplete / moves90Days.length) * 100)
        : 0;
      const photoComplianceRate = fullCompliancePercent;
      
      // Claims with photo evidence (from evidenceComplianceStatus field)
      const claimsWithFullEvidence = allAccidents.filter((a: any) => a.evidenceComplianceStatus === 'complete').length;
      const claimsWithPartialEvidence = allAccidents.filter((a: any) => a.evidenceComplianceStatus === 'partial').length;
      const claimsMissingPhotos = allAccidents.filter((a: any) => 
        !a.evidenceComplianceStatus || a.evidenceComplianceStatus === 'none'
      ).length;
      
      const evidenceCompliancePercent = allAccidents.length > 0
        ? Math.round((claimsWithFullEvidence / allAccidents.length) * 100)
        : 0;
      
      // Claim success rate with photos vs without (from claimOutcome field)
      // Favorable = denied, recovered, or paid with payout <= recoveredAmount
      const isFavorable = (a: any) => {
        if (a.claimOutcome === 'denied') return true;
        if (a.claimOutcome === 'recovered') return true;
        const payout = parseFloat(a.payoutAmount || '0');
        const recovered = parseFloat(a.recoveredAmount || '0');
        return payout > 0 && recovered >= payout;
      };
      
      const claimsWithEvidenceResolved = allAccidents.filter((a: any) => 
        a.evidenceComplianceStatus === 'complete' && a.claimOutcome
      );
      const claimsWithoutEvidenceResolved = allAccidents.filter((a: any) => 
        (!a.evidenceComplianceStatus || a.evidenceComplianceStatus === 'none') && a.claimOutcome
      );
      
      const successRateWithEvidence = claimsWithEvidenceResolved.length > 0
        ? Math.round((claimsWithEvidenceResolved.filter(isFavorable).length / claimsWithEvidenceResolved.length) * 100)
        : null;
      const successRateWithoutEvidence = claimsWithoutEvidenceResolved.length > 0
        ? Math.round((claimsWithoutEvidenceResolved.filter(isFavorable).length / claimsWithoutEvidenceResolved.length) * 100)
        : null;
      
      // ============ 4) ROOT-CAUSE & LOSS PATTERN SIGNALS ============
      
      // Top 3 claim locations
      const locationCounts = new Map<string, number>();
      allAccidents.forEach((a: any) => {
        const loc = (a.location || 'Unknown').trim().toLowerCase();
        const normalized = loc.split(',')[0].trim(); // Use city/area
        locationCounts.set(normalized, (locationCounts.get(normalized) || 0) + 1);
      });
      const topLocations = Array.from(locationCounts.entries())
        .sort((a, b) => b[1] - a[1])
        .slice(0, 3)
        .map(([location, count]) => ({ location, count }));
      
      // Top 3 drivers by severity-weighted loss
      const driverLossScores = new Map<string, { driverId: string; name: string; score: number; claimCount: number }>();
      allAccidents.forEach((a: any) => {
        if (!a.driverId) return;
        const weight = getSeverityWeight(a.claimSeverity);
        const cost = parseFloat(a.probableCost || a.totalEstimate || '0');
        const existing = driverLossScores.get(a.driverId) || { 
          driverId: a.driverId, 
          name: '', 
          score: 0, 
          claimCount: 0 
        };
        existing.score += weight * (cost > 0 ? cost : 1000); // Weighted by cost
        existing.claimCount++;
        driverLossScores.set(a.driverId, existing);
      });
      
      // Add driver names
      driverLossScores.forEach((data, driverId) => {
        const driver = allDrivers.find((d: any) => d.id === driverId);
        data.name = driver?.user 
          ? `${driver.user.firstName || ''} ${driver.user.lastName || ''}`.trim() 
          : 'Unknown';
      });
      
      const topDriversBySeverity = Array.from(driverLossScores.values())
        .sort((a, b) => b.score - a.score)
        .slice(0, 3)
        .map(d => ({ driverId: d.driverId, name: d.name, claimCount: d.claimCount, score: Math.round(d.score) }));
      
      // Time-of-day distribution
      const timeDistribution = { morning: 0, afternoon: 0, evening: 0, night: 0 };
      allAccidents.forEach((a: any) => {
        const date = a.incidentDate || a.accidentDate;
        if (!date) return;
        const hour = new Date(date).getHours();
        if (hour >= 6 && hour < 12) timeDistribution.morning++;
        else if (hour >= 12 && hour < 18) timeDistribution.afternoon++;
        else if (hour >= 18 && hour < 22) timeDistribution.evening++;
        else timeDistribution.night++;
      });
      
      const totalTimeCount = Object.values(timeDistribution).reduce((a, b) => a + b, 0) || 1;
      const peakTimeWindow = Object.entries(timeDistribution)
        .sort((a, b) => b[1] - a[1])[0];
      
      // ============ 5) CARRIER-READY KPI SUMMARY ============
      
      // Avg days to close
      const closedClaims = allAccidents.filter((a: any) => 
        ['closed', 'resolved', 'denied'].includes((a.status || '').toLowerCase()) ||
        ['CLOSED', 'DENIED', 'PAID'].includes(a.claimStatus || '')
      );
      
      let totalDaysToClose = 0;
      closedClaims.forEach((a: any) => {
        const created = a.createdAt ? new Date(a.createdAt) : null;
        const updated = a.updatedAt ? new Date(a.updatedAt) : null;
        if (created && updated) {
          totalDaysToClose += Math.max(0, Math.floor((updated.getTime() - created.getTime()) / (1000 * 60 * 60 * 24)));
        }
      });
      const avgDaysToClose = closedClaims.length > 0 
        ? Math.round(totalDaysToClose / closedClaims.length)
        : 0;
      
      // Open claims > 30 days
      const openClaimsOver30Days = allAccidents.filter((a: any) => {
        const isOpen = !['closed', 'resolved', 'denied'].includes((a.status || '').toLowerCase()) &&
                       !['CLOSED', 'DENIED', 'PAID'].includes(a.claimStatus || '');
        if (!isOpen) return false;
        const created = a.createdAt ? new Date(a.createdAt) : null;
        if (!created) return false;
        const daysSinceCreation = Math.floor((now.getTime() - created.getTime()) / (1000 * 60 * 60 * 24));
        return daysSinceCreation > 30;
      }).length;
      
      // Claims trend (30 vs 90 day delta)
      const claims30DayCount = claims30Days.length;
      const claims60to90Days = allAccidents.filter((a: any) => {
        const date = a.incidentDate || a.accidentDate;
        if (!date) return false;
        const d = new Date(date);
        return d >= last90Days && d < last30Days;
      }).length;
      
      // Calculate 30-day average from 60-90 day window
      const avg30DayFromPrior = claims60to90Days / 2; // 60 days = 2x30 day periods
      const trendPercent = avg30DayFromPrior > 0 
        ? Math.round(((claims30DayCount - avg30DayFromPrior) / avg30DayFromPrior) * 100)
        : 0;
      
      // Total claims cost
      const totalClaimsCost = allAccidents.reduce((sum: number, a: any) => {
        const cost = parseFloat(a.probableCost || a.totalEstimate || a.actualCost || '0');
        return sum + cost;
      }, 0);
      
      // Open claims count
      const openClaimsCount = allAccidents.filter((a: any) => 
        !['closed', 'resolved', 'denied'].includes((a.status || '').toLowerCase()) &&
        !['CLOSED', 'DENIED', 'PAID'].includes(a.claimStatus || '')
      ).length;
      
      res.json({
        calculatedAt: now.toISOString(),
        
        // 1) Driver Claims Scorecard
        driverScorecard: {
          claimsPer1k30Days,
          claimsPer1k90Days,
          severityWeightedLossScore,
          repeatIncidentDriverCount: repeatIncidentDrivers.length,
          repeatIncidentDriverIds: repeatIncidentDrivers,
          preventablePercent,
          preventableCount,
          totalClaims90Days: claims90Days.length,
        },
        
        // 2) Move-Level Risk Signals
        riskSignals: {
          highRiskMoveCount,
          claimsFromHighRiskPercent,
          avgRiskScore,
          totalMoves90Days: moves90Days.length,
        },
        
        // 3) Photo & Evidence Compliance
        evidenceCompliance: {
          // Move photo compliance (from trips table)
          pickupCompliancePercent,
          dropoffCompliancePercent,
          fullCompliancePercent,
          photoComplianceRate,
          // Claims evidence compliance (from accidents table)
          claimsWithFullEvidence,
          claimsWithPartialEvidence,
          claimsMissingPhotos,
          claimsWithFullEvidencePercent: evidenceCompliancePercent,
          // Success rate correlation
          successRateWithEvidence,
          successRateWithoutEvidence,
          // Totals for context
          totalMoves90Days: moves90Days.length,
          totalClaims: allAccidents.length,
          // Backward compatibility
          claimsChecked: allAccidents.length,
        },
        
        // 4) Root-Cause & Loss Patterns
        lossPatterns: {
          topLocations,
          topDriversBySeverity,
          peakTimeWindow: peakTimeWindow[0],
          peakTimePercent: Math.round((peakTimeWindow[1] / totalTimeCount) * 100),
          timeDistribution,
        },
        
        // 5) Carrier-Ready KPIs
        carrierKpis: {
          avgDaysToClose,
          openClaimsOver30Days,
          claimsTrendPercent: trendPercent,
          claims30Days: claims30DayCount,
          totalClaimsCost: Math.round(totalClaimsCost * 100) / 100,
          openClaimsCount,
        },
        
        // Thresholds for warnings
        thresholds: {
          claimsPer1kWarning: 10, // Warning if > 10 claims per 1k moves
          severityScoreWarning: 60, // Warning if severity score > 60
          repeatDriverWarning: 3, // Warning if > 3 repeat incident drivers
          preventableWarning: 50, // Warning if > 50% preventable
          riskScoreWarning: 40, // Warning if avg risk > 40
          daysToCloseWarning: 45, // Warning if avg > 45 days
          openOver30Warning: 5, // Warning if > 5 claims open > 30 days
        },
      });
    } catch (error) {
      console.error("Error fetching claims dashboard scorecard:", error);
      res.status(500).json({ message: "Failed to fetch dashboard scorecard" });
    }
  });

  // ============================================
  // FEEDBACK SYSTEM ENDPOINTS (INCREMENT 28)
  // ============================================

  // Create feedback ticket (any authenticated user)
  app.post("/api/feedback", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await storage.getUser(userId);
      if (!user) {
        return res.status(404).json({ message: "User not found" });
      }

      const { type, area, title, description, impact, urgency, attachmentUrls, userAgent, pageUrl } = req.body;
      
      if (!type || !area || !title || !description) {
        return res.status(400).json({ message: "Missing required fields: type, area, title, description" });
      }

      const ticket = await storage.createFeedbackTicket({
        type,
        area,
        title,
        description,
        impact: impact || null,
        urgency: urgency || null,
        priority: 'NORMAL',
        status: 'OPEN',
        visibility: 'PUBLIC',
        createdByUserId: userId,
        createdByName: user.firstName && user.lastName 
          ? `${user.firstName} ${user.lastName}` 
          : user.email || 'Unknown User',
        attachmentUrls: attachmentUrls || null,
        userAgent: userAgent || null,
        pageUrl: pageUrl || null,
      });

      // Create audit log entry
      await storage.createFeedbackAuditLog({
        ticketId: ticket.id,
        actorUserId: userId,
        actorName: user.email || 'Unknown',
        action: 'CREATED',
      });

      res.status(201).json(ticket);
    } catch (error) {
      console.error("Error creating feedback ticket:", error);
      res.status(500).json({ message: "Failed to create feedback ticket" });
    }
  });

  // Get current user's feedback tickets
  app.get("/api/feedback/mine", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const tickets = await storage.getFeedbackTicketsByUser(userId);
      res.json(tickets);
    } catch (error) {
      console.error("Error fetching user feedback:", error);
      res.status(500).json({ message: "Failed to fetch feedback" });
    }
  });

  // Get single feedback ticket (user can see their own, admin can see all)
  app.get("/api/feedback/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const ticket = await storage.getFeedbackTicket(req.params.id);
      if (!ticket) {
        return res.status(404).json({ message: "Ticket not found" });
      }

      const user = await storage.getUser(userId);
      const isCorporate = user && hasCorporateAccess(user);

      // Users can only see their own tickets unless they're corporate
      if (ticket.createdByUserId !== userId && !isCorporate) {
        return res.status(403).json({ message: "Not authorized to view this ticket" });
      }

      // Get comments (filter internal for non-corporate users)
      let comments = await storage.getFeedbackComments(ticket.id);
      if (!isCorporate) {
        comments = comments.filter(c => c.visibility !== 'INTERNAL');
      }

      res.json({ ...ticket, comments });
    } catch (error) {
      console.error("Error fetching feedback ticket:", error);
      res.status(500).json({ message: "Failed to fetch ticket" });
    }
  });

  // Add comment to feedback ticket (user or admin)
  app.post("/api/feedback/:id/comment", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const ticket = await storage.getFeedbackTicket(req.params.id);
      if (!ticket) {
        return res.status(404).json({ message: "Ticket not found" });
      }

      const user = await storage.getUser(userId);
      if (!user) {
        return res.status(404).json({ message: "User not found" });
      }

      const isCorporate = hasCorporateAccess(user);

      // Non-corporate users can only comment on their own tickets
      if (ticket.createdByUserId !== userId && !isCorporate) {
        return res.status(403).json({ message: "Not authorized to comment on this ticket" });
      }

      const { content, visibility } = req.body;
      if (!content) {
        return res.status(400).json({ message: "Content is required" });
      }

      // Non-corporate users can only post PUBLIC comments
      const commentVisibility = isCorporate ? (visibility || 'PUBLIC') : 'PUBLIC';

      const comment = await storage.createFeedbackComment({
        ticketId: ticket.id,
        authorUserId: userId,
        authorName: user.firstName && user.lastName 
          ? `${user.firstName} ${user.lastName}` 
          : user.email || 'Unknown User',
        content,
        visibility: commentVisibility,
        attachmentUrls: req.body.attachmentUrls || null,
      });

      // Create audit log
      await storage.createFeedbackAuditLog({
        ticketId: ticket.id,
        actorUserId: userId,
        actorName: user.email || 'Unknown',
        action: 'COMMENT_ADDED',
      });

      res.status(201).json(comment);
    } catch (error) {
      console.error("Error adding comment:", error);
      res.status(500).json({ message: "Failed to add comment" });
    }
  });

  // Admin: Get all feedback tickets with filters
  app.get("/api/admin/feedback", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await storage.getUser(userId);
      if (!user || !hasCorporateAccess(user)) {
        return res.status(403).json({ message: "Corporate access required" });
      }

      const { status, priority, type, area, source } = req.query;
      const filters: any = {};
      if (status) filters.status = status as string;
      if (priority) filters.priority = priority as string;
      if (type) filters.type = type as string;
      if (area) filters.area = area as string;
      if (source) filters.ticketSource = source as string;

      const tickets = await storage.getAllFeedbackTickets(Object.keys(filters).length > 0 ? filters : undefined);
      res.json(tickets);
    } catch (error) {
      console.error("Error fetching admin feedback:", error);
      res.status(500).json({ message: "Failed to fetch feedback" });
    }
  });

  // Admin: Update feedback ticket (status, priority, assignment)
  app.patch("/api/admin/feedback/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await storage.getUser(userId);
      if (!user || !hasCorporateAccess(user)) {
        return res.status(403).json({ message: "Corporate access required" });
      }

      const ticket = await storage.getFeedbackTicket(req.params.id);
      if (!ticket) {
        return res.status(404).json({ message: "Ticket not found" });
      }

      const { status, priority, assignedToUserId } = req.body;
      const updates: any = {};
      
      if (status && status !== ticket.status) {
        updates.status = status;
        await storage.createFeedbackAuditLog({
          ticketId: ticket.id,
          actorUserId: userId,
          actorName: user.email || 'Unknown',
          action: 'STATUS_CHANGED',
          fromValue: ticket.status,
          toValue: status,
        });
      }
      
      if (priority && priority !== ticket.priority) {
        updates.priority = priority;
        await storage.createFeedbackAuditLog({
          ticketId: ticket.id,
          actorUserId: userId,
          actorName: user.email || 'Unknown',
          action: 'PRIORITY_CHANGED',
          fromValue: ticket.priority,
          toValue: priority,
        });
      }
      
      if (assignedToUserId !== undefined && assignedToUserId !== ticket.assignedToUserId) {
        updates.assignedToUserId = assignedToUserId;
        await storage.createFeedbackAuditLog({
          ticketId: ticket.id,
          actorUserId: userId,
          actorName: user.email || 'Unknown',
          action: 'ASSIGNED',
          fromValue: ticket.assignedToUserId || 'Unassigned',
          toValue: assignedToUserId || 'Unassigned',
        });
      }

      if (Object.keys(updates).length === 0) {
        return res.json(ticket);
      }

      const updated = await storage.updateFeedbackTicket(req.params.id, updates);
      res.json(updated);
    } catch (error) {
      console.error("Error updating feedback ticket:", error);
      res.status(500).json({ message: "Failed to update ticket" });
    }
  });

  // Admin: Get audit log for a ticket
  app.get("/api/admin/feedback/:id/audit", isAuthenticated, async (req: any, res: Response) => {

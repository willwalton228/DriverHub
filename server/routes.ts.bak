  // GET /api/recruiting/candidates/:candidateId/duplicates - Find possible duplicates
  app.get("/api/recruiting/candidates/:candidateId/duplicates", async (req: any, res: Response) => {
    try {
      // Support both session-based (password) and OIDC auth
      let userId: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      const user = await storage.getUser(userId);
      // Admin or Recruiter can view duplicates
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user' && user.role !== 'recruiter')) {
        return res.status(403).json({ message: "Forbidden: Recruiter or Admin access required" });
      }

      const { detectDuplicates } = await import("./services/recruitingMergeService");
      const { candidateId } = req.params;
      
      if (!candidateId) {
        return res.status(400).json({ message: "Candidate ID is required" });
      }

      const duplicates = await detectDuplicates(candidateId);
      res.json({ duplicates });
    } catch (error) {

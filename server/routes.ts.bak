        });
      }
      if (!user || (user.role !== 'admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { id } = req.params;
      const { durationMinutes, warningThresholdMinutes, criticalThresholdMinutes, config, isActive } = req.body;

      const { updateSlaDefinition } = await import("./slaService");
      const updated = await updateSlaDefinition(id, {
        durationMinutes,
        warningThresholdMinutes,
        criticalThresholdMinutes,
        config: config ? JSON.stringify(config) : undefined,
        isActive,
      }, userId);

      if (!updated) {
        return res.status(404).json({ message: "SLA definition not found" });
      }
      res.json(updated);
    } catch (error) {
      console.error("[SLA] Error updating definition:", error);
      res.status(500).json({ message: "Failed to update SLA definition" });
    }
  });


    } catch (error) {
      console.error("Error deleting payment retry config:", error);
      res.status(500).json({ message: "Failed to delete payment retry config" });
    }
  });

  // ==========================================
  // PAYMENT RETRY ATTEMPTS ROUTES
  // ==========================================

  // Get retry attempts for a payment
  app.get("/api/corporate/invoicing/payments/:paymentId/retry-attempts", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { paymentId } = req.params;
      const attempts = await storage.getPaymentRetryAttempts(paymentId);
      res.json(attempts);
    } catch (error) {
      console.error("Error fetching retry attempts:", error);
      res.status(500).json({ message: "Failed to fetch retry attempts" });
    }
  });

  // Get scheduled retries (for admin monitoring)
  app.get("/api/corporate/invoicing/payment-retry/scheduled", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const beforeDate = req.query.beforeDate ? new Date(req.query.beforeDate as string) : undefined;
      const scheduled = await storage.getScheduledRetryAttempts(beforeDate);
      res.json(scheduled);
    } catch (error) {
      console.error("Error fetching scheduled retries:", error);
      res.status(500).json({ message: "Failed to fetch scheduled retries" });
    }
  });

  // Manually schedule a retry
  app.post("/api/corporate/invoicing/payments/:paymentId/schedule-retry", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { paymentId } = req.params;
      const { retryAt, attemptNumber } = req.body;
      
      if (!retryAt) {
        return res.status(400).json({ message: "retryAt is required" });
      }
      
      const attempt = await storage.schedulePaymentRetry(
        paymentId,
        new Date(retryAt),
        attemptNumber || 1
      );
      
      res.status(201).json(attempt);
    } catch (error) {
      console.error("Error scheduling retry:", error);
      res.status(500).json({ message: "Failed to schedule retry" });
    }
  });

  // Cancel pending retries for a payment
  app.post("/api/corporate/invoicing/payments/:paymentId/cancel-retries", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { paymentId } = req.params;
      const cancelledCount = await storage.cancelPendingRetries(paymentId);
      
      res.json({ success: true, cancelledCount });
    } catch (error) {
      console.error("Error cancelling retries:", error);
      res.status(500).json({ message: "Failed to cancel retries" });
    }
  });

  // Record payment failure and schedule retries based on config
  app.post("/api/corporate/invoicing/payments/:paymentId/record-failure", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { paymentId } = req.params;
      const { failureCode, failureMessage, paymentMethod } = req.body;
      
      // Update payment with failure details
      const payment = await storage.updatePayment(paymentId, {
        status: 'failed',
        failureCode,
        failureMessage,
        failedAt: new Date(),
      });
      
      if (!payment) {
        return res.status(404).json({ message: "Payment not found" });
      }
      
      // Get retry config for this payment method
      const retryConfig = await storage.getPaymentRetryConfigByMethod(paymentMethod || 'credit_card');
      
      let scheduledRetries: any[] = [];
      
      if (retryConfig?.autoRetry && retryConfig.retryScheduleDays?.length > 0) {
        const currentRetryCount = (payment as any).retryCount || 0;
        
        if (currentRetryCount < retryConfig.maxRetries) {
          const now = new Date();
          for (let i = currentRetryCount; i < Math.min(retryConfig.maxRetries, retryConfig.retryScheduleDays.length); i++) {
            const daysToAdd = retryConfig.retryScheduleDays[i];
            const retryAt = new Date(now);
            retryAt.setDate(retryAt.getDate() + daysToAdd);
            
            const attempt = await storage.schedulePaymentRetry(paymentId, retryAt, i + 1);
            scheduledRetries.push(attempt);
          }
          
          // Update payment with retry tracking
          await storage.updatePayment(paymentId, {
            retryCount: currentRetryCount,
            maxRetries: retryConfig.maxRetries,
            nextRetryAt: scheduledRetries[0]?.scheduledAt,
          });
        }
      }
      
      res.json({
        payment,
        scheduledRetries,
        config: retryConfig,
      });
    } catch (error) {
      console.error("Error recording payment failure:", error);
      res.status(500).json({ message: "Failed to record payment failure" });
    }
  });


  // ==========================================
  // AUTOPAY & PAYMENT METHODS ROUTES
  // ==========================================

  // Validation schemas for autopay
  const customerPaymentMethodSchema = z.object({
    customerId: z.string(),
    methodType: z.enum(['ach', 'card']),
    stripePaymentMethodId: z.string().optional(),
    vaultToken: z.string().optional(),
    last4: z.string().max(4).optional(),
    bankName: z.string().optional(),
    cardBrand: z.string().optional(),
    expiryMonth: z.number().int().min(1).max(12).optional(),
    expiryYear: z.number().int().optional(),
    isDefault: z.boolean().optional().default(false),
    nickname: z.string().optional(),
  });

  const autopaySettingsSchema = z.object({
    autopayEnabled: z.boolean(),
    autopayMethod: z.enum(['ach']).optional(),
    autopayTrigger: z.enum(['on_send', 'on_due_date']).optional(),
    autopayPaymentMethodId: z.string().optional(),
  });

  // Get customer payment methods
  app.get("/api/customers/:customerId/payment-methods", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { customerId } = req.params;
      const methods = await storage.getCustomerPaymentMethods(customerId);
      res.json(methods);
    } catch (error) {
      console.error("Error fetching payment methods:", error);
      res.status(500).json({ message: "Failed to fetch payment methods" });
    }
  });

  // Add customer payment method
  app.post("/api/customers/:customerId/payment-methods", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { customerId } = req.params;
      const validatedData = customerPaymentMethodSchema.parse({ ...req.body, customerId });
      
      const method = await storage.createCustomerPaymentMethod({
        ...validatedData,
        createdBy: req.user.claims.sub,
        isActive: true,
        isVerified: false,
      });
      
      res.status(201).json(method);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error creating payment method:", error);
      res.status(500).json({ message: "Failed to create payment method" });
    }
  });

  // Update customer payment method
  app.patch("/api/customers/:customerId/payment-methods/:methodId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { methodId } = req.params;
      const { nickname, isDefault } = req.body;
      
      const method = await storage.updateCustomerPaymentMethod(methodId, {
        ...(nickname !== undefined && { nickname }),
        ...(isDefault !== undefined && { isDefault }),
      });
      
      if (!method) {
        return res.status(404).json({ message: "Payment method not found" });
      }
      
      res.json(method);
    } catch (error) {
      console.error("Error updating payment method:", error);
      res.status(500).json({ message: "Failed to update payment method" });
    }
  });

  // Delete customer payment method (soft delete)
  app.delete("/api/customers/:customerId/payment-methods/:methodId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { methodId } = req.params;
      await storage.deleteCustomerPaymentMethod(methodId);
      res.status(204).send();
    } catch (error) {
      console.error("Error deleting payment method:", error);
      res.status(500).json({ message: "Failed to delete payment method" });
    }
  });

  // Set default payment method
  app.post("/api/customers/:customerId/payment-methods/:methodId/set-default", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { customerId, methodId } = req.params;
      await storage.setDefaultPaymentMethod(customerId, methodId);
      res.json({ message: "Default payment method updated" });
    } catch (error) {
      console.error("Error setting default payment method:", error);
      res.status(500).json({ message: "Failed to set default payment method" });
    }
  });

  // Get customer autopay settings (from billing profile)
  app.get("/api/customers/:customerId/autopay", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { customerId } = req.params;
      const billingProfile = await storage.getCustomerBillingProfile(customerId);
      
      if (!billingProfile) {
        return res.status(404).json({ message: "Billing profile not found" });
      }
      
      res.json({
        autopayEnabled: billingProfile.autopayEnabled,
        autopayMethod: billingProfile.autopayMethod,
        autopayTrigger: billingProfile.autopayTrigger,
        autopayPaymentMethodId: billingProfile.autopayPaymentMethodId,
        autopayDisabledAt: billingProfile.autopayDisabledAt,
        autopayDisabledBy: billingProfile.autopayDisabledBy,
        autopayDisabledReason: billingProfile.autopayDisabledReason,
      });
    } catch (error) {
      console.error("Error fetching autopay settings:", error);
      res.status(500).json({ message: "Failed to fetch autopay settings" });
    }
  });

  // Update customer autopay settings
  app.patch("/api/customers/:customerId/autopay", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { customerId } = req.params;
      const validatedData = autopaySettingsSchema.parse(req.body);
      
      if (validatedData.autopayEnabled && validatedData.autopayPaymentMethodId) {
        const paymentMethod = await storage.getCustomerPaymentMethod(validatedData.autopayPaymentMethodId);
        if (!paymentMethod || !paymentMethod.isActive || !paymentMethod.isVerified) {
          return res.status(400).json({ message: "Invalid or unverified payment method" });
        }
        if (paymentMethod.methodType !== 'ach') {
          return res.status(400).json({ message: "Only ACH payment methods are supported for autopay" });
        }
      }
      
      const billingProfile = await storage.updateCustomerBillingProfile(customerId, {
        ...validatedData,
        ...(validatedData.autopayEnabled && {
          autopayDisabledAt: null,
          autopayDisabledBy: null,
          autopayDisabledReason: null,
        }),
      });
      
      if (!billingProfile) {
        return res.status(404).json({ message: "Billing profile not found" });
      }
      
      res.json({
        autopayEnabled: billingProfile.autopayEnabled,
        autopayMethod: billingProfile.autopayMethod,
        autopayTrigger: billingProfile.autopayTrigger,
        autopayPaymentMethodId: billingProfile.autopayPaymentMethodId,
      });
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error updating autopay settings:", error);
      res.status(500).json({ message: "Failed to update autopay settings" });
    }
  });

  // Disable customer autopay (with audit trail)
  app.post("/api/customers/:customerId/autopay/disable", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { customerId } = req.params;
      const { reason } = req.body;
      
      await storage.disableCustomerAutopay(customerId, req.user.claims.sub, reason);
      res.json({ message: "Autopay disabled" });
    } catch (error) {
      console.error("Error disabling autopay:", error);
      res.status(500).json({ message: "Failed to disable autopay" });
    }
  });

  // Get autopay eligible invoices (for processing)
  app.get("/api/corporate/invoicing/autopay/eligible", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const trigger = req.query.trigger as 'on_send' | 'on_due_date' || 'on_due_date';
      const eligibleInvoices = await storage.getAutopayEligibleInvoices(trigger);
      res.json(eligibleInvoices);
    } catch (error) {
      console.error("Error fetching eligible invoices:", error);
      res.status(500).json({ message: "Failed to fetch eligible invoices" });
    }
  });

  // Process autopay for invoice (manual trigger)
  app.post("/api/invoices/:invoiceId/autopay/process", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { invoiceId } = req.params;
      const invoice = await storage.getInvoice(invoiceId);
      
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }
      
      const billingProfile = await storage.getCustomerBillingProfile(invoice.customerId);
      
      if (!billingProfile || !billingProfile.autopayEnabled) {
        return res.status(400).json({ message: "Autopay is not enabled for this customer" });
      }
      
      if (!billingProfile.autopayPaymentMethodId) {
        return res.status(400).json({ message: "No autopay payment method configured" });
      }
      
      const attempt = await storage.processAutopay(
        invoiceId,
        billingProfile.autopayPaymentMethodId,
        'manual'
      );
      
      res.json(attempt);
    } catch (error: any) {
      console.error("Error processing autopay:", error);
      res.status(500).json({ message: error.message || "Failed to process autopay" });
    }
  });

  // Get autopay attempts for invoice
  app.get("/api/invoices/:invoiceId/autopay/attempts", isAuthenticated, async (req: any, res: Response) => {

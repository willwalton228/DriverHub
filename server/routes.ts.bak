  // GET /api/recruiting/audit - List audit events with filters
  app.get("/api/recruiting/audit", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { entityType, entityId, userId: actorId, actionType, source, dateFrom, dateTo, includeDiffs, limit, offset } = req.query;

      if (dateFrom && isNaN(new Date(dateFrom as string).getTime())) {
        return res.status(400).json({ message: "Invalid dateFrom parameter" });
      }
      if (dateTo && isNaN(new Date(dateTo as string).getTime())) {
        return res.status(400).json({ message: "Invalid dateTo parameter" });
      }

      const { getAuditEvents } = await import("./recruitingService");

      const result = await getAuditEvents({
        entityType: entityType as string | undefined,
        entityId: entityId as string | undefined,
        userId: actorId as string | undefined,
        actionType: actionType as string | undefined,
        source: source as string | undefined,
        dateFrom: dateFrom as string | undefined,
        dateTo: dateTo as string | undefined,
        includeDiffs: includeDiffs === 'true',
        limit: limit ? parseInt(limit as string) : undefined,
        offset: offset ? parseInt(offset as string) : undefined,
      });

      res.json(result);
    } catch (error) {
      console.error("[Recruiting] Error fetching audit events:", error);
      res.status(500).json({ message: "Failed to fetch audit events" });
    }
  });

  // GET /api/recruiting/audit/filters - Get distinct filter options for audit log
  app.get("/api/recruiting/audit/filters", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { getDistinctAuditActionTypes, getDistinctAuditEntityTypes } = await import("./recruitingService");

      const [actionTypes, entityTypes] = await Promise.all([
        getDistinctAuditActionTypes(),
        getDistinctAuditEntityTypes(),
      ]);

      const sources = ["ui", "api", "integration", "system"];

      res.json({ actionTypes, entityTypes, sources });
    } catch (error) {
      console.error("[Recruiting] Error fetching audit filters:", error);
      res.status(500).json({ message: "Failed to fetch audit filters" });
    }
  });

  // GET /api/recruiting/ready - Ready drivers API for Scheduling integration
  app.get("/api/recruiting/ready", async (req: Request, res: Response) => {
    // System-to-system authentication via API key
    const apiKey = req.headers['x-api-key'] || req.query.apiKey;
    const isSystemAuth = apiKey === process.env.DRIVERHUB_API_KEY;
    
    if (!isSystemAuth && !req.isAuthenticated()) {
      return res.status(401).json({ 
        error: "UNAUTHORIZED",
        message: "Valid API key or authentication required" 
      });
    }
    
    try {
      const { getDeployableCandidates } = await import("./services/schedulingIntegrationService");
      
      const filters = {
        market: req.query.market as string | undefined,
        role: req.query.role as string | undefined,
        workerType: req.query.workerType as string | undefined,
        workType: req.query.workType as string | undefined,
        limit: req.query.limit ? parseInt(req.query.limit as string) : 100,
        offset: req.query.offset ? parseInt(req.query.offset as string) : 0,
      };
      
      const result = await getDeployableCandidates(filters);
      
      res.json({
        success: true,
        data: result.candidates,
        meta: {
          total: result.total,
          limit: filters.limit,
          offset: filters.offset,
          filters: {
            market: filters.market || null,
            role: filters.role || null,
            workerType: filters.workerType || null,
            workType: filters.workType || null,
          },
        },
      });
    } catch (error: any) {
      console.error("[Scheduling] Ready candidates query error:", error);
      res.status(500).json({ 
        error: "INTERNAL_ERROR",
        message: "Failed to retrieve deployable candidates" 
      });
    }
  });

  // POST /api/recruiting/apply/:requisitionId - Public apply endpoint
  app.post("/api/recruiting/apply/:requisitionId", async (req: Request, res: Response) => {
    try {
      const { requisitionId } = req.params;
      const { firstName, lastName, email, phone, city, state, notes, consentSms, consentEmail } = req.body;

      if (!firstName || !lastName || !email) {
        return res.status(400).json({ message: "firstName, lastName, and email are required" });
      }

      const { 
        createCandidate, 
        findCandidateByEmailOrPhone, 
        createApplication, 
        getRequisition 
      } = await import("./recruitingService");

      const requisition = await getRequisition(requisitionId);
      if (!requisition) {
        return res.status(404).json({ message: "Requisition not found" });
      }

      if (requisition.status !== 'open') {
        return res.status(400).json({ message: "This position is not currently accepting applications" });
      }

      let candidate = await findCandidateByEmailOrPhone(email, phone);
      
      if (!candidate) {
        candidate = await createCandidate({
          firstName,
          lastName,
          email,
          phone,
          city,
          state,
          notes,
          source: 'website',
        }, null, null);
      }

      const application = await createApplication({
        candidateId: candidate.id,
        requisitionId,
        internalNotes: consentSms ? 'Consented to SMS' : undefined,
      }, null, null);

      res.status(201).json({ 
        success: true, 
        applicationId: application.id,
        message: "Application submitted successfully" 
      });
    } catch (error: any) {
      console.error("[Recruiting] Error processing application:", error);
      if (error.message?.includes("already exists")) {
        return res.status(400).json({ message: "You have already applied for this position" });
      }
      res.status(500).json({ message: "Failed to submit application" });
    }
  });

  // ============================================================================

      if (error.message?.startsWith("Invalid authorization type")) {
        return res.status(400).json({ message: error.message });
      }
      res.status(500).json({ message: "Failed to update candidate" });
    }
  });

  // GET /api/recruiting/job-feed/status - Job feed status for UI
  app.get("/api/recruiting/job-feed/status", async (req: Request, res: Response) => {
    // Check session-based authentication
    const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
    if (!userId) {
      return res.status(401).json({ message: "Authentication required" });
    }
    
    try {
      // Count open requisitions
      const openCount = await db.select({ count: sql<number>`count(*)::int` })
        .from(jobRequisitions)
        .where(
          or(
            eq(jobRequisitions.status, 'open'),
            eq(jobRequisitions.status, 'approved')
          )
        );
      
      const totalOpenJobs = openCount[0]?.count ?? 0;
      const lastRefreshed = new Date().toISOString();
      const baseUrl = `${req.protocol}://${req.get('host')}`;
      const feedUrl = `${baseUrl}/api/public/job-feed`;
      
      res.json({
        lastRefreshed,
        totalOpenJobs,
        feedUrl
      });
    } catch (error) {
      console.error('[Job Feed Status] Error:', error);
      res.status(500).json({ message: "Failed to get job feed status" });
    }
  });

  // GET /api/recruiting/requisitions - List requisitions with filters (market-isolated)
  app.get("/api/recruiting/requisitions", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Get user's recruiting permissions and authorized markets
      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });
      const recruitingContext = await getUserRecruitingContext(userId, user?.role || "");
      
      // Check read permission
      if (!hasPermission(recruitingContext, "read")) {
        return res.status(403).json({ message: "No permission to view requisitions" });
      }

      const { market, status, limit, offset, includeArchived } = req.query;
      const { getRequisitions } = await import("./recruitingService");

      // Pass authorized markets for filtering (null = admin access, [] = no access)
      const authorizedMarkets = recruitingContext.isAdmin ? null : recruitingContext.authorizedMarkets;

      const result = await getRequisitions({
        market: market as string | undefined,
        status: status as string | undefined,
        limit: limit ? parseInt(limit as string) : undefined,
        offset: offset ? parseInt(offset as string) : undefined,
        authorizedMarkets,
      });

      res.json(result);
    } catch (error) {
      console.error("[Recruiting] Error fetching requisitions:", error);
      res.status(500).json({ message: "Failed to fetch requisitions" });
    }
  });
  // POST /api/recruiting/requisitions - Create a new requisition
  app.post("/api/recruiting/requisitions", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      const { createRequisition, getDefaultWorkflow } = await import("./recruitingService");
      
      const data = { ...req.body };
      if (!data.workflowId) {
        const defaultWorkflow = await getDefaultWorkflow();
        if (defaultWorkflow) {
          data.workflowId = defaultWorkflow.id;
        }
      }

      const requisition = await createRequisition(data, userId, user?.email || null);

      res.status(201).json(requisition);
    } catch (error) {
      console.error("[Recruiting] Error creating requisition:", error);
      res.status(500).json({ message: "Failed to create requisition" });
    }
  });


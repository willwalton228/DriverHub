  // Request background check for an application
  app.post("/api/recruiting/applications/:id/background-check", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { requestBackgroundCheck } = await import("./services/backgroundCheckService");
      const { provider, candidateInfo, checkType } = req.body;

      if (!provider) {
        return res.status(400).json({ message: "Provider is required" });
      }
      if (!candidateInfo || !candidateInfo.firstName || !candidateInfo.lastName || !candidateInfo.email) {
        return res.status(400).json({ message: "Candidate info (firstName, lastName, email) is required" });
      }

      const result = await requestBackgroundCheck(
        req.params.id,
        provider,
        candidateInfo,
        checkType || 'standard',
        userId
      );

      if (!result.success) {
        return res.status(400).json({ message: result.error });
      }

      res.json({ success: true, checkId: result.checkId });
    } catch (error: any) {
      console.error("[BackgroundCheck] Error requesting check:", error);
      res.status(500).json({ message: "Failed to request background check" });
    }
  });


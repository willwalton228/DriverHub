  // POST /api/recruiting/kill-switches/toggle - Toggle a kill switch (admin only)
  app.post("/api/recruiting/kill-switches/toggle", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }

      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      if (!user || !["admin", "super_user", "recruiting_admin"].includes(user.role || "")) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { key, isActive, scope, market } = req.body;

      const { KILL_SWITCH_KEYS, KILL_SWITCH_DEFAULTS } = await import("./services/recruitingKillSwitch");
      const validKeys = Object.values(KILL_SWITCH_KEYS);
      if (!validKeys.includes(key)) {
        return res.status(400).json({ message: `Invalid kill switch key. Must be one of: ${validKeys.join(', ')}` });
      }
      if (!["global", "market"].includes(scope)) {
        return res.status(400).json({ message: "Scope must be 'global' or 'market'" });
      }
      if (scope === "market" && !market) {
        return res.status(400).json({ message: "Market is required for market-scoped kill switches" });
      }

      const defaults = KILL_SWITCH_DEFAULTS[key];
      const flagMarket = scope === "market" ? market : null;

      const [existing] = await db.select()
        .from(recruitingFeatureFlags)
        .where(and(
          eq(recruitingFeatureFlags.flagKey, key),
          scope === "global" 
            ? eq(recruitingFeatureFlags.scope, "global")
            : and(eq(recruitingFeatureFlags.scope, "market"), eq(recruitingFeatureFlags.market, flagMarket!))
        ));

      if (existing) {
        const [updated] = await db.update(recruitingFeatureFlags)
          .set({
            isEnabled: isActive,
            updatedAt: new Date(),
            updatedByEmail: user.email,
          })
          .where(eq(recruitingFeatureFlags.id, existing.id))
          .returning();
        
        console.log(`[KillSwitch] ${isActive ? 'ACTIVATED' : 'DEACTIVATED'} ${key} (${scope}${flagMarket ? ': ' + flagMarket : ''}) by ${user.email}`);
        res.json({ success: true, flag: updated, action: isActive ? "activated" : "deactivated" });
      } else {
        const [created] = await db.insert(recruitingFeatureFlags)
          .values({
            flagKey: key,
            name: defaults.name,
            description: defaults.description,
            warningMessage: defaults.warningMessage,
            scope: scope as "global" | "market",
            market: flagMarket,
            isEnabled: isActive,
            isMvpFeature: false,
            requiresExplicitEnable: false,
            createdByEmail: user.email,
            updatedByEmail: user.email,
          })
          .returning();
        
        console.log(`[KillSwitch] CREATED and ${isActive ? 'ACTIVATED' : 'DEACTIVATED'} ${key} (${scope}${flagMarket ? ': ' + flagMarket : ''}) by ${user.email}`);
        res.json({ success: true, flag: created, action: isActive ? "activated" : "deactivated" });
      }
    } catch (error: any) {
      console.error("Error toggling kill switch:", error);
      res.status(500).json({ message: "Failed to toggle kill switch" });
    }
  });

  // GET /api/recruiting/kill-switches/audit-log - Get kill switch change history (admin only)
  app.get("/api/recruiting/kill-switches/audit-log", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }

      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      if (!user || !["admin", "super_user", "recruiting_admin"].includes(user.role || "")) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { KILL_SWITCH_KEYS } = await import("./services/recruitingKillSwitch");
      const killSwitchKeys = Object.values(KILL_SWITCH_KEYS);

      const flags = await db.select()
        .from(recruitingFeatureFlags)
        .where(
          sql`${recruitingFeatureFlags.flagKey} = ANY(${killSwitchKeys})`
        )
        .orderBy(desc(recruitingFeatureFlags.updatedAt));

      res.json(flags);
    } catch (error: any) {
      console.error("Error fetching kill switch audit log:", error);
      res.status(500).json({ message: "Failed to fetch audit log" });
    }
  });

  // PATCH /api/recruiting/candidates/:id/communication-preferences - Update candidate communication preferences
  app.patch("/api/recruiting/candidates/:id/communication-preferences", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Recruiting access required" });
      }

      const { id } = req.params;
      
      const [existing] = await db.select().from(recruitingCandidates).where(eq(recruitingCandidates.id, id));
      
      if (!existing) {
        return res.status(404).json({ message: "Candidate not found" });
      }

      const { preferredChannel, contactHoursStart, contactHoursEnd, contactTimezone, doNotContact, doNotContactReason } = req.body;
      
      const updateData: any = {
        updatedAt: new Date(),
        updatedBy: user.id,
      };
      
      if (preferredChannel !== undefined) updateData.preferredChannel = preferredChannel;
      if (contactHoursStart !== undefined) updateData.contactHoursStart = contactHoursStart;
      if (contactHoursEnd !== undefined) updateData.contactHoursEnd = contactHoursEnd;
      if (contactTimezone !== undefined) updateData.contactTimezone = contactTimezone;
      if (doNotContact !== undefined) {
        updateData.doNotContact = doNotContact;
        if (doNotContact) {
          updateData.doNotContactSetAt = new Date();
          updateData.doNotContactSetBy = user.id;
          updateData.doNotContactReason = doNotContactReason || null;
        } else {
          updateData.doNotContactSetAt = null;
          updateData.doNotContactSetBy = null;
          updateData.doNotContactReason = null;
        }
      }

      const [updated] = await db.update(recruitingCandidates)
        .set(updateData)
        .where(eq(recruitingCandidates.id, id))
        .returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "COMM_PREFERENCES_UPDATED",
        entityType: "candidate",
        entityId: id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        previousValue: JSON.stringify({
          preferredChannel: existing.preferredChannel,
          contactHoursStart: existing.contactHoursStart,
          contactHoursEnd: existing.contactHoursEnd,
          contactTimezone: existing.contactTimezone,
          doNotContact: existing.doNotContact,
          doNotContactReason: existing.doNotContactReason,
        }),
        newValue: JSON.stringify({
          preferredChannel: updated.preferredChannel,
          contactHoursStart: updated.contactHoursStart,
          contactHoursEnd: updated.contactHoursEnd,
          contactTimezone: updated.contactTimezone,
          doNotContact: updated.doNotContact,
          doNotContactReason: updated.doNotContactReason,
        }),
      });

      res.json(updated);
    } catch (error: any) {
      console.error("Error updating communication preferences:", error);
      res.status(500).json({ message: "Failed to update communication preferences" });
    }
  });

  // PATCH /api/recruiting/candidates/:id/language-preference - Update candidate language preference
  app.patch("/api/recruiting/candidates/:id/language-preference", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Recruiting access required" });
      }

      const { id } = req.params;
      const { languagePreference } = req.body;
      
      if (!languagePreference) {
        return res.status(400).json({ message: "Language preference is required" });
      }
      
      // Validate language is supported
      const { supportedLanguages } = await import("@shared/schema");
      if (!supportedLanguages.includes(languagePreference)) {
        return res.status(400).json({ 
          message: "Unsupported language",
          supportedLanguages: supportedLanguages,
        });
      }
      
      const [existing] = await db.select().from(recruitingCandidates).where(eq(recruitingCandidates.id, id));
      
      if (!existing) {
        return res.status(404).json({ message: "Candidate not found" });
      }

      const previousLanguage = existing.languagePreference || "en";
      
      // Skip update if same value
      if (previousLanguage === languagePreference) {
        return res.json(existing);
      }

      const [updated] = await db.update(recruitingCandidates)
        .set({
          languagePreference,
          languagePreferenceSetAt: new Date(),
          languagePreferenceSetBy: user.id,
          updatedAt: new Date(),
          updatedBy: user.id,
        })
        .where(eq(recruitingCandidates.id, id))
        .returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "LANGUAGE_PREFERENCE_CHANGED",
        entityType: "candidate",
        entityId: id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        previousValue: JSON.stringify({ languagePreference: previousLanguage }),
        newValue: JSON.stringify({ languagePreference: updated.languagePreference }),
      });

      res.json(updated);
    } catch (error: any) {
      console.error("Error updating language preference:", error);
      res.status(500).json({ message: "Failed to update language preference" });
    }
  });


      const [event] = await db.select()
        .from(ingestedEvents)
        .where(and(
          eq(ingestedEvents.eventId, eventId),
          eq(ingestedEvents.processingStatus, "dlq")
        ))
        .limit(1);

      if (!event) {
        return res.status(404).json({ message: "DLQ event not found" });
      }

      await db.update(ingestedEvents)
        .set({
          processingStatus: "received",
          retryCount: 0,
          lastError: null,
        })
        .where(eq(ingestedEvents.eventId, eventId));

      console.log(`[Processing] Event ${eventId} requeued from DLQ by user ${userId}`);
      res.json({ message: "Event requeued successfully", eventId });
    } catch (error) {
      console.error("[Processing] Error requeuing event:", error);
      res.status(500).json({ message: "Failed to requeue event" });
    }
  });


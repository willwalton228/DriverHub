      }
      const { customerId, chargeIds, invoiceData } = req.body;
      if (!customerId || !chargeIds || !Array.isArray(chargeIds) || chargeIds.length < 2) {
        return res.status(400).json({ message: "customerId and at least 2 chargeIds are required" });
      }
      const result = await storage.consolidateCharges(customerId, chargeIds, invoiceData || {}, req.user.claims.sub);
      res.json(result);
    } catch (error: any) {
      res.status(400).json({ message: error.message || "Failed to consolidate charges" });
    }
  });


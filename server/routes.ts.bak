  // Create expansion or renewal task
  app.post("/api/accounts/:id/opportunity-task", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const taskSchema = z.object({
        taskType: z.enum(['expansion', 'renewal']),
        opportunityDetails: z.string().optional().default(''),
      });

      const parseResult = taskSchema.safeParse(req.body);
      if (!parseResult.success) {
        return res.status(400).json({ message: "Validation failed", errors: parseResult.error.errors });
      }

      const { taskType, opportunityDetails } = parseResult.data;
      const event = await storage.createOpportunityTask(
        req.params.id,
        taskType,
        opportunityDetails,
        currentUser?.id || currentUserId
      );

      res.status(201).json({
        message: `${taskType === 'expansion' ? 'Expansion' : 'Renewal'} task created`,
        event,
      });
    } catch (error) {
      console.error("Error creating opportunity task:", error);
      res.status(500).json({ message: "Failed to create opportunity task" });
    }
  });


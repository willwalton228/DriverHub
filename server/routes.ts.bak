      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user' && user.role !== 'recruiter' && user.role !== 'hiring_manager')) {
        return res.status(403).json({ message: "Forbidden: Recruiter, Hiring Manager, or Admin access required" });
      }

      const { recruitingNotesService } = await import("./services/recruitingNotesService");
      const { noteId } = req.params;
      const { body, mentionedUserIds, visibility } = req.body;

      const note = await recruitingNotesService.updateNote(
        noteId,
        { body, mentionedUserIds, visibility },
        userId,
        user.email || ''
      );

      res.json(note);
    } catch (error: any) {
      console.error("Error updating note:", error);
      if (error.message === 'Note not found') {
        return res.status(404).json({ message: "Note not found" });
      }
      res.status(500).json({ message: "Failed to update note" });
    }
  });


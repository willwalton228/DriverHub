  // =============================================
  // RECRUITER ASSIGNMENT RULES v2 - Skill/Market Matching
  // =============================================

  app.get("/api/recruiting/skill-tags", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });
      const user = await storage.getUser(userId);
      if (!user || !["admin", "super_user", "recruiting_admin", "recruiter"].includes(user.role || "")) {
        return res.status(403).json({ message: "Access denied" });
      }
      const { recruiterSkillTags } = await import("@shared/schema");
      const tags = await db.select().from(recruiterSkillTags).orderBy(recruiterSkillTags.name);
      res.json(tags);
    } catch (error: any) {
      console.error("[SkillTags] Error listing:", error);
      res.status(500).json({ message: "Failed to list skill tags" });
    }
  });

  app.post("/api/recruiting/skill-tags", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });
      const user = await storage.getUser(userId);
      if (!user || !["admin", "super_user", "recruiting_admin"].includes(user.role || "")) {
        return res.status(403).json({ message: "Admin access required" });
      }
      const { recruiterSkillTags } = await import("@shared/schema");
      const { name, description, category } = req.body;
      if (!name || !name.trim()) return res.status(400).json({ message: "Name is required" });
      const [tag] = await db.insert(recruiterSkillTags).values({
        name: name.trim(),
        description: description || null,
        category: category || null,
        createdBy: userId,
      }).returning();
      res.json(tag);
    } catch (error: any) {
      if (error.code === "23505") return res.status(409).json({ message: "A skill tag with this name already exists" });
      console.error("[SkillTags] Error creating:", error);
      res.status(500).json({ message: "Failed to create skill tag" });
    }
  });

  app.patch("/api/recruiting/skill-tags/:id", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });
      const user = await storage.getUser(userId);
      if (!user || !["admin", "super_user", "recruiting_admin"].includes(user.role || "")) {
        return res.status(403).json({ message: "Admin access required" });
      }
      const { recruiterSkillTags } = await import("@shared/schema");
      const { eq } = await import("drizzle-orm");
      const updates: any = { updatedAt: new Date() };
      if (req.body.name !== undefined) updates.name = req.body.name.trim();
      if (req.body.description !== undefined) updates.description = req.body.description;
      if (req.body.category !== undefined) updates.category = req.body.category;
      if (req.body.isActive !== undefined) updates.isActive = req.body.isActive;
      const [updated] = await db.update(recruiterSkillTags).set(updates).where(eq(recruiterSkillTags.id, req.params.id)).returning();
      if (!updated) return res.status(404).json({ message: "Skill tag not found" });
      res.json(updated);
    } catch (error: any) {
      if (error.code === "23505") return res.status(409).json({ message: "A skill tag with this name already exists" });
      console.error("[SkillTags] Error updating:", error);
      res.status(500).json({ message: "Failed to update skill tag" });
    }
  });

  app.delete("/api/recruiting/skill-tags/:id", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });
      const user = await storage.getUser(userId);
      if (!user || !["admin", "super_user"].includes(user.role || "")) {
        return res.status(403).json({ message: "Admin access required" });
      }
      const { recruiterSkillTags } = await import("@shared/schema");
      const { eq } = await import("drizzle-orm");
      const [deleted] = await db.delete(recruiterSkillTags).where(eq(recruiterSkillTags.id, req.params.id)).returning();
      if (!deleted) return res.status(404).json({ message: "Skill tag not found" });
      res.json({ success: true });
    } catch (error: any) {
      console.error("[SkillTags] Error deleting:", error);
      res.status(500).json({ message: "Failed to delete skill tag" });
    }
  });

  app.get("/api/recruiting/recruiter-skills/:userId", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });
      const user = await storage.getUser(userId);
      if (!user || !["admin", "super_user", "recruiting_admin", "recruiter"].includes(user.role || "")) {
        return res.status(403).json({ message: "Access denied" });
      }
      if (user.role === "recruiter" && req.params.userId !== userId) {
        return res.status(403).json({ message: "Recruiters can only view their own skills" });
      }
      const { recruiterSkills, recruiterSkillTags } = await import("@shared/schema");
      const { eq } = await import("drizzle-orm");
      const skills = await db.select({
        id: recruiterSkills.id,
        userId: recruiterSkills.userId,
        skillTagId: recruiterSkills.skillTagId,
        proficiencyLevel: recruiterSkills.proficiencyLevel,
        createdAt: recruiterSkills.createdAt,
        tagName: recruiterSkillTags.name,
        tagCategory: recruiterSkillTags.category,
      }).from(recruiterSkills)
        .innerJoin(recruiterSkillTags, eq(recruiterSkills.skillTagId, recruiterSkillTags.id))
        .where(eq(recruiterSkills.userId, req.params.userId));
      res.json(skills);
    } catch (error: any) {
      console.error("[RecruiterSkills] Error listing:", error);
      res.status(500).json({ message: "Failed to list recruiter skills" });
    }
  });

  app.post("/api/recruiting/recruiter-skills", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });
      const user = await storage.getUser(userId);
      if (!user || !["admin", "super_user", "recruiting_admin"].includes(user.role || "")) {
        return res.status(403).json({ message: "Admin access required" });
      }
      const { recruiterSkills } = await import("@shared/schema");
      const { targetUserId, skillTagId, proficiencyLevel } = req.body;
      if (!targetUserId || !skillTagId) return res.status(400).json({ message: "userId and skillTagId are required" });
      const [skill] = await db.insert(recruiterSkills).values({
        userId: targetUserId,
        skillTagId,
        proficiencyLevel: proficiencyLevel || 1,
        assignedBy: userId,
      }).returning();
      res.json(skill);
    } catch (error: any) {
      if (error.code === "23505") return res.status(409).json({ message: "This skill is already assigned to the recruiter" });
      console.error("[RecruiterSkills] Error assigning:", error);
      res.status(500).json({ message: "Failed to assign skill" });
    }
  });

  app.delete("/api/recruiting/recruiter-skills/:id", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;

  // GET /api/risp/controls - Get all RISP controls
  app.get("/api/risp/controls", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Most users can read controls (read-only for non-admins)
      const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);
      if (!user) {
        const [userByEmail] = await db.select().from(users)
          .where(eq(users.email, (req as any).user?.claims?.email || ''))
          .limit(1);
        if (!userByEmail) {
          return res.status(403).json({ message: "Access denied" });
        }
      }

      const { activeOnly } = req.query;
      let query = db.select().from(rispControls);
      
      if (activeOnly === 'true') {
        query = query.where(eq(rispControls.isActive, true)) as any;
      }

      const controls = await query.orderBy(rispControls.controlId);
      res.json({ controls });
    } catch (error) {
      console.error("[RISP] Error fetching controls:", error);
      res.status(500).json({ message: "Failed to fetch RISP controls" });
    }
  });

  // GET /api/risp/controls/:controlId - Get a specific RISP control with links
  app.get("/api/risp/controls/:controlId", async (req: Request, res: Response) => {
    try {

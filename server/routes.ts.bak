  // Create collections note
  app.post("/api/corporate/collections/notes", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const noteSchema = z.object({
        customerId: z.string().optional(),
        invoiceId: z.string().optional(),
        noteType: z.string().default('general'),
        content: z.string().min(1, "Note content is required"),
        assignedToUserId: z.string().optional(),
        followUpDate: z.string().optional(),
        suggestedAction: z.string().optional(),
      });
      
      const validatedData = noteSchema.parse(req.body);
      
      const note = await storage.createCollectionsNote({
        ...validatedData,
        createdBy: req.user.claims.sub,
      });
      
      res.status(201).json(note);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error creating collections note:", error);
      res.status(500).json({ message: "Failed to create collections note" });
    }
  });

  // Update collections note
  app.patch("/api/corporate/collections/notes/:noteId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const updateSchema = z.object({
        content: z.string().optional(),
        assignedToUserId: z.string().nullable().optional(),
        followUpDate: z.string().nullable().optional(),
        followUpCompleted: z.boolean().optional(),
        actionTaken: z.string().optional(),
      });
      
      const validatedData = updateSchema.parse(req.body);
      
      // If marking as completed, set the completion timestamp
      const updates: any = { ...validatedData };
      if (validatedData.followUpCompleted) {
        updates.followUpCompletedAt = new Date();
      }
      if (validatedData.actionTaken) {
        updates.actionTakenAt = new Date();
      }
      
      const note = await storage.updateCollectionsNote(req.params.noteId, updates);
      if (!note) {
        return res.status(404).json({ message: "Note not found" });
      }
      
      res.json(note);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error updating collections note:", error);
      res.status(500).json({ message: "Failed to update collections note" });
    }
  });


  app.post("/api/corporate/scheduling/shifts", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const schedPerm = await resolveSchedulingPermission(user!.id, user?.role, req.body.locationId);
      if (!hasSchedulingPermission(schedPerm, 'edit')) return res.status(403).json({ message: 'Insufficient scheduling permission: edit required' });
      const shiftData = {
        ...req.body,
        createdBy: req.user.claims.sub,
        startTime: req.body.startTime ? new Date(req.body.startTime) : null,
        endTime: req.body.endTime ? new Date(req.body.endTime) : null,
      };
      const shift = await storage.createShift(shiftData);
      await logSchedulingAudit({ actorUserId: user!.id, actionType: 'shift_created', entityType: 'shift', entityId: shift.id, locationId: req.body.locationId, newData: shift, ipAddress: req.ip, userAgent: req.get('user-agent') });
      res.json(shift);
    } catch (error) {
      console.error("Error creating shift:", error);
      res.status(500).json({ message: "Failed to create shift" });
    }
  });

  app.patch("/api/corporate/scheduling/shifts/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const schedPerm = await resolveSchedulingPermission(user!.id, user?.role, req.body.locationId);
      if (!hasSchedulingPermission(schedPerm, 'edit')) return res.status(403).json({ message: 'Insufficient scheduling permission: edit required' });
      const existingShift = await storage.getShiftWithAssignments(req.params.id);
      const shift = await storage.updateShift(req.params.id, req.body);
      await logSchedulingAudit({ actorUserId: user!.id, actionType: 'shift_updated', entityType: 'shift', entityId: req.params.id, locationId: req.body.locationId || existingShift?.locationId, previousData: existingShift, newData: shift, ipAddress: req.ip, userAgent: req.get('user-agent') });
      res.json(shift);
    } catch (error) {
      console.error("Error updating shift:", error);
      res.status(500).json({ message: "Failed to update shift" });
    }
  });


  // Seed Test Data for Pay Period (Admin only)
  // Creates a test pay period with 5 demo moves (PASS/WARN/FAIL eligibility statuses)
  app.post("/api/payroll/seed-test-data", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role;
      
      // Admin-only access
      if (!currentUser || (role !== "super_user" && role !== "admin")) {
        return res.status(403).json({ 
          message: "Admin access required to seed test data",
          code: 'ADMIN_REQUIRED',
        });
      }

      // Create a test pay period for the current week
      const today = new Date();
      const weekStart = new Date(today);
      weekStart.setDate(today.getDate() - today.getDay()); // Start of week (Sunday)
      const weekEnd = new Date(weekStart);
      weekEnd.setDate(weekStart.getDate() + 6); // End of week (Saturday)

      const testPayPeriod = await storage.createPayPeriod({
        payGroup: `TEST_${Date.now()}`,
        periodType: 'WEEKLY',
        periodStart: weekStart.toISOString().split('T')[0],
        periodEnd: weekEnd.toISOString().split('T')[0],
        status: 'OPEN',
        createdBy: currentUserId,
      });

      // Get a driver to assign moves to (or create demo moves without driver)
      const driversWithUsers = await storage.getAllDriversWithUsers();
      const testDriverId = driversWithUsers[0]?.id || null;

      // Create 5 demo moves with different eligibility statuses
      const demoMoves = [
        {
          moveNumber: `TEST-PASS-${Date.now()}-1`,
          driverId: testDriverId,
          tripDate: new Date(),
          origin: 'Dallas, TX',
          destination: 'Houston, TX',
          distance: '239.00',
          status: 'completed',
          payRate: '150.00',
          billRate: '200.00',
          eligibilityStatus: 'PASS',
          eligibilityReasons: [],
          eligibilityCheckedAt: new Date(),
          eligibilityPolicyVersionId: 'v25b.1',
          ingestSource: 'MANUAL',
          ingestedAt: new Date(),
          ingestedBy: `system:seed-test-data`,
        },
        {
          moveNumber: `TEST-PASS-${Date.now()}-2`,
          driverId: testDriverId,
          tripDate: new Date(),
          origin: 'Austin, TX',
          destination: 'San Antonio, TX',
          distance: '80.00',
          status: 'completed',
          payRate: '75.00',
          billRate: '100.00',
          eligibilityStatus: 'PASS',
          eligibilityReasons: [],
          eligibilityCheckedAt: new Date(),
          eligibilityPolicyVersionId: 'v25b.1',
          ingestSource: 'MANUAL',
          ingestedAt: new Date(),
          ingestedBy: `system:seed-test-data`,
        },
        {
          moveNumber: `TEST-WARN-${Date.now()}-3`,
          driverId: testDriverId,
          tripDate: new Date(),
          origin: 'Fort Worth, TX',
          destination: 'Waco, TX',
          distance: '95.00',
          status: 'completed',
          payRate: '85.00',
          billRate: '120.00',
          eligibilityStatus: 'WARN',
          eligibilityReasons: ['Work type mismatch: driver not eligible for ON_DEMAND'],
          eligibilityCheckedAt: new Date(),
          eligibilityPolicyVersionId: 'v25b.1',
          ingestSource: 'MANUAL',
          ingestedAt: new Date(),
          ingestedBy: `system:seed-test-data`,
        },
        {
          moveNumber: `TEST-FAIL-${Date.now()}-4`,
          driverId: testDriverId,
          tripDate: new Date(),
          origin: 'El Paso, TX',
          destination: 'Midland, TX',
          distance: '300.00',
          status: 'completed',
          payRate: '200.00',
          billRate: '280.00',
          eligibilityStatus: 'FAIL',
          eligibilityReasons: ['Driver safety state is SUSPENDED', 'Active block on driver'],
          eligibilityCheckedAt: new Date(),
          eligibilityPolicyVersionId: 'v25b.1',
          ingestSource: 'MANUAL',
          ingestedAt: new Date(),
          ingestedBy: `system:seed-test-data`,
        },
        {
          moveNumber: `TEST-PASS-${Date.now()}-5`,
          driverId: testDriverId,
          tripDate: new Date(),
          origin: 'Lubbock, TX',
          destination: 'Amarillo, TX',
          distance: '123.00',
          status: 'completed',
          payRate: '100.00',
          billRate: '140.00',
          eligibilityStatus: 'PASS',
          eligibilityReasons: [],
          eligibilityCheckedAt: new Date(),
          eligibilityPolicyVersionId: 'v25b.1',
          ingestSource: 'MANUAL',
          ingestedAt: new Date(),
          ingestedBy: `system:seed-test-data`,
        },
      ];

      const createdMoves = [];
      for (const move of demoMoves) {
        const created = await storage.createTrip(move as any);
        createdMoves.push(created);
      }

      res.json({
        success: true,
        payPeriod: testPayPeriod,
        moves: createdMoves,
        summary: {
          passCount: 3,
          warnCount: 1,
          failCount: 1,
        },
      });

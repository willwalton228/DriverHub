  // GET /api/program-execution-flags - Get all program execution flags (read-only for Ops Console)
  app.get("/api/program-execution-flags", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { programId, opsConsole } = req.query;

      const { getProgramExecutionFlagsForOpsConsole, getProgramExecutionFlagsForProgram } = 
        await import("./programExecutionFlagsService");

      if (programId && typeof programId === 'string') {
        const flags = await getProgramExecutionFlagsForProgram(programId);
        return res.json(flags);
      }

      if (opsConsole === "true") {
        const data = await getProgramExecutionFlagsForOpsConsole();
        return res.json(data);
      }

      const data = await getProgramExecutionFlagsForOpsConsole();
      res.json(data);
    } catch (error) {
      console.error("[Program Flags] Error fetching execution flags:", error);
      res.status(500).json({ message: "Failed to fetch program execution flags" });
    }
  });


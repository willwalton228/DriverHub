      const settings = await storage.upsertQuickbooksSettings({
        isConnected: false,
        accessToken: null,
        refreshToken: null,
        tokenExpiresAt: null,
        realmId: null,
        connectionError: null,
        updatedBy: req.user.claims.sub,
      });
      
      const { accessToken, refreshToken, ...safeSettings } = settings;
      res.json({ ...safeSettings, hasTokens: false, message: "QuickBooks disconnected successfully" });
    } catch (error) {
      console.error("Error disconnecting QuickBooks:", error);
      res.status(500).json({ message: "Failed to disconnect QuickBooks" });
    }
  });

  // Sync single invoice to QuickBooks
  app.post("/api/corporate/invoicing/invoices/:id/sync-quickbooks", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const settings = await storage.getQuickbooksSettings();
      if (!settings?.isConnected) {
        return res.status(400).json({ message: "QuickBooks is not connected" });
      }
      
      const invoice = await storage.getInvoice(req.params.id);
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }
      
      // Update sync status to processing
      await storage.updateQuickbooksSyncStatus('invoice', req.params.id, 'processing');
      
      try {
        // Simulate QuickBooks sync (in production, call QuickBooks API)
        const qbInvoiceId = `QB_INV_${Date.now()}`;
        
        // Mark as synced
        await storage.updateQuickbooksSyncStatus('invoice', req.params.id, 'synced', undefined, qbInvoiceId);
        
        res.json({ 
          success: true, 
          qbInvoiceId,
          message: "Invoice synced to QuickBooks successfully" 
        });
      } catch (syncError: any) {
        // Mark as failed
        await storage.updateQuickbooksSyncStatus('invoice', req.params.id, 'failed', syncError.message);
        throw syncError;
      }
    } catch (error: any) {
      console.error("Error syncing invoice to QuickBooks:", error);
      res.status(500).json({ message: error.message || "Failed to sync invoice to QuickBooks" });
    }
  });

  // Sync single payment to QuickBooks
  app.post("/api/corporate/invoicing/payments/:id/sync-quickbooks", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const settings = await storage.getQuickbooksSettings();
      if (!settings?.isConnected) {
        return res.status(400).json({ message: "QuickBooks is not connected" });
      }
      
      // Update sync status to processing
      await storage.updateQuickbooksSyncStatus('payment', req.params.id, 'processing');
      
      try {
        // Simulate QuickBooks sync
        const qbPaymentId = `QB_PMT_${Date.now()}`;
        
        await storage.updateQuickbooksSyncStatus('payment', req.params.id, 'synced', undefined, qbPaymentId);
        
        res.json({ 
          success: true, 
          qbPaymentId,
          message: "Payment synced to QuickBooks successfully" 
        });
      } catch (syncError: any) {
        await storage.updateQuickbooksSyncStatus('payment', req.params.id, 'failed', syncError.message);
        throw syncError;
      }
    } catch (error: any) {
      console.error("Error syncing payment to QuickBooks:", error);
      res.status(500).json({ message: error.message || "Failed to sync payment to QuickBooks" });
    }
  });

  // Batch sync invoices to QuickBooks
  app.post("/api/corporate/integrations/quickbooks/batch-sync", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const settings = await storage.getQuickbooksSettings();
      if (!settings?.isConnected) {
        return res.status(400).json({ message: "QuickBooks is not connected" });
      }
      
      const { startDate, endDate, entityTypes } = qbBatchSyncSchema.parse(req.body);
      
      const types = entityTypes || ['invoice', 'payment'];
      const results = { queued: 0, invoices: 0, payments: 0 };
      
      // Queue invoices for sync
      if (types.includes('invoice')) {
        const invoicesResult = await db.select({ id: invoices.id })
          .from(invoices)
          .where(and(
            gte(invoices.invoiceDate, startDate),
            lte(invoices.invoiceDate, endDate),
            or(
              isNull(invoices.qbSyncStatus),
              eq(invoices.qbSyncStatus, 'not_queued'),
              eq(invoices.qbSyncStatus, 'failed')
            )
          ));
        
        for (const inv of invoicesResult) {
          await storage.queueQuickbooksSync('invoice', inv.id, 'sync', req.user.claims.sub);
          results.invoices++;
        }
        results.queued += results.invoices;
      }
      
      // Queue payments for sync
      if (types.includes('payment')) {
        const paymentsResult = await db.select({ id: payments.id })
          .from(payments)
          .where(and(
            gte(payments.paymentDate, startDate),
            lte(payments.paymentDate, endDate),
            or(
              isNull(payments.qbSyncStatus),
              eq(payments.qbSyncStatus, 'not_queued'),
              eq(payments.qbSyncStatus, 'failed')
            )
          ));
        
        for (const pmt of paymentsResult) {
          await storage.queueQuickbooksSync('payment', pmt.id, 'sync', req.user.claims.sub);
          results.payments++;
        }
        results.queued += results.payments;
      }
      
      res.json({ 
        success: true, 
        message: `Queued ${results.queued} items for sync`,
        ...results
      });
    } catch (error) {
      console.error("Error batch syncing to QuickBooks:", error);
      res.status(500).json({ message: "Failed to batch sync to QuickBooks" });
    }
  });

  // Get sync queue status
  app.get("/api/corporate/integrations/quickbooks/sync-queue", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const status = req.query.status as string | undefined;
      const queue = await storage.getQuickbooksSyncQueue(status);
      res.json(queue);
    } catch (error) {
      console.error("Error fetching sync queue:", error);
      res.status(500).json({ message: "Failed to fetch sync queue" });
    }
  });

  // Retry failed sync
  app.post("/api/corporate/integrations/quickbooks/retry/:queueId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      // Update queue item to retry
      await db.update(integrationQueue)
        .set({ 
          status: 'queued', 
          retryCount: sql`retry_count + 1`,
          nextAttemptAt: new Date(),
          updatedAt: new Date()
        })
        .where(eq(integrationQueue.id, req.params.queueId));
      
      res.json({ success: true, message: "Sync queued for retry" });
    } catch (error) {
      console.error("Error retrying sync:", error);
      res.status(500).json({ message: "Failed to retry sync" });
    }
  });

  // Payment Retry Config validation schemas
  const paymentRetryConfigSchema = z.object({
    orgId: z.string().optional(),
    paymentMethod: z.enum(['credit_card', 'ach']),
    retryScheduleDays: z.array(z.number().int().positive()).min(1),
    maxRetries: z.number().int().min(1).max(10),
    sendFailureEmail: z.boolean().optional().default(true),
    sendRetryNotice: z.boolean().optional().default(true),
    includePayLink: z.boolean().optional().default(true),
    autoRetry: z.boolean().optional().default(true),
    escalateToCollections: z.boolean().optional().default(false),
    markInvoiceOverdue: z.boolean().optional().default(true),
  });

  const recordPaymentFailureSchema = z.object({
    failureCode: z.string().optional(),
    failureMessage: z.string().optional(),
    paymentMethod: z.enum(['credit_card', 'ach']).optional(),
  });

  const scheduleRetrySchema = z.object({
    retryAt: z.string().refine(val => !isNaN(Date.parse(val)), { message: 'Invalid date format' }),
    attemptNumber: z.number().int().positive().optional(),
  });

  // ==========================================

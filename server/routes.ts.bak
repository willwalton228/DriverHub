    }
  });
  
  app.patch("/api/carrier/narratives/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser || currentUser.role !== 'admin') {
        return res.status(403).json({ message: "Admin access required to edit narratives" });
      }
      
      const updateSchema = z.object({
        editedContent: z.string().optional(),
        status: z.enum(['DRAFT', 'APPROVED', 'SHARED']).optional(),
      });
      
      const parseResult = updateSchema.safeParse(req.body);
      if (!parseResult.success) {
        return res.status(400).json({ message: "Validation failed", errors: parseResult.error.errors });
      }
      
      const updates = {
        ...parseResult.data,
        lastEditedByUserId: currentUserId,
        isEdited: parseResult.data.editedContent ? true : undefined,
      };
      
      const narrative = await storage.updateCarrierNarrative(req.params.id, updates);
      if (!narrative) {
        return res.status(404).json({ message: "Narrative not found" });
      }
      res.json(narrative);
    } catch (error) {
      console.error("Error updating carrier narrative:", error);
      res.status(500).json({ message: "Failed to update carrier narrative" });
    }
  });
  
  app.post("/api/carrier/narratives/:id/approve", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser || currentUser.role !== 'admin') {
        return res.status(403).json({ message: "Admin access required to approve narratives" });
      }
      
      const narrative = await storage.approveCarrierNarrative(req.params.id, currentUserId);
      if (!narrative) {
        return res.status(404).json({ message: "Narrative not found" });
      }
      res.json(narrative);
    } catch (error) {
      console.error("Error approving carrier narrative:", error);
      res.status(500).json({ message: "Failed to approve carrier narrative" });
    }
  });
  
  app.delete("/api/carrier/narratives/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser || currentUser.role !== 'admin') {
        return res.status(403).json({ message: "Admin access required" });
      }
      
      await storage.deleteCarrierNarrative(req.params.id);
      res.status(204).send();
    } catch (error) {
      console.error("Error deleting carrier narrative:", error);
      res.status(500).json({ message: "Failed to delete carrier narrative" });
    }
  });
  
  // AI Narrative Generation endpoint
  app.post("/api/carrier/generate-narrative", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const { narrativeType, periodDays = 90 } = req.body;
      
      // Fetch current metrics and trends
      const metrics = await storage.getCarrierDashboardMetrics(periodDays);
      const trends = await storage.getCarrierTrendData(periodDays);
      const mitigationActions = await storage.getAllRiskMitigationActions({ status: 'ACTIVE' });
      
      // Build prompt for AI
      const prompt = `You are an insurance risk analyst helping a transportation/logistics company prepare carrier-ready reports.

Generate a professional, carrier-ready narrative summary based on the following data:

## Claims Metrics (${periodDays}-day period):
- Claims Frequency: ${metrics.claimsFrequency} per 1,000 moves
- Total Claims: ${metrics.totalClaims}
- Total Moves: ${metrics.totalMoves}
- Severity-Weighted Index: ${metrics.severityWeightedIndex}
- Total Claims Cost: $${metrics.totalClaimsCost.toLocaleString()}
- Average Days to Close: ${metrics.avgDaysToClose}
- Open Claims Over 30 Days: ${metrics.openClaimsOver30Days}
- At-Fault Rate: ${metrics.atFaultPercent}%

## Evidence & Safety Discipline:
- Pickup Photo Compliance: ${metrics.pickupCompliancePercent}%
- Dropoff Photo Compliance: ${metrics.dropoffCompliancePercent}%
- Claims with Evidence: ${metrics.claimsWithEvidencePercent}%

## Trends:
- Frequency Trend: ${trends.trends.frequency} (${trends.trends.frequencyChange > 0 ? '+' : ''}${trends.trends.frequencyChange})
- Severity Trend: ${trends.trends.severity} (${trends.trends.severityChange > 0 ? '+' : ''}${trends.trends.severityChange})
- Photo Compliance Trend: ${trends.trends.photoCompliance} (${trends.trends.photoChange > 0 ? '+' : ''}${trends.trends.photoChange}%)

## Active Mitigation Actions: ${mitigationActions.length}
${mitigationActions.slice(0, 5).map((a: any) => `- ${a.title}: ${a.description?.substring(0, 100)}...`).join('\n')}

Please generate a narrative following this structure:
1) What happened (summarize key metrics and any notable trends or spikes)
2) Why it happened (root cause analysis based on the data patterns)
3) What we did (reference mitigation actions if applicable)
4) Result (measurable outcomes or expected improvements)

The narrative should be:
- Professional and suitable for carrier/underwriter review
- Data-driven with specific metrics cited
- Focused on demonstrating operational control and continuous improvement
- Between 150-300 words

Narrative Type: ${narrativeType || 'QUARTERLY_SUMMARY'}`;

      // Call OpenAI using the AI integrations
      const OpenAI = (await import('openai')).default;
      const openai = new OpenAI();
      
      const completion = await openai.chat.completions.create({
        model: "gpt-5.2",
        messages: [
          {
            role: "system",
            content: "You are an insurance risk analyst specializing in transportation and logistics. Generate professional, carrier-ready narratives that demonstrate operational discipline and risk control."
          },
          {
            role: "user",
            content: prompt
          }
        ],
        max_tokens: 1000,
        temperature: 0.7,
      });
      
      const generatedContent = completion.choices[0]?.message?.content || '';
      
      // Create the narrative record
      const narrative = await storage.createCarrierNarrative({
        title: `${narrativeType || 'Quarterly'} Summary - ${new Date().toLocaleDateString()}`,
        narrativeType: narrativeType || 'QUARTERLY_SUMMARY',
        generatedContent,
        periodStart: new Date(metrics.periodStart),
        periodEnd: new Date(metrics.periodEnd),
        metricsSnapshot: JSON.stringify(metrics),
        createdByUserId: currentUserId,
        status: 'DRAFT',
      });
      
      res.status(201).json({
        narrative,
        generatedContent,
      });
    } catch (error) {
      console.error("Error generating carrier narrative:", error);
      res.status(500).json({ message: "Failed to generate carrier narrative" });
    }
  });
  
  // ============================================
  // Account Documents Hub
  // ============================================
  
  // Get all documents for a customer account
  app.get("/api/corporate/customers/:customerId/documents", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const documents = await storage.getAccountDocuments(req.params.customerId);
      
      // Enhance with uploader info
      const documentsWithUploader = await Promise.all(documents.map(async (doc) => {
        const uploader = doc.uploadedByUserId ? await storage.getUser(doc.uploadedByUserId) : null;
        return {
          ...doc,
          uploadedByName: uploader ? `${uploader.firstName} ${uploader.lastName}` : 'Unknown',
        };
      }));
      
      res.json(documentsWithUploader);
    } catch (error) {
      console.error("Error fetching account documents:", error);
      res.status(500).json({ message: "Failed to fetch account documents" });
    }
  });
  
  // Upload a document to a customer account
  app.post("/api/corporate/customers/:customerId/documents", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const uploadSchema = z.object({
        filename: z.string().min(1),
        originalFilename: z.string().min(1),
        fileUrl: z.string().min(1),
        fileSize: z.number().optional(),
        mimeType: z.string().optional(),
        category: z.enum(["Contract", "Pricing/Quote", "Compliance", "Reports", "Other"]),
        notes: z.string().optional(),
      });
      
      const parseResult = uploadSchema.safeParse(req.body);
      if (!parseResult.success) {
        return res.status(400).json({ message: "Validation failed", errors: parseResult.error.errors });
      }
      
      const document = await storage.createAccountDocument({
        customerId: req.params.customerId,
        ...parseResult.data,
        uploadedByUserId: currentUserId,
      });
      
      res.status(201).json(document);
    } catch (error) {
      console.error("Error creating account document:", error);
      res.status(500).json({ message: "Failed to create account document" });
    }
  });
  
  // Delete a document from a customer account
  app.delete("/api/corporate/customers/:customerId/documents/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const document = await storage.getAccountDocument(req.params.id);
      if (!document) {
        return res.status(404).json({ message: "Document not found" });
      }
      
      // Only admin or the uploader can delete
      if (role !== 'admin' && document.uploadedByUserId !== currentUserId) {
        return res.status(403).json({ message: "Only admin or the uploader can delete this document" });
      }
      
      await storage.deleteAccountDocument(req.params.id);
      res.status(204).send();
    } catch (error) {
      console.error("Error deleting account document:", error);
      res.status(500).json({ message: "Failed to delete account document" });
    }
  });
  

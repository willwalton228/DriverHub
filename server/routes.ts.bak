  // POST /api/driver-master-data/resolve - Resolve multiple drivers by IDs
  app.post("/api/driver-master-data/resolve", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { driverIds } = req.body;
      if (!Array.isArray(driverIds) || driverIds.length === 0) {
        return res.status(400).json({ message: "driverIds array is required" });
      }

      if (driverIds.length > 100) {
        return res.status(400).json({ message: "Maximum 100 drivers per request" });
      }

      const { queryDriverMasterData } = await import("./driverMasterDataService");
      const result = await queryDriverMasterData({
        driverIds,
        includeInactive: true,
        limit: 100,
      });

      const driverMap = new Map(result.drivers.map(d => [d.driverId, d]));
      const resolved = driverIds.map(id => ({
        driverId: id,
        found: driverMap.has(id),
        data: driverMap.get(id) || null,
      }));

      res.json({
        resolved,
        totalFound: result.drivers.length,
        totalRequested: driverIds.length,
      });
    } catch (error) {
      console.error("[Driver Master Data] Error resolving drivers:", error);
      res.status(500).json({ message: "Failed to resolve driver identities" });
    }
  });

  // GET /api/driver-events - Get driver lifecycle events for Ops Console
  app.get("/api/driver-events", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { status, limit } = req.query;

      const driverLifecycleEvents = await db.select()
        .from(schema.driverLifecycleEvents)
        .where(status ? eq(schema.driverLifecycleEvents.status, status as string) : undefined)
        .orderBy(desc(schema.driverLifecycleEvents.emittedAt))
        .limit(limit ? parseInt(limit as string) : 100);

      res.json(driverLifecycleEvents);
    } catch (error) {
      console.error("[Driver Events] Error fetching events:", error);
      res.status(500).json({ message: "Failed to fetch driver events" });
    }
  });

  // POST /api/driver-events/:eventId/delivered - Mark driver event as delivered
  app.post("/api/driver-events/:eventId/delivered", async (req: Request, res: Response) => {
    try {
      let authUserId: string | null = (req as any).session?.userId || null;
      if (!authUserId && (req as any).user?.claims?.sub) {
        authUserId = (req as any).user.claims.sub;
      }
      if (!authUserId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      let user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, authUserId!),
      });
      if (!user && (req as any).user?.claims?.email) {
        user = await db.query.users.findFirst({
          where: (users, { eq }) => eq(users.email, (req as any).user.claims.email),
        });
      }
      if (!user || (user.role !== 'admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { eventId } = req.params;
      
      await db.update(schema.driverLifecycleEvents)
        .set({
          status: 'delivered',
          deliveredAt: new Date(),
          deliveryAttempts: sql`${schema.driverLifecycleEvents.deliveryAttempts} + 1`,
        })
        .where(eq(schema.driverLifecycleEvents.eventId, eventId));

      res.json({ success: true, message: "Event marked as delivered" });
    } catch (error) {
      console.error("[Driver Events] Error marking event delivered:", error);
      res.status(500).json({ message: "Failed to mark event as delivered" });
    }
  });


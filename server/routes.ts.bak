  // Get all invoices with optional filters (entity/location)
  app.get("/api/corporate/invoicing/invoices", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      
      const filters: InvoiceSearchFilters = {};
      if (req.query.billingEntityId) filters.billingEntityId = req.query.billingEntityId as string;
      if (req.query.locationId) filters.locationId = req.query.locationId as string;
      if (req.query.customerId) filters.customerId = req.query.customerId as string;
      if (req.query.status) filters.status = req.query.status as string;
      if (req.query.search) filters.searchQuery = req.query.search as string;
      if (req.query.statuses) filters.statuses = (req.query.statuses as string).split(',');
      if (req.query.amountMin) filters.amountMin = parseFloat(req.query.amountMin as string);
      if (req.query.amountMax) filters.amountMax = parseFloat(req.query.amountMax as string);
      if (req.query.dateField) filters.dateField = req.query.dateField as string;
      if (req.query.dateStart) filters.dateStart = req.query.dateStart as string;
      if (req.query.dateEnd) filters.dateEnd = req.query.dateEnd as string;
      if (req.query.agingBucket) filters.agingBucket = req.query.agingBucket as string;
      if (req.query.collectionsTier) filters.collectionsTier = req.query.collectionsTier as string;
      if (req.query.includeConsolidated === 'true') filters.includeConsolidated = true;
      
      const invoices = await storage.getAllInvoices(Object.keys(filters).length > 0 ? filters : undefined);
      res.json(invoices);
    } catch (error) {
      console.error("Error fetching invoices:", error);
      res.status(500).json({ message: "Failed to fetch invoices" });
    }
  });

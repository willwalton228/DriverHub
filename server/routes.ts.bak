  // Twilio inbound SMS webhook
  app.post("/webhooks/twilio/sms", async (req: Request, res: Response) => {
    try {
      const { handleInboundSms, validateTwilioWebhook } = await import("./services/twilioSmsService");
      
      // Validate Twilio signature in production
      const authToken = process.env.TWILIO_AUTH_TOKEN;
      if (authToken && process.env.NODE_ENV === 'production') {
        const signature = req.headers['x-twilio-signature'] as string;
        const url = `${req.protocol}://${req.get("host")}${req.originalUrl}`;
        if (!validateTwilioWebhook(authToken, signature, url, req.body)) {
          console.log('[Twilio] Invalid webhook signature');
          return res.status(403).send('Forbidden');
        }
      }

      await handleInboundSms({
        from: req.body.From,
        to: req.body.To,
        body: req.body.Body,
        messageSid: req.body.MessageSid,
        accountSid: req.body.AccountSid,
        numMedia: req.body.NumMedia,
      });

      // Respond with empty TwiML
      res.type('text/xml');
      res.send('<?xml version="1.0" encoding="UTF-8"?><Response></Response>');
    } catch (error) {
      console.error("[Twilio] Webhook error:", error);
      res.type('text/xml');
      res.send('<?xml version="1.0" encoding="UTF-8"?><Response></Response>');
    }
  });

  // Twilio status callback webhook
  app.post("/webhooks/twilio/status", async (req: Request, res: Response) => {
    try {
      const { updateSmsDeliveryStatus } = await import("./services/twilioSmsService");
      
      const { MessageSid, MessageStatus, ErrorCode, ErrorMessage } = req.body;
      await updateSmsDeliveryStatus(MessageSid, MessageStatus, ErrorCode, ErrorMessage);

      res.status(200).send('OK');
    } catch (error) {
      console.error("[Twilio] Status callback error:", error);
      res.status(200).send('OK');
    }
  });

  // SendGrid event webhook
  app.post("/webhooks/sendgrid/events", async (req: Request, res: Response) => {
    try {
      const { updateEmailStatus, handleUnsubscribe } = await import("./services/sendgridEmailService");
      
      const events = Array.isArray(req.body) ? req.body : [req.body];
      
      for (const event of events) {
        if (event.event === 'unsubscribe' || event.event === 'group_unsubscribe') {
          await handleUnsubscribe(event.email);
        } else {
          const messageId = event.sg_message_id?.split('.')[0];
          if (messageId) {
            await updateEmailStatus(messageId, event.event, new Date(event.timestamp * 1000));
          }
        }
      }

      res.status(200).send('OK');
    } catch (error) {
      console.error("[SendGrid] Webhook error:", error);
      res.status(200).send('OK');
    }
  });


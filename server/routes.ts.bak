  // GET /api/risp/summary - Get RISP Insurance Summary metrics
  app.get("/api/risp/summary", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);
      if (!user) {
        const [userByEmail] = await db.select().from(users)
          .where(eq(users.email, (req as any).user?.claims?.email || ''))
          .limit(1);
        if (!userByEmail || !['admin', 'super_user'].includes(userByEmail.role || '')) {
          return res.status(403).json({ message: "Admin access required" });
        }
      } else if (!['admin', 'super_user'].includes(user.role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { customerId, marketId, days = "30" } = req.query;
      const daysNum = parseInt(days as string) || 30;
      
      const endDate = new Date();
      const startDate = new Date();
      startDate.setDate(startDate.getDate() - daysNum);

      const { getRISPSummaryMetrics, getRISPControlCoverage } = await import("./rispSummaryService");
      
      const metrics = await getRISPSummaryMetrics({
        customerId: customerId as string | undefined,
        marketId: marketId as string | undefined,
        startDate,
        endDate,
      });

      const controlCoverage = await getRISPControlCoverage();

      res.json({ metrics, controlCoverage });
    } catch (error) {
      console.error("[RISP] Error fetching summary:", error);
      res.status(500).json({ message: "Failed to fetch RISP summary" });
    }
  });

  // GET /api/risp/summary/export/pdf - Export RISP summary as PDF
  app.get("/api/risp/summary/export/pdf", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);

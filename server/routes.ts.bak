  // Dashboard metrics for litigation holds
  app.get("/api/claims/dashboard/litigation-holds", isAuthenticated, async (req: any, res: Response) => {
    try {
      const claims = await db.select({
        id: accidents.id,
        litigationHoldActive: accidents.litigationHoldActive,
        triageSeverity: accidents.triageSeverity,
        injuryFlag: accidents.injuryFlag,
        attorneyLetterReceived: accidents.attorneyLetterReceived,
      }).from(accidents);

      const activeHolds = claims.filter(c => c.litigationHoldActive).length;
      const severeClaims = claims.filter(c => c.triageSeverity === 'severe').length;
      const injuryClaims = claims.filter(c => c.injuryFlag).length;
      const attorneyLetterClaims = claims.filter(c => c.attorneyLetterReceived).length;

      res.json({
        activeHoldsCount: activeHolds,
        severeClaimsCount: severeClaims,
        injuryClaimsCount: injuryClaims,
        attorneyLetterClaimsCount: attorneyLetterClaims,
        totalClaims: claims.length,
      });
    } catch (error) {
      console.error("Error fetching litigation hold metrics:", error);
      res.status(500).json({ message: "Failed to fetch litigation hold metrics" });
    }
  });

  // Dashboard metrics for drug tests (Ticket 6)
  app.get("/api/claims/dashboard/drug-test-metrics", isAuthenticated, async (req: any, res: Response) => {
    try {
      const claims = await db.select({
        id: accidents.id,
        drugTestRequired: accidents.drugTestRequired,
        drugTestStatus: accidents.drugTestStatus,
        drugTestDueBy: accidents.drugTestDueBy,
      }).from(accidents);

      const now = new Date();
      const requiredTests = claims.filter(c => c.drugTestRequired);
      const pendingTests = requiredTests.filter(c => 
        c.drugTestStatus && !['completed', 'waived'].includes(c.drugTestStatus)
      );
      const overdueTests = pendingTests.filter(c => 
        c.drugTestDueBy && new Date(c.drugTestDueBy) < now
      );
      const completedTests = requiredTests.filter(c => c.drugTestStatus === 'completed');
      const waivedTests = requiredTests.filter(c => c.drugTestStatus === 'waived');
      const acknowledgedTests = requiredTests.filter(c => c.drugTestStatus === 'acknowledged');

      res.json({
        totalRequired: requiredTests.length,
        pendingCount: pendingTests.length,
        overdueCount: overdueTests.length,
        completedCount: completedTests.length,
        waivedCount: waivedTests.length,
        acknowledgedCount: acknowledgedTests.length,
        complianceRate: requiredTests.length > 0 
          ? Math.round((completedTests.length / requiredTests.length) * 100) 
          : 100,
      });
    } catch (error) {
      console.error("Error fetching drug test metrics:", error);
      res.status(500).json({ message: "Failed to fetch drug test metrics" });
    }
  });

  // Legal Packet Export - Generate comprehensive claim packet
  app.get("/api/claims/:claimId/legal-packet", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;

      // Get full claim details
      const [claim] = await db.select().from(accidents).where(eq(accidents.id, claimId)).limit(1);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      // Get driver snapshot
      const driver = claim.driverId ? await db.select().from(drivers).where(eq(drivers.id, claim.driverId)).limit(1) : [];
      const driverUser = driver[0]?.userId ? await db.select().from(users).where(eq(users.id, driver[0].userId)).limit(1) : [];

      // Get move/trip snapshot
      const move = claim.moveId ? await db.select().from(trips).where(eq(trips.id, claim.moveId)).limit(1) : [];

      // Get claim events (status history)
      const events = await db.select().from(claimEvents)
        .where(eq(claimEvents.claimId, claimId))
        .orderBy(desc(claimEvents.createdAt));

      // Get evidence/attachments
      const attachments = await db.select().from(accidentAttachments)
        .where(eq(accidentAttachments.accidentId, claimId))
        .orderBy(desc(accidentAttachments.createdAt));

      // Get litigation hold audit log
      const litigationAudit = await db.select().from(litigationHoldAuditLogs)
        .where(eq(litigationHoldAuditLogs.claimId, claimId))
        .orderBy(desc(litigationHoldAuditLogs.createdAt));

      // Build comprehensive legal packet
      const packet = {
        generatedAt: new Date().toISOString(),
        generatedByUserId: userId,
        
        // Claim Summary
        claimSummary: {
          claimId: claim.id,
          status: claim.claimStatus || claim.status,
          triageSeverity: claim.triageSeverity,
          injuryFlag: claim.injuryFlag,
          incidentDate: claim.incidentDate || claim.accidentDate,
          location: claim.location,
          incidentType: claim.incidentType,
          atFault: claim.dodAtFault,
          description: claim.description,
          probableCost: claim.probableCost,
          actualCost: claim.actualCost,
          createdAt: claim.createdAt,
        },

        // Litigation Hold Status
        litigationHold: {
          active: claim.litigationHoldActive,
          trigger: claim.litigationHoldTrigger,
          reason: claim.litigationHoldReason,
          activatedAt: claim.litigationHoldActivatedAt,
          attorneyLetterReceived: claim.attorneyLetterReceived,
          attorneyLetterReceivedAt: claim.attorneyLetterReceivedAt,
        },

        // Driver Snapshot (at time of incident)
        driverSnapshot: driver[0] ? {
          driverId: driver[0].id,
          name: driverUser[0] ? `${driverUser[0].firstName} ${driverUser[0].lastName}` : 'Unknown',
          email: driverUser[0]?.email,
          phone: driverUser[0]?.phone,
          hireDate: driver[0].hireDate,
          status: driver[0].status,
          marketId: driver[0].marketId,
          driverClassification: driver[0].driverClassification,
        } : null,

        // Move Snapshot (at time of incident)
        moveSnapshot: move[0] ? {
          moveId: move[0].id,
          customerId: move[0].customerId,
          origin: move[0].origin,
          destination: move[0].destination,
          scheduledDate: move[0].scheduledDate,
          completedAt: move[0].completedAt,
          status: move[0].status,
        } : null,

        // Full Timeline (status history + key events)
        timeline: events.map(e => ({
          timestamp: e.createdAt,
          fromStatus: e.fromStatus,
          toStatus: e.toStatus,
          changedBy: e.changedByName,
          note: e.note,
        })),

        // Evidence Index
        evidenceIndex: attachments.map(a => ({
          id: a.id,
          fileName: a.fileName,
          fileType: a.fileType,
          fileSize: a.fileSize,
          uploadedAt: a.createdAt,
          category: 'claim_attachment',
        })),

        // Litigation Hold Audit Trail
        litigationAuditTrail: litigationAudit.map(l => ({
          timestamp: l.createdAt,
          actionType: l.actionType,
          triggerType: l.triggerType,
          reason: l.reason,
        })),

        // Insurance Information
        insuranceInfo: {
          claimSubmitted: claim.insuranceClaimSubmitted,
          claimNumber: claim.insuranceClaimNumber,
          reserve: claim.insuranceReserve,
          paid: claim.insurancePaid,
          fault: claim.insuranceFault,
          comments: claim.insuranceComments,
        },

        // Notes and Comments
        notes: {
          description: claim.description,
          resolutionNotes: claim.resolutionNotes,
          notesReceived: claim.notesReceived,
          incidentCommentsHistory: claim.incidentCommentsHistory,
        },
      };

      // Log the export action
      await db.insert(litigationHoldAuditLogs).values({
        claimId,
        userId,
        actionType: 'LEGAL_PACKET_EXPORTED',
        metadata: { exportedAt: new Date().toISOString() },
      });

      res.json(packet);
    } catch (error) {
      console.error("Error generating legal packet:", error);
      res.status(500).json({ message: "Failed to generate legal packet" });
    }
  });

  // ==========================================
  // POST-ACCIDENT DRUG TEST NOTIFICATION (Ticket 6)
  // ==========================================

  // Helper function to check drug test trigger conditions
  function shouldAutoTriggerDrugTest(claim: any): { trigger: boolean; reason: string } {
    if (claim.triageSeverity === 'severe') {
      return { trigger: true, reason: 'Auto-triggered: Claim severity is severe' };
    }
    if (claim.injuryFlag) {
      return { trigger: true, reason: 'Auto-triggered: Injury reported' };
    }
    if (claim.drivableFlag === false) {
      return { trigger: true, reason: 'Auto-triggered: Vehicle not drivable' };
    }
    if (claim.policeReportFlag) {
      return { trigger: true, reason: 'Auto-triggered: Police report filed' };
    }
    return { trigger: false, reason: '' };
  }

  // Get drug test status for a claim
  app.get("/api/claims/:claimId/drug-test", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      
      const [claim] = await db.select({
        drugTestRequired: accidents.drugTestRequired,
        drugTestStatus: accidents.drugTestStatus,
        drugTestRequiredAt: accidents.drugTestRequiredAt,
        drugTestDueBy: accidents.drugTestDueBy,
        drugTestRequiredReason: accidents.drugTestRequiredReason,
        drugTestWaivedReason: accidents.drugTestWaivedReason,
        drugTestCompletedAt: accidents.drugTestCompletedAt,
        drugTestLastNotifiedAt: accidents.drugTestLastNotifiedAt,
        drugTestAcknowledgedAt: accidents.drugTestAcknowledgedAt,
        triageSeverity: accidents.triageSeverity,
        injuryFlag: accidents.injuryFlag,
        drivableFlag: accidents.drivableFlag,
        policeReportFlag: accidents.policeReportFlag,
        driverId: accidents.driverId,
      }).from(accidents).where(eq(accidents.id, claimId)).limit(1);

      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      // Calculate overdue status
      const isOverdue = claim.drugTestRequired && 
        claim.drugTestDueBy && 
        new Date() > new Date(claim.drugTestDueBy) &&
        !['completed', 'waived'].includes(claim.drugTestStatus || '');

      // Get notification history
      const notifications = await db.select()
        .from(notificationLogs)
        .where(eq(notificationLogs.claimId, claimId))
        .orderBy(desc(notificationLogs.createdAt))
        .limit(10);

      // Get driver task if exists
      const [task] = await db.select()
        .from(driverTasks)
        .where(eq(driverTasks.claimId, claimId))
        .limit(1);

      res.json({
        ...claim,
        isOverdue,
        daysOverdue: isOverdue ? Math.floor((Date.now() - new Date(claim.drugTestDueBy!).getTime()) / (1000 * 60 * 60 * 24)) : 0,
        notifications,
        driverTask: task || null,
      });
    } catch (error) {
      console.error("Error fetching drug test status:", error);
      res.status(500).json({ message: "Failed to fetch drug test status" });
    }
  });

  // Require drug test (manual or auto-trigger)
  app.post("/api/claims/:claimId/drug-test/require", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;
      const { reason, isAutoTrigger } = req.body;

      // Manual requires a reason
      if (!isAutoTrigger && !reason) {
        return res.status(400).json({ message: "Reason is required for manual drug test requirement" });
      }

      // Get claim and driver info
      const [claim] = await db.select().from(accidents).where(eq(accidents.id, claimId)).limit(1);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      // Check if already required (idempotency)
      if (claim.drugTestRequired && claim.drugTestStatus !== 'not_required') {
        return res.status(400).json({ message: "Drug test already required for this claim" });
      }

      const now = new Date();
      const dueBy = new Date(now.getTime() + 24 * 60 * 60 * 1000); // 24 hours from now
      const triggerReason = isAutoTrigger ? reason : `Manual: ${reason}`;

      // Update claim with drug test requirement
      const [updated] = await db.update(accidents)
        .set({
          drugTestRequired: true,
          drugTestStatus: 'required',
          drugTestRequiredAt: now,
          drugTestDueBy: dueBy,
          drugTestRequiredReason: triggerReason,
          updatedAt: now,
        })
        .where(eq(accidents.id, claimId))
        .returning();

      // Create audit log
      await db.insert(drugTestAuditLogs).values({
        claimId,
        userId,
        actionType: 'REQUIRED_SET',
        previousStatus: claim.drugTestStatus || 'not_required',
        newStatus: 'required',
        reason: triggerReason,
      });

      // Create driver task (unique per claim+driver+type)
      const existingTask = await db.select()
        .from(driverTasks)
        .where(eq(driverTasks.claimId, claimId))
        .limit(1);

      let taskId = existingTask[0]?.id;
      if (!existingTask.length) {
        const [newTask] = await db.insert(driverTasks).values({
          driverId: claim.driverId,
          claimId,
          taskType: 'drug_test_required',
          title: 'Post-Accident Drug Test Required',
          description: 'A drug test is required following the incident. Please acknowledge this task and complete the test within 24 hours.',
          instructions: 'Visit an approved testing facility to complete your drug test. Bring your driver ID and this task confirmation.',
          status: 'open',
          dueBy,
          createdByUserId: userId,
        }).returning();
        taskId = newTask.id;
      }

      // Create notification log (simulating push notification)
      await db.insert(notificationLogs).values({
        claimId,
        driverId: claim.driverId,
        taskId,
        channel: 'push',
        notificationType: 'drug_test_required',
        title: 'Action Required: Post-Accident Drug Test',
        body: 'A drug test is required following the incident. Open the app for instructions.',
        sentAt: now,
        deliveryStatus: 'sent',
        createdByUserId: userId,
      });

      // Update status to notified
      await db.update(accidents)
        .set({
          drugTestStatus: 'notified',
          drugTestLastNotifiedAt: now,
          updatedAt: now,
        })
        .where(eq(accidents.id, claimId));

      // Log notification sent
      await db.insert(drugTestAuditLogs).values({
        claimId,
        userId,
        actionType: 'NOTIFICATION_SENT',
        previousStatus: 'required',
        newStatus: 'notified',
      });

      res.json({ success: true, claim: updated, taskId });
    } catch (error) {
      console.error("Error requiring drug test:", error);
      res.status(500).json({ message: "Failed to require drug test" });
    }
  });

  // Waive drug test requirement (Admin only with reason)
  app.post("/api/claims/:claimId/drug-test/waive", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;
      const { reason } = req.body;

      if (!reason) {
        return res.status(400).json({ message: "Reason is required to waive drug test" });
      }

      // Verify admin role
      const [currentUser] = await db.select({ role: users.role }).from(users).where(eq(users.id, userId)).limit(1);
      if (!currentUser || !['admin', 'super_user'].includes(currentUser.role || '')) {
        return res.status(403).json({ message: "Only administrators can waive drug test requirements" });
      }

      const [claim] = await db.select().from(accidents).where(eq(accidents.id, claimId)).limit(1);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      const previousStatus = claim.drugTestStatus;

      // Update claim
      const [updated] = await db.update(accidents)
        .set({
          drugTestStatus: 'waived',
          drugTestWaivedReason: reason,
          updatedAt: new Date(),
        })
        .where(eq(accidents.id, claimId))
        .returning();

      // Cancel driver task if exists
      await db.update(driverTasks)
        .set({ status: 'cancelled', updatedAt: new Date() })
        .where(eq(driverTasks.claimId, claimId));

      // Audit log
      await db.insert(drugTestAuditLogs).values({
        claimId,
        userId,
        actionType: 'WAIVED',
        previousStatus,
        newStatus: 'waived',
        reason,
      });

      res.json({ success: true, claim: updated });
    } catch (error) {
      console.error("Error waiving drug test:", error);
      res.status(500).json({ message: "Failed to waive drug test" });
    }
  });

  // Resend drug test notification
  app.post("/api/claims/:claimId/drug-test/resend", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;

      const [claim] = await db.select().from(accidents).where(eq(accidents.id, claimId)).limit(1);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      if (!claim.drugTestRequired) {
        return res.status(400).json({ message: "Drug test not required for this claim" });
      }

      // Get the driver task
      const [task] = await db.select()
        .from(driverTasks)
        .where(eq(driverTasks.claimId, claimId))
        .limit(1);

      const now = new Date();

      // Create new notification log
      await db.insert(notificationLogs).values({
        claimId,
        driverId: claim.driverId,
        taskId: task?.id,
        channel: 'push',
        notificationType: 'drug_test_reminder',
        title: 'Reminder: Post-Accident Drug Test Required',
        body: 'A drug test is still required. Please complete it as soon as possible.',
        sentAt: now,
        deliveryStatus: 'sent',
        createdByUserId: userId,
      });

      // Update last notified timestamp
      await db.update(accidents)
        .set({
          drugTestLastNotifiedAt: now,
          updatedAt: now,
        })
        .where(eq(accidents.id, claimId));

      // Audit log
      await db.insert(drugTestAuditLogs).values({
        claimId,
        userId,
        actionType: 'NOTIFICATION_RESENT',
      });

      res.json({ success: true, message: "Notification resent" });
    } catch (error) {
      console.error("Error resending drug test notification:", error);
      res.status(500).json({ message: "Failed to resend notification" });
    }
  });

  // Driver acknowledges drug test task
  app.post("/api/claims/:claimId/drug-test/acknowledge", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;

      const [claim] = await db.select().from(accidents).where(eq(accidents.id, claimId)).limit(1);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      if (!claim.drugTestRequired) {
        return res.status(400).json({ message: "No drug test required for this claim" });
      }

      const previousStatus = claim.drugTestStatus;
      const now = new Date();

      // Update claim status
      await db.update(accidents)
        .set({
          drugTestStatus: 'acknowledged',
          drugTestAcknowledgedAt: now,
          updatedAt: now,
        })
        .where(eq(accidents.id, claimId));

      // Update driver task
      await db.update(driverTasks)
        .set({
          status: 'acknowledged',
          acknowledgedAt: now,
          updatedAt: now,
        })
        .where(eq(driverTasks.claimId, claimId));

      // Audit log
      await db.insert(drugTestAuditLogs).values({
        claimId,
        userId,
        actionType: 'ACKNOWLEDGED',
        previousStatus,
        newStatus: 'acknowledged',
      });

      res.json({ success: true, message: "Drug test requirement acknowledged" });
    } catch (error) {
      console.error("Error acknowledging drug test:", error);
      res.status(500).json({ message: "Failed to acknowledge drug test" });
    }
  });

  // Mark drug test as completed (Admin/Safety only)
  app.post("/api/claims/:claimId/drug-test/complete", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;

      // Verify admin role
      const [currentUser] = await db.select({ role: users.role }).from(users).where(eq(users.id, userId)).limit(1);
      if (!currentUser || !['admin', 'super_user'].includes(currentUser.role || '')) {
        return res.status(403).json({ message: "Only administrators can mark drug tests as completed" });
      }

      const [claim] = await db.select().from(accidents).where(eq(accidents.id, claimId)).limit(1);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      const previousStatus = claim.drugTestStatus;
      const now = new Date();

      // Update claim status
      await db.update(accidents)
        .set({
          drugTestStatus: 'completed',
          drugTestCompletedAt: now,
          updatedAt: now,
        })
        .where(eq(accidents.id, claimId));

      // Complete driver task
      await db.update(driverTasks)
        .set({
          status: 'completed',
          completedAt: now,
          updatedAt: now,
        })
        .where(eq(driverTasks.claimId, claimId));

      // Audit log
      await db.insert(drugTestAuditLogs).values({
        claimId,
        userId,
        actionType: 'COMPLETED',
        previousStatus,
        newStatus: 'completed',
      });

      res.json({ success: true, message: "Drug test marked as completed" });
    } catch (error) {
      console.error("Error completing drug test:", error);
      res.status(500).json({ message: "Failed to complete drug test" });
    }
  });

  // Get drug test audit log
  app.get("/api/claims/:claimId/drug-test/audit-log", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;

      const logs = await db.select()
        .from(drugTestAuditLogs)
        .where(eq(drugTestAuditLogs.claimId, claimId))
        .orderBy(desc(drugTestAuditLogs.createdAt));

      res.json(logs);
    } catch (error) {
      console.error("Error fetching drug test audit log:", error);
      res.status(500).json({ message: "Failed to fetch audit log" });
    }
  });

  // Dashboard metrics for drug test
  app.get("/api/claims/dashboard/drug-test-metrics", isAuthenticated, async (req: any, res: Response) => {
    try {
      const claims = await db.select({
        id: accidents.id,
        drugTestRequired: accidents.drugTestRequired,
        drugTestStatus: accidents.drugTestStatus,
        drugTestDueBy: accidents.drugTestDueBy,
      }).from(accidents);

      const now = new Date();
      
      const requiredCount = claims.filter(c => c.drugTestRequired && !['completed', 'waived'].includes(c.drugTestStatus || '')).length;
      const overdueCount = claims.filter(c => 
        c.drugTestRequired && 
        c.drugTestDueBy && 
        new Date(c.drugTestDueBy) < now &&
        !['completed', 'waived'].includes(c.drugTestStatus || '')
      ).length;
      const completedCount = claims.filter(c => c.drugTestStatus === 'completed').length;
      const waivedCount = claims.filter(c => c.drugTestStatus === 'waived').length;
      const acknowledgedCount = claims.filter(c => c.drugTestStatus === 'acknowledged').length;

      res.json({
        requiredCount,
        overdueCount,
        completedCount,
        waivedCount,
        acknowledgedCount,
        totalWithDrugTest: claims.filter(c => c.drugTestRequired).length,
      });
    } catch (error) {
      console.error("Error fetching drug test metrics:", error);
      res.status(500).json({ message: "Failed to fetch drug test metrics" });
    }
  });

  // Auto-check trigger on claim update (call this after claim updates)
  app.post("/api/claims/:claimId/drug-test/check-trigger", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;

      const [claim] = await db.select().from(accidents).where(eq(accidents.id, claimId)).limit(1);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      // Check if already required
      if (claim.drugTestRequired) {
        return res.json({ triggered: false, message: "Drug test already required" });
      }

      // Check auto-trigger conditions
      const { trigger, reason } = shouldAutoTriggerDrugTest(claim);
      
      if (trigger) {
        // Auto-trigger the drug test requirement
        const now = new Date();
        const dueBy = new Date(now.getTime() + 24 * 60 * 60 * 1000);

        await db.update(accidents)
          .set({
            drugTestRequired: true,
            drugTestStatus: 'required',
            drugTestRequiredAt: now,
            drugTestDueBy: dueBy,
            drugTestRequiredReason: reason,
            updatedAt: now,
          })
          .where(eq(accidents.id, claimId));

        // Create driver task
        const [newTask] = await db.insert(driverTasks).values({
          driverId: claim.driverId,
          claimId,
          taskType: 'drug_test_required',
          title: 'Post-Accident Drug Test Required',
          description: 'A drug test is required following the incident.',
          instructions: 'Visit an approved testing facility to complete your drug test.',
          status: 'open',
          dueBy,
          createdByUserId: userId,
        }).returning();

        // Create notification
        await db.insert(notificationLogs).values({
          claimId,
          driverId: claim.driverId,
          taskId: newTask.id,
          channel: 'push',
          notificationType: 'drug_test_required',
          title: 'Action Required: Post-Accident Drug Test',
          body: 'A drug test is required following the incident. Open the app for instructions.',
          sentAt: now,
          deliveryStatus: 'sent',
          createdByUserId: userId,
        });

        // Update to notified
        await db.update(accidents)
          .set({
            drugTestStatus: 'notified',
            drugTestLastNotifiedAt: now,
          })
          .where(eq(accidents.id, claimId));

        // Audit logs
        await db.insert(drugTestAuditLogs).values({
          claimId,
          userId,
          actionType: 'REQUIRED_SET',
          previousStatus: 'not_required',
          newStatus: 'required',
          reason,
        });

        await db.insert(drugTestAuditLogs).values({
          claimId,
          userId,
          actionType: 'NOTIFICATION_SENT',
          previousStatus: 'required',
          newStatus: 'notified',
        });

        return res.json({ triggered: true, reason });
      }

      res.json({ triggered: false, message: "No trigger conditions met" });
    } catch (error) {
      console.error("Error checking drug test trigger:", error);
      res.status(500).json({ message: "Failed to check trigger" });
    }
  });

  // Driver App: Get required tasks for current driver
  app.get("/api/driver/tasks", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user?.claims?.sub;

      // Get the driver record for this user
      const [driver] = await db.select()
        .from(drivers)
        .where(eq(drivers.userId, userId))
        .limit(1);

      if (!driver) {
        return res.json({ tasks: [] });
      }

      // Get open tasks for this driver
      const tasks = await db.select()
        .from(driverTasks)
        .where(eq(driverTasks.driverId, driver.id))
        .orderBy(desc(driverTasks.createdAt));

      // Filter to only show open/acknowledged tasks (not completed/cancelled)
      const activeTasks = tasks.filter(t => ['open', 'acknowledged', 'in_progress'].includes(t.status));

      res.json({ tasks: activeTasks });
    } catch (error) {
      console.error("Error fetching driver tasks:", error);
      res.status(500).json({ message: "Failed to fetch tasks" });
    }
  });

  // Driver App: Acknowledge a task
  app.post("/api/driver/tasks/:taskId/acknowledge", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { taskId } = req.params;
      const userId = req.user?.claims?.sub;

      const [task] = await db.select()
        .from(driverTasks)
        .where(eq(driverTasks.id, taskId))
        .limit(1);

      if (!task) {
        return res.status(404).json({ message: "Task not found" });
      }

      const now = new Date();

      // Update task status
      await db.update(driverTasks)
        .set({
          status: 'acknowledged',
          acknowledgedAt: now,
          updatedAt: now,
        })
        .where(eq(driverTasks.id, taskId));

      // If it's a drug test task, update the claim status too
      if (task.taskType === 'drug_test_required' && task.claimId) {
        const [claim] = await db.select()
          .from(accidents)
          .where(eq(accidents.id, task.claimId))
          .limit(1);

        if (claim) {
          await db.update(accidents)
            .set({
              drugTestStatus: 'acknowledged',
              drugTestAcknowledgedAt: now,
              updatedAt: now,
            })
            .where(eq(accidents.id, task.claimId));

          // Audit log
          await db.insert(drugTestAuditLogs).values({
            claimId: task.claimId,
            userId,
            actionType: 'ACKNOWLEDGED',
            previousStatus: claim.drugTestStatus,
            newStatus: 'acknowledged',
          });
        }
      }

      res.json({ success: true, message: "Task acknowledged" });
    } catch (error) {
      console.error("Error acknowledging task:", error);
      res.status(500).json({ message: "Failed to acknowledge task" });
    }
  });

  // ==========================================
  // CUSTOMER NOTIFICATION PREFERENCES ENDPOINTS
  // ==========================================

  // Get notification preferences for current customer user
  app.get("/api/customer/notification-preferences", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      
      // Initialize preferences on first access (all enabled by default)
      const preferences = await storage.initializeCustomerNotificationPreferences(userId);
      res.json(preferences);
    } catch (error) {
      console.error("Error fetching notification preferences:", error);
      res.status(500).json({ message: "Failed to fetch notification preferences" });
    }
  });

  // Update a single notification preference
  app.patch("/api/customer/notification-preferences/:eventType", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const { eventType } = req.params;
      const { enabled } = req.body;

      if (typeof enabled !== 'boolean') {
        return res.status(400).json({ message: "enabled must be a boolean" });
      }

      const updated = await storage.updateCustomerNotificationPreference(userId, eventType, enabled);
      if (!updated) {
        return res.status(500).json({ message: "Failed to update preference" });
      }

      res.json(updated);
    } catch (error) {
      console.error("Error updating notification preference:", error);
      res.status(500).json({ message: "Failed to update notification preference" });
    }
  });

  // ==========================================
  // CUSTOMER USER MANAGEMENT ENDPOINTS
  // ==========================================

  // Get all users for the current customer account
  app.get("/api/customer/users", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      
      // Get the customer user record for the current user
      const customerUser = await storage.getCustomerUserByUserId(userId);
      if (!customerUser) {
        return res.status(403).json({ message: "Not associated with a customer account" });
      }

      const users = await storage.getCustomerUsersByCustomerId(customerUser.customerId);
      res.json(users);
    } catch (error) {
      console.error("Error fetching customer users:", error);
      res.status(500).json({ message: "Failed to fetch users" });
    }
  });

  // Invite a new user to the customer account (ADMIN only)
  const inviteUserSchema = z.object({
    email: z.string().email("Valid email is required"),
    role: z.enum(['ACCOUNT_ADMIN', 'ACCOUNT_VIEWER']),
  });

  app.post("/api/customer/users/invite", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      
      // Get the customer user record for the current user
      const customerUser = await storage.getCustomerUserByUserId(userId);
      if (!customerUser) {
        return res.status(403).json({ message: "Not associated with a customer account" });
      }

      // Check if user is an admin
      if (customerUser.role !== 'ACCOUNT_ADMIN') {
        return res.status(403).json({ message: "Only account admins can invite users" });
      }

      // Validate request body
      const validationResult = inviteUserSchema.safeParse(req.body);
      if (!validationResult.success) {
        return res.status(400).json({ 
          message: "Invalid request data",
          errors: validationResult.error.flatten().fieldErrors 
        });
      }

      const { email, role } = validationResult.data;

      // Check if user already exists in this account
      const existingUser = await storage.getCustomerUserByEmail(customerUser.customerId, email);
      if (existingUser) {
        return res.status(400).json({ message: "User with this email already exists in your account" });
      }

      // Create the customer user invitation
      const newCustomerUser = await storage.createCustomerUser({
        customerId: customerUser.customerId,
        email,
        role,
        status: 'PENDING',
        invitedBy: userId,
      });

      // Get customer info for the email
      const customer = await storage.getCustomer(customerUser.customerId);

      // Send invitation email
      const { sendCustomerUserInvitation } = await import('./emailService');
      await sendCustomerUserInvitation(email, customer?.customerName || 'Customer Account', newCustomerUser.id);

      res.status(201).json(newCustomerUser);
    } catch (error) {
      console.error("Error inviting customer user:", error);
      res.status(500).json({ message: "Failed to invite user" });
    }
  });

  // Update a customer user's role (ADMIN only)
  const updateRoleSchema = z.object({
    role: z.enum(['ACCOUNT_ADMIN', 'ACCOUNT_VIEWER']),
  });

  app.patch("/api/customer/users/:id/role", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const { id } = req.params;
      
      // Get the customer user record for the current user
      const customerUser = await storage.getCustomerUserByUserId(userId);
      if (!customerUser) {
        return res.status(403).json({ message: "Not associated with a customer account" });
      }

      // Check if user is an admin
      if (customerUser.role !== 'ACCOUNT_ADMIN') {
        return res.status(403).json({ message: "Only account admins can update user roles" });
      }

      // Validate request body
      const validationResult = updateRoleSchema.safeParse(req.body);
      if (!validationResult.success) {
        return res.status(400).json({ 
          message: "Invalid request data",
          errors: validationResult.error.flatten().fieldErrors 
        });
      }

      // Get the target user
      const targetUser = await storage.getCustomerUserById(id);
      if (!targetUser) {
        return res.status(404).json({ message: "User not found" });
      }

      // Verify same customer account
      if (targetUser.customerId !== customerUser.customerId) {
        return res.status(403).json({ message: "Cannot modify users from other accounts" });
      }

      // Prevent self-demotion (admin can't remove their own admin role)
      if (targetUser.userId === userId && validationResult.data.role !== 'ACCOUNT_ADMIN') {
        return res.status(400).json({ message: "You cannot remove your own admin privileges" });
      }

      const updated = await storage.updateCustomerUserRole(id, validationResult.data.role);
      res.json(updated);
    } catch (error) {
      console.error("Error updating customer user role:", error);
      res.status(500).json({ message: "Failed to update user role" });
    }
  });

  // Delete a customer user (ADMIN only)
  app.delete("/api/customer/users/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const { id } = req.params;
      
      // Get the customer user record for the current user
      const customerUser = await storage.getCustomerUserByUserId(userId);
      if (!customerUser) {
        return res.status(403).json({ message: "Not associated with a customer account" });
      }

      // Check if user is an admin
      if (customerUser.role !== 'ACCOUNT_ADMIN') {
        return res.status(403).json({ message: "Only account admins can remove users" });
      }

      // Get the target user
      const targetUser = await storage.getCustomerUserById(id);
      if (!targetUser) {
        return res.status(404).json({ message: "User not found" });
      }

      // Verify same customer account
      if (targetUser.customerId !== customerUser.customerId) {
        return res.status(403).json({ message: "Cannot remove users from other accounts" });
      }

      // Prevent self-deletion
      if (targetUser.userId === userId) {
        return res.status(400).json({ message: "You cannot remove yourself from the account" });
      }

      await storage.deleteCustomerUser(id);
      res.status(204).send();
    } catch (error) {
      console.error("Error deleting customer user:", error);
      res.status(500).json({ message: "Failed to remove user" });
    }
  });

  // Get current user's customer role (for permission checking on frontend)
  app.get("/api/customer/me", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const customerUser = await storage.getCustomerUserByUserId(userId);
      
      if (!customerUser) {
        return res.status(404).json({ message: "Not associated with a customer account" });
      }

      // Get customer info
      const customer = await storage.getCustomer(customerUser.customerId);

      res.json({
        ...customerUser,
        customerName: customer?.customerName,
      });
    } catch (error) {
      console.error("Error fetching customer user info:", error);
      res.status(500).json({ message: "Failed to fetch user info" });
    }
  });

  // Accept invitation (public endpoint for invited users)
  app.post("/api/customer/users/accept-invitation/:invitationId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const userEmail = req.user.claims.email?.toLowerCase();
      const { invitationId } = req.params;

      // Get the invitation
      const invitation = await storage.getCustomerUserById(invitationId);
      if (!invitation) {
        return res.status(404).json({ message: "Invitation not found" });
      }

      if (invitation.status !== 'PENDING') {
        return res.status(400).json({ message: "This invitation has already been used or is no longer valid" });
      }

      // Verify email matches
      if (invitation.email.toLowerCase() !== userEmail) {
        return res.status(403).json({ message: "This invitation was sent to a different email address" });
      }

      // Check if user already has a customer user record
      const existingCustomerUser = await storage.getCustomerUserByUserId(userId);
      if (existingCustomerUser) {
        return res.status(400).json({ message: "You are already associated with a customer account" });
      }

      // Activate the invitation
      const updated = await storage.updateCustomerUserStatus(invitationId, 'ACTIVE', userId);
      res.json(updated);
    } catch (error) {
      console.error("Error accepting invitation:", error);
      res.status(500).json({ message: "Failed to accept invitation" });
    }
  });

  // Add insurance comment to accident (corporate only) - atomic server-side append for concurrency safety
  const insuranceCommentSchema = z.object({
    text: z.string().trim().min(1, "Comment text is required").max(60, "Comment must be 60 characters or less"),
  });

  app.post("/api/corporate/accidents/:accidentId/insurance-comments", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      // Validate request body with Zod schema
      const validationResult = insuranceCommentSchema.safeParse(req.body);
      if (!validationResult.success) {
        return res.status(400).json({ 
          message: "Invalid comment data",
          errors: validationResult.error.flatten().fieldErrors 
        });
      }

      const { text } = validationResult.data;

      // Create new comment object (text is already trimmed by Zod schema)
      const newComment = {
        id: Date.now().toString(),
        text: text,
        createdAt: new Date().toISOString(),
        createdBy: user?.firstName && user?.lastName 
          ? `${user.firstName} ${user.lastName}` 
          : user?.email || "Unknown",
      };

      // Use atomic database operation to prepend comment (prevents race conditions)
      const updatedAccident = await storage.addAccidentInsuranceComment(req.params.accidentId, newComment);
      
      if (!updatedAccident) {
        return res.status(404).json({ message: "Accident not found" });
      }

      res.json(updatedAccident);
    } catch (error) {
      console.error("Error adding insurance comment:", error);
      res.status(500).json({ message: "Failed to add insurance comment" });
    }
  });


  // GET /api/recruiting/candidate/:id/summary - Get candidate summary for scheduling
  app.get("/api/recruiting/candidate/:id/summary", async (req: Request, res: Response) => {
    // System-to-system authentication via API key
    const apiKey = req.headers['x-api-key'] || req.query.apiKey;
    const isSystemAuth = apiKey === process.env.DRIVERHUB_API_KEY;
    
    if (!isSystemAuth && !req.isAuthenticated()) {
      return res.status(401).json({ 
        error: "UNAUTHORIZED",
        message: "Valid API key or authentication required" 
      });
    }
    
    try {
      const { getCandidateSummary } = await import("./services/schedulingIntegrationService");
      const summary = await getCandidateSummary(req.params.id);
      
      if (!summary) {
        return res.status(404).json({ 
          error: "NOT_FOUND",
          message: "Candidate not found or not in ready status" 
        });
      }
      
      res.json({
        success: true,
        data: summary,
      });
    } catch (error: any) {
      console.error("[Scheduling] Candidate summary error:", error);
      res.status(500).json({ 
        error: "INTERNAL_ERROR",
        message: "Failed to retrieve candidate summary" 
      });
    }
  });

  // GET /api/recruiting/readiness-events - Poll for readiness change events
  app.get("/api/recruiting/readiness-events", async (req: Request, res: Response) => {
    // System-to-system authentication via API key
    const apiKey = req.headers['x-api-key'] || req.query.apiKey;
    const isSystemAuth = apiKey === process.env.DRIVERHUB_API_KEY;
    
    if (!isSystemAuth && !req.isAuthenticated()) {
      return res.status(401).json({ 
        error: "UNAUTHORIZED",
        message: "Valid API key or authentication required" 
      });
    }
    
    try {
      const { getReadinessChangesAfter } = await import("./services/schedulingIntegrationService");
      
      // Default to last 5 minutes if no since timestamp provided
      const since = req.query.since 
        ? new Date(req.query.since as string)
        : new Date(Date.now() - 5 * 60 * 1000);
      
      const limit = req.query.limit ? parseInt(req.query.limit as string) : 100;
      
      const events = await getReadinessChangesAfter(since, limit);
      
      res.json({
        success: true,
        data: events,
        meta: {
          since: since.toISOString(),
          count: events.length,
          limit,
        },
      });
    } catch (error: any) {
      console.error("[Scheduling] Readiness events error:", error);
      res.status(500).json({ 
        error: "INTERNAL_ERROR",
        message: "Failed to retrieve readiness events" 
      });
    }
  });

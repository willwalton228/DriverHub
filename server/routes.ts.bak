      const { expirationDays, isActive } = req.body || {};
      if (expirationDays !== undefined && (typeof expirationDays !== "number" || expirationDays < 1)) {
        return res.status(400).json({ message: "expirationDays must be a positive number" });
      }
      const { updateExpirationRule } = await import("./services/recruitingConsentExpirationService");
      const rule = await updateExpirationRule(req.params.id, { expirationDays, isActive }, userId, user?.email || null);
      if (!rule) {
        return res.status(404).json({ message: "Rule not found" });
      }
      res.json(rule);
    } catch (error: any) {

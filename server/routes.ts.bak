        .map((d: any) => ({
          id: d.id,
          displayName: `${d.user?.firstName || ''} ${d.user?.lastName || ''}`.trim() || d.user?.email || `Driver ${d.id}`
        }));

      res.json(filtered);
    } catch (error) {
      console.error("Error searching drivers:", error);
      res.status(500).json({ message: "Failed to search drivers" });

  // POST /api/recruiting/saved-views - Create a new saved view
  app.post("/api/recruiting/saved-views", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      const user = await storage.getUser(userId);
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user' && user.role !== 'recruiter' && user.role !== 'hiring_manager')) {
        return res.status(403).json({ message: "Forbidden: Recruiting access required" });
      }

      const { recruitingSavedViewsService } = await import("./services/recruitingSavedViewsService");
      const { name, description, type, icon, color, filters, sortBy, sortOrder, market, displayOrder } = req.body;

      if (!name || !filters) {
        return res.status(400).json({ message: "Name and filters are required" });
      }

      const viewType = (type === 'shared' && (user.role === 'admin' || user.role === 'recruiting_admin' || user.role === 'super_user')) 
        ? 'shared' 
        : 'private';

      const view = await recruitingSavedViewsService.createSavedView({
        name,
        description,
        type: viewType,
        icon,
        color,
        filters,
        sortBy: sortBy || 'appliedAt',
        sortOrder: sortOrder || 'desc',
        createdBy: user.id,
        market: viewType === 'shared' ? market : null,
        displayOrder: displayOrder || 99,
        isActive: true,
      });

      res.status(201).json(view);
    } catch (error: any) {
      console.error("Error creating saved view:", error);
      res.status(500).json({ message: "Failed to create saved view" });
    }
  });


  // GET /api/move-events/range - Get events for a time range with cursor pagination
  app.get("/api/move-events/range", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { startTime, endTime, eventTypes, status, cursor, limit } = req.query;

      if (!startTime || !endTime) {
        return res.status(400).json({ message: "startTime and endTime query parameters are required" });
      }

      const start = new Date(startTime as string);
      const end = new Date(endTime as string);

      if (isNaN(start.getTime()) || isNaN(end.getTime())) {
        return res.status(400).json({ message: "Invalid date format. Use ISO 8601 format." });
      }

      const { getEventsForTimeRange } = await import("./moveEventService");
      const result = await getEventsForTimeRange({
        startTime: start,
        endTime: end,
        eventTypes: eventTypes ? (eventTypes as string).split(',') as ('MOVE_CREATED' | 'MOVE_UPDATED')[] : undefined,
        status: status as string | undefined,
        cursor: cursor as string | undefined,
        limit: limit ? parseInt(limit as string, 10) : 100,
      });

      res.json(result);
    } catch (error) {
      console.error("[Move Events] Error fetching events for range:", error);
      res.status(500).json({ message: "Failed to fetch events for range" });
    }
  });


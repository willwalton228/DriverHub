  // ==========================================
  // CLAIM LIFECYCLE STATE MACHINE ENDPOINTS
  // ==========================================

  // Get claim events (audit trail) for a claim
  app.get("/api/claims/:claimId/events", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { claimId } = req.params;
      const events = await storage.getClaimEventsByClaimId(claimId);

      res.json(events.map(event => ({
        id: event.id,
        claim_id: event.claimId,
        from_status: event.fromStatus,
        to_status: event.toStatus,
        changed_by_user_id: event.changedByUserId,
        changed_by_name: event.changedByName,
        note: event.note,
        created_at: event.createdAt?.toISOString(),
      })));
    } catch (error) {
      console.error("Error fetching claim events:", error);
      res.status(500).json({ message: "Failed to fetch claim events" });
    }
  });

  // Transition claim status (with validation)
  app.post("/api/claims/:claimId/transition", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { claimId } = req.params;
      const { to_status, note } = req.body;

      if (!to_status) {
        return res.status(400).json({ message: "to_status is required" });
      }

      // Import state machine helpers
      const { isValidTransition, canUserTransition, CLAIM_STATUSES } = await import('./helpers/claimStateMachine');
      type ClaimStatus = typeof CLAIM_STATUSES[number];

      // Validate the target status is a valid claim status
      if (!CLAIM_STATUSES.includes(to_status as ClaimStatus)) {
        return res.status(400).json({ 
          message: `Invalid status: ${to_status}. Valid statuses are: ${CLAIM_STATUSES.join(', ')}` 
        });
      }

      // Get current claim
      const accident = await storage.getAccidentById(claimId);
      if (!accident) {
        return res.status(404).json({ message: "Claim not found" });
      }

      const fromStatus = (accident.claimStatus || 'DRAFT') as ClaimStatus;
      const toStatus = to_status as ClaimStatus;

      // Validate the transition is allowed
      if (!isValidTransition(fromStatus, toStatus)) {
        return res.status(400).json({ 
          message: `Invalid transition from ${fromStatus} to ${toStatus}` 
        });
      }

      // Check user has permission for this transition
      const userRole = user?.role || '';
      const permissionCheck = canUserTransition(userRole, fromStatus, toStatus);
      if (!permissionCheck.allowed) {
        return res.status(403).json({ message: permissionCheck.reason });
      }

      const userName = `${user?.firstName || ''} ${user?.lastName || ''}`.trim() || user?.email || 'Unknown';
      const result = await storage.transitionClaimStatus(claimId, toStatus, userId, userName, note);

      if (!result) {
        return res.status(500).json({ message: "Failed to transition claim status" });
      }

      // Log audit event for status transition
      const eventType = toStatus === 'CLOSED' || toStatus === 'DENIED' ? 'CLAIM_CLOSED' : 'STATUS_CHANGED';
      await storage.createClaimAuditLog({
        claimId: claimId,
        userId: userId,
        eventType: eventType,
        actionSummary: `Claim status changed from ${fromStatus} to ${toStatus}${note ? ` - Note: ${note}` : ''}`,
        previousValue: fromStatus,
        newValue: toStatus,
        metadata: note ? JSON.stringify({ note }) : null,
      });

      res.json({
        accident: {
          id: result.accident.id,
          claim_status: result.accident.claimStatus,
          updated_at: result.accident.updatedAt?.toISOString(),
        },
        event: {
          id: result.event.id,
          claim_id: result.event.claimId,
          from_status: result.event.fromStatus,
          to_status: result.event.toStatus,
          changed_by_user_id: result.event.changedByUserId,
          changed_by_name: result.event.changedByName,
          note: result.event.note,
          created_at: result.event.createdAt?.toISOString(),
        },
      });
    } catch (error) {
      console.error("Error transitioning claim status:", error);
      res.status(500).json({ message: "Failed to transition claim status" });
    }
  });

  // Get available transitions for a claim
  app.get("/api/claims/:claimId/available-transitions", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { claimId } = req.params;

      // Get current claim
      const accident = await storage.getAccidentById(claimId);
      if (!accident) {
        return res.status(404).json({ message: "Claim not found" });
      }

      const { getAvailableTransitions, getStatusDisplayInfo, isClaimEditable, canAddAdditionalInfo, CLAIM_STATUSES } = await import('./helpers/claimStateMachine');
      type ClaimStatus = typeof CLAIM_STATUSES[number];

      const currentStatus = (accident.claimStatus || 'DRAFT') as ClaimStatus;
      const userRole = user?.role || '';
      const availableTransitions = getAvailableTransitions(currentStatus, userRole);
      const statusInfo = getStatusDisplayInfo(currentStatus);

      res.json({
        current_status: currentStatus,
        status_info: statusInfo,
        available_transitions: availableTransitions.map(status => ({
          status,
          ...getStatusDisplayInfo(status),
        })),
        is_editable: isClaimEditable(currentStatus),
        can_add_info: canAddAdditionalInfo(currentStatus),
      });
    } catch (error) {
      console.error("Error fetching available transitions:", error);
      res.status(500).json({ message: "Failed to fetch available transitions" });
    }
  });


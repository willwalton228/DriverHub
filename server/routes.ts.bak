  // Create a health override (Admin only)
  app.post("/api/accounts/:id/health-override", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      // Only admins can create overrides
      if (!role || !['super_admin', 'corporate_admin'].includes(role)) {
        return res.status(403).json({ message: "Only administrators can create health overrides" });
      }

      const { overrideType, overrideValue, reason, expiresAt } = req.body;
      
      if (!overrideValue || !reason || !expiresAt) {
        return res.status(400).json({ message: "Missing required fields: overrideValue, reason, expiresAt" });
      }
      
      if (!['green', 'yellow', 'red'].includes(overrideValue)) {
        return res.status(400).json({ message: "Invalid overrideValue. Must be green, yellow, or red" });
      }
      
      const expiresDate = new Date(expiresAt);
      if (isNaN(expiresDate.getTime()) || expiresDate <= new Date()) {
        return res.status(400).json({ message: "Invalid expiresAt. Must be a future date" });
      }

      const override = await storage.createHealthOverride({
        accountId: req.params.id,
        createdBy: currentUser!.id,
        overrideType: overrideType || 'overall_health',
        overrideValue,
        reason,
        expiresAt: expiresDate,
      });

      res.status(201).json(override);
    } catch (error) {
      console.error("Error creating health override:", error);
      res.status(500).json({ message: "Failed to create health override" });
    }
  });

  // Remove a health override (Admin only)
  app.delete("/api/health-overrides/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      // Only admins can remove overrides
      if (!role || !['super_admin', 'corporate_admin'].includes(role)) {
        return res.status(403).json({ message: "Only administrators can remove health overrides" });
      }

      const { reason } = req.body;
      if (!reason) {
        return res.status(400).json({ message: "Reason is required for removing an override" });
      }

      const override = await storage.deactivateHealthOverride(req.params.id, currentUser!.id, reason);
      if (!override) {
        return res.status(404).json({ message: "Override not found" });
      }

      res.json(override);
    } catch (error) {
      console.error("Error removing health override:", error);
      res.status(500).json({ message: "Failed to remove health override" });
    }
  });


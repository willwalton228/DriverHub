  app.get("/api/corporate/invoicing/statements/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { getStatement } = await import("./services/billingStatementService");
      const statement = await getStatement(req.params.id);
      if (!statement) return res.status(404).json({ message: "Statement not found" });
      res.json(statement);
    } catch (error) {
      console.error("Error fetching statement:", error);
      res.status(500).json({ message: "Failed to fetch statement" });
    }
  });

  app.post("/api/corporate/invoicing/statements", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { customerId, periodStartDate, periodEndDate, statementType } = req.body;
      if (!customerId || !periodStartDate || !periodEndDate) {
        return res.status(400).json({ message: "customerId, periodStartDate, and periodEndDate are required" });
      }
      const { generateStatement } = await import("./services/billingStatementService");
      const statement = await generateStatement({
        customerId,
        periodStartDate,
        periodEndDate,
        statementType: statementType || "monthly",
        generatedBy: req.user?.id || "system",
      });
      res.status(201).json(statement);
    } catch (error: any) {
      console.error("Error generating statement:", error);
      res.status(500).json({ message: error.message || "Failed to generate statement" });
    }
  });

  app.get("/api/corporate/invoicing/statements/:id/pdf", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { getStatement, generateStatementPDF } = await import("./services/billingStatementService");
      const statement = await getStatement(req.params.id);
      if (!statement) return res.status(404).json({ message: "Statement not found" });

      const doc = generateStatementPDF(statement);
      res.setHeader('Content-Type', 'application/pdf');
      res.setHeader('Content-Disposition', `attachment; filename="statement-${statement.statementNumber}.pdf"`);
      doc.pipe(res);
      doc.end();
    } catch (error) {
      console.error("Error generating statement PDF:", error);
      res.status(500).json({ message: "Failed to generate statement PDF" });
    }
  });

  app.post("/api/corporate/invoicing/statements/:id/email", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { getStatement } = await import("./services/billingStatementService");
      const statement = await getStatement(req.params.id);
      if (!statement) return res.status(404).json({ message: "Statement not found" });

      const { emails } = req.body;
      if (!emails || !Array.isArray(emails) || emails.length === 0) {
        return res.status(400).json({ message: "At least one email address is required" });
      }

      const { customerStatements } = await import("@shared/schema");
      const { eq } = await import("drizzle-orm");
      const { db } = await import("./db");
      await db.update(customerStatements)
        .set({
          sentAt: new Date(),
          sentBy: req.user?.id,
          sentToEmails: emails,
          updatedAt: new Date(),
        })
        .where(eq(customerStatements.id, req.params.id));

      res.json({ message: "Statement queued for delivery", sentTo: emails });
    } catch (error) {
      console.error("Error sending statement:", error);
      res.status(500).json({ message: "Failed to send statement" });
    }
  });


  // ============================================
  // SLA & Services Configuration
  // ============================================

  // Update SLA settings for an account
  app.patch("/api/accounts/:id/sla-settings", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const slaSchema = z.object({
        enabledServices: z.string().optional(),
        operatingHours: z.string().optional(),
        coverageExpectation: z.string().optional(),
        icAllowed: z.boolean().optional(),
        employeeOnly: z.boolean().optional(),
        driverTier: z.string().optional(),
      });

      const parsed = slaSchema.parse(req.body);

      // Update the customer with SLA settings
      const customer = await storage.getCustomer(req.params.id);
      if (!customer) {
        return res.status(404).json({ message: "Account not found" });
      }

      const updated = await storage.updateCustomer(req.params.id, {
        enabledServices: parsed.enabledServices,
        operatingHours: parsed.operatingHours,
        coverageExpectation: parsed.coverageExpectation,
        icAllowed: parsed.icAllowed,
        employeeOnly: parsed.employeeOnly,
        driverTier: parsed.driverTier,
      });

      // Log the SLA settings update as an activity event
      // Only use database user ID for FK compliance - if user not in DB, use null
      const dbUserId = currentUser?.id || null;
      await storage.createAccountActivityEvent({
        accountId: req.params.id,
        category: "system",
        eventType: "sla_settings_updated",
        summary: "SLA & Services settings were updated",
        createdByUserId: dbUserId,
        metadata: JSON.stringify({ 
          updatedFields: Object.keys(parsed).filter(k => parsed[k as keyof typeof parsed] !== undefined)
        }),
      });

      res.json(updated);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error updating SLA settings:", error);
      res.status(500).json({ message: "Failed to update SLA settings" });
    }
  });

  // Log an SLA breach event
  app.post("/api/accounts/:id/sla-breach", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const breachSchema = z.object({
        breachType: z.enum(["late_pickup", "missed_coverage", "escalation"]),
        description: z.string(),
        tripId: z.string().optional(),
      });

      const parsed = breachSchema.parse(req.body);

      // Increment the appropriate SLA metric counter
      const customer = await storage.getCustomer(req.params.id);
      if (!customer) {
        return res.status(404).json({ message: "Account not found" });
      }

      let updateField = {};
      if (parsed.breachType === "late_pickup") {
        updateField = { slaLatePickups: (customer.slaLatePickups || 0) + 1 };
      } else if (parsed.breachType === "missed_coverage") {
        updateField = { slaMissedCoverage: (customer.slaMissedCoverage || 0) + 1 };
      } else if (parsed.breachType === "escalation") {
        updateField = { slaEscalations: (customer.slaEscalations || 0) + 1 };
      }

      await storage.updateCustomer(req.params.id, updateField);

      // Log the SLA breach as an activity event
      // Only use database user ID for FK compliance - if user not in DB, use null
      const dbUserId = currentUser?.id || null;
      const event = await storage.createAccountActivityEvent({
        accountId: req.params.id,
        category: "system",
        eventType: "sla_breach",
        summary: `SLA Breach: ${parsed.breachType.replace("_", " ")} - ${parsed.description}`,
        createdByUserId: dbUserId,
        metadata: JSON.stringify({ 
          breachType: parsed.breachType,
          tripId: parsed.tripId,
        }),
      });

      res.json({ event, customer: await storage.getCustomer(req.params.id) });
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error logging SLA breach:", error);
      res.status(500).json({ message: "Failed to log SLA breach" });
    }
  });

  // ============================================
  // Claims Intelligence & Risk Profile
  // ============================================

  // Get claims intelligence data for an account
  app.get("/api/accounts/:id/claims-intelligence", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const claims = await storage.getAccidentsByCustomerId(req.params.id);
      const now = new Date();
      const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
      const ninetyDaysAgo = new Date(now.getTime() - 90 * 24 * 60 * 60 * 1000);

      // Summary metrics
      const openClaims = claims.filter((c: any) => 
        !["CLOSED", "PAID", "DENIED"].includes(c.claimStatus || "")
      ).length;
      
      const claimsLast30Days = claims.filter((c: any) => {
        const date = c.incidentDate || c.accidentDate;
        return date && new Date(date) >= thirtyDaysAgo;
      }).length;
      
      const claimsLast90Days = claims.filter((c: any) => {
        const date = c.incidentDate || c.accidentDate;
        return date && new Date(date) >= ninetyDaysAgo;
      }).length;

      // Financial totals
      const totalPaid = claims.reduce((sum: number, c: any) => 
        sum + (parseFloat(c.insurancePaid) || 0), 0
      );
      const totalReserved = claims.reduce((sum: number, c: any) => 
        sum + (parseFloat(c.insuranceReserve) || 0), 0
      );

      // Severity distribution
      const severityBuckets = {
        low: claims.filter((c: any) => c.claimSeverity === "LOW").length,
        medium: claims.filter((c: any) => c.claimSeverity === "MEDIUM").length,
        high: claims.filter((c: any) => c.claimSeverity === "HIGH").length,
        critical: claims.filter((c: any) => c.claimSeverity === "CRITICAL").length,
        unclassified: claims.filter((c: any) => !c.claimSeverity).length,
      };

      // Top claim types
      const claimTypeCounts: Record<string, number> = {};
      claims.forEach((c: any) => {
        const type = c.claimType || "UNSPECIFIED";
        claimTypeCounts[type] = (claimTypeCounts[type] || 0) + 1;
      });
      const topClaimTypes = Object.entries(claimTypeCounts)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 5)
        .map(([type, count]) => ({ type, count }));

      // Location analysis (repeated issues)
      const locationCounts: Record<string, number> = {};
      claims.forEach((c: any) => {
        const location = c.location || "Unknown";
        locationCounts[location] = (locationCounts[location] || 0) + 1;
      });
      const problemLocations = Object.entries(locationCounts)
        .filter(([_, count]) => count >= 2) // Only locations with 2+ claims
        .sort((a, b) => b[1] - a[1])
        .slice(0, 5)
        .map(([location, count]) => ({ location, count }));

      // Monthly trend data (last 12 months)
      const monthlyTrend: { month: string; count: number }[] = [];
      for (let i = 11; i >= 0; i--) {
        const monthStart = new Date(now.getFullYear(), now.getMonth() - i, 1);
        const monthEnd = new Date(now.getFullYear(), now.getMonth() - i + 1, 0);
        const monthName = monthStart.toLocaleString('default', { month: 'short', year: '2-digit' });
        
        const count = claims.filter((c: any) => {
          const date = c.incidentDate || c.accidentDate;
          if (!date) return false;
          const d = new Date(date);
          return d >= monthStart && d <= monthEnd;
        }).length;
        
        monthlyTrend.push({ month: monthName, count });
      }

      // Generate narrative
      let narrative = "";
      if (claims.length === 0) {
        narrative = "No claims have been recorded for this account. This is a positive indicator of operational safety.";
      } else {
        const parts: string[] = [];
        
        // Trend analysis
        const recentMonthCount = monthlyTrend.slice(-1)[0]?.count || 0;
        const previousMonthCount = monthlyTrend.slice(-2, -1)[0]?.count || 0;
        
        if (claimsLast30Days > 0) {
          if (recentMonthCount > previousMonthCount) {
            parts.push(`Claims increased in the last 30 days (${claimsLast30Days} claims)`);
          } else if (recentMonthCount < previousMonthCount) {
            parts.push(`Claims decreased in the last 30 days (${claimsLast30Days} claims)`);
          } else {
            parts.push(`${claimsLast30Days} claim(s) recorded in the last 30 days`);
          }
        }
        
        // Top claim type
        if (topClaimTypes.length > 0) {
          const topType = topClaimTypes[0];
          parts.push(`driven primarily by ${topType.type.toLowerCase().replace("_", " ")} incidents`);
        }
        
        // Problem locations
        if (problemLocations.length > 0) {
          const topLocation = problemLocations[0];
          parts.push(`with repeated issues at ${topLocation.location}`);
        }
        
        // High severity warning
        const highSeverity = severityBuckets.high + severityBuckets.critical;
        if (highSeverity > 0) {
          parts.push(`${highSeverity} high-severity or critical claim(s) require attention`);
        }
        
        // Financial impact
        if (totalPaid > 0 || totalReserved > 0) {
          const total = totalPaid + totalReserved;
          parts.push(`Total financial exposure: $${total.toLocaleString()}`);
        }
        
        narrative = parts.length > 0 ? parts.join(". ") + "." : "Claims activity is within normal parameters.";
      }

      // Risk score (simple calculation)
      let riskScore = 0;
      riskScore += openClaims * 5;
      riskScore += severityBuckets.critical * 20;
      riskScore += severityBuckets.high * 10;
      riskScore += severityBuckets.medium * 5;
      riskScore += claimsLast30Days * 3;
      const riskLevel = riskScore >= 50 ? "HIGH" : riskScore >= 25 ? "MEDIUM" : "LOW";

      res.json({
        summary: {
          totalClaims: claims.length,
          openClaims,
          claimsLast30Days,
          claimsLast90Days,
          totalPaid,
          totalReserved,
        },
        severityBuckets,
        topClaimTypes,
        problemLocations,
        monthlyTrend,
        narrative,
        riskScore,
        riskLevel,
        claims: claims.slice(0, 10), // Return latest 10 claims for display
      });
    } catch (error) {
      console.error("Error fetching claims intelligence:", error);
      res.status(500).json({ message: "Failed to fetch claims intelligence" });
    }
  });

  // Get claims efficiency metrics for an account (claims per 1,000 moves, claim $ per move, etc.)
  app.get("/api/accounts/:id/claims-efficiency", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const accountId = req.params.id;
      const now = new Date();
      const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
      const sixtyDaysAgo = new Date(now.getTime() - 60 * 24 * 60 * 60 * 1000);
      const ninetyDaysAgo = new Date(now.getTime() - 90 * 24 * 60 * 60 * 1000);
      const oneEightyDaysAgo = new Date(now.getTime() - 180 * 24 * 60 * 60 * 1000);

      // Get claims and trips for this account
      const claims = await storage.getAccidentsByCustomerId(accountId);
      
      // Get trip counts for different periods
      const tripResult30 = await db
        .select({ count: sql<number>`count(*)` })
        .from(trips)
        .where(and(eq(trips.customerId, accountId), gte(trips.tripDate, thirtyDaysAgo)));
      const moves30 = Number(tripResult30[0]?.count || 0);

      const tripResultPrior30 = await db
        .select({ count: sql<number>`count(*)` })
        .from(trips)
        .where(and(eq(trips.customerId, accountId), gte(trips.tripDate, sixtyDaysAgo), lt(trips.tripDate, thirtyDaysAgo)));
      const movesPrior30 = Number(tripResultPrior30[0]?.count || 0);

      const tripResult90 = await db
        .select({ count: sql<number>`count(*)` })
        .from(trips)
        .where(and(eq(trips.customerId, accountId), gte(trips.tripDate, ninetyDaysAgo)));
      const moves90 = Number(tripResult90[0]?.count || 0);

      const tripResultPrior90 = await db
        .select({ count: sql<number>`count(*)` })
        .from(trips)
        .where(and(eq(trips.customerId, accountId), gte(trips.tripDate, oneEightyDaysAgo), lt(trips.tripDate, ninetyDaysAgo)));
      const movesPrior90 = Number(tripResultPrior90[0]?.count || 0);

      // Filter claims by period
      const getClaimsInPeriod = (startDate: Date, endDate?: Date) => {
        return claims.filter((c: any) => {
          const date = c.incidentDate || c.accidentDate;
          if (!date) return false;
          const d = new Date(date);
          return d >= startDate && (!endDate || d < endDate);
        });
      };

      const claims30 = getClaimsInPeriod(thirtyDaysAgo);
      const claimsPrior30 = getClaimsInPeriod(sixtyDaysAgo, thirtyDaysAgo);
      const claims90 = getClaimsInPeriod(ninetyDaysAgo);
      const claimsPrior90 = getClaimsInPeriod(oneEightyDaysAgo, ninetyDaysAgo);

      // Calculate total claims cost (paid + reserved)
      const getClaimsCost = (claimsList: any[]) => {
        return claimsList.reduce((sum: number, c: any) => {
          const paid = parseFloat(c.insurancePaid || c.actualCost || '0') || 0;
          const reserved = parseFloat(c.insuranceReserve || c.probableCost || '0') || 0;
          return sum + paid + reserved;
        }, 0);
      };

      const claimsCost30 = getClaimsCost(claims30);
      const claimsCostPrior30 = getClaimsCost(claimsPrior30);
      const claimsCost90 = getClaimsCost(claims90);
      const claimsCostPrior90 = getClaimsCost(claimsPrior90);

      // Calculate claims per 1,000 moves
      const claimsPer1000Moves30 = moves30 > 0 ? (claims30.length / moves30) * 1000 : 0;
      const claimsPer1000MovesPrior30 = movesPrior30 > 0 ? (claimsPrior30.length / movesPrior30) * 1000 : 0;
      const claimsPer1000Moves90 = moves90 > 0 ? (claims90.length / moves90) * 1000 : 0;
      const claimsPer1000MovesPrior90 = movesPrior90 > 0 ? (claimsPrior90.length / movesPrior90) * 1000 : 0;

      // Calculate claim $ per move
      const claimDollarPerMove30 = moves30 > 0 ? claimsCost30 / moves30 : 0;
      const claimDollarPerMovePrior30 = movesPrior30 > 0 ? claimsCostPrior30 / movesPrior30 : 0;
      const claimDollarPerMove90 = moves90 > 0 ? claimsCost90 / moves90 : 0;
      const claimDollarPerMovePrior90 = movesPrior90 > 0 ? claimsCostPrior90 / movesPrior90 : 0;

      // Calculate trends (percentage change)
      const calcTrend = (current: number, prior: number): { direction: 'up' | 'down' | 'flat'; change: number } => {
        if (prior === 0 && current === 0) return { direction: 'flat', change: 0 };
        if (prior === 0) return { direction: 'up', change: 100 };
        const change = ((current - prior) / prior) * 100;
        if (Math.abs(change) < 5) return { direction: 'flat', change };
        return { direction: change > 0 ? 'up' : 'down', change };
      };

      // Monthly trend data for charts (last 6 months)
      const monthlyTrend: { month: string; claims: number; moves: number; claimsPer1000: number; claimDollarPerMove: number; totalCost: number }[] = [];
      for (let i = 5; i >= 0; i--) {
        const monthStart = new Date(now.getFullYear(), now.getMonth() - i, 1);
        const monthEnd = new Date(now.getFullYear(), now.getMonth() - i + 1, 0);
        const monthName = monthStart.toLocaleString('default', { month: 'short' });

        // Count claims in this month
        const monthClaims = claims.filter((c: any) => {
          const date = c.incidentDate || c.accidentDate;
          if (!date) return false;
          const d = new Date(date);
          return d >= monthStart && d <= monthEnd;
        });

        // Get move count for this month
        const monthTripsResult = await db
          .select({ count: sql<number>`count(*)` })
          .from(trips)
          .where(and(
            eq(trips.customerId, accountId),
            gte(trips.tripDate, monthStart),
            lte(trips.tripDate, monthEnd)
          ));
        const monthMoves = Number(monthTripsResult[0]?.count || 0);

        const monthClaimsCost = getClaimsCost(monthClaims);

        monthlyTrend.push({
          month: monthName,
          claims: monthClaims.length,
          moves: monthMoves,
          claimsPer1000: monthMoves > 0 ? (monthClaims.length / monthMoves) * 1000 : 0,
          claimDollarPerMove: monthMoves > 0 ? monthClaimsCost / monthMoves : 0,
          totalCost: monthClaimsCost,
        });
      }

      res.json({
        period30: {
          claimsPer1000Moves: claimsPer1000Moves30,
          claimDollarPerMove: claimDollarPerMove30,
          totalClaimsCost: claimsCost30,
          claimsCount: claims30.length,
          movesCount: moves30,
          trends: {
            claimsPer1000: calcTrend(claimsPer1000Moves30, claimsPer1000MovesPrior30),
            claimDollarPerMove: calcTrend(claimDollarPerMove30, claimDollarPerMovePrior30),
            totalCost: calcTrend(claimsCost30, claimsCostPrior30),
          },
        },
        period90: {
          claimsPer1000Moves: claimsPer1000Moves90,
          claimDollarPerMove: claimDollarPerMove90,
          totalClaimsCost: claimsCost90,
          claimsCount: claims90.length,
          movesCount: moves90,
          trends: {
            claimsPer1000: calcTrend(claimsPer1000Moves90, claimsPer1000MovesPrior90),
            claimDollarPerMove: calcTrend(claimDollarPerMove90, claimDollarPerMovePrior90),
            totalCost: calcTrend(claimsCost90, claimsCostPrior90),
          },
        },
        monthlyTrend,
      });
    } catch (error) {
      console.error("Error fetching claims efficiency:", error);
      res.status(500).json({ message: "Failed to fetch claims efficiency" });
    }
  });


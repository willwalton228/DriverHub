  // Driver acknowledges/confirms a shift assignment
  app.post("/api/scheduling/assignments/:id/acknowledge", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const assignmentId = req.params.id;
      
      // First verify this assignment belongs to the user
      const assignments = await storage.getAssignmentsByUserId(userId);
      const assignment = assignments.find((a: any) => a.id === assignmentId);
      
      if (!assignment) {
        return res.status(404).json({ message: "Assignment not found or not authorized" });
      }
      
      if (assignment.status !== 'assigned') {
        return res.status(400).json({ message: "Assignment is not in a state that can be acknowledged" });
      }
      
      // Update assignment status to confirmed
      const { updateAssignment } = await import("./schedulingService");
      const updated = await updateAssignment(assignmentId, {
        status: 'confirmed',
        confirmedAt: new Date(),
      }, userId, req.user.claims.email);
      
      res.json(updated);
    } catch (error: any) {
      console.error("Error acknowledging assignment:", error);
      res.status(500).json({ message: error.message || "Failed to acknowledge assignment" });
    }
  });


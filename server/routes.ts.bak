  // GET /api/recruiting/referrals/rewards/my - Get my rewards
  app.get("/api/recruiting/referrals/rewards/my", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { getRewardsForReferrer } = await import("./recruitingService");
      
      const rewards = await getRewardsForReferrer(userId);
      
      const totalPending = rewards
        .filter(r => r.status === 'pending' || r.status === 'approved')
        .reduce((sum, r) => sum + parseFloat(r.amount), 0);
      
      const totalPaid = rewards
        .filter(r => r.status === 'paid')
        .reduce((sum, r) => sum + parseFloat(r.amount), 0);
      
      res.json({ rewards, totalPending, totalPaid });
    } catch (error) {
      console.error("[Recruiting] Error fetching rewards:", error);
      res.status(500).json({ message: "Failed to fetch rewards" });
    }
  });


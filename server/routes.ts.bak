  // PATCH /api/recruiting/candidates/:id - Update candidate
  app.patch("/api/recruiting/candidates/:id", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      const { updateCandidate } = await import("./recruitingService");
      const candidate = await updateCandidate(req.params.id, req.body, userId, user?.email || null);

      if (!candidate) {
        return res.status(404).json({ message: "Candidate not found" });
      }

      res.json(candidate);
    } catch (error: any) {

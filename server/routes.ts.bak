  app.patch("/api/recruiting/assignment-rules/:id", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });
      const user = await storage.getUser(userId);
      if (!user || !["admin", "super_user", "recruiting_admin"].includes(user.role || "")) {
        return res.status(403).json({ message: "Admin access required" });
      }
      const { recruitingAssignmentRules } = await import("@shared/schema");
      const { eq } = await import("drizzle-orm");
      const updates: any = { updatedAt: new Date(), updatedBy: userId };
      const allowed = ["name", "description", "strategy", "market", "workerType", "maxActiveApplications",
                       "eligibleRecruiters", "requiredSkillTagIds", "priority", "isActive", "marketWeight", "skillWeight", "workloadWeight"];
      for (const key of allowed) {
        if (req.body[key] !== undefined) updates[key] = req.body[key];
      }
      const [updated] = await db.update(recruitingAssignmentRules).set(updates).where(eq(recruitingAssignmentRules.id, req.params.id)).returning();
      if (!updated) return res.status(404).json({ message: "Assignment rule not found" });
      res.json(updated);
    } catch (error: any) {
      console.error("[AssignmentRules] Error updating:", error);
      res.status(500).json({ message: "Failed to update assignment rule" });
    }
  });


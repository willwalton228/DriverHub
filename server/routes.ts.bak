        const performer = activity.performedByUserId ? await storage.getUser(activity.performedByUserId) : null;
        return {
          ...activity,
          performedByName: performer ? `${performer.firstName || ''} ${performer.lastName || ''}`.trim() || performer.email || 'Unknown' : 'System',
        };

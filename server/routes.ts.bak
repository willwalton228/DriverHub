  // Create employee (corporate only)
  app.post("/api/corporate/employees", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      // Auto-assign Employee ID if not provided
      let dataWithId = { ...req.body };
      if (!dataWithId.employeeId) {
        dataWithId.employeeId = await storage.getNextEmployeeId();
      }

      const validatedData = insertEmployeeSchema.parse(dataWithId);
      const employee = await storage.createEmployee(validatedData);

      // Send invitation email if work email is provided
      const workEmail = employee.workEmail;
      if (workEmail) {
        try {
          // Generate unique invite code
          const inviteCode = Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);
          
          // Set expiration to 7 days from now
          const expiresAt = new Date();
          expiresAt.setDate(expiresAt.getDate() + 7);

          // Check if invitation already exists for this email
          const existingInvitation = await storage.getInvitationByEmail(workEmail);
          if (!existingInvitation || existingInvitation.usedAt) {
            // Create invitation record
            await storage.createUserInvitation({
              email: workEmail,
              role: "employee",
              invitedBy: userId,
              inviteCode,
              expiresAt,
            });

            // Send invitation email
            await sendInvitationEmail({
              to: workEmail,
              firstName: employee.firstName,
              lastName: employee.lastName,
              role: "employee",
              inviteCode,
            });
          }
        } catch (emailError) {
          console.error("Error sending employee invitation email:", emailError);
          // Don't fail the employee creation if email fails
        }
      }

      res.json(employee);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error creating employee:", error);
      res.status(500).json({ message: "Failed to create employee" });
    }
  });


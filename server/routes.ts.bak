  // POST /api/sla-definitions - Create a new SLA definition
  app.post("/api/sla-definitions", async (req: Request, res: Response) => {
    try {
      let authUserId: string | null = (req as any).session?.userId || null;
      if (!authUserId && (req as any).user?.claims?.sub) {
        authUserId = (req as any).user.claims.sub;
      }
      if (!authUserId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      let user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, authUserId!),
      });
      if (!user && (req as any).user?.claims?.email) {
        user = await db.query.users.findFirst({
          where: (users, { eq }) => eq(users.email, (req as any).user.claims.email),
        });
      }
      if (!user || (user.role !== 'admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { name, slaType, durationMinutes, warningThresholdMinutes, criticalThresholdMinutes, config, isGlobal } = req.body;
      
      if (!name || !slaType) {
        return res.status(400).json({ message: "name and slaType are required" });
      }

      const { createSlaDefinition } = await import("./slaService");
      const definition = await createSlaDefinition({
        name,
        slaType,
        durationMinutes,
        warningThresholdMinutes,
        criticalThresholdMinutes,
        config: config ? JSON.stringify(config) : null,
        isGlobal: isGlobal !== false,
        createdBy: user.id,
        updatedBy: user.id,
      });

      res.status(201).json(definition);
    } catch (error) {
      console.error("[SLA] Error creating definition:", error);
      res.status(500).json({ message: "Failed to create SLA definition" });
    }
  });

  // PUT /api/sla-definitions/:id - Update an SLA definition
  app.put("/api/sla-definitions/:id", async (req: Request, res: Response) => {
    try {
      let authUserId: string | null = (req as any).session?.userId || null;
      if (!authUserId && (req as any).user?.claims?.sub) {
        authUserId = (req as any).user.claims.sub;
      }

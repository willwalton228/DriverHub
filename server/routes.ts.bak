  // POST /api/recruiting/candidates/:id/communication-preferences/override - Admin override for DNC (with audit logging)
  app.post("/api/recruiting/candidates/:id/communication-preferences/override", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      // Admin-only override capability
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Admin access required for DNC override" });
      }

      const { id } = req.params;
      const { reason, intendedChannel, intendedAction } = req.body;
      
      if (!reason) {
        return res.status(400).json({ message: "Override reason is required" });
      }
      
      const [candidate] = await db.select().from(recruitingCandidates).where(eq(recruitingCandidates.id, id));
      
      if (!candidate) {
        return res.status(404).json({ message: "Candidate not found" });
      }

      if (!candidate.doNotContact) {
        return res.status(400).json({ message: "Candidate is not marked as Do Not Contact" });
      }

      // Log the override as a separate audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "COMM_PREFERENCE_OVERRIDE",
        entityType: "candidate",
        entityId: id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        previousValue: JSON.stringify({
          doNotContact: true,
          doNotContactReason: candidate.doNotContactReason,
        }),
        newValue: JSON.stringify({
          overrideReason: reason,
          intendedChannel: intendedChannel || null,
          intendedAction: intendedAction || null,
          overrideAt: new Date().toISOString(),
          overrideBy: user.id,
        }),
      });

      res.json({ 
        success: true, 
        message: "DNC override logged. You may proceed with contact.",
        overrideId: id,
        overrideBy: user.id,
        overrideAt: new Date().toISOString(),
      });
    } catch (error: any) {
      console.error("Error processing DNC override:", error);
      res.status(500).json({ message: "Failed to process DNC override" });
    }
  });

  // POST /api/recruiting/candidates/:id/check-contact-compliance - Server-side DNC and preference check
  app.post("/api/recruiting/candidates/:id/check-contact-compliance", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user) {
        return res.status(403).json({ message: "Forbidden" });
      }

      const { id } = req.params;
      const { intendedChannel } = req.body;
      
      const [candidate] = await db.select({
        id: recruitingCandidates.id,
        preferredChannel: recruitingCandidates.preferredChannel,
        contactHoursStart: recruitingCandidates.contactHoursStart,
        contactHoursEnd: recruitingCandidates.contactHoursEnd,
        contactTimezone: recruitingCandidates.contactTimezone,
        doNotContact: recruitingCandidates.doNotContact,
        doNotContactReason: recruitingCandidates.doNotContactReason,
      }).from(recruitingCandidates).where(eq(recruitingCandidates.id, id));
      
      if (!candidate) {
        return res.status(404).json({ message: "Candidate not found" });
      }

      const warnings: string[] = [];
      let canContact = true;
      let blockReason: string | null = null;

      // DNC is a hard stop
      if (candidate.doNotContact) {
        canContact = false;
        blockReason = candidate.doNotContactReason || "Candidate marked as Do Not Contact";
      } else {
        // Check channel preference
        if (intendedChannel && candidate.preferredChannel && candidate.preferredChannel !== intendedChannel) {
          warnings.push(`Preferred channel is ${candidate.preferredChannel}`);
        }

        // Check contact hours
        if (candidate.contactHoursStart && candidate.contactHoursEnd) {
          try {
            const tz = candidate.contactTimezone || "America/Chicago";
            const now = new Date();
            const formatter = new Intl.DateTimeFormat("en-US", { 
              hour: "2-digit", 
              minute: "2-digit", 
              hour12: false, 
              timeZone: tz 
            });
            const currentTime = formatter.format(now);
            
            const [currentHour, currentMin] = currentTime.split(":").map(Number);
            const [startHour, startMin] = candidate.contactHoursStart.split(":");
            const [endHour, endMin] = candidate.contactHoursEnd.split(":");
            
            const currentMinutes = currentHour * 60 + currentMin;
            const startMinutes = parseInt(startHour) * 60 + parseInt(startMin);
            const endMinutes = parseInt(endHour) * 60 + parseInt(endMin);
            
            if (currentMinutes < startMinutes || currentMinutes > endMinutes) {
              warnings.push(`Outside contact hours (${candidate.contactHoursStart} - ${candidate.contactHoursEnd} ${tz})`);
            }
          } catch {
            // Ignore timezone parsing errors
          }
        }
      }

      res.json({
        candidateId: id,
        canContact,
        blockReason,
        warnings,
        preferences: {
          preferredChannel: candidate.preferredChannel,
          contactHoursStart: candidate.contactHoursStart,
          contactHoursEnd: candidate.contactHoursEnd,
          contactTimezone: candidate.contactTimezone,
          doNotContact: candidate.doNotContact,
        },
      });
    } catch (error: any) {
      console.error("Error checking contact compliance:", error);
      res.status(500).json({ message: "Failed to check contact compliance" });
    }
  });

  // ==================== Recruiting Reason Codes API ====================
  
  // GET /api/recruiting/reason-codes - Get all reason codes (with optional filtering)
  app.get("/api/recruiting/reason-codes", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user) {
        return res.status(403).json({ message: "Forbidden" });
      }

      const { stage, market, activeOnly } = req.query;
      
      let query = db.select().from(recruitingReasonCodes);
      const conditions: any[] = [];
      
      if (stage) {
        conditions.push(eq(recruitingReasonCodes.stage, stage as string));
      }
      if (market) {
        conditions.push(or(eq(recruitingReasonCodes.market, market as string), isNull(recruitingReasonCodes.market)));
      }
      if (activeOnly === 'true') {
        conditions.push(eq(recruitingReasonCodes.isActive, true));
      }
      
      const reasonCodes = conditions.length > 0
        ? await query.where(and(...conditions)).orderBy(asc(recruitingReasonCodes.displayOrder))
        : await query.orderBy(asc(recruitingReasonCodes.displayOrder));

      res.json(reasonCodes);
    } catch (error: any) {
      console.error("Error fetching reason codes:", error);
      res.status(500).json({ message: "Failed to fetch reason codes" });
    }
  });

  // POST /api/recruiting/reason-codes - Create a new reason code
  app.post("/api/recruiting/reason-codes", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Admin access required" });
      }

      const { code, label, description, stage, isRequired, isActive, displayOrder, market } = req.body;
      
      if (!code || !label || !stage) {
        return res.status(400).json({ message: "Code, label, and stage are required" });
      }

      const [created] = await db.insert(recruitingReasonCodes).values({
        code,
        label,
        description: description || null,
        stage,
        isRequired: isRequired || false,
        isActive: isActive !== false,
        displayOrder: displayOrder || 0,
        market: market || null,
        createdBy: user.id,
        updatedBy: user.id,
      }).returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "REASON_CODE_CREATED",
        entityType: "reason_code",
        entityId: created.id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        newValue: JSON.stringify(created),
      });

      res.status(201).json(created);
    } catch (error: any) {
      console.error("Error creating reason code:", error);
      if (error.code === '23505') {
        res.status(409).json({ message: "Reason code with this code/stage/market combination already exists" });
      } else {
        res.status(500).json({ message: "Failed to create reason code" });
      }
    }
  });

  // PATCH /api/recruiting/reason-codes/:id - Update a reason code
  app.patch("/api/recruiting/reason-codes/:id", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Admin access required" });
      }

      const { id } = req.params;
      
      const [existing] = await db.select().from(recruitingReasonCodes).where(eq(recruitingReasonCodes.id, id));
      
      if (!existing) {
        return res.status(404).json({ message: "Reason code not found" });
      }

      const { code, label, description, stage, isRequired, isActive, displayOrder, market } = req.body;
      
      const updateData: any = {
        updatedAt: new Date(),
        updatedBy: user.id,
      };
      
      if (code !== undefined) updateData.code = code;
      if (label !== undefined) updateData.label = label;
      if (description !== undefined) updateData.description = description;
      if (stage !== undefined) updateData.stage = stage;
      if (isRequired !== undefined) updateData.isRequired = isRequired;
      if (isActive !== undefined) updateData.isActive = isActive;
      if (displayOrder !== undefined) updateData.displayOrder = displayOrder;
      if (market !== undefined) updateData.market = market;

      const [updated] = await db.update(recruitingReasonCodes)
        .set(updateData)
        .where(eq(recruitingReasonCodes.id, id))
        .returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "REASON_CODE_UPDATED",
        entityType: "reason_code",
        entityId: id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        previousValue: JSON.stringify(existing),
        newValue: JSON.stringify(updated),
      });

      res.json(updated);
    } catch (error: any) {
      console.error("Error updating reason code:", error);
      res.status(500).json({ message: "Failed to update reason code" });
    }
  });


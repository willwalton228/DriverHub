  // GET /api/recruiting/feature-flags - List all feature flags
  app.get("/api/recruiting/feature-flags", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user) {
        return res.status(403).json({ message: "Forbidden: Authentication required" });
      }

      const { market, scope, flagKey } = req.query;
      
      // Build query based on filters
      let query = db.select().from(recruitingFeatureFlags);
      const conditions: any[] = [];
      
      if (market) {
        conditions.push(eq(recruitingFeatureFlags.market, market as string));
      }
      if (scope) {
        conditions.push(eq(recruitingFeatureFlags.scope, scope as 'global' | 'market'));
      }
      if (flagKey) {
        conditions.push(eq(recruitingFeatureFlags.flagKey, flagKey as string));
      }
      
      const flags = conditions.length > 0
        ? await db.select().from(recruitingFeatureFlags).where(and(...conditions)).orderBy(asc(recruitingFeatureFlags.flagKey))
        : await db.select().from(recruitingFeatureFlags).orderBy(asc(recruitingFeatureFlags.flagKey));

      res.json(flags);
    } catch (error: any) {
      console.error("Error fetching feature flags:", error);
      res.status(500).json({ message: "Failed to fetch feature flags" });
    }
  });

  // GET /api/recruiting/feature-flags/:key/check - Check if a feature is enabled
  app.get("/api/recruiting/feature-flags/:key/check", async (req: any, res: Response) => {
    try {
      const { key } = req.params;
      const { market } = req.query;

      // Check for market-specific flag first, then global
      let flag = null;
      
      if (market) {
        const [marketFlag] = await db.select()
          .from(recruitingFeatureFlags)
          .where(and(
            eq(recruitingFeatureFlags.flagKey, key),
            eq(recruitingFeatureFlags.market, market as string)
          ));
        flag = marketFlag;
      }
      
      // If no market-specific flag, check global
      if (!flag) {
        const [globalFlag] = await db.select()
          .from(recruitingFeatureFlags)
          .where(and(
            eq(recruitingFeatureFlags.flagKey, key),
            eq(recruitingFeatureFlags.scope, 'global')
          ));
        flag = globalFlag;
      }

      res.json({
        flagKey: key,
        market: market || null,
        isEnabled: flag?.isEnabled || false,
        requiresExplicitEnable: flag?.requiresExplicitEnable ?? true,
        exists: !!flag,
      });
    } catch (error: any) {
      console.error("Error checking feature flag:", error);
      res.status(500).json({ message: "Failed to check feature flag" });
    }
  });

  // POST /api/recruiting/feature-flags - Create a new feature flag (admin only)
  app.post("/api/recruiting/feature-flags", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Admin access required" });
      }

      const { flagKey, name, description, scope, market, isEnabled, isMvpFeature, requiresExplicitEnable, warningMessage } = req.body;
      
      if (!flagKey || !name) {
        return res.status(400).json({ message: "flagKey and name are required" });
      }

      // Check for duplicate key + market combination
      const [existing] = await db.select()
        .from(recruitingFeatureFlags)
        .where(and(
          eq(recruitingFeatureFlags.flagKey, flagKey),
          market ? eq(recruitingFeatureFlags.market, market) : isNull(recruitingFeatureFlags.market)
        ));
      
      if (existing) {
        return res.status(409).json({ message: "Feature flag with this key and market already exists" });
      }

      const [newFlag] = await db.insert(recruitingFeatureFlags).values({
        flagKey,
        name,
        description,
        scope: scope || 'global',
        market: market || null,
        isEnabled: isEnabled ?? false,
        isMvpFeature: isMvpFeature ?? false,
        requiresExplicitEnable: requiresExplicitEnable ?? true,
        warningMessage,
        createdBy: user.id,
        createdByEmail: user.email,
        updatedBy: user.id,
        updatedByEmail: user.email,
      }).returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "FEATURE_FLAG_CREATED",
        entityType: "feature_flag",
        entityId: newFlag.id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        newValue: JSON.stringify(newFlag),
      });

      res.status(201).json(newFlag);
    } catch (error: any) {
      console.error("Error creating feature flag:", error);
      res.status(500).json({ message: "Failed to create feature flag" });
    }
  });


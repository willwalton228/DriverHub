      } = req.body;
      
      const userName = currentUser 
        ? `${currentUser.firstName || ''} ${currentUser.lastName || ''}`.trim() || currentUser.email 
        : 'Unknown';

      // Get previous state for comparison
      const previousState = await storage.getAccountReadiness(req.params.id);
      const previousScore = previousState?.readinessScore ?? 0;

      const readiness = await storage.upsertAccountReadiness(
        req.params.id,
        { 
          contractSigned, 
          pricingApproved, 
          insuranceDocsComplete, 
          paymentTermsApproved, 
          slaConfigured, 
          driverCapacityConfirmed,
          activationThreshold 
        },
        currentUser?.id || 'system',
        userName
      );

      // Log readiness change to Activity Timeline
      const newScore = readiness.readinessScore ?? 0;
      const scoreChange = newScore - previousScore;
      const changeDescription = scoreChange > 0 
        ? `increased from ${previousScore} to ${newScore}`
        : scoreChange < 0 
          ? `decreased from ${previousScore} to ${newScore}`
          : `unchanged at ${newScore}`;
      
      await storage.createAccountActivityEvent({
        accountId: req.params.id,
        category: 'status',
        eventType: 'readiness_updated',
        summary: `Readiness score ${changeDescription} by ${userName}`,
        triggeredBy: currentUser?.id || 'system',
      });


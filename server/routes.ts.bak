  // POST /api/recruiting/applications/:id/archive - Archive an application
  app.post("/api/recruiting/applications/:id/archive", async (req: Request, res: Response) => {
    try {
      if (!req.isAuthenticated()) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;

      const { enforceApplicationLock } = await import("./recruitingService");
      const lockResult = await enforceApplicationLock(req.params.id, userId);
      if (!lockResult.allowed) {
        return res.status(409).json({
          message: "Application is locked by another user",
          conflict: lockResult.conflict,
        });
      }

      const { reason } = req.body;
      const { archiveApplication } = await import("./recruitingService");
      const application = await archiveApplication(req.params.id, userId, reason);

      if (!application) {
        return res.status(404).json({ message: "Application not found" });
      }

      res.json({ message: "Application archived", application });
    } catch (error) {
      console.error("[Recruiting] Error archiving application:", error);
      res.status(500).json({ message: "Failed to archive application" });
    }
  });


  // === CUSTOMER ROUTES (Corporate only) ===
  // Search customers for DriverShift assignment (active DriverShift/Hybrid customers)
  app.get("/api/corporate/customers/search/drivershift", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const searchQuery = (req.query.q as string) || "";
      const customers = await storage.getAllCustomers();
      
      // Filter for active customers with DriverShift or Hybrid type
      const filteredCustomers = customers.filter(customer => {
        const isActive = customer.status === "active";
        const isDriverShiftOrHybrid = customer.customerType === "DriverShift" || 
                                       customer.customerType === "Hybrid" ||
                                       customer.customerType === "drivershift" ||
                                       customer.customerType === "hybrid";
        const matchesSearch = !searchQuery || 
                              customer.customerName?.toLowerCase().includes(searchQuery.toLowerCase());
        return isActive && isDriverShiftOrHybrid && matchesSearch;
      });

      // Return simplified list for dropdown
      res.json(filteredCustomers.map(c => ({
        id: c.id,
        customerName: c.customerName,
        customerType: c.customerType
      })));
    } catch (error) {
      console.error("Error searching customers:", error);
      res.status(500).json({ message: "Failed to search customers" });
    }
  });

  // Get account metrics for dashboard (corporate only)
  app.get("/api/corporate/customers/metrics", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const customers = await storage.getAllCustomers();
      const now = new Date();
      const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
      const ninetyDaysFromNow = new Date(now.getTime() + 90 * 24 * 60 * 60 * 1000);

      // Calculate metrics
      const activeAccounts = customers.filter(c => c.status === "active");
      const atRiskAccounts = customers.filter(c => 
        c.potentialRisk && c.potentialRisk.toLowerCase() !== "none" && c.potentialRisk !== ""
      );
      const pastDueAccounts = customers.filter(c => 
        c.arStatus && (c.arStatus.toLowerCase().includes("past due") || c.arStatus.toLowerCase().includes("overdue"))
      );
      const noActivityAccounts = customers.filter(c => {
        if (!c.lastInvoiceDate) return c.status === "active"; // Active but never invoiced
        const lastActivity = new Date(c.lastInvoiceDate);
        return lastActivity < thirtyDaysAgo && c.status === "active";
      });
      const contractsExpiringAccounts = customers.filter(c => {
        if (!c.cancellationDate) return false;
        const cancelDate = new Date(c.cancellationDate);
        return cancelDate > now && cancelDate <= ninetyDaysFromNow;
      });

      res.json({
        activeAccounts: { count: activeAccounts.length, ids: activeAccounts.map(c => c.id) },
        atRiskAccounts: { count: atRiskAccounts.length, ids: atRiskAccounts.map(c => c.id) },
        pastDueAccounts: { count: pastDueAccounts.length, ids: pastDueAccounts.map(c => c.id) },
        noActivityAccounts: { count: noActivityAccounts.length, ids: noActivityAccounts.map(c => c.id) },
        contractsExpiringAccounts: { count: contractsExpiringAccounts.length, ids: contractsExpiringAccounts.map(c => c.id) },
      });
    } catch (error) {
      console.error("Error fetching customer metrics:", error);
      res.status(500).json({ message: "Failed to fetch customer metrics" });
    }
  });

  // Search customers by name (for autocomplete)
  app.get("/api/customers/search", async (req: any, res: Response) => {
    try {
      // Support both session-based (password) and OIDC auth
      const userId = (req.session as any)?.userId || req.user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ error: "UNAUTHORIZED", message: "Not authenticated" });
      }
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const query = (req.query.q as string || '').toLowerCase().trim();
      const customers = await storage.getAllCustomers();
      
      const filtered = customers
        .filter((c: any) => {
          const name = (c.customerName || '').toLowerCase();
          const code = (c.customerCode || '').toLowerCase();
          return name.includes(query) || code.includes(query);
        })
        .slice(0, 20)
        .map((c: any) => ({
          id: c.id,
          name: c.customerName || `Customer ${c.id}`
        }));

      res.json(filtered);
    } catch (error) {
      console.error("Error searching customers:", error);
      res.status(500).json({ message: "Failed to search customers" });
    }
  });


  // ============================================================================
  // RECRUITING - MARKET DEMAND SIGNALS
  // ============================================================================

  // GET /api/recruiting/demand-signals - List demand signals with filters
  app.get("/api/recruiting/demand-signals", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      const user = await storage.getUser(userId);
      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'corporate' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Recruiting access required" });
      }

      const { market, isActive, effectiveDate } = req.query;
      
      const conditions: any[] = [];
      
      if (market) {
        conditions.push(eq(marketDemandSignals.market, market as string));
      }
      if (isActive !== undefined) {
        conditions.push(eq(marketDemandSignals.isActive, isActive === 'true'));
      }
      
      let signals;
      if (conditions.length > 0) {
        signals = await db.select().from(marketDemandSignals)
          .where(and(...conditions))
          .orderBy(desc(marketDemandSignals.effectiveFrom));
      } else {
        signals = await db.select().from(marketDemandSignals)
          .orderBy(desc(marketDemandSignals.effectiveFrom));
      }
      
      // Filter by effective date if provided
      if (effectiveDate) {
        const checkDate = new Date(effectiveDate as string);
        signals = signals.filter(s => {
          const from = new Date(s.effectiveFrom);
          const to = new Date(s.effectiveTo);
          return checkDate >= from && checkDate <= to;
        });
      }

      res.json(signals);
    } catch (error: any) {
      console.error("Error fetching demand signals:", error);
      res.status(500).json({ message: "Failed to fetch demand signals" });
    }
  });

  // POST /api/recruiting/demand-signals - Create a new demand signal (admin only)
  app.post("/api/recruiting/demand-signals", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Admin access required" });
      }

      const { market, workerType, workType, expectedHeadcount, effectiveFrom, effectiveTo, notes, priority } = req.body;
      
      if (!market || !expectedHeadcount || !effectiveFrom || !effectiveTo) {
        return res.status(400).json({ message: "Market, expected headcount, and date range are required" });
      }

      const [signal] = await db.insert(marketDemandSignals).values({
        market,
        workerType: workerType || null,
        workType: workType || null,
        expectedHeadcount: parseInt(expectedHeadcount),
        effectiveFrom,
        effectiveTo,
        notes: notes || null,
        priority: priority || 'normal',
        isActive: true,
        createdBy: user.id,
        createdByEmail: user.email,
        updatedBy: user.id,
        updatedByEmail: user.email,
      }).returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "DEMAND_SIGNAL_CREATED",
        entityType: "demand_signal",
        entityId: signal.id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        newValue: JSON.stringify(signal),
        changedFields: ["market", "expectedHeadcount", "effectiveFrom", "effectiveTo", "workerType", "workType", "notes", "priority"],
      });

      res.status(201).json(signal);
    } catch (error: any) {
      console.error("Error creating demand signal:", error);
      res.status(500).json({ message: "Failed to create demand signal" });
    }
  });

  // GET /api/recruiting/demand-signals/:id - Get a single demand signal
  app.get("/api/recruiting/demand-signals/:id", async (req: any, res: Response) => {
    try {

  app.post("/api/scheduling/messages/send-reminders", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { sendShiftReminderAlerts } = await import("./schedulingService");
      const { hoursBeforeShift } = req.body;
      const alertsSent = await sendShiftReminderAlerts(hoursBeforeShift || 24);
      
      res.json({ alertsSent });
    } catch (error) {
      console.error("[Scheduling] Error sending reminder alerts:", error);
      res.status(500).json({ message: "Failed to send reminder alerts" });
    }
  });

  // Get locations for targeting
  app.get("/api/scheduling/locations", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { db } = await import("./db");
      const { workLocations, drivers, employees } = await import("@shared/schema");
      const { sql } = await import("drizzle-orm");
      
      // Get work locations
      const locations = await db.select().from(workLocations);
      
      // Get unique locations from drivers and employees as fallback
      const driverLocations = await db.selectDistinct({ location: drivers.homeLocation })
        .from(drivers)
        .where(sql`home_location IS NOT NULL`);
      const employeeLocations = await db.selectDistinct({ location: employees.location })
        .from(employees)
        .where(sql`location IS NOT NULL`);
      
      const allLocations = [
        ...locations.map(l => ({ id: l.id, name: l.name })),
        ...driverLocations.filter(d => d.location).map(d => ({ id: d.location!, name: d.location! })),
        ...employeeLocations.filter(e => e.location).map(e => ({ id: e.location!, name: e.location! })),
      ];
      
      // Deduplicate
      const uniqueLocations = Array.from(new Map(allLocations.map(l => [l.id, l])).values());
      
      res.json(uniqueLocations);
    } catch (error) {
      console.error("[Scheduling] Error fetching locations:", error);
      res.status(500).json({ message: "Failed to fetch locations" });
    }
  });

  // Get roles for targeting
  app.get("/api/scheduling/roles", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { db } = await import("./db");
      const { drivers, employees } = await import("@shared/schema");
      const { sql } = await import("drizzle-orm");
      
      // Get unique roles from drivers and employees
      const driverRoles = await db.selectDistinct({ role: drivers.role })
        .from(drivers)
        .where(sql`role IS NOT NULL`);
      const employeeRoles = await db.selectDistinct({ role: employees.role })
        .from(employees)
        .where(sql`role IS NOT NULL`);
      
      const allRoles = [
        ...driverRoles.filter(d => d.role).map(d => d.role!),
        ...employeeRoles.filter(e => e.role).map(e => e.role!),
      ];
      
      // Deduplicate
      const uniqueRoles = [...new Set(allRoles)];
      
      res.json(uniqueRoles.map(r => ({ id: r, name: r })));
    } catch (error) {
      console.error("[Scheduling] Error fetching roles:", error);
      res.status(500).json({ message: "Failed to fetch roles" });
    }
  });


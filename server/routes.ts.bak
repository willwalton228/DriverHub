  // Apply template to create shifts on specific dates
  app.post("/api/scheduling/templates/:id/apply", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { applyTemplateToDateRange } = await import("./schedulingService");
      const { scheduleId, dates } = req.body;
      
      if (!scheduleId || !dates || !Array.isArray(dates) || dates.length === 0) {
        return res.status(400).json({ message: "scheduleId and dates array are required" });
      }
      
      const parsedDates = dates.map((d: string) => new Date(d));
      const shifts = await applyTemplateToDateRange(req.params.id, scheduleId, parsedDates, userId);
      
      res.status(201).json({ shifts, count: shifts.length });
    } catch (error: any) {
      console.error("[Scheduling] Error applying template:", error);
      res.status(400).json({ message: error.message || "Failed to apply template" });
    }
  });


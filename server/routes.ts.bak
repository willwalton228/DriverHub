  // POST /api/admin/integration-keys - Generate a new integration API key
  app.post("/api/admin/integration-keys", isAuthenticated, async (req: any, res: Response) => {
    try {
      if (req.user?.role !== 'admin') {
        return res.status(403).json({ message: "Access denied. Admin role required." });
      }

      const { keyName, sourceSystem, permissions, expiresAt } = req.body;

      if (!keyName || !sourceSystem) {
        return res.status(400).json({ message: "keyName and sourceSystem are required" });
      }

      // Generate a secure random API key
      const crypto = await import('crypto');
      const rawKey = crypto.randomBytes(32).toString('hex'); // 64 char hex string
      const keyPrefix = rawKey.substring(0, 8);
      const keyHash = crypto.createHash('sha256').update(rawKey).digest('hex');

      const [newKey] = await db.insert(integrationApiKeys).values({
        keyName,
        keyHash,
        keyPrefix,
        sourceSystem,
        permissions: permissions || ['events:write'],
        isActive: true,
        expiresAt: expiresAt ? new Date(expiresAt) : null,
        createdByUserId: req.user?.id || null,
      }).returning();

      console.log(`[Integration Keys] Generated new key: ${keyPrefix}... for ${sourceSystem}`);

      // Return the raw key ONLY ONCE - it cannot be retrieved later
      res.status(201).json({
        id: newKey.id,
        keyName: newKey.keyName,
        sourceSystem: newKey.sourceSystem,
        keyPrefix: newKey.keyPrefix,
        // IMPORTANT: This is the only time the full key is returned
        apiKey: rawKey,
        message: "Store this API key securely. It cannot be retrieved again.",
        expiresAt: newKey.expiresAt,
        createdAt: newKey.createdAt,
      });
    } catch (error) {
      console.error("[Integration Keys] Error generating key:", error);
      res.status(500).json({ message: "Failed to generate integration key" });
    }
  });

  // PATCH /api/admin/integration-keys/:id/revoke - Revoke an integration API key
  app.patch("/api/admin/integration-keys/:id/revoke", isAuthenticated, async (req: any, res: Response) => {
    try {
      if (req.user?.role !== 'admin') {
        return res.status(403).json({ message: "Access denied. Admin role required." });
      }

      const { id } = req.params;

      const [revokedKey] = await db.update(integrationApiKeys)
        .set({
          isActive: false,
          revokedAt: new Date(),
          revokedByUserId: req.user?.id || null,
        })
        .where(eq(integrationApiKeys.id, id))
        .returning();

      if (!revokedKey) {
        return res.status(404).json({ message: "Integration key not found" });
      }

      console.log(`[Integration Keys] Revoked key: ${revokedKey.keyPrefix}...`);

      res.json({
        message: "Key revoked successfully",
        id: revokedKey.id,
        keyPrefix: revokedKey.keyPrefix,
        revokedAt: revokedKey.revokedAt,
      });
    } catch (error) {
      console.error("[Integration Keys] Error revoking key:", error);
      res.status(500).json({ message: "Failed to revoke integration key" });
    }
  });

  // GET /api/admin/ingestion-audit - Get ingestion audit logs
  app.get("/api/admin/ingestion-audit", isAuthenticated, async (req: any, res: Response) => {
    try {
      if (req.user?.role !== 'admin' && req.user?.role !== 'corporate') {
        return res.status(403).json({ message: "Access denied" });
      }

      const { keyId, status, limit = 100, offset = 0 } = req.query;

      let query = db.select().from(ingestionAuditLogs);
      const conditions = [];

      if (keyId) {
        conditions.push(eq(ingestionAuditLogs.keyId, keyId as string));
      }
      if (status) {
        conditions.push(eq(ingestionAuditLogs.responseStatus, parseInt(status as string)));
      }

      if (conditions.length > 0) {
        query = query.where(and(...conditions)) as typeof query;
      }

      const logs = await query
        .orderBy(desc(ingestionAuditLogs.occurredAt))
        .limit(parseInt(limit as string))
        .offset(parseInt(offset as string));

      res.json(logs);
    } catch (error) {
      console.error("[Ingestion Audit] Error fetching audit logs:", error);
      res.status(500).json({ message: "Failed to fetch ingestion audit logs" });
    }
  });

  // GET /api/admin/ingestion-audit/summary - Get summary of ingestion activity
  app.get("/api/admin/ingestion-audit/summary", isAuthenticated, async (req: any, res: Response) => {
    try {
      if (req.user?.role !== 'admin' && req.user?.role !== 'corporate') {
        return res.status(403).json({ message: "Access denied" });
      }

      // Get summary stats for last 24 hours
      const oneDayAgo = new Date(Date.now() - 24 * 60 * 60 * 1000);

      const [stats] = await db.select({
        totalRequests: sql<number>`COUNT(*)`,
        totalEvents: sql<number>`COALESCE(SUM(${ingestionAuditLogs.eventCount}), 0)`,
        totalAccepted: sql<number>`COALESCE(SUM(${ingestionAuditLogs.acceptedCount}), 0)`,
        totalRejected: sql<number>`COALESCE(SUM(${ingestionAuditLogs.rejectedCount}), 0)`,
        totalDuplicates: sql<number>`COALESCE(SUM(${ingestionAuditLogs.duplicateCount}), 0)`,
        authFailures: sql<number>`SUM(CASE WHEN ${ingestionAuditLogs.responseStatus} = 401 THEN 1 ELSE 0 END)`,
        avgResponseTime: sql<number>`ROUND(AVG(${ingestionAuditLogs.responseTimeMs}), 0)`,
      }).from(ingestionAuditLogs)
        .where(gte(ingestionAuditLogs.occurredAt, oneDayAgo));

      // Get breakdown by key
      const byKey = await db.select({
        keyId: ingestionAuditLogs.keyId,
        keyPrefix: ingestionAuditLogs.keyPrefix,
        requestCount: sql<number>`COUNT(*)`,
        eventCount: sql<number>`COALESCE(SUM(${ingestionAuditLogs.eventCount}), 0)`,
      }).from(ingestionAuditLogs)
        .where(gte(ingestionAuditLogs.occurredAt, oneDayAgo))
        .groupBy(ingestionAuditLogs.keyId, ingestionAuditLogs.keyPrefix);

      res.json({
        period: '24h',
        stats,
        byKey,
      });
    } catch (error) {
      console.error("[Ingestion Audit] Error fetching summary:", error);
      res.status(500).json({ message: "Failed to fetch ingestion audit summary" });
    }
  });

  // ========================================
  // TICKET 22: Mapping Health Dashboard API
  // ========================================

  // GET /api/admin/mapping-health - Get mapping health statistics
  app.get("/api/admin/mapping-health", async (req: any, res: Response) => {
    try {
      // Support both session-based auth (password login) and OIDC auth
      let currentUserId: string | null = null;
      if ((req.session as any)?.userId) {
        currentUserId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        currentUserId = req.user.claims.sub;
      }
      
      if (!currentUserId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      // Look up user by ID, then fall back to email lookup (for OIDC linking)
      const userEmail = req.user?.claims?.email;
      let currentUser = await storage.getUser(currentUserId);
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!role || (role !== 'admin' && role !== 'corporate' && role !== 'super_user')) {
        return res.status(403).json({ message: "Access denied" });
      }

      const { since } = req.query;
      const sinceDate = since ? new Date(since as string) : new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);

      // Get mapping status counts
      const [stats] = await db.select({
        totalIngested: sql<number>`COUNT(*)`,
        mappedOk: sql<number>`SUM(CASE WHEN ${ingestedEvents.mappingStatus} = 'ok' THEN 1 ELSE 0 END)`,
        failedDriver: sql<number>`SUM(CASE WHEN ${ingestedEvents.mappingStatus} = 'failed_driver' THEN 1 ELSE 0 END)`,
        failedMove: sql<number>`SUM(CASE WHEN ${ingestedEvents.mappingStatus} = 'failed_move' THEN 1 ELSE 0 END)`,
        pending: sql<number>`SUM(CASE WHEN ${ingestedEvents.mappingStatus} = 'pending' OR ${ingestedEvents.mappingStatus} IS NULL THEN 1 ELSE 0 END)`,
      }).from(ingestedEvents)
        .where(gte(ingestedEvents.receivedAt, sinceDate));

      // Get quarantined events for review
      const quarantinedEvents = await db.select({
        eventId: ingestedEvents.eventId,
        eventType: ingestedEvents.eventType,
        mappingStatus: ingestedEvents.mappingStatus,
        mappingError: ingestedEvents.mappingError,
        driverId: ingestedEvents.driverId,
        moveId: ingestedEvents.moveId,
        receivedAt: ingestedEvents.receivedAt,
      }).from(ingestedEvents)
        .where(and(
          eq(ingestedEvents.processingStatus, 'failed_mapping'),
          gte(ingestedEvents.receivedAt, sinceDate)
        ))
        .orderBy(desc(ingestedEvents.receivedAt))
        .limit(50);

      // Calculate health percentage
      const total = Number(stats?.totalIngested || 0);
      const mapped = Number(stats?.mappedOk || 0);
      const healthPct = total > 0 ? Math.round((mapped / total) * 100) : 100;

      res.json({
        period: {
          since: sinceDate.toISOString(),
          until: new Date().toISOString(),
        },
        stats: {
          totalIngested: Number(stats?.totalIngested || 0),
          mappedOk: Number(stats?.mappedOk || 0),
          failedDriver: Number(stats?.failedDriver || 0),
          failedMove: Number(stats?.failedMove || 0),
          pending: Number(stats?.pending || 0),
        },
        healthPercentage: healthPct,
        healthStatus: healthPct >= 95 ? 'healthy' : healthPct >= 80 ? 'warning' : 'critical',
        quarantinedEvents,
      });
    } catch (error) {
      console.error("[Mapping Health] Error:", error);
      res.status(500).json({ message: "Failed to fetch mapping health" });
    }
  });

  // ========================================
  // TICKET 20: QA/Claims Case Management API
  // ========================================

  // GET /api/cases - List all cases with filtering
  app.get("/api/cases", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { status, caseType, severity, moveId, driverId, assignedQueue, limit = 50, offset = 0 } = req.query;

      let query = db.select().from(cases);

      const conditions = [];
      if (status && status !== 'all') {
        conditions.push(eq(cases.status, status as string));
      }
      if (caseType && caseType !== 'all') {
        conditions.push(eq(cases.caseType, caseType as string));
      }
      if (severity && severity !== 'all') {
        conditions.push(eq(cases.severity, severity as string));
      }
      if (moveId) {
        conditions.push(eq(cases.moveId, moveId as string));
      }
      if (driverId) {
        conditions.push(eq(cases.driverId, driverId as string));
      }
      if (assignedQueue && assignedQueue !== 'all') {
        conditions.push(eq(cases.assignedQueue, assignedQueue as string));
      }

      if (conditions.length > 0) {
        query = query.where(and(...conditions)) as typeof query;
      }

      const caseList = await query
        .orderBy(desc(cases.createdAt))
        .limit(parseInt(limit as string))
        .offset(parseInt(offset as string));

      res.json(caseList);
    } catch (error) {
      console.error("[Cases] Error listing cases:", error);
      res.status(500).json({ message: "Failed to list cases" });
    }
  });

  // GET /api/cases/summary - Get case summary stats
  app.get("/api/cases/summary", isAuthenticated, async (req: any, res: Response) => {
    try {
      const stats = await db.select({
        status: cases.status,
        caseType: cases.caseType,
        severity: cases.severity,
        count: sql<number>`count(*)::int`,
      })
        .from(cases)
        .groupBy(cases.status, cases.caseType, cases.severity);

      // Aggregate into summary
      const summary = {
        byStatus: { open: 0, in_review: 0, resolved: 0, closed: 0 },
        byType: { QA: 0, CLAIMS: 0 },
        bySeverity: { low: 0, medium: 0, high: 0 },
        total: 0,
      };

      for (const stat of stats) {
        summary.total += stat.count;
        
        if (stat.status && summary.byStatus[stat.status as keyof typeof summary.byStatus] !== undefined) {
          summary.byStatus[stat.status as keyof typeof summary.byStatus] += stat.count;
        }
        if (stat.caseType && summary.byType[stat.caseType as keyof typeof summary.byType] !== undefined) {
          summary.byType[stat.caseType as keyof typeof summary.byType] += stat.count;
        }
        if (stat.severity && summary.bySeverity[stat.severity as keyof typeof summary.bySeverity] !== undefined) {
          summary.bySeverity[stat.severity as keyof typeof summary.bySeverity] += stat.count;
        }
      }

      res.json(summary);
    } catch (error) {
      console.error("[Cases] Error fetching summary:", error);
      res.status(500).json({ message: "Failed to fetch case summary" });
    }
  });

  // GET /api/cases/:id - Get single case with activity
  app.get("/api/cases/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { id } = req.params;

      const [caseData] = await db.select().from(cases).where(eq(cases.id, id)).limit(1);
      
      if (!caseData) {
        return res.status(404).json({ message: "Case not found" });
      }

      // Get case activity
      const activity = await db.select().from(caseActivity)
        .where(eq(caseActivity.caseId, id))
        .orderBy(desc(caseActivity.occurredAt));

      res.json({
        ...caseData,
        activity,
      });
    } catch (error) {
      console.error("[Cases] Error fetching case:", error);
      res.status(500).json({ message: "Failed to fetch case" });
    }
  });

  // GET /api/cases/move/:moveId - Get cases by move ID
  app.get("/api/cases/move/:moveId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { moveId } = req.params;

      const moveCases = await db.select().from(cases)
        .where(eq(cases.moveId, moveId))
        .orderBy(desc(cases.createdAt));

      res.json(moveCases);
    } catch (error) {
      console.error("[Cases] Error fetching cases for move:", error);
      res.status(500).json({ message: "Failed to fetch cases for move" });
    }
  });

  // PATCH /api/cases/:id/status - Update case status
  app.patch("/api/cases/:id/status", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { id } = req.params;
      const userId = req.user.claims.sub;
      const { status, resolutionSummary } = req.body;

      const validStatuses = ['open', 'in_review', 'resolved', 'closed'];
      if (!validStatuses.includes(status)) {
        return res.status(400).json({ message: `Invalid status. Must be one of: ${validStatuses.join(', ')}` });
      }

      const [existingCase] = await db.select().from(cases).where(eq(cases.id, id)).limit(1);
      if (!existingCase) {
        return res.status(404).json({ message: "Case not found" });
      }

      const previousStatus = existingCase.status;

      // Update case
      const updateData: any = {
        status,
        updatedAt: new Date(),
      };

      if (status === 'resolved' || status === 'closed') {
        updateData.resolvedAt = new Date();
        updateData.resolvedByUserId = userId;
        if (resolutionSummary) {
          updateData.resolutionSummary = resolutionSummary;
        }
      }

      await db.update(cases).set(updateData).where(eq(cases.id, id));

      // Add activity record
      await db.insert(caseActivity).values({
        caseId: id,
        action: 'status_changed',
        actorId: userId,
        actorType: 'user',
        previousValue: previousStatus,
        newValue: status,
        notes: resolutionSummary || undefined,
      });

      const [updatedCase] = await db.select().from(cases).where(eq(cases.id, id)).limit(1);
      res.json(updatedCase);
    } catch (error) {
      console.error("[Cases] Error updating case status:", error);
      res.status(500).json({ message: "Failed to update case status" });
    }
  });

  // POST /api/cases/:id/activity - Add activity/note to case
  app.post("/api/cases/:id/activity", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { id } = req.params;
      const userId = req.user.claims.sub;
      const { action, notes, attachmentUrls } = req.body;

      const [existingCase] = await db.select({ id: cases.id }).from(cases).where(eq(cases.id, id)).limit(1);
      if (!existingCase) {
        return res.status(404).json({ message: "Case not found" });
      }

      const validActions = ['note_added', 'assigned', 'attachment_added', 'escalated'];
      if (!validActions.includes(action)) {
        return res.status(400).json({ message: `Invalid action. Must be one of: ${validActions.join(', ')}` });
      }

      const [newActivity] = await db.insert(caseActivity).values({
        caseId: id,
        action,
        actorId: userId,
        actorType: 'user',
        notes,
        attachmentUrls: attachmentUrls ? JSON.stringify(attachmentUrls) : undefined,
      }).returning();

      // Update case updated_at
      await db.update(cases).set({ updatedAt: new Date() }).where(eq(cases.id, id));

      res.status(201).json(newActivity);
    } catch (error) {
      console.error("[Cases] Error adding case activity:", error);
      res.status(500).json({ message: "Failed to add case activity" });
    }
  });

  // ============================================
  // TICKET 25: Integration Monitoring & Alerting
  // ============================================

  // Alert thresholds (could be moved to env/config)
  const ALERT_THRESHOLDS = {
    ingestionFailureRate: 0.1, // 10% failure rate triggers warning
    ingestionFailureRateCritical: 0.25, // 25% triggers critical
    noEventsMinutes: 30, // Alert if no events for 30 minutes
    latencyP95ThresholdMs: 60000, // 60 seconds processing latency
    mappingFailureRate: 0.15, // 15% mapping failure rate
    backlogThreshold: 1000, // More than 1000 unprocessed events
  };

  // GET /api/admin/integrations/monitoring/metrics - Get dashboard KPIs
  app.get("/api/admin/integrations/monitoring/metrics", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const now = new Date();
      const oneHourAgo = new Date(now.getTime() - 60 * 60 * 1000);
      const oneDayAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000);

      // Events received in last hour and day
      const [hourlyEvents] = await db.select({
        total: sql<number>`COUNT(*)::int`,
        failed: sql<number>`SUM(CASE WHEN ${ingestedEvents.processingStatus} = 'failed' THEN 1 ELSE 0 END)::int`,
      }).from(ingestedEvents)
        .where(gte(ingestedEvents.receivedAt, oneHourAgo));

      const [dailyEvents] = await db.select({
        total: sql<number>`COUNT(*)::int`,
        failed: sql<number>`SUM(CASE WHEN ${ingestedEvents.processingStatus} = 'failed' THEN 1 ELSE 0 END)::int`,
      }).from(ingestedEvents)
        .where(gte(ingestedEvents.receivedAt, oneDayAgo));

      // Processing latency (p50, p95) - for processed events in last 24 hours
      const [latencyStats] = await db.select({
        p50: sql<number>`PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (${ingestedEvents.processedAt} - ${ingestedEvents.receivedAt})) * 1000)::int`,
        p95: sql<number>`PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (${ingestedEvents.processedAt} - ${ingestedEvents.receivedAt})) * 1000)::int`,
        avgLatency: sql<number>`AVG(EXTRACT(EPOCH FROM (${ingestedEvents.processedAt} - ${ingestedEvents.receivedAt})) * 1000)::int`,
      }).from(ingestedEvents)
        .where(and(
          gte(ingestedEvents.receivedAt, oneDayAgo),
          isNotNull(ingestedEvents.processedAt)
        ));

      // Mapping failures
      const [mappingStats] = await db.select({
        total: sql<number>`COUNT(*)::int`,
        unmapped: sql<number>`SUM(CASE WHEN ${ingestedEvents.mappingStatus} != 'ok' THEN 1 ELSE 0 END)::int`,
        quarantined: sql<number>`SUM(CASE WHEN ${ingestedEvents.mappingStatus} = 'quarantined' THEN 1 ELSE 0 END)::int`,
      }).from(ingestedEvents)
        .where(gte(ingestedEvents.receivedAt, oneDayAgo));

      // Processor backlog (pending events)
      const [backlogStats] = await db.select({
        count: sql<number>`COUNT(*)::int`,
      }).from(ingestedEvents)
        .where(and(
          eq(ingestedEvents.processingStatus, 'pending'),
          isNull(ingestedEvents.processedAt)
        ));

      // Top failure reasons (last 24 hours)
      const failureReasons = await db.select({
        reason: ingestedEvents.processingError,
        count: sql<number>`COUNT(*)::int`,
      }).from(ingestedEvents)
        .where(and(
          gte(ingestedEvents.receivedAt, oneDayAgo),
          eq(ingestedEvents.processingStatus, 'failed'),
          isNotNull(ingestedEvents.processingError)
        ))
        .groupBy(ingestedEvents.processingError)
        .orderBy(desc(sql`COUNT(*)`))
        .limit(10);

      // Most recent event timestamp
      const [lastEvent] = await db.select({
        receivedAt: ingestedEvents.receivedAt,
      }).from(ingestedEvents)
        .orderBy(desc(ingestedEvents.receivedAt))
        .limit(1);

      // Event type breakdown (last 24 hours)
      const eventTypeBreakdown = await db.select({
        eventType: ingestedEvents.eventType,
        count: sql<number>`COUNT(*)::int`,
      }).from(ingestedEvents)
        .where(gte(ingestedEvents.receivedAt, oneDayAgo))
        .groupBy(ingestedEvents.eventType)
        .orderBy(desc(sql`COUNT(*)`));

      // Active alerts count
      const [activeAlertsCount] = await db.select({
        count: sql<number>`COUNT(*)::int`,
      }).from(integrationAlerts)
        .where(isNull(integrationAlerts.resolvedAt));

      res.json({
        eventsLastHour: {
          total: hourlyEvents?.total || 0,
          failed: hourlyEvents?.failed || 0,
          failureRate: hourlyEvents?.total ? ((hourlyEvents.failed || 0) / hourlyEvents.total) : 0,
        },
        eventsLastDay: {
          total: dailyEvents?.total || 0,
          failed: dailyEvents?.failed || 0,
          failureRate: dailyEvents?.total ? ((dailyEvents.failed || 0) / dailyEvents.total) : 0,
        },
        latency: {
          p50Ms: latencyStats?.p50 || 0,
          p95Ms: latencyStats?.p95 || 0,
          avgMs: latencyStats?.avgLatency || 0,
        },
        mapping: {
          total: mappingStats?.total || 0,
          unmapped: mappingStats?.unmapped || 0,
          quarantined: mappingStats?.quarantined || 0,
          failureRate: mappingStats?.total ? ((mappingStats.unmapped || 0) / mappingStats.total) : 0,
        },
        backlog: {
          pendingCount: backlogStats?.count || 0,
        },
        topFailureReasons: failureReasons,
        lastEventReceivedAt: lastEvent?.receivedAt || null,
        minutesSinceLastEvent: lastEvent?.receivedAt 
          ? Math.floor((now.getTime() - new Date(lastEvent.receivedAt).getTime()) / 60000)
          : null,
        eventTypeBreakdown,
        activeAlertsCount: activeAlertsCount?.count || 0,
        thresholds: ALERT_THRESHOLDS,
      });
    } catch (error) {
      console.error("[Monitoring] Error fetching metrics:", error);
      res.status(500).json({ message: "Failed to fetch integration metrics" });
    }
  });

  // GET /api/admin/integrations/monitoring/alerts - List alerts
  app.get("/api/admin/integrations/monitoring/alerts", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { status, limit: limitParam } = req.query;
      const queryLimit = parseInt(limitParam as string) || 50;

      let conditions = [];
      if (status === 'active') {
        conditions.push(isNull(integrationAlerts.resolvedAt));
      } else if (status === 'resolved') {
        conditions.push(isNotNull(integrationAlerts.resolvedAt));
      }

      const alerts = await db.select()
        .from(integrationAlerts)
        .where(conditions.length > 0 ? and(...conditions) : undefined)
        .orderBy(desc(integrationAlerts.triggeredAt))
        .limit(queryLimit);

      res.json(alerts);
    } catch (error) {
      console.error("[Monitoring] Error fetching alerts:", error);
      res.status(500).json({ message: "Failed to fetch alerts" });
    }
  });

  // POST /api/admin/integrations/monitoring/alerts/:id/resolve - Resolve an alert
  app.post("/api/admin/integrations/monitoring/alerts/:id/resolve", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { id } = req.params;
      const { resolutionNotes } = req.body;

      const [existingAlert] = await db.select()
        .from(integrationAlerts)
        .where(eq(integrationAlerts.id, id))
        .limit(1);

      if (!existingAlert) {
        return res.status(404).json({ message: "Alert not found" });
      }

      if (existingAlert.resolvedAt) {
        return res.status(400).json({ message: "Alert already resolved" });
      }

      const [updatedAlert] = await db.update(integrationAlerts)
        .set({
          resolvedAt: new Date(),
          resolvedBy: currentUser?.id || currentUserId,
          resolutionNotes: resolutionNotes || null,
        })
        .where(eq(integrationAlerts.id, id))
        .returning();

      res.json(updatedAlert);
    } catch (error) {
      console.error("[Monitoring] Error resolving alert:", error);
      res.status(500).json({ message: "Failed to resolve alert" });
    }
  });

  // POST /api/admin/integrations/monitoring/evaluate - Trigger alert evaluation
  app.post("/api/admin/integrations/monitoring/evaluate", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const triggeredAlerts: any[] = [];
      const now = new Date();
      const oneHourAgo = new Date(now.getTime() - 60 * 60 * 1000);
      
      // Helper: Check for existing unresolved alert of same type (deduplication)
      async function hasActiveAlert(alertType: string): Promise<boolean> {
        const [existing] = await db.select({ id: integrationAlerts.id })
          .from(integrationAlerts)
          .where(and(
            eq(integrationAlerts.alertType, alertType),
            isNull(integrationAlerts.resolvedAt),
            gte(integrationAlerts.triggeredAt, oneHourAgo) // Within cooldown window
          ))
          .limit(1);
        return !!existing;
      }

      // Check 1: Ingestion failure rate
      const [hourlyEvents] = await db.select({
        total: sql<number>`COUNT(*)::int`,
        failed: sql<number>`SUM(CASE WHEN ${ingestedEvents.processingStatus} = 'failed' THEN 1 ELSE 0 END)::int`,
      }).from(ingestedEvents)
        .where(gte(ingestedEvents.receivedAt, oneHourAgo));

      if (hourlyEvents && hourlyEvents.total > 0) {
        const failureRate = (hourlyEvents.failed || 0) / hourlyEvents.total;
        
        if (failureRate >= ALERT_THRESHOLDS.ingestionFailureRateCritical) {
          if (!await hasActiveAlert('ingestion_failure_spike')) {
            const [newAlert] = await db.insert(integrationAlerts).values({
              alertType: 'ingestion_failure_spike',
              severity: 'critical',
              title: 'Critical: High Ingestion Failure Rate',
              message: `Ingestion failure rate is ${(failureRate * 100).toFixed(1)}% in the last hour (${hourlyEvents.failed} of ${hourlyEvents.total} events failed)`,
              details: { failureRate, failed: hourlyEvents.failed, total: hourlyEvents.total, threshold: ALERT_THRESHOLDS.ingestionFailureRateCritical },
            }).returning();
            triggeredAlerts.push(newAlert);
          }
        } else if (failureRate >= ALERT_THRESHOLDS.ingestionFailureRate) {
          if (!await hasActiveAlert('ingestion_failure_spike')) {
            const [newAlert] = await db.insert(integrationAlerts).values({
              alertType: 'ingestion_failure_spike',
              severity: 'warning',
              title: 'Warning: Elevated Ingestion Failure Rate',
              message: `Ingestion failure rate is ${(failureRate * 100).toFixed(1)}% in the last hour (${hourlyEvents.failed} of ${hourlyEvents.total} events failed)`,
              details: { failureRate, failed: hourlyEvents.failed, total: hourlyEvents.total, threshold: ALERT_THRESHOLDS.ingestionFailureRate },
            }).returning();
            triggeredAlerts.push(newAlert);
          }
        }
      }

      // Check 2: No events received
      const [lastEvent] = await db.select({
        receivedAt: ingestedEvents.receivedAt,
      }).from(ingestedEvents)
        .orderBy(desc(ingestedEvents.receivedAt))
        .limit(1);

      if (lastEvent?.receivedAt) {
        const minutesSinceLastEvent = Math.floor((now.getTime() - new Date(lastEvent.receivedAt).getTime()) / 60000);
        if (minutesSinceLastEvent >= ALERT_THRESHOLDS.noEventsMinutes) {
          if (!await hasActiveAlert('no_events_received')) {
            const [newAlert] = await db.insert(integrationAlerts).values({
              alertType: 'no_events_received',
              severity: 'warning',
              title: 'Warning: No Events Received',
              message: `No events received in the last ${minutesSinceLastEvent} minutes`,
              details: { minutesSinceLastEvent, threshold: ALERT_THRESHOLDS.noEventsMinutes, lastEventAt: lastEvent.receivedAt },
            }).returning();
            triggeredAlerts.push(newAlert);
          }
        }
      }

      // Check 3: Latency threshold
      const [latencyStats] = await db.select({
        p95: sql<number>`PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (${ingestedEvents.processedAt} - ${ingestedEvents.receivedAt})) * 1000)::int`,
      }).from(ingestedEvents)
        .where(and(
          gte(ingestedEvents.receivedAt, oneHourAgo),
          isNotNull(ingestedEvents.processedAt)
        ));

      if (latencyStats?.p95 && latencyStats.p95 > ALERT_THRESHOLDS.latencyP95ThresholdMs) {
        if (!await hasActiveAlert('latency_threshold_exceeded')) {
          const [newAlert] = await db.insert(integrationAlerts).values({
            alertType: 'latency_threshold_exceeded',
            severity: 'warning',
            title: 'Warning: High Processing Latency',
            message: `P95 processing latency is ${(latencyStats.p95 / 1000).toFixed(1)} seconds (threshold: ${ALERT_THRESHOLDS.latencyP95ThresholdMs / 1000}s)`,
            details: { p95Ms: latencyStats.p95, thresholdMs: ALERT_THRESHOLDS.latencyP95ThresholdMs },
          }).returning();
          triggeredAlerts.push(newAlert);
        }
      }

      // Check 4: Mapping failures
      const [mappingStats] = await db.select({
        total: sql<number>`COUNT(*)::int`,
        failed: sql<number>`SUM(CASE WHEN ${ingestedEvents.mappingStatus} != 'ok' THEN 1 ELSE 0 END)::int`,
      }).from(ingestedEvents)
        .where(gte(ingestedEvents.receivedAt, oneHourAgo));

      if (mappingStats && mappingStats.total > 0) {
        const mappingFailureRate = (mappingStats.failed || 0) / mappingStats.total;
        if (mappingFailureRate >= ALERT_THRESHOLDS.mappingFailureRate) {
          if (!await hasActiveAlert('mapping_failure_spike')) {
            const [newAlert] = await db.insert(integrationAlerts).values({
              alertType: 'mapping_failure_spike',
              severity: 'warning',
              title: 'Warning: High Mapping Failure Rate',
              message: `Mapping failure rate is ${(mappingFailureRate * 100).toFixed(1)}% in the last hour`,
              details: { failureRate: mappingFailureRate, failed: mappingStats.failed, total: mappingStats.total, threshold: ALERT_THRESHOLDS.mappingFailureRate },
            }).returning();
            triggeredAlerts.push(newAlert);
          }
        }
      }

      // Check 5: Backlog
      const [backlogStats] = await db.select({
        count: sql<number>`COUNT(*)::int`,
      }).from(ingestedEvents)
        .where(and(
          eq(ingestedEvents.processingStatus, 'pending'),
          isNull(ingestedEvents.processedAt)
        ));

      if (backlogStats && backlogStats.count > ALERT_THRESHOLDS.backlogThreshold) {
        if (!await hasActiveAlert('processor_backlog')) {
          const [newAlert] = await db.insert(integrationAlerts).values({
            alertType: 'processor_backlog',
            severity: 'critical',
            title: 'Critical: Large Processor Backlog',
            message: `${backlogStats.count} events are pending processing (threshold: ${ALERT_THRESHOLDS.backlogThreshold})`,
            details: { backlogCount: backlogStats.count, threshold: ALERT_THRESHOLDS.backlogThreshold },
          }).returning();
          triggeredAlerts.push(newAlert);
        }
      }

      res.json({
        evaluated: true,
        triggeredAlerts: triggeredAlerts.length,
        alerts: triggeredAlerts,
      });
    } catch (error) {
      console.error("[Monitoring] Error evaluating alerts:", error);
      res.status(500).json({ message: "Failed to evaluate alerts" });
    }
  });

  // GET /api/admin/integrations/monitoring/logs - Export logs for troubleshooting
  app.get("/api/admin/integrations/monitoring/logs", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { from, to, status, limit: limitParam, format } = req.query;
      const queryLimit = Math.min(parseInt(limitParam as string) || 500, 5000);

      const conditions = [];
      
      if (from) {
        const fromDate = new Date(from as string);
        if (!isNaN(fromDate.getTime())) {
          conditions.push(gte(ingestedEvents.receivedAt, fromDate));
        }
      }
      
      if (to) {
        const toDate = new Date(to as string);
        if (!isNaN(toDate.getTime())) {
          conditions.push(lte(ingestedEvents.receivedAt, toDate));
        }
      }

      if (status === 'failed') {
        conditions.push(eq(ingestedEvents.processingStatus, 'failed'));
      } else if (status === 'pending') {
        conditions.push(eq(ingestedEvents.processingStatus, 'pending'));
      } else if (status === 'quarantined') {
        conditions.push(eq(ingestedEvents.mappingStatus, 'quarantined'));
      }

      const logs = await db.select({
        eventId: ingestedEvents.eventId,
        eventType: ingestedEvents.eventType,
        moveId: ingestedEvents.moveId,
        driverId: ingestedEvents.driverId,
        receivedAt: ingestedEvents.receivedAt,
        processedAt: ingestedEvents.processedAt,
        processingStatus: ingestedEvents.processingStatus,
        processingError: ingestedEvents.processingError,
        mappingStatus: ingestedEvents.mappingStatus,
        mappingErrors: ingestedEvents.mappingErrors,
      }).from(ingestedEvents)
        .where(conditions.length > 0 ? and(...conditions) : undefined)
        .orderBy(desc(ingestedEvents.receivedAt))
        .limit(queryLimit);

      if (format === 'csv') {
        const csvHeader = 'Event ID,Event Type,Move ID,Driver ID,Received At,Processed At,Processing Status,Processing Error,Mapping Status,Mapping Errors\n';
        const csvRows = logs.map(log => [
          log.eventId,
          log.eventType,
          log.moveId || '',
          log.driverId || '',
          log.receivedAt?.toISOString() || '',
          log.processedAt?.toISOString() || '',
          log.processingStatus || '',
          (log.processingError || '').replace(/,/g, ';'),
          log.mappingStatus || '',
          JSON.stringify(log.mappingErrors || {}).replace(/,/g, ';'),
        ].join(','));

        res.setHeader('Content-Type', 'text/csv');
        res.setHeader('Content-Disposition', `attachment; filename=integration-logs-${new Date().toISOString().split('T')[0]}.csv`);
        res.send(csvHeader + csvRows.join('\n'));
      } else {
        res.json({
          logs,
          count: logs.length,
          limit: queryLimit,
        });
      }
    } catch (error) {
      console.error("[Monitoring] Error exporting logs:", error);
      res.status(500).json({ message: "Failed to export logs" });
    }
  });

  // ===========================================
  // Ticket 26: Event Schema Registry API
  // ===========================================

  // GET /api/schemas - List all event schemas
  app.get("/api/schemas", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Check for admin access
      const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);
      if (!user) {
        const [userByEmail] = await db.select().from(users)
          .where(eq(users.email, (req as any).user?.claims?.email || ''))
          .limit(1);
        if (!userByEmail || !['admin', 'super_user'].includes(userByEmail.role || '')) {
          return res.status(403).json({ message: "Admin access required" });
        }
      } else if (!['admin', 'super_user'].includes(user.role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { eventType, status } = req.query;
      
      const conditions: any[] = [];
      if (eventType) {
        conditions.push(eq(eventSchemas.eventType, eventType as string));
      }
      if (status && schemaStatuses.includes(status as any)) {
        conditions.push(eq(eventSchemas.status, status as string));
      }

      const schemas = await db.select()
        .from(eventSchemas)
        .where(conditions.length > 0 ? and(...conditions) : undefined)
        .orderBy(eventSchemas.eventType, desc(eventSchemas.schemaVersion));

      res.json({ schemas });
    } catch (error) {
      console.error("[Schemas] Error listing schemas:", error);
      res.status(500).json({ message: "Failed to list schemas" });
    }
  });

  // GET /api/schemas/:id - Get a specific schema by ID
  app.get("/api/schemas/:id", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { id } = req.params;
      const [schema] = await db.select().from(eventSchemas).where(eq(eventSchemas.id, id)).limit(1);

      if (!schema) {
        return res.status(404).json({ message: "Schema not found" });
      }

      res.json({ schema });
    } catch (error) {
      console.error("[Schemas] Error getting schema:", error);
      res.status(500).json({ message: "Failed to get schema" });
    }
  });

  // POST /api/schemas - Create a new schema
  app.post("/api/schemas", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Check for admin access
      let adminUser: any = null;
      const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);
      if (!user) {
        const [userByEmail] = await db.select().from(users)
          .where(eq(users.email, (req as any).user?.claims?.email || ''))
          .limit(1);
        if (!userByEmail || !['admin', 'super_user'].includes(userByEmail.role || '')) {
          return res.status(403).json({ message: "Admin access required" });
        }
        adminUser = userByEmail;
      } else if (!['admin', 'super_user'].includes(user.role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      } else {
        adminUser = user;
      }

      const { eventType, schemaVersion, schemaJson, description, requiredFields, deprecationWindowDays } = req.body;

      if (!eventType || !schemaVersion || !schemaJson) {
        return res.status(400).json({ message: "eventType, schemaVersion, and schemaJson are required" });
      }

      // Check for existing schema with same type and version
      const [existing] = await db.select()
        .from(eventSchemas)
        .where(and(
          eq(eventSchemas.eventType, eventType),
          eq(eventSchemas.schemaVersion, schemaVersion)
        ))
        .limit(1);

      if (existing) {
        return res.status(409).json({ 
          message: "Schema already exists for this event type and version",
          existingId: existing.id
        });
      }

      const [newSchema] = await db.insert(eventSchemas).values({
        eventType,
        schemaVersion,
        schemaJson,
        description,
        requiredFields: requiredFields || [],
        deprecationWindowDays: deprecationWindowDays || 30,
        createdBy: adminUser.id,
        status: 'active',
      }).returning();

      res.status(201).json({ schema: newSchema });
    } catch (error) {
      console.error("[Schemas] Error creating schema:", error);
      res.status(500).json({ message: "Failed to create schema" });
    }
  });

  // PATCH /api/schemas/:id/deprecate - Deprecate a schema
  app.patch("/api/schemas/:id/deprecate", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Check for admin access
      let adminUser: any = null;
      const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);
      if (!user) {
        const [userByEmail] = await db.select().from(users)
          .where(eq(users.email, (req as any).user?.claims?.email || ''))
          .limit(1);
        if (!userByEmail || !['admin', 'super_user'].includes(userByEmail.role || '')) {
          return res.status(403).json({ message: "Admin access required" });
        }
        adminUser = userByEmail;
      } else if (!['admin', 'super_user'].includes(user.role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      } else {
        adminUser = user;
      }

      const { id } = req.params;
      const { deprecationWindowDays } = req.body;

      const [schema] = await db.select().from(eventSchemas).where(eq(eventSchemas.id, id)).limit(1);
      if (!schema) {
        return res.status(404).json({ message: "Schema not found" });
      }

      if (schema.status !== 'active') {
        return res.status(400).json({ message: "Only active schemas can be deprecated" });
      }

      const [updated] = await db.update(eventSchemas)
        .set({
          status: 'deprecated',
          deprecatedAt: new Date(),
          deprecatedBy: adminUser.id,
          deprecationWindowDays: deprecationWindowDays || schema.deprecationWindowDays,
        })
        .where(eq(eventSchemas.id, id))
        .returning();

      res.json({ schema: updated });
    } catch (error) {
      console.error("[Schemas] Error deprecating schema:", error);
      res.status(500).json({ message: "Failed to deprecate schema" });
    }
  });


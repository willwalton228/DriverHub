      }

      // Check if requisition or market is paused (hiring freeze)
      if (req.body.requisitionId) {
        const { recruitingPauseService } = await import("./services/recruitingSlaService");
        const pauseStatus = await recruitingPauseService.isRequisitionPaused(req.body.requisitionId);
        if (pauseStatus.isPaused) {
          return res.status(409).json({ 
            message: "Applications are temporarily paused for this position.",
            reason: pauseStatus.reason || "Hiring freeze in effect"
          });
        }
      }

      const validatedData = insertApplicationSchema.parse(req.body);
      const application = await storage.createApplication(validatedData);
      
      // Log activity
      await storage.createApplicationActivity({
        applicationId: application.id,
        activityType: "application_created",
        description: "Application submitted",
        performedBy: req.user.claims.sub,
      });

      res.json(application);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });

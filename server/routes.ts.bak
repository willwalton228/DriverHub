  // GET /api/recruiting/reports/kpis - Get recruiting KPIs
  app.get("/api/recruiting/reports/kpis", async (req: Request, res: Response) => {
    if (!req.isAuthenticated()) {
      return res.status(401).json({ message: "Authentication required" });
    }
    try {
      const queryStartTime = performance.now();
      const { getRecruitingKPIs } = await import("./services/recruitingReportingService");
      const filters = {
        startDate: req.query.startDate ? new Date(req.query.startDate as string) : undefined,
        endDate: req.query.endDate ? new Date(req.query.endDate as string) : undefined,
        market: req.query.market as string | undefined,
        requisitionId: req.query.requisitionId as string | undefined,
      };
      const kpis = await getRecruitingKPIs(filters);
      // Log query timing for performance monitoring
      const { logQueryTiming } = await import("./services/queryTimingService");
      const queryDurationMs = Math.round(performance.now() - queryStartTime);
      logQueryTiming({ endpoint: "/api/recruiting/reports/kpis", queryName: "getRecruitingKPIs", method: "GET", durationMs: queryDurationMs, filters });

      res.json(kpis);
    } catch (error: any) {
      console.error("[Reporting] KPIs error:", error);
      res.status(500).json({ message: "Failed to get KPIs" });
    }
  });


  // QuickBooks Zod schemas
  const qbSettingsUpdateSchema = z.object({
    arAccountId: z.string().nullable().optional(),
    arAccountName: z.string().nullable().optional(),
    incomeAccountId: z.string().nullable().optional(),
    incomeAccountName: z.string().nullable().optional(),
    feeAccountId: z.string().nullable().optional(),
    feeAccountName: z.string().nullable().optional(),
    taxAccountId: z.string().nullable().optional(),
    taxAccountName: z.string().nullable().optional(),
    depositAccountId: z.string().nullable().optional(),
    depositAccountName: z.string().nullable().optional(),
    itemMappings: z.record(z.object({ itemId: z.string(), itemName: z.string() })).nullable().optional(),
    creditSyncMode: z.enum(['credit_memo', 'negative_line']).optional(),
    autoSyncEnabled: z.boolean().optional(),
    syncInvoicesOnSend: z.boolean().optional(),
    syncPaymentsOnReceive: z.boolean().optional(),
  });

  const qbConnectSchema = z.object({
    realmId: z.string().min(1, "QuickBooks Realm ID is required"),
    companyName: z.string().optional(),
  });

  const qbBatchSyncSchema = z.object({
    startDate: z.string().min(1, "Start date is required"),
    endDate: z.string().min(1, "End date is required"),
    entityTypes: z.array(z.enum(['invoice', 'payment'])).optional(),
  });

  // Get QuickBooks settings
  app.get("/api/corporate/integrations/quickbooks/settings", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const settings = await storage.getQuickbooksSettings();
      // Don't expose tokens in the response
      if (settings) {
        const { accessToken, refreshToken, ...safeSettings } = settings;
        return res.json({ ...safeSettings, hasTokens: !!accessToken });
      }
      res.json(null);
    } catch (error) {
      console.error("Error fetching QuickBooks settings:", error);
      res.status(500).json({ message: "Failed to fetch QuickBooks settings" });
    }
  });

  // Update QuickBooks settings (account mappings, sync options)
  app.put("/api/corporate/integrations/quickbooks/settings", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasAdminAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Admin access only" });
      }
      
      const validatedBody = qbSettingsUpdateSchema.parse(req.body);
      const {
        arAccountId, arAccountName,
        incomeAccountId, incomeAccountName,
        feeAccountId, feeAccountName,
        taxAccountId, taxAccountName,
        depositAccountId, depositAccountName,
        itemMappings,
        creditSyncMode,
        autoSyncEnabled,
        syncInvoicesOnSend,
        syncPaymentsOnReceive
      } = validatedBody;
      
      const settings = await storage.upsertQuickbooksSettings({
        arAccountId, arAccountName,
        incomeAccountId, incomeAccountName,
        feeAccountId, feeAccountName,
        taxAccountId, taxAccountName,
        depositAccountId, depositAccountName,
        itemMappings,
        creditSyncMode,
        autoSyncEnabled,
        syncInvoicesOnSend,
        syncPaymentsOnReceive,
        updatedBy: req.user.claims.sub,
      });
      
      const { accessToken, refreshToken, ...safeSettings } = settings;
      res.json({ ...safeSettings, hasTokens: !!accessToken });
    } catch (error) {
      console.error("Error updating QuickBooks settings:", error);
      res.status(500).json({ message: "Failed to update QuickBooks settings" });
    }
  });

  // Connect QuickBooks (stub - in production would initiate OAuth)
  app.post("/api/corporate/integrations/quickbooks/connect", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasAdminAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Admin access only" });
      }
      
      // In production, this would return an OAuth URL to redirect to QuickBooks
      // For now, we stub the connection with mock data
      const { realmId, companyName } = qbConnectSchema.parse(req.body);
      
      const settings = await storage.upsertQuickbooksSettings({
        realmId,
        isConnected: true,
        accessToken: `mock_access_token_${Date.now()}`, // In production, from OAuth
        refreshToken: `mock_refresh_token_${Date.now()}`,
        tokenExpiresAt: new Date(Date.now() + 3600000), // 1 hour from now
        connectionError: null,
        createdBy: req.user.claims.sub,
        updatedBy: req.user.claims.sub,
      });
      
      const { accessToken, refreshToken, ...safeSettings } = settings;
      res.json({ ...safeSettings, hasTokens: true, message: "QuickBooks connected successfully" });
    } catch (error) {

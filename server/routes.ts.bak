    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const { shiftIds } = req.body;
      if (!Array.isArray(shiftIds) || shiftIds.length === 0) {
        return res.status(400).json({ message: "shiftIds array required" });
      }
      const risks = await storage.assessSchedulingSlaRisk(shiftIds);
      res.json({ risks, assessedAt: new Date().toISOString(), shiftCount: shiftIds.length });
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to assess SLA risk" });
    }
  });

  app.get("/api/corporate/scheduling/sla-performance", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const startDate = req.query.startDate as string || new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
      const endDate = req.query.endDate as string || new Date().toISOString().split('T')[0];
      const events = await storage.getSchedulingSlaEvents({ startDate, endDate });
      const defs = await storage.getSchedulingSlaDefinitions();

      const totalEvents = events.length;
      const metCount = events.filter(e => e.status === 'met').length;
      const warningCount = events.filter(e => e.status === 'warning').length;
      const breachedCount = events.filter(e => e.status === 'breached').length;
      const pendingCount = events.filter(e => e.status === 'pending').length;
      const complianceRate = totalEvents > 0 ? ((metCount / totalEvents) * 100).toFixed(1) : '100.0';

      const byDefinition = defs.map(def => {
        const defEvents = events.filter(e => e.slaDefinitionId === def.id);
        const defMet = defEvents.filter(e => e.status === 'met').length;
        const defBreached = defEvents.filter(e => e.status === 'breached').length;
        return {
          definitionId: def.id,
          name: def.name,
          metricType: def.metricType,
          totalEvents: defEvents.length,
          met: defMet,
          breached: defBreached,
          complianceRate: defEvents.length > 0 ? ((defMet / defEvents.length) * 100).toFixed(1) : '100.0',
        };
      });

      res.json({
        period: { startDate, endDate },
        summary: { totalEvents, met: metCount, warning: warningCount, breached: breachedCount, pending: pendingCount, complianceRate },
        byDefinition,
      });
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to get SLA performance" });
    }
  });



  // Cross-Location Mobility Controls
  app.get("/api/corporate/scheduling/mobility-configs", isAuthenticated, async (req: any, res: Response) => {
    try {
      const entityId = req.query.entityId as string | undefined;
      const configs = await storage.getCrossLocationMobilityConfigs(entityId);
      res.json(configs);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to get mobility configs" });
    }
  });

  app.get("/api/corporate/scheduling/mobility-configs/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const config = await storage.getCrossLocationMobilityConfig(req.params.id);
      if (!config) return res.status(404).json({ message: "Config not found" });
      res.json(config);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to get mobility config" });
    }
  });

  app.post("/api/corporate/scheduling/mobility-configs", isAuthenticated, async (req: any, res: Response) => {
    try {
      const config = await storage.createCrossLocationMobilityConfig({ ...req.body, createdBy: req.user?.id });
      res.status(201).json(config);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to create mobility config" });
    }
  });

  app.patch("/api/corporate/scheduling/mobility-configs/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const config = await storage.updateCrossLocationMobilityConfig(req.params.id, req.body);
      if (!config) return res.status(404).json({ message: "Config not found" });
      res.json(config);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to update mobility config" });
    }
  });

  app.delete("/api/corporate/scheduling/mobility-configs/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      await storage.deleteCrossLocationMobilityConfig(req.params.id);
      res.json({ success: true });
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to delete mobility config" });
    }
  });

  app.get("/api/corporate/scheduling/travel-logs", isAuthenticated, async (req: any, res: Response) => {
    try {
      const filters: any = {};
      if (req.query.driverId) filters.driverId = req.query.driverId;
      if (req.query.userId) filters.userId = req.query.userId;
      if (req.query.startDate) filters.startDate = req.query.startDate;
      if (req.query.endDate) filters.endDate = req.query.endDate;
      if (req.query.riskLevel) filters.riskLevel = req.query.riskLevel;
      const logs = await storage.getCrossLocationTravelLogs(filters);
      res.json(logs);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to get travel logs" });
    }
  });

  app.post("/api/corporate/scheduling/travel-logs", isAuthenticated, async (req: any, res: Response) => {
    try {
      const log = await storage.createCrossLocationTravelLog(req.body);
      res.status(201).json(log);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to create travel log" });
    }
  });

  app.post("/api/corporate/scheduling/mobility-risk-assessment", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { driverId, targetLocationId, targetShiftDate, targetShiftStartTime } = req.body;
      if (!driverId || !targetLocationId || !targetShiftDate || !targetShiftStartTime) {
        return res.status(400).json({ message: "driverId, targetLocationId, targetShiftDate, and targetShiftStartTime are required" });
      }
      const result = await storage.assessCrossLocationMobilityRisk(driverId, targetLocationId, targetShiftDate, targetShiftStartTime);
      res.json(result);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to assess mobility risk" });
    }
  });

  app.get("/api/corporate/scheduling/mobility-summary", isAuthenticated, async (req: any, res: Response) => {
    try {
      const startDate = req.query.startDate as string || new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
      const endDate = req.query.endDate as string || new Date().toISOString().split('T')[0];
      const logs = await storage.getCrossLocationTravelLogs({ startDate, endDate });

      const totalTrips = logs.length;
      const highRiskTrips = logs.filter(l => l.riskLevel === 'high').length;
      const warningTrips = logs.filter(l => l.riskLevel === 'warning').length;
      const avgDistance = totalTrips > 0
        ? (logs.reduce((sum, l) => sum + parseFloat(l.travelDistanceMiles || '0'), 0) / totalTrips).toFixed(1)
        : '0';
      const avgTravelTime = totalTrips > 0
        ? Math.round(logs.reduce((sum, l) => sum + (l.travelTimeMinutes || 0), 0) / totalTrips)
        : 0;

      const uniqueDrivers = new Set(logs.map(l => l.driverId || l.userId).filter(Boolean));

      res.json({
        period: { startDate, endDate },
        summary: {
          totalTrips,
          highRiskTrips,
          warningTrips,
          safeTrips: totalTrips - highRiskTrips - warningTrips,
          avgDistanceMiles: avgDistance,
          avgTravelTimeMinutes: avgTravelTime,
          uniqueDrivers: uniqueDrivers.size,
        },
      });
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to get mobility summary" });
    }
  });


  // Scheduling Justifications & Narrative Capture
  app.get("/api/corporate/scheduling/justifications", isAuthenticated, async (req: any, res: Response) => {
    try {
      const filters: any = {};
      if (req.query.category) filters.category = req.query.category;
      if (req.query.scheduleId) filters.scheduleId = req.query.scheduleId;
      if (req.query.driverId) filters.driverId = req.query.driverId;
      if (req.query.createdById) filters.createdById = req.query.createdById;
      if (req.query.search) filters.search = req.query.search;
      if (req.query.startDate) filters.startDate = req.query.startDate;
      if (req.query.endDate) filters.endDate = req.query.endDate;
      const justifications = await storage.getSchedulingJustifications(filters);
      res.json(justifications);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to fetch justifications" });
    }
  });

  app.get("/api/corporate/scheduling/justifications/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const justification = await storage.getSchedulingJustification(req.params.id);
      if (!justification) return res.status(404).json({ message: "Justification not found" });
      res.json(justification);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to fetch justification" });
    }
  });

  app.post("/api/corporate/scheduling/justifications", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { category, narrative, scheduleId, shiftId, driverId, entityId, metadata } = req.body;
      if (!category || !narrative) {
        return res.status(400).json({ message: "Category and narrative are required" });
      }
      if (!["ot_override", "break_exception", "incident_mode"].includes(category)) {
        return res.status(400).json({ message: "Invalid category. Must be ot_override, break_exception, or incident_mode" });
      }
      if (narrative.trim().length < 10) {
        return res.status(400).json({ message: "Narrative must be at least 10 characters" });
      }
      const authId = req.user?.claims?.sub;
      if (!authId) return res.status(401).json({ message: "Not authenticated" });
      let dbUser = await storage.getUser(authId);
      if (!dbUser && req.user?.claims?.email) {
        dbUser = await storage.getUserByEmail(req.user.claims.email);
      }
      const actualUserId = dbUser?.id || authId;
      const userName = dbUser?.firstName && dbUser?.lastName
        ? `${dbUser.firstName} ${dbUser.lastName}`
        : dbUser?.email || req.user?.claims?.email || "Unknown";
      const justification = await storage.createSchedulingJustification({
        category,
        narrative: narrative.trim(),
        scheduleId: scheduleId || null,
        shiftId: shiftId || null,
        driverId: driverId || null,
        entityId: entityId || null,
        createdById: actualUserId,
        createdByName: userName,
        metadata: metadata || null,
      });
      res.status(201).json(justification);
    } catch (error: any) {
      res.status(500).json({ message: error.message || "Failed to create justification" });
    }
  });

  return app;
}

  // Roles allowed to access payroll export
  const payrollExportRoles = ['super_user', 'admin', 'payroll_admin', 'ops_manager', 'manager'];

  // Generate payroll export (JSON)
  app.post("/api/scheduling/payroll-export", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Role authorization check
      const user = await storage.getUser(userId);
      if (!user || !payrollExportRoles.includes(user.role || '')) {
        return res.status(403).json({ message: "Forbidden: Insufficient permissions for payroll export" });
      }

      const { generatePayrollExport } = await import("./schedulingService");
      const { startDate, endDate, locationIds } = req.body;
      
      if (!startDate || !endDate) {
        return res.status(400).json({ message: "startDate and endDate are required" });
      }

      const result = await generatePayrollExport(
        startDate,
        endDate,
        locationIds,
        userId
      );
      
      res.json(result);
    } catch (error: any) {
      console.error("[Scheduling] Error generating payroll export:", error);
      res.status(500).json({ message: "Failed to generate payroll export" });
    }
  });

  // Generate payroll export (CSV download)
  app.post("/api/scheduling/payroll-export/csv", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Role authorization check
      const user = await storage.getUser(userId);
      if (!user || !payrollExportRoles.includes(user.role || '')) {
        return res.status(403).json({ message: "Forbidden: Insufficient permissions for payroll export" });
      }

      const { generatePayrollExport, convertPayrollToCSV } = await import("./schedulingService");
      const { startDate, endDate, locationIds } = req.body;
      
      if (!startDate || !endDate) {
        return res.status(400).json({ message: "startDate and endDate are required" });
      }

      const result = await generatePayrollExport(
        startDate,
        endDate,
        locationIds,
        userId
      );
      
      const csv = convertPayrollToCSV(result.records);
      const filename = `payroll_export_${startDate}_to_${endDate}.csv`;
      
      res.setHeader('Content-Type', 'text/csv');
      res.setHeader('Content-Disposition', `attachment; filename="${filename}"`);
      res.send(csv);
    } catch (error: any) {
      console.error("[Scheduling] Error generating payroll CSV:", error);
      res.status(500).json({ message: "Failed to generate payroll CSV" });
    }
  });


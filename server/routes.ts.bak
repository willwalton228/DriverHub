  // GET /api/billing/summary - Get billing summary stats
  app.get("/api/billing/summary", isAuthenticated, async (req: any, res: Response) => {
    try {
      const stats = await db.select({
        status: invoiceLineCandidates.status,
        count: sql<number>`count(*)::int`,
        totalAmount: sql<string>`coalesce(sum(${invoiceLineCandidates.amount}::numeric), 0)::text`,
      })
        .from(invoiceLineCandidates)
        .groupBy(invoiceLineCandidates.status);

      const summary = {
        draft: { count: 0, amount: '0' },
        approved: { count: 0, amount: '0' },
        issued: { count: 0, amount: '0' },
      };

      for (const stat of stats) {
        if (stat.status && summary[stat.status as keyof typeof summary]) {
          summary[stat.status as keyof typeof summary] = {
            count: stat.count,
            amount: stat.totalAmount,
          };
        }
      }

      res.json(summary);
    } catch (error) {
      console.error("[Billing] Error fetching summary:", error);
      res.status(500).json({ message: "Failed to fetch billing summary" });
    }
  });


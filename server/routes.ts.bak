  // ==========================================
  // SCHEDULING – INSURANCE REPORTING PACK
  // ==========================================

  app.get("/api/corporate/scheduling/insurance-reports/generate", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const { periodType = "monthly", periodStart, entityId } = req.query as any;
      if (!periodStart) {
        return res.status(400).json({ message: "periodStart is required (YYYY-MM-DD)" });
      }
      const { generateFullInsuranceReport } = await import("./services/schedulingInsuranceService");
      const report = await generateFullInsuranceReport(entityId || null, periodType, periodStart);
      res.json(report);
    } catch (error: any) {

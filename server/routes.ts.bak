  // Create a new decision
  app.post("/api/accounts/:id/decisions", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const { decisionType, reason, expectedOutcome, effectiveDate, reviewDate } = req.body;
      
      if (!decisionType || !reason || !effectiveDate) {
        return res.status(400).json({ message: "Decision type, reason, and effective date are required" });
      }

      const validTypes = ['Repricing', 'SLA change', 'Risk Override', 'Exit', 'Other'];
      if (!validTypes.includes(decisionType)) {
        return res.status(400).json({ message: `Invalid decision type. Must be one of: ${validTypes.join(', ')}` });
      }

      const decision = await storage.createAccountDecision({
        accountId: req.params.id,
        decisionType,
        reason,
        expectedOutcome: expectedOutcome || null,
        effectiveDate: new Date(effectiveDate),
        reviewDate: reviewDate ? new Date(reviewDate) : null,
        enteredBy: currentUser?.id || null,
        enteredByName: currentUser ? `${currentUser.firstName || ''} ${currentUser.lastName || ''}`.trim() || currentUser.email : 'Unknown',
      });

      // Log major decisions (Repricing, SLA change, Risk Override, Exit) to Activity Timeline
      const majorTypes = ['Repricing', 'SLA change', 'Risk Override', 'Exit'];
      if (majorTypes.includes(decisionType)) {
        await storage.createAccountActivityEvent({
          accountId: req.params.id,
          category: 'status',
          eventType: 'major_decision',
          summary: `${decisionType} decision: ${reason.substring(0, 100)}${reason.length > 100 ? '...' : ''}`,
          triggeredBy: currentUser?.id || 'system',
        });
      }

      res.status(201).json(decision);
    } catch (error) {
      console.error("Error creating account decision:", error);
      res.status(500).json({ message: "Failed to create account decision" });
    }
  });


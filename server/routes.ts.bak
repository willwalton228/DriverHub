  // GET /api/external-access/logs - Get access logs (admin only)
  app.get("/api/external-access/logs", async (req: Request, res: Response) => {
    try {
      let authUserId: string | null = (req as any).session?.userId || null;
      if (!authUserId && (req as any).user?.claims?.sub) {
        authUserId = (req as any).user.claims.sub;
      }
      if (!authUserId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      let user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, authUserId!),
      });
      if (!user && (req as any).user?.claims?.email) {
        user = await db.query.users.findFirst({
          where: (users, { eq }) => eq(users.email, (req as any).user.claims.email),
        });
      }
      if (!user || (user.role !== 'admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { grantId, startDate, endDate, resource } = req.query;

      if (grantId) {
        const { getAccessLogs } = await import("./externalAccessService");
        const logs = await getAccessLogs(grantId as string);
        return res.json(logs);
      }

      const { getAllAccessLogs } = await import("./externalAccessService");
      const logs = await getAllAccessLogs({
        startDate: startDate ? new Date(startDate as string) : undefined,
        endDate: endDate ? new Date(endDate as string) : undefined,
        resource: resource as string | undefined,
      });

      res.json(logs);
    } catch (error) {
      console.error("[External Access] Error getting logs:", error);
      res.status(500).json({ message: "Failed to get access logs" });
    }
  });

  // ==========================================
  // EXTERNAL PORTAL ENDPOINTS (Token-based auth for carriers/brokers)
  // ==========================================

  // GET /api/external/validate - Validate external access token
  app.get("/api/external/validate", async (req: Request, res: Response) => {
    try {
      const token = req.headers["x-access-token"] as string;
      if (!token) {
        return res.status(401).json({ message: "Access token required" });
      }

      const { validateAccessToken, logExternalAccess } = await import("./externalAccessService");
      const grant = await validateAccessToken(token);

      if (!grant) {
        return res.status(401).json({ message: "Invalid or expired access token" });
      }

      await logExternalAccess({
        grant,
        accessedResource: "validate_token",
        requestMethod: "GET",
        requestPath: "/api/external/validate",
        ipAddress: req.ip,
        userAgent: req.headers["user-agent"],
      }, 200);

      res.json({
        valid: true,
        grantId: grant.id,
        granteeEmail: grant.grantedToEmail,
        granteeName: grant.grantedToName || grant.grantedToEmail,
        granteeOrganization: grant.grantedToOrg || "Unknown",
        role: grant.role,
        scopes: grant.allowedScopes || [],
        expiresAt: grant.expiresAt,
        customerRestriction: grant.customerId || null,
        claimRestriction: grant.claimId || null,
      });
    } catch (error) {
      console.error("[External Portal] Error validating token:", error);
      res.status(500).json({ message: "Token validation failed" });
    }
  });

  // GET /api/external/risp-summary - External access to RISP summary (no PII)
  app.get("/api/external/risp-summary", async (req: Request, res: Response) => {
    try {
      const token = req.headers["x-access-token"] as string;
      if (!token) {
        return res.status(401).json({ message: "Access token required" });
      }

      const { validateAccessToken, checkScopeAccess, logExternalAccess } = await import("./externalAccessService");
      const grant = await validateAccessToken(token);

      if (!grant) {
        return res.status(401).json({ message: "Invalid or expired access token" });
      }

      if (!checkScopeAccess(grant, 'risp_summary')) {
        await logExternalAccess({
          grant,
          accessedResource: "risp_summary",
          requestMethod: "GET",
          requestPath: "/api/external/risp-summary",
          ipAddress: req.ip,
          userAgent: req.headers["user-agent"],
        }, 403);
        return res.status(403).json({ message: "Access to this resource not permitted" });
      }

      const { customerId, periodDays } = req.query;
      const customerFilter = grant.customerId || customerId as string;

      const { getRISPSummaryMetrics } = await import("./rispSummaryService");
      const metrics = await getRISPSummaryMetrics({
        customerId: customerFilter,
        periodDays: periodDays ? parseInt(periodDays as string) : 30,
      });

      await logExternalAccess({
        grant,
        accessedResource: "risp_summary",
        resourceScope: customerFilter ? `customer:${customerFilter}` : "all",
        requestMethod: "GET",
        requestPath: "/api/external/risp-summary",
        ipAddress: req.ip,
        userAgent: req.headers["user-agent"],
      }, 200);

      res.json(metrics);
    } catch (error) {
      console.error("[External Portal] Error fetching RISP summary:", error);
      res.status(500).json({ message: "Failed to fetch RISP summary" });
    }
  });

  // GET /api/external/evidence-chain/:claimId - External access to evidence chain (limited)
  app.get("/api/external/evidence-chain/:claimId", async (req: Request, res: Response) => {
    try {
      const token = req.headers["x-access-token"] as string;
      if (!token) {
        return res.status(401).json({ message: "Access token required" });
      }

      const { validateAccessToken, checkScopeAccess, logExternalAccess } = await import("./externalAccessService");
      const grant = await validateAccessToken(token);

      if (!grant) {
        return res.status(401).json({ message: "Invalid or expired access token" });
      }

      if (!checkScopeAccess(grant, 'evidence_chain')) {
        await logExternalAccess({
          grant,
          accessedResource: "evidence_chain",
          resourceScope: `claim:${req.params.claimId}`,
          requestMethod: "GET",
          requestPath: `/api/external/evidence-chain/${req.params.claimId}`,
          ipAddress: req.ip,
          userAgent: req.headers["user-agent"],
        }, 403);
        return res.status(403).json({ message: "Access to this resource not permitted" });
      }

      if (grant.claimId && grant.claimId !== req.params.claimId) {
        await logExternalAccess({
          grant,
          accessedResource: "evidence_chain",
          resourceScope: `claim:${req.params.claimId}`,
          requestMethod: "GET",
          requestPath: `/api/external/evidence-chain/${req.params.claimId}`,
          ipAddress: req.ip,
          userAgent: req.headers["user-agent"],
        }, 403);
        return res.status(403).json({ message: "Access limited to specific claim" });
      }

      const { getEvidenceChainForClaim } = await import("./evidenceChainService");
      const chain = await getEvidenceChainForClaim(req.params.claimId);

      if (!chain) {
        await logExternalAccess({
          grant,
          accessedResource: "evidence_chain",
          resourceScope: `claim:${req.params.claimId}`,
          requestMethod: "GET",
          requestPath: `/api/external/evidence-chain/${req.params.claimId}`,
          ipAddress: req.ip,
          userAgent: req.headers["user-agent"],
        }, 404);
        return res.status(404).json({ message: "No evidence chain found for this claim" });
      }

      const sanitizedChain = {
        ...chain,
        entries: chain.entries.map(entry => ({
          ...entry,
          actor: {
            type: entry.actor.type,
            id: null,
            name: entry.actor.type === 'driver' ? 'Driver' : entry.actor.name,
          },
        })),
      };

      await logExternalAccess({
        grant,
        accessedResource: "evidence_chain",
        resourceScope: `claim:${req.params.claimId}`,
        requestMethod: "GET",
        requestPath: `/api/external/evidence-chain/${req.params.claimId}`,
        ipAddress: req.ip,
        userAgent: req.headers["user-agent"],
      }, 200);

      res.json(sanitizedChain);
    } catch (error) {
      console.error("[External Portal] Error fetching evidence chain:", error);
      res.status(500).json({ message: "Failed to fetch evidence chain" });
    }
  });

  // ==========================================
  // EXTERNAL SCHEDULING READ-ONLY ENDPOINTS (Token-based auth)
  // ==========================================

  app.get("/api/external/scheduling/controls", async (req: Request, res: Response) => {
    try {
      const token = req.headers["x-access-token"] as string;
      if (!token) return res.status(401).json({ message: "Access token required" });
      const { validateAccessToken, checkScopeAccess, logExternalAccess } = await import("./externalAccessService");
      const grant = await validateAccessToken(token);
      if (!grant) return res.status(401).json({ message: "Invalid or expired access token" });
      if (!checkScopeAccess(grant, 'scheduling_controls')) {
        await logExternalAccess({ grant, accessedResource: "scheduling_controls", requestMethod: "GET", requestPath: "/api/external/scheduling/controls", ipAddress: req.ip, userAgent: req.headers["user-agent"] }, 403);
        return res.status(403).json({ message: "Access to this resource not permitted" });
      }
      const { getGrantOrgContext } = await import("./externalAccessService");
      const orgId = await getGrantOrgContext(grant);
      const orgUsers = orgId ? await db.select({ id: users.id }).from(users).where(eq(users.orgId, orgId)) : [];
      const orgUserIds = orgUsers.map(u => u.id);
      const { schedulingEntities, crossLocationMobilityConfigs } = await import("@shared/schema");
      const entities = orgUserIds.length > 0
        ? await db.select({ id: schedulingEntities.id }).from(schedulingEntities).where(inArray(schedulingEntities.createdBy, orgUserIds))
        : [];
      const allowedEntityIds = entities.map(e => e.id);
      const mobilityConfigs = await db.select().from(crossLocationMobilityConfigs);
      const scopedConfigs = allowedEntityIds.length > 0
        ? mobilityConfigs.filter((c: any) => c.entityId && allowedEntityIds.includes(c.entityId))
        : [];
      const controlsOverview = {
        schedulingControls: {
          mobilityConfigurations: scopedConfigs.map((c: any) => ({
            entityId: c.entityId, maxTravelDistanceMiles: c.maxTravelDistanceMiles,
            maxTravelTimeMinutes: c.maxTravelTimeMinutes,
            minRestBetweenCrossLocationMinutes: c.minRestBetweenCrossLocationMinutes,
            maxCrossLocationShiftsPerWeek: c.maxCrossLocationShiftsPerWeek,
            maxCrossLocationShiftsPerDay: c.maxCrossLocationShiftsPerDay, isActive: c.isActive,
          })),
          totalConfigurations: scopedConfigs.length,
          activeConfigurations: scopedConfigs.filter((c: any) => c.isActive).length,
        },
        accessedAt: new Date().toISOString(), grantId: grant.id,
      };
      await logExternalAccess({ grant, accessedResource: "scheduling_controls", requestMethod: "GET", requestPath: "/api/external/scheduling/controls", ipAddress: req.ip, userAgent: req.headers["user-agent"] }, 200);
      res.json(controlsOverview);
    } catch (error) {
      console.error("[External Scheduling] Error fetching controls:", error);
      res.status(500).json({ message: "Failed to fetch scheduling controls" });
    }
  });

  app.get("/api/external/scheduling/sla", async (req: Request, res: Response) => {
    try {
      const token = req.headers["x-access-token"] as string;
      if (!token) return res.status(401).json({ message: "Access token required" });
      const { validateAccessToken, checkScopeAccess, logExternalAccess } = await import("./externalAccessService");
      const grant = await validateAccessToken(token);
      if (!grant) return res.status(401).json({ message: "Invalid or expired access token" });
      if (!checkScopeAccess(grant, 'scheduling_sla')) {
        await logExternalAccess({ grant, accessedResource: "scheduling_sla", requestMethod: "GET", requestPath: "/api/external/scheduling/sla", ipAddress: req.ip, userAgent: req.headers["user-agent"] }, 403);
        return res.status(403).json({ message: "Access to this resource not permitted" });
      }
      const { getGrantOrgContext: getOrgCtxSla } = await import("./externalAccessService");
      const slaOrgId = await getOrgCtxSla(grant);
      const slaOrgUsers = slaOrgId ? await db.select({ id: users.id }).from(users).where(eq(users.orgId, slaOrgId)) : [];
      const slaOrgUserIds = slaOrgUsers.map(u => u.id);
      const { schedulingEntities: slaEntitiesTable, schedulingSlaDefinitions, schedulingSlaEvents } = await import("@shared/schema");
      const slaEntities = slaOrgUserIds.length > 0
        ? await db.select({ id: slaEntitiesTable.id }).from(slaEntitiesTable).where(inArray(slaEntitiesTable.createdBy, slaOrgUserIds))
        : [];
      const slaAllowedEntityIds = slaEntities.map(e => e.id);
      const definitions = await db.select().from(schedulingSlaDefinitions);
      const scopedDefinitions = slaAllowedEntityIds.length > 0
        ? definitions.filter((d: any) => d.entityId && slaAllowedEntityIds.includes(d.entityId))
        : [];
      const scopedDefIds = scopedDefinitions.map((d: any) => d.id);
      const events = await db.select().from(schedulingSlaEvents).limit(500);
      const scopedEvents = scopedDefIds.length > 0
        ? events.filter((e: any) => scopedDefIds.includes(e.slaDefinitionId))
        : [];
      const totalEvents = scopedEvents.length;
      const metEvents = scopedEvents.filter((e: any) => e.status === 'met').length;
      const warningEvents = scopedEvents.filter((e: any) => e.status === 'warning').length;
      const breachedEvents = scopedEvents.filter((e: any) => e.status === 'breached').length;
      const slaOverview = {
        slaCompliance: {
          definitions: scopedDefinitions.map((d: any) => ({
            id: d.id, name: d.name, metricType: d.metricType,
            targetValue: d.targetValue, warningThreshold: d.warningThreshold, isActive: d.isActive,
          })),
          metrics: { totalEvents, met: metEvents, warning: warningEvents, breached: breachedEvents,
            complianceRate: totalEvents > 0 ? Math.round((metEvents / totalEvents) * 100) : 100,
          },
        },
        accessedAt: new Date().toISOString(), grantId: grant.id,
      };
      await logExternalAccess({ grant, accessedResource: "scheduling_sla", requestMethod: "GET", requestPath: "/api/external/scheduling/sla", ipAddress: req.ip, userAgent: req.headers["user-agent"] }, 200);
      res.json(slaOverview);
    } catch (error) {
      console.error("[External Scheduling] Error fetching SLA data:", error);
      res.status(500).json({ message: "Failed to fetch SLA compliance data" });
    }
  });

  app.get("/api/external/scheduling/justifications", async (req: Request, res: Response) => {
    try {
      const token = req.headers["x-access-token"] as string;
      if (!token) return res.status(401).json({ message: "Access token required" });
      const { validateAccessToken, checkScopeAccess, logExternalAccess } = await import("./externalAccessService");
      const grant = await validateAccessToken(token);
      if (!grant) return res.status(401).json({ message: "Invalid or expired access token" });
      if (!checkScopeAccess(grant, 'scheduling_justifications')) {
        await logExternalAccess({ grant, accessedResource: "scheduling_justifications", requestMethod: "GET", requestPath: "/api/external/scheduling/justifications", ipAddress: req.ip, userAgent: req.headers["user-agent"] }, 403);
        return res.status(403).json({ message: "Access to this resource not permitted" });
      }
      const { getGrantOrgContext: getOrgCtxJust } = await import("./externalAccessService");
      const justOrgId = await getOrgCtxJust(grant);
      const justOrgUsers = justOrgId ? await db.select({ id: users.id }).from(users).where(eq(users.orgId, justOrgId)) : [];
      const justOrgUserIds = justOrgUsers.map(u => u.id);
      const { schedulingEntities: justEntitiesTable } = await import("@shared/schema");
      const justEntities = justOrgUserIds.length > 0
        ? await db.select({ id: justEntitiesTable.id }).from(justEntitiesTable).where(inArray(justEntitiesTable.createdBy, justOrgUserIds))
        : [];
      const justAllowedEntityIds = justEntities.map(e => e.id);
      const justifications = await storage.getSchedulingJustifications({});
      const scopedJustifications = justAllowedEntityIds.length > 0
        ? justifications.filter((j: any) => j.entityId && justAllowedEntityIds.includes(j.entityId))
        : [];
      const sanitized = scopedJustifications.map((j: any) => ({
        id: j.id, category: j.category, narrative: j.narrative,
        scheduleId: j.scheduleId, shiftId: j.shiftId, entityId: j.entityId,
        createdAt: j.createdAt, createdByName: j.createdByName,
      }));
      await logExternalAccess({ grant, accessedResource: "scheduling_justifications", resourceScope: `count:${sanitized.length}`, requestMethod: "GET", requestPath: "/api/external/scheduling/justifications", ipAddress: req.ip, userAgent: req.headers["user-agent"] }, 200);
      res.json({ justifications: sanitized, total: sanitized.length, accessedAt: new Date().toISOString(), grantId: grant.id });
    } catch (error) {
      console.error("[External Scheduling] Error fetching justifications:", error);
      res.status(500).json({ message: "Failed to fetch justification audit trail" });
    }
  });


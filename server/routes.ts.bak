  app.get("/api/corporate/scheduling/insurance-reports/export-csv", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const { periodType = "monthly", periodStart, entityId } = req.query as any;
      if (!periodStart) {
        return res.status(400).json({ message: "periodStart required" });
      }
      const { generateFullInsuranceReport, generateCSVExport } = await import("./services/schedulingInsuranceService");
      const report = await generateFullInsuranceReport(entityId || null, periodType, periodStart);
      const csv = generateCSVExport(report);
      res.setHeader("Content-Type", "text/csv");
      res.setHeader("Content-Disposition", `attachment; filename=insurance_report_${periodStart}_${periodType}.csv`);
      res.send(csv);
    } catch (error: any) {
      console.error("[Insurance] Error exporting CSV:", error);
      res.status(500).json({ message: "Failed to export CSV" });

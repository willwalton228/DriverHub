      }
      const schedPerm = await resolveSchedulingPermission(user!.id, user?.role);
      if (!hasSchedulingPermission(schedPerm, 'edit')) return res.status(403).json({ message: 'Insufficient scheduling permission: edit required' });
      const [existingAssignment] = await db.select().from(shiftAssignments).where(eq(shiftAssignments.id, req.params.id));
      await storage.deleteShiftAssignment(req.params.id);
      await logSchedulingAudit({ actorUserId: user!.id, actionType: 'assignment_removed', entityType: 'assignment', entityId: req.params.id, previousData: existingAssignment, ipAddress: req.ip, userAgent: req.get('user-agent') });
      res.json({ success: true });
    } catch (error) {
      console.error("Error deleting shift assignment:", error);
      res.status(500).json({ message: "Failed to delete shift assignment" });
    }
  });

  // ===== SCHEDULING PERMISSIONS MANAGEMENT =====

  app.get('/api/corporate/scheduling/permissions/my', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user) return res.status(401).json({ message: 'Unauthorized' });
      
      const permLevel = await resolveSchedulingPermission(user.id, user.role);
      res.json({ permissionLevel: permLevel, role: user.role });
    } catch (error) {
      console.error('Error fetching scheduling permission:', error);
      res.status(500).json({ message: 'Failed to fetch scheduling permission' });
    }
  });

  app.get('/api/corporate/scheduling/permissions/users', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can manage scheduling permissions' });
      }
      
      const allUsers = await db.select({
        id: users.id,
        firstName: users.firstName,
        lastName: users.lastName,
        email: users.email,
        role: users.role,
      })
      .from(users)
      .where(eq(users.status, 'ACTIVE'))
      .orderBy(users.firstName);
      
      res.json({ users: allUsers });
    } catch (error) {
      console.error('Error fetching users for permissions:', error);
      res.status(500).json({ message: 'Failed to fetch users' });
    }
  });

  app.get('/api/corporate/scheduling/permissions', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can manage scheduling permissions' });
      }
      const { locationId, userId: filterUserId } = req.query;
      let conditions = [eq(schedulingPermissions.isActive, true)];
      if (locationId) conditions.push(eq(schedulingPermissions.locationId, locationId as string));
      if (filterUserId) conditions.push(eq(schedulingPermissions.userId, filterUserId as string));
      
      const perms = await db.select({
        permission: schedulingPermissions,
        userName: sql<string>`CONCAT(${users.firstName}, ' ', ${users.lastName})`,
        userEmail: users.email,
        userRole: users.role,
        locationName: workLocations.name,
      })
      .from(schedulingPermissions)
      .leftJoin(users, eq(schedulingPermissions.userId, users.id))
      .leftJoin(workLocations, eq(schedulingPermissions.locationId, workLocations.id))
      .where(and(...conditions))
      .orderBy(desc(schedulingPermissions.grantedAt));
      
      res.json({ permissions: perms });
    } catch (error) {
      console.error('Error fetching scheduling permissions:', error);
      res.status(500).json({ message: 'Failed to fetch scheduling permissions' });
    }
  });

  app.post('/api/corporate/scheduling/permissions', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can manage scheduling permissions' });
      }
      const { userId: targetUserId, permissionLevel, locationId, teamId, notes } = req.body;
      if (!targetUserId || !permissionLevel) {
        return res.status(400).json({ message: 'userId and permissionLevel are required' });
      }
      if (!['view', 'edit', 'approve', 'publish'].includes(permissionLevel)) {
        return res.status(400).json({ message: 'Invalid permission level' });
      }
      
      const existing = await db.select().from(schedulingPermissions).where(and(
        eq(schedulingPermissions.userId, targetUserId),
        eq(schedulingPermissions.isActive, true),
        locationId ? eq(schedulingPermissions.locationId, locationId) : isNull(schedulingPermissions.locationId)
      ));
      
      if (existing.length > 0) {
        const [updated] = await db.update(schedulingPermissions)
          .set({ permissionLevel, notes, teamId })
          .where(eq(schedulingPermissions.id, existing[0].id))
          .returning();
        
        await logSchedulingAudit({
          actorUserId: user.id,
          actionType: 'permission_granted',
          entityType: 'permission',
          entityId: updated.id,
          locationId,
          previousData: { permissionLevel: existing[0].permissionLevel },
          newData: { permissionLevel, userId: targetUserId, locationId, teamId },
          ipAddress: req.ip,
          userAgent: req.get('user-agent'),
        });
        
        return res.json({ permission: updated });
      }
      
      const [perm] = await db.insert(schedulingPermissions).values({
        userId: targetUserId,
        permissionLevel,
        locationId: locationId || null,
        teamId: teamId || null,
        grantedBy: user.id,
        notes: notes || null,
      }).returning();
      
      await logSchedulingAudit({
        actorUserId: user.id,
        actionType: 'permission_granted',
        entityType: 'permission',
        entityId: perm.id,
        locationId,
        newData: { permissionLevel, userId: targetUserId, locationId, teamId },
        ipAddress: req.ip,
        userAgent: req.get('user-agent'),
      });
      
      res.json({ permission: perm });
    } catch (error) {
      console.error('Error granting scheduling permission:', error);
      res.status(500).json({ message: 'Failed to grant scheduling permission' });
    }
  });

  app.delete('/api/corporate/scheduling/permissions/:id', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can manage scheduling permissions' });
      }
      
      const [existing] = await db.select().from(schedulingPermissions).where(eq(schedulingPermissions.id, req.params.id));
      if (!existing) return res.status(404).json({ message: 'Permission not found' });
      
      const [revoked] = await db.update(schedulingPermissions)
        .set({ isActive: false, revokedAt: new Date(), revokedBy: user.id })
        .where(eq(schedulingPermissions.id, req.params.id))
        .returning();
      
      await logSchedulingAudit({
        actorUserId: user.id,
        actionType: 'permission_revoked',
        entityType: 'permission',
        entityId: req.params.id,
        locationId: existing.locationId,
        previousData: { permissionLevel: existing.permissionLevel, userId: existing.userId },
        ipAddress: req.ip,
        userAgent: req.get('user-agent'),
      });
      
      res.json({ success: true, permission: revoked });
    } catch (error) {
      console.error('Error revoking scheduling permission:', error);
      res.status(500).json({ message: 'Failed to revoke scheduling permission' });
    }
  });

  // ===== SCHEDULING AUDIT LOG =====

  app.get('/api/corporate/scheduling/audit-log', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can view the scheduling audit log' });
      }
      
      const { actionType, entityType, actorUserId, locationId, startDate, endDate, limit: queryLimit, offset: queryOffset } = req.query;
      let conditions: any[] = [];
      
      if (actionType) conditions.push(eq(schedulingAuditLog.actionType, actionType as string));
      if (entityType) conditions.push(eq(schedulingAuditLog.entityType, entityType as string));
      if (actorUserId) conditions.push(eq(schedulingAuditLog.actorUserId, actorUserId as string));
      if (locationId) conditions.push(eq(schedulingAuditLog.locationId, locationId as string));
      if (startDate) conditions.push(gte(schedulingAuditLog.createdAt, new Date(startDate as string)));
      if (endDate) conditions.push(lte(schedulingAuditLog.createdAt, new Date(endDate as string)));
      
      const totalResult = await db.select({ count: sql<number>`count(*)::int` })
        .from(schedulingAuditLog)
        .where(conditions.length > 0 ? and(...conditions) : undefined);
      
      const logs = await db.select({
        log: schedulingAuditLog,
        actorName: sql<string>`CONCAT(${users.firstName}, ' ', ${users.lastName})`,
        actorEmail: users.email,
        locationName: workLocations.name,
      })
      .from(schedulingAuditLog)
      .leftJoin(users, eq(schedulingAuditLog.actorUserId, users.id))
      .leftJoin(workLocations, eq(schedulingAuditLog.locationId, workLocations.id))
      .where(conditions.length > 0 ? and(...conditions) : undefined)
      .orderBy(desc(schedulingAuditLog.createdAt))
      .limit(parseInt(queryLimit as string) || 50)
      .offset(parseInt(queryOffset as string) || 0);
      
      res.json({ 
        logs, 
        total: totalResult[0]?.count || 0,
        limit: parseInt(queryLimit as string) || 50,
        offset: parseInt(queryOffset as string) || 0,
      });
    } catch (error) {
      console.error('Error fetching scheduling audit log:', error);
      res.status(500).json({ message: 'Failed to fetch scheduling audit log' });
    }
  });


  // ── Scheduling Data Integrity & Health Monitoring ──

  // Run integrity scan
  app.post('/api/corporate/scheduling/integrity/scans', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Only admins can trigger integrity scans' });
      }

      const { lookbackDays } = req.body;
      const days = Math.min(Math.max(parseInt(lookbackDays) || 7, 1), 90);
      const windowEnd = new Date();
      const windowStart = new Date();
      windowStart.setDate(windowStart.getDate() - days);

      const startTime = Date.now();

      // Create scan record
      const [scan] = await db.insert(schedulingIntegrityScans).values({
        status: 'running',
        initiatedBy: resolvedId,
        triggerType: 'manual',
        windowStart: windowStart.toISOString().split('T')[0],
        windowEnd: windowEnd.toISOString().split('T')[0],
      }).returning();

      const issueCounts: Record<string, number> = {
        unassigned_shift: 0,
        missing_clock_in: 0,
        broken_location_link: 0,
        attendance_mismatch: 0,
      };
      const issues: any[] = [];

      // Load config for per-check toggles
      const [scanConfig] = await db.select().from(schedulingIntegrityConfig).limit(1);
      const checksEnabled = (scanConfig?.checksEnabled) || {
        unassigned_shift: true, missing_clock_in: true, broken_location_link: true, attendance_mismatch: true,
      };

      try {
        // Check 1: Unassigned Shifts - published/approved shifts where assignedStaff < requiredStaff
        if (checksEnabled.unassigned_shift !== false) {
        const unassignedShifts = await db.select({
          shift: shifts,
          locationName: workLocations.name,
        })
        .from(shifts)
        .leftJoin(workLocations, eq(shifts.locationId, workLocations.id))
        .where(and(
          or(eq(shifts.status, 'published'), eq(shifts.status, 'approved')),
          gte(shifts.date, windowStart.toISOString().split('T')[0]),
          lte(shifts.date, windowEnd.toISOString().split('T')[0]),
          sql`${shifts.assignedStaff} < ${shifts.requiredStaff}`
        ));

        for (const row of unassignedShifts) {
          const gap = (row.shift.requiredStaff || 1) - (row.shift.assignedStaff || 0);
          issues.push({
            scanId: scan.id,
            issueType: 'unassigned_shift',
            severity: gap >= 2 ? 'critical' : 'warning',
            entityType: 'shift',
            entityId: row.shift.id,
            shiftId: row.shift.id,
            locationId: row.shift.locationId,
            title: `Shift on ${row.shift.date} understaffed by ${gap}`,
            description: `Shift at ${row.locationName || 'Unknown location'} needs ${row.shift.requiredStaff} staff but only has ${row.shift.assignedStaff} assigned.`,
            details: {
              date: row.shift.date,
              requiredStaff: row.shift.requiredStaff,
              assignedStaff: row.shift.assignedStaff,
              gap,
              locationName: row.locationName,
              startTime: row.shift.startTime,
              endTime: row.shift.endTime,
            },
          });
          issueCounts.unassigned_shift++;
        }
        }

        // Check 2: Missing Clock-Ins - set-based using NOT EXISTS (no N+1)
        if (checksEnabled.missing_clock_in !== false) {
        const missingClockIns = await db.select({
          assignment: shiftAssignments,
          shift: shifts,
          locationName: workLocations.name,
          userName: sql<string>`CONCAT(${users.firstName}, ' ', ${users.lastName})`,
          userEmail: users.email,
        })
        .from(shiftAssignments)
        .innerJoin(shifts, eq(shiftAssignments.shiftId, shifts.id))
        .leftJoin(users, eq(shiftAssignments.userId, users.id))
        .leftJoin(workLocations, eq(shifts.locationId, workLocations.id))
        .where(and(
          or(eq(shiftAssignments.status, 'assigned'), eq(shiftAssignments.status, 'confirmed')),
          gte(shifts.date, windowStart.toISOString().split('T')[0]),
          lte(shifts.date, windowEnd.toISOString().split('T')[0]),
          lte(shifts.endTime, new Date()),
          sql`NOT EXISTS (SELECT 1 FROM time_clock_events WHERE time_clock_events.shift_assignment_id = ${shiftAssignments.id} AND time_clock_events.event_type = 'clock_in')`
        ));

        for (const row of missingClockIns) {
            issues.push({
              scanId: scan.id,
              issueType: 'missing_clock_in',
              severity: 'critical',
              entityType: 'assignment',
              entityId: row.assignment.id,
              shiftId: row.shift.id,
              assignmentId: row.assignment.id,
              userId: row.assignment.userId,
              locationId: row.shift.locationId,
              title: `No clock-in for ${row.userName || 'Unknown'} on ${row.shift.date}`,
              description: `${row.userName || 'Unknown'} (${row.userEmail || ''}) was assigned to a shift on ${row.shift.date} but never clocked in.`,
              details: {
                date: row.shift.date,
                userName: row.userName,
                userEmail: row.userEmail,
                assignmentStatus: row.assignment.status,
                shiftStart: row.shift.startTime,
                shiftEnd: row.shift.endTime,
                locationName: row.locationName,
              },
            });
            issueCounts.missing_clock_in++;
        }
        }

        // Check 3: Broken Location Links - shifts or assignments referencing inactive/nonexistent locations
        if (checksEnabled.broken_location_link !== false) {
        const brokenLocationShifts = await db.select({
          shift: shifts,
          locationActive: workLocations.isActive,
          locationName: workLocations.name,
        })
        .from(shifts)
        .leftJoin(workLocations, eq(shifts.locationId, workLocations.id))
        .where(and(
          isNotNull(shifts.locationId),
          gte(shifts.date, windowStart.toISOString().split('T')[0]),
          lte(shifts.date, windowEnd.toISOString().split('T')[0]),
          or(
            isNull(workLocations.id), // location doesn't exist
            eq(workLocations.isActive, false), // location is deactivated
          ),
        ));

        for (const row of brokenLocationShifts) {
          const isInactive = row.locationName && !row.locationActive;
          issues.push({
            scanId: scan.id,
            issueType: 'broken_location_link',
            severity: isInactive ? 'warning' : 'critical',
            entityType: 'shift',
            entityId: row.shift.id,
            shiftId: row.shift.id,
            locationId: row.shift.locationId,
            title: isInactive
              ? `Shift references inactive location "${row.locationName}"`
              : `Shift references nonexistent location`,
            description: isInactive
              ? `Shift on ${row.shift.date} is linked to deactivated location "${row.locationName}".`
              : `Shift on ${row.shift.date} references location ID ${row.shift.locationId} which does not exist in the system.`,
            details: {
              date: row.shift.date,
              locationId: row.shift.locationId,
              locationName: row.locationName,
              locationActive: row.locationActive,
              isOrphan: !row.locationName,
            },
          });
          issueCounts.broken_location_link++;
        }
        }

        // Check 4: Schedule vs Attendance Mismatch - clock events outside shift window (>30min early/late)
        if (checksEnabled.attendance_mismatch !== false) {
        const clockEventsWithShifts = await db.select({
          event: timeClockEvents,
          assignment: shiftAssignments,
          shift: shifts,
          userName: sql<string>`CONCAT(${users.firstName}, ' ', ${users.lastName})`,
        })
        .from(timeClockEvents)
        .innerJoin(shiftAssignments, eq(timeClockEvents.shiftAssignmentId, shiftAssignments.id))
        .innerJoin(shifts, eq(shiftAssignments.shiftId, shifts.id))
        .leftJoin(users, eq(timeClockEvents.userId, users.id))
        .where(and(
          eq(timeClockEvents.eventType, 'clock_in'),
          gte(shifts.date, windowStart.toISOString().split('T')[0]),
          lte(shifts.date, windowEnd.toISOString().split('T')[0]),
        ));

        for (const row of clockEventsWithShifts) {
          const eventTime = new Date(row.event.eventTime).getTime();
          const shiftStart = new Date(row.shift.startTime).getTime();
          const diffMinutes = Math.abs(eventTime - shiftStart) / (1000 * 60);

          if (diffMinutes > 30) {
            const direction = eventTime < shiftStart ? 'early' : 'late';
            issues.push({
              scanId: scan.id,
              issueType: 'attendance_mismatch',
              severity: diffMinutes > 120 ? 'critical' : 'warning',
              entityType: 'time_clock_event',
              entityId: row.event.id,
              shiftId: row.shift.id,
              assignmentId: row.assignment.id,
              userId: row.event.userId,
              locationId: row.shift.locationId,
              title: `Clock-in ${Math.round(diffMinutes)} min ${direction} for ${row.userName || 'Unknown'}`,
              description: `${row.userName || 'Unknown'} clocked in ${Math.round(diffMinutes)} minutes ${direction} for shift on ${row.shift.date}.`,
              details: {
                date: row.shift.date,
                userName: row.userName,
                clockInTime: row.event.eventTime,
                shiftStartTime: row.shift.startTime,
                diffMinutes: Math.round(diffMinutes),
                direction,
              },
            });
            issueCounts.attendance_mismatch++;
          }
        }
        }

        // Insert all issues
        if (issues.length > 0) {
          await db.insert(schedulingIntegrityIssues).values(issues);
        }

        const durationMs = Date.now() - startTime;
        const totalIssues = issues.length;

        // Update scan record
        const [completedScan] = await db.update(schedulingIntegrityScans)
          .set({
            status: 'completed',
            totalIssues,
            issueCounts,
            durationMs,
            completedAt: new Date(),
          })
          .where(eq(schedulingIntegrityScans.id, scan.id))
          .returning();

        // Update config's last scan reference
        const [existingConfig] = await db.select().from(schedulingIntegrityConfig).limit(1);
        if (existingConfig) {
          await db.update(schedulingIntegrityConfig)
            .set({ lastScanId: scan.id, lastScanAt: new Date() })
            .where(eq(schedulingIntegrityConfig.id, existingConfig.id));
        }

        res.json({ scan: completedScan, totalIssues, issueCounts });
      } catch (scanError: any) {
        // Mark scan as failed
        await db.update(schedulingIntegrityScans)
          .set({ status: 'failed', errorMessage: scanError.message, completedAt: new Date(), durationMs: Date.now() - startTime })
          .where(eq(schedulingIntegrityScans.id, scan.id));
        throw scanError;
      }
    } catch (error) {
      console.error('Error running integrity scan:', error);
      res.status(500).json({ message: 'Failed to run integrity scan' });
    }
  });

  // Get scan history
  app.get('/api/corporate/scheduling/integrity/scans', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Admin access required' });
      }

      const limit = parseInt(req.query.limit as string) || 20;
      const offset = parseInt(req.query.offset as string) || 0;

      const scans = await db.select({
        scan: schedulingIntegrityScans,
        initiatorName: sql<string>`CONCAT(${users.firstName}, ' ', ${users.lastName})`,
      })
      .from(schedulingIntegrityScans)
      .leftJoin(users, eq(schedulingIntegrityScans.initiatedBy, users.id))
      .orderBy(desc(schedulingIntegrityScans.startedAt))
      .limit(limit)
      .offset(offset);

      const [{ count }] = await db.select({ count: sql<number>`count(*)::int` })
        .from(schedulingIntegrityScans);

      res.json({ scans, total: count });
    } catch (error) {
      console.error('Error fetching integrity scans:', error);
      res.status(500).json({ message: 'Failed to fetch scan history' });
    }
  });

  // Get integrity issues with filters
  app.get('/api/corporate/scheduling/integrity/issues', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Admin access required' });
      }

      const { issueType, severity, status: issueStatus, scanId, locationId } = req.query;
      const limit = parseInt(req.query.limit as string) || 50;
      const offset = parseInt(req.query.offset as string) || 0;

      let conditions: any[] = [];
      if (issueType) conditions.push(eq(schedulingIntegrityIssues.issueType, issueType as string));
      if (severity) conditions.push(eq(schedulingIntegrityIssues.severity, severity as string));
      if (issueStatus) conditions.push(eq(schedulingIntegrityIssues.status, issueStatus as string));
      if (scanId) conditions.push(eq(schedulingIntegrityIssues.scanId, scanId as string));
      if (locationId) conditions.push(eq(schedulingIntegrityIssues.locationId, locationId as string));

      const [{ count }] = await db.select({ count: sql<number>`count(*)::int` })
        .from(schedulingIntegrityIssues)
        .where(conditions.length > 0 ? and(...conditions) : undefined);

      const issuesList = await db.select({
        issue: schedulingIntegrityIssues,
        locationName: workLocations.name,
        userName: sql<string>`CONCAT(${users.firstName}, ' ', ${users.lastName})`,
      })
      .from(schedulingIntegrityIssues)
      .leftJoin(workLocations, eq(schedulingIntegrityIssues.locationId, workLocations.id))
      .leftJoin(users, eq(schedulingIntegrityIssues.userId, users.id))
      .where(conditions.length > 0 ? and(...conditions) : undefined)
      .orderBy(
        sql`CASE ${schedulingIntegrityIssues.severity} WHEN 'critical' THEN 1 WHEN 'warning' THEN 2 WHEN 'info' THEN 3 END`,
        desc(schedulingIntegrityIssues.createdAt)
      )
      .limit(limit)
      .offset(offset);

      res.json({ issues: issuesList, total: count, limit, offset });
    } catch (error) {
      console.error('Error fetching integrity issues:', error);
      res.status(500).json({ message: 'Failed to fetch integrity issues' });
    }
  });

  // Acknowledge/resolve an issue
  app.patch('/api/corporate/scheduling/integrity/issues/:id', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Admin access required' });
      }

      const { status: newStatus } = req.body;
      if (!['acknowledged', 'resolved'].includes(newStatus)) {
        return res.status(400).json({ message: 'Status must be "acknowledged" or "resolved"' });
      }

      const updateData: any = { status: newStatus };
      if (newStatus === 'acknowledged') {
        updateData.acknowledgedBy = resolvedId;
        updateData.acknowledgedAt = new Date();
      } else if (newStatus === 'resolved') {
        updateData.resolvedAt = new Date();
      }

      const [updated] = await db.update(schedulingIntegrityIssues)
        .set(updateData)
        .where(eq(schedulingIntegrityIssues.id, req.params.id))
        .returning();

      if (!updated) return res.status(404).json({ message: 'Issue not found' });

      res.json({ issue: updated });
    } catch (error) {
      console.error('Error updating integrity issue:', error);
      res.status(500).json({ message: 'Failed to update issue' });
    }
  });

  // Get integrity summary (latest scan + open issue counts)
  app.get('/api/corporate/scheduling/integrity/summary', isAuthenticated, async (req: any, res: Response) => {
    try {
      const resolvedId = await resolveSchedulingUserId(req);
      if (!resolvedId) return res.status(401).json({ message: 'Unauthorized' });
      const user = await storage.getUser(resolvedId);
      if (!user || !['super_user', 'admin'].includes(user.role)) {
        return res.status(403).json({ message: 'Admin access required' });
      }

      // Latest scan
      const [latestScan] = await db.select()
        .from(schedulingIntegrityScans)
        .where(eq(schedulingIntegrityScans.status, 'completed'))
        .orderBy(desc(schedulingIntegrityScans.completedAt))
        .limit(1);

      // Open issue counts by type
      const openCounts = await db.select({
        issueType: schedulingIntegrityIssues.issueType,
        severity: schedulingIntegrityIssues.severity,
        count: sql<number>`count(*)::int`,
      })
      .from(schedulingIntegrityIssues)
      .where(eq(schedulingIntegrityIssues.status, 'open'))
      .groupBy(schedulingIntegrityIssues.issueType, schedulingIntegrityIssues.severity);

      // Build summary
      const summary: Record<string, { total: number; critical: number; warning: number; info: number }> = {};
      for (const row of openCounts) {
        if (!summary[row.issueType]) {
          summary[row.issueType] = { total: 0, critical: 0, warning: 0, info: 0 };
        }
        summary[row.issueType][row.severity as 'critical' | 'warning' | 'info'] += row.count;
        summary[row.issueType].total += row.count;
      }

      const totalOpen = openCounts.reduce((sum, r) => sum + r.count, 0);
      const totalCritical = openCounts.filter(r => r.severity === 'critical').reduce((sum, r) => sum + r.count, 0);

      res.json({
        latestScan,
        openIssues: summary,
        totalOpen,
        totalCritical,
      });
    } catch (error) {
      console.error('Error fetching integrity summary:', error);
      res.status(500).json({ message: 'Failed to fetch integrity summary' });
    }
  });

  // Get/update integrity config

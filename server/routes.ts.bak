  // POST /api/execution-outcomes - Ingest execution outcome from Ops Console
  app.post("/api/execution-outcomes", async (req: Request, res: Response) => {
    try {
      let authUserId: string | null = (req as any).session?.userId || null;
      if (!authUserId && (req as any).user?.claims?.sub) {
        authUserId = (req as any).user.claims.sub;
      }
      if (!authUserId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      let user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, authUserId!),
      });
      if (!user && (req as any).user?.claims?.email) {
        user = await db.query.users.findFirst({
          where: (users, { eq }) => eq(users.email, (req as any).user.claims.email),
        });
      }
      if (!user || (user.role !== 'admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { ingestExecutionOutcome } = await import("./executionOutcomeService");
      const result = await ingestExecutionOutcome(req.body);

      if (!result.success) {
        return res.status(400).json({ success: false, error: result.error });
      }

      res.status(result.isDuplicate ? 200 : 201).json({
        success: true,
        outcome: result.outcome,
        isDuplicate: result.isDuplicate,
      });
    } catch (error) {
      console.error("[Execution Outcomes] Error ingesting outcome:", error);
      res.status(500).json({ message: "Failed to ingest execution outcome" });
    }
  });

  // POST /api/execution-outcomes/batch - Batch ingest multiple outcomes
  app.post("/api/execution-outcomes/batch", async (req: Request, res: Response) => {

  // POST /api/admin/integrations/replay - Create and start a replay job
  app.post("/api/admin/integrations/replay", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const userId = currentUser?.id || currentUserId;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { from_timestamp, to_timestamp, event_type, move_id, driver_id, dry_run = false } = req.body;

      if (!from_timestamp || !to_timestamp) {
        return res.status(400).json({ message: "from_timestamp and to_timestamp are required" });
      }

      const fromDate = new Date(from_timestamp);
      const toDate = new Date(to_timestamp);

      if (isNaN(fromDate.getTime()) || isNaN(toDate.getTime())) {
        return res.status(400).json({ message: "Invalid timestamp format" });
      }

      if (fromDate >= toDate) {
        return res.status(400).json({ message: "from_timestamp must be before to_timestamp" });
      }

      // Build filters object
      const filters: Record<string, string> = {};
      if (event_type) filters.event_type = event_type;
      if (move_id) filters.move_id = move_id;
      if (driver_id) filters.driver_id = driver_id;

      // Create the replay job
      const [newJob] = await db.insert(replayJobs)
        .values({
          createdBy: user.id,
          fromTimestamp: fromDate,
          toTimestamp: toDate,
          filters,
          dryRun: dry_run,
          status: 'pending',
        })
        .returning();

      console.log(`[Replay Jobs] Created job ${newJob.id} by ${userId}`);

      // Start processing asynchronously
      processReplayJob(newJob.id).catch(err => {
        console.error(`[Replay Jobs] Error processing job ${newJob.id}:`, err);
      });

      res.status(201).json({
        message: "Replay job created and started",
        job: newJob,
      });

    } catch (error) {
      console.error("[Replay Jobs] Error creating job:", error);
      res.status(500).json({ message: "Failed to create replay job" });
    }
  });

  // POST /api/admin/integrations/replay/:jobId/cancel - Cancel a running replay job
  app.post("/api/admin/integrations/replay/:jobId/cancel", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const [job] = await db.select()
        .from(replayJobs)
        .where(eq(replayJobs.id, req.params.jobId))
        .limit(1);

      if (!job) {
        return res.status(404).json({ message: "Replay job not found" });
      }

      if (job.status !== 'pending' && job.status !== 'running') {
        return res.status(400).json({ message: "Can only cancel pending or running jobs" });
      }

      await db.update(replayJobs)
        .set({
          status: 'cancelled',
          completedAt: new Date(),
        })
        .where(eq(replayJobs.id, req.params.jobId));

      res.json({ message: "Replay job cancelled" });

    } catch (error) {
      console.error("[Replay Jobs] Error cancelling job:", error);
      res.status(500).json({ message: "Failed to cancel replay job" });
    }
  });

  // GET /api/admin/integrations/replay/preview - Preview events that would be replayed
  app.get("/api/admin/integrations/replay/preview", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { from_timestamp, to_timestamp, event_type, move_id, driver_id } = req.query;

      if (!from_timestamp || !to_timestamp) {
        return res.status(400).json({ message: "from_timestamp and to_timestamp are required" });
      }

      const fromDate = new Date(from_timestamp as string);
      const toDate = new Date(to_timestamp as string);

      // Build query conditions
      const conditions = [
        sql`${ingestedEvents.occurredAt} >= ${fromDate}`,
        sql`${ingestedEvents.occurredAt} <= ${toDate}`,
        eq(ingestedEvents.mappingStatus, 'ok'), // Only replay mapped events
      ];

      if (event_type) {
        conditions.push(eq(ingestedEvents.eventType, event_type as string));
      }
      if (move_id) {
        conditions.push(eq(ingestedEvents.moveId, move_id as string));
      }
      if (driver_id) {
        conditions.push(eq(ingestedEvents.driverId, driver_id as string));
      }

      // Validate dates
      if (isNaN(fromDate.getTime()) || isNaN(toDate.getTime())) {
        return res.status(400).json({ message: "Invalid timestamp format" });
      }

      // Count events that would be processed
      const [countResult] = await db.select({
        total: sql<number>`COUNT(*)::int`,
      }).from(ingestedEvents)
        .where(and(...conditions));

      // Get event type breakdown
      const typeBreakdown = await db.select({
        eventType: ingestedEvents.eventType,
        count: sql<number>`COUNT(*)::int`,
      })
        .from(ingestedEvents)
        .where(and(...conditions))
        .groupBy(ingestedEvents.eventType)
        .orderBy(sql`COUNT(*) DESC`);

      res.json({
        totalEvents: countResult?.total || 0,
        timeRange: {
          from: fromDate.toISOString(),
          to: toDate.toISOString(),
        },
        filters: {
          event_type: event_type || null,
          move_id: move_id || null,
          driver_id: driver_id || null,
        },
        eventsByType: typeBreakdown,
      });

    } catch (error) {
      console.error("[Replay Jobs] Error previewing replay:", error);
      res.status(500).json({ message: "Failed to preview replay" });
    }
  });

  // Replay job processor - processes events asynchronously
  async function processReplayJob(jobId: string) {
    console.log(`[Replay Processor] Starting job ${jobId}`);

    try {
      // Mark job as running
      await db.update(replayJobs)
        .set({
          status: 'running',
          startedAt: new Date(),
        })
        .where(eq(replayJobs.id, jobId));

      // Get job details
      const [job] = await db.select()
        .from(replayJobs)
        .where(eq(replayJobs.id, jobId))
        .limit(1);

      if (!job) {
        console.error(`[Replay Processor] Job ${jobId} not found`);
        return;
      }

      const filters = job.filters as Record<string, string>;

      // Build query conditions for events to replay
      const conditions = [
        sql`${ingestedEvents.occurredAt} >= ${job.fromTimestamp}`,
        sql`${ingestedEvents.occurredAt} <= ${job.toTimestamp}`,
        eq(ingestedEvents.mappingStatus, 'ok'), // Only replay mapped events
      ];

      if (filters.event_type) {
        conditions.push(eq(ingestedEvents.eventType, filters.event_type));
      }
      if (filters.move_id) {
        conditions.push(eq(ingestedEvents.moveId, filters.move_id));
      }
      if (filters.driver_id) {
        conditions.push(eq(ingestedEvents.driverId, filters.driver_id));
      }

      // Get total count
      const [countResult] = await db.select({
        count: sql<number>`COUNT(*)::int`
      })
        .from(ingestedEvents)
        .where(and(...conditions));

      const totalEvents = countResult?.count || 0;

      await db.update(replayJobs)
        .set({ totalEvents })
        .where(eq(replayJobs.id, jobId));

      console.log(`[Replay Processor] Job ${jobId} - ${totalEvents} events to process`);

      // Process events in batches
      const batchSize = 100;
      let processed = 0;
      let skipped = 0;
      let failed = 0;
      let lastEventId: string | null = null;
      const errors: string[] = [];

      // Fetch events in batches ordered by occurred_at
      let hasMore = true;
      while (hasMore) {
        // Check if job was cancelled
        const [currentJob] = await db.select({ status: replayJobs.status })
          .from(replayJobs)
          .where(eq(replayJobs.id, jobId))
          .limit(1);

        if (currentJob?.status === 'cancelled') {
          console.log(`[Replay Processor] Job ${jobId} was cancelled`);
          return;
        }

        // Fetch next batch
        const events = await db.select()
          .from(ingestedEvents)
          .where(and(...conditions))
          .orderBy(ingestedEvents.occurredAt)
          .limit(batchSize)
          .offset(processed + skipped);

        if (events.length === 0) {
          hasMore = false;
          break;
        }

        for (const event of events) {
          try {
            lastEventId = event.eventId;

            // Check idempotency - has this event already been processed to ledger?
            const [existingLedgerEntry] = await db.select({ id: moveExecutionLedger.id })
              .from(moveExecutionLedger)
              .where(eq(moveExecutionLedger.eventId, event.eventId))
              .limit(1);

            if (existingLedgerEntry) {
              // Already processed, skip but still run derived state updates
              skipped++;
            } else {
              processed++;
            }

            // In dry-run mode, don't actually process
            if (job.dryRun) {
              continue;
            }

            // Reprocess the event through the ledger processor
            // This is idempotent - it will skip if already in ledger, but update derived state
            if (event.moveId) {
              const payload = event.payloadJson as Record<string, any>;
              
              // 1. Add to execution ledger if not exists (idempotent)
              if (!existingLedgerEntry) {
                await db.insert(moveExecutionLedger).values({
                  moveId: event.moveId,
                  driverId: event.driverId,
                  eventId: event.eventId,
                  eventType: event.eventType,
                  occurredAt: event.occurredAt,
                  payloadJson: payload,
                });
              }

              // 2. Update current state if this is a state change event
              const stateChangeTypes = ['assigned', 'accepted', 'arrived', 'started', 'completed', 'cancelled', 'reassigned'];
              if (stateChangeTypes.some(t => event.eventType.toLowerCase().includes(t))) {
                const newState = payload.state || payload.status || payload.current_state || 
                                payload.new_state || event.eventType.replace('move.', '');
                
                const [currentState] = await db.select()
                  .from(moveCurrentState)
                  .where(eq(moveCurrentState.moveId, event.moveId))
                  .limit(1);
                
                if (!currentState || new Date(event.occurredAt) >= new Date(currentState.stateChangedAt)) {
                  await db.insert(moveCurrentState)
                    .values({
                      moveId: event.moveId,
                      driverId: event.driverId,
                      currentState: newState,
                      stateChangedAt: event.occurredAt,
                      sourceEventId: event.eventId,
                    })
                    .onConflictDoUpdate({
                      target: moveCurrentState.moveId,
                      set: {
                        driverId: event.driverId,
                        currentState: newState,
                        stateChangedAt: event.occurredAt,
                        sourceEventId: event.eventId,
                        lastUpdatedAt: new Date(),
                      },
                    });
                }
              }

              // 3. Index proofs if this is a proof event
              if (event.eventType.toLowerCase().includes('proof') || 
                  event.eventType.toLowerCase().includes('photo') ||
                  event.eventType.toLowerCase().includes('signature')) {
                
                // Check if proof already indexed (idempotent)
                const [existingProof] = await db.select({ id: moveProofsIndex.id })
                  .from(moveProofsIndex)
                  .where(eq(moveProofsIndex.eventId, event.eventId))
                  .limit(1);

                if (!existingProof) {
                  await db.insert(moveProofsIndex).values({
                    moveId: event.moveId,
                    driverId: event.driverId,
                    proofType: payload.proof_type || payload.type || 'photo',
                    mediaRef: payload.media_ref || payload.url || payload.media_url,
                    occurredAt: event.occurredAt,
                    geoLat: payload.geo?.lat || payload.latitude,
                    geoLng: payload.geo?.lng || payload.longitude,
                    geoAccuracy: payload.geo?.accuracy,
                    eventId: event.eventId,
                    metadata: payload,
                  });
                }
              }
            }

          } catch (eventError: any) {
            failed++;
            errors.push(`${event.eventId}: ${eventError.message}`);
            console.error(`[Replay Processor] Error processing event ${event.eventId}:`, eventError.message);
          }
        }

        // Update progress
        const totalProcessed = processed + skipped + failed;
        const progressPercent = Math.round((totalProcessed / totalEvents) * 100);

        await db.update(replayJobs)
          .set({
            processedCount: processed,
            skippedCount: skipped,
            failedCount: failed,
            currentEventId: lastEventId,
            progressPercent,
            errorSummary: errors.length > 0 ? errors.slice(-10).join('\n') : null,
          })
          .where(eq(replayJobs.id, jobId));

        console.log(`[Replay Processor] Job ${jobId} progress: ${progressPercent}% (${processed} processed, ${skipped} skipped, ${failed} failed)`);
      }

      // Mark job as completed
      await db.update(replayJobs)
        .set({
          status: failed > 0 && processed === 0 ? 'failed' : 'completed',
          completedAt: new Date(),
          processedCount: processed,
          skippedCount: skipped,
          failedCount: failed,
          progressPercent: 100,
          errorSummary: errors.length > 0 ? errors.slice(-10).join('\n') : null,
          lastError: errors.length > 0 ? errors[errors.length - 1] : null,
        })
        .where(eq(replayJobs.id, jobId));

      console.log(`[Replay Processor] Job ${jobId} completed: ${processed} processed, ${skipped} skipped, ${failed} failed`);

    } catch (error: any) {
      console.error(`[Replay Processor] Job ${jobId} failed:`, error);
      
      await db.update(replayJobs)
        .set({
          status: 'failed',
          completedAt: new Date(),
          lastError: error.message,
          errorSummary: error.message,
        })
        .where(eq(replayJobs.id, jobId));
    }
  }

  // GET /api/admin/integrations/health - Integration health overview
  app.get("/api/admin/integrations/health", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const now = new Date();
      const oneHourAgo = new Date(now.getTime() - 60 * 60 * 1000);
      const twentyFourHoursAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000);

      // Events in last hour
      const [hourlyStats] = await db.select({
        received: sql<number>`COUNT(*) FILTER (WHERE ${ingestedEvents.receivedAt} >= ${oneHourAgo})::int`,
        failed: sql<number>`COUNT(*) FILTER (WHERE ${ingestedEvents.processingStatus} = 'failed' AND ${ingestedEvents.receivedAt} >= ${oneHourAgo})::int`,
      }).from(ingestedEvents);

      // Events in last 24 hours
      const [dailyStats] = await db.select({
        total: sql<number>`COUNT(*)::int`,
        received: sql<number>`COUNT(*) FILTER (WHERE ${ingestedEvents.processingStatus} = 'received')::int`,
        processed: sql<number>`COUNT(*) FILTER (WHERE ${ingestedEvents.processingStatus} = 'processed')::int`,
        failed: sql<number>`COUNT(*) FILTER (WHERE ${ingestedEvents.processingStatus} = 'failed')::int`,
        unsupported: sql<number>`COUNT(*) FILTER (WHERE ${ingestedEvents.processingStatus} = 'unsupported')::int`,
      })
      .from(ingestedEvents)
      .where(sql`${ingestedEvents.receivedAt} >= ${twentyFourHoursAgo}`);

      // Last event received
      const [lastEvent] = await db.select({
        eventId: ingestedEvents.eventId,
        eventType: ingestedEvents.eventType,
        receivedAt: ingestedEvents.receivedAt
      })
      .from(ingestedEvents)
      .orderBy(desc(ingestedEvents.receivedAt))
      .limit(1);

      // Determine health status
      const failureRate = dailyStats?.total > 0 
        ? (dailyStats.failed / dailyStats.total) * 100 
        : 0;
      
      let healthStatus = 'healthy';
      if (failureRate > 10) healthStatus = 'degraded';
      if (failureRate > 25) healthStatus = 'critical';

      res.json({
        status: healthStatus,
        lastEventAt: lastEvent?.receivedAt || null,
        lastHour: {
          eventsReceived: hourlyStats?.received || 0,
          failedEvents: hourlyStats?.failed || 0
        },
        last24Hours: {
          total: dailyStats?.total || 0,
          received: dailyStats?.received || 0,
          processed: dailyStats?.processed || 0,
          failed: dailyStats?.failed || 0,
          unsupported: dailyStats?.unsupported || 0,
          failureRate: Math.round(failureRate * 100) / 100
        }
      });

    } catch (error) {
      console.error("[Admin Integrations] Error fetching health:", error);
      res.status(500).json({ message: "Failed to fetch integration health" });
    }
  });

  // GET /api/admin/integrations/api-keys - List API keys
  app.get("/api/admin/integrations/api-keys", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const keys = await db.select({
        id: integrationApiKeys.id,
        keyName: integrationApiKeys.keyName,
        keyPrefix: integrationApiKeys.keyPrefix,
        sourceSystem: integrationApiKeys.sourceSystem,
        permissions: integrationApiKeys.permissions,
        isActive: integrationApiKeys.isActive,
        expiresAt: integrationApiKeys.expiresAt,
        lastUsedAt: integrationApiKeys.lastUsedAt,
        usageCount: integrationApiKeys.usageCount,
        createdAt: integrationApiKeys.createdAt,
      }).from(integrationApiKeys)
        .orderBy(desc(integrationApiKeys.createdAt));

      res.json(keys);

    } catch (error) {
      console.error("[Admin Integrations] Error fetching API keys:", error);
      res.status(500).json({ message: "Failed to fetch API keys" });
    }
  });

  // POST /api/admin/integrations/api-keys - Create new API key
  app.post("/api/admin/integrations/api-keys", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { keyName, sourceSystem, expiresAt } = req.body;
      
      if (!keyName || !sourceSystem) {
        return res.status(400).json({ message: "keyName and sourceSystem are required" });
      }

      // Generate secure API key
      const crypto = await import('crypto');
      const rawKey = crypto.randomBytes(32).toString('hex');
      const keyHash = crypto.createHash('sha256').update(rawKey).digest('hex');
      const keyPrefix = rawKey.substring(0, 8);

      const [newKey] = await db.insert(integrationApiKeys).values({
        keyName,
        keyHash,
        keyPrefix,
        sourceSystem,
        permissions: ['events:write'],
        expiresAt: expiresAt ? new Date(expiresAt) : null,
        createdByUserId: currentUser?.id,
      }).returning();

      // Return the raw key ONCE - it cannot be retrieved later
      res.status(201).json({
        id: newKey.id,
        keyName: newKey.keyName,
        keyPrefix: newKey.keyPrefix,
        sourceSystem: newKey.sourceSystem,
        apiKey: rawKey, // Only returned on creation
        expiresAt: newKey.expiresAt,
        message: "Store this API key securely - it cannot be retrieved again"
      });

    } catch (error) {
      console.error("[Admin Integrations] Error creating API key:", error);
      res.status(500).json({ message: "Failed to create API key" });
    }
  });

  // DELETE /api/admin/integrations/api-keys/:id - Revoke API key
  app.delete("/api/admin/integrations/api-keys/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      await db.update(integrationApiKeys)
        .set({
          isActive: false,
          revokedAt: new Date(),
          revokedByUserId: currentUser?.id
        })
        .where(eq(integrationApiKeys.id, req.params.id));

      res.json({ message: "API key revoked" });

    } catch (error) {
      console.error("[Admin Integrations] Error revoking API key:", error);
      res.status(500).json({ message: "Failed to revoke API key" });
    }
  });


  app.post("/api/admin/integrations/events/:eventId/reprocess", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!['admin', 'super_user'].includes(role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const [event] = await db.select()
        .from(ingestedEvents)
        .where(eq(ingestedEvents.eventId, req.params.eventId))
        .limit(1);

      if (!event) {
        return res.status(404).json({ message: "Event not found" });
      }

      // Reset status to received for reprocessing
      await db.update(ingestedEvents)
        .set({
          processingStatus: 'received',
          lastError: null,
          retryCount: sql`${ingestedEvents.retryCount} + 1`
        })
        .where(eq(ingestedEvents.eventId, req.params.eventId));

      res.json({ 
        message: "Event queued for reprocessing",
        event_id: req.params.eventId
      });

    } catch (error) {
      console.error("[Admin Integrations] Error reprocessing event:", error);
      res.status(500).json({ message: "Failed to reprocess event" });
    }
  });


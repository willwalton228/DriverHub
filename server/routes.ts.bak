  // AI Content Generation endpoint
  app.post("/api/corporate/social-media/generate", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { postType, topic, tone, platforms, requisitionId } = req.body;
      
      // Import OpenAI client
      const OpenAI = (await import("openai")).default;
      const openai = new OpenAI({
        apiKey: process.env.AI_INTEGRATIONS_OPENAI_API_KEY,
        baseURL: process.env.AI_INTEGRATIONS_OPENAI_BASE_URL,
      });

      let context = "";
      if (requisitionId) {
        const requisition = await storage.getRequisition(requisitionId);
        if (requisition) {
          context = `Job Title: ${requisition.title}\nDepartment: ${requisition.department || 'Not specified'}\nLocation: ${requisition.location || 'Not specified'}\nEmployment Type: ${requisition.employmentType}\nDescription: ${requisition.description || 'Not provided'}\nRequirements: ${requisition.requirements || 'Not provided'}`;
        }
      }

      const prompt = `Create a social media post for a driver management and transportation company called DriverHub 360.

Post Type: ${postType || 'promotional'}
Topic: ${topic || 'General company promotion'}
Tone: ${tone || 'professional'}
Target Platforms: ${platforms?.join(', ') || 'Facebook, Instagram'}
${context ? `\nJob Details:\n${context}` : ''}

Requirements:
- Keep it concise and engaging
- Use appropriate hashtags (3-5)
- Include a call to action
- Make it suitable for the transportation/logistics industry
- If this is a job posting, highlight key benefits and requirements

Respond in JSON format:
{
  "content": "The main post text",
  "hashtags": ["hashtag1", "hashtag2"],
  "callToAction": "Apply now at our website!"
}`;

      const response = await openai.chat.completions.create({
        model: "gpt-4o",
        messages: [{ role: "user", content: prompt }],
        response_format: { type: "json_object" },
        max_completion_tokens: 500,
      });

      const generatedContent = JSON.parse(response.choices[0]?.message?.content || "{}");
      res.json(generatedContent);
    } catch (error) {
      console.error("Error generating social media content:", error);
      res.status(500).json({ message: "Failed to generate content" });
    }
  });

  // ============================================================================
  // READ-ONLY ENGINE DATA ENDPOINTS (Increment 25A)
  // Thin API layer over existing backend engines - no business logic
  // ============================================================================

  // Import engine modules
  const safetyEngine = await import("./services/safetyEnforcementEngine");
  const compensationEngine = await import("./services/compensationEngine");
  const marketProfitEngine = await import("./services/marketProfitabilityEngine");

  // Get driver safety status
  app.get("/api/drivers/:driverId/safety-status", isAuthenticated, async (req: any, res: Response) => {
    try {
      const driverId = req.params.driverId;
      
      // Get driver's claims/accidents for safety evaluation
      const accidents = await storage.getAccidentsByDriverId(driverId);
      
      // Build safety events from accidents
      const safetyEvents: any[] = accidents.map((acc: any) => ({
        id: `accident_${acc.id}`,
        driverId: driverId,
        eventType: 'AT_FAULT_COLLISION' as const,
        severity: 'MODERATE' as const,
        date: acc.accidentDate ? new Date(acc.accidentDate).toISOString() : new Date().toISOString(),
        description: acc.notesReceived || 'Accident on record',
        atFault: acc.dodAtFault === 'Yes',
        claimAmount: acc.totalProbableCost ? parseFloat(acc.totalProbableCost) * 100 : 0,
      }));
      
      const evaluationDate = new Date().toISOString();
      const status = safetyEngine.evaluateDriverSafetyStatus(
        driverId,
        safetyEvents,
        evaluationDate
      );
      
      res.json(status);
    } catch (error) {
      console.error("Error fetching driver safety status:", error);
      res.status(500).json({ message: "Failed to fetch safety status" });
    }
  });

  // Get all drivers with tier and safety state summary
  app.get("/api/corporate/drivers/summary", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const drivers = await storage.getAllDriversWithUsers();
      
      const driverSummaries = await Promise.all(drivers.map(async (driver: any) => {
        // Get pay records to determine tier
        const payRecords = await storage.getPayRecordsByDriverId(driver.id);
        const latestPay = payRecords[0];
        
        // Get accidents for safety state
        const accidents = await storage.getAccidentsByDriverId(driver.id);
        const atFaultCount = accidents.filter((a: any) => a.dodAtFault === 'Yes').length;
        
        // Determine safety state based on at-fault claims
        let safetyState: string = 'ACTIVE';
        if (atFaultCount >= 3) safetyState = 'SUSPENDED';
        else if (atFaultCount >= 2) safetyState = 'RESTRICTED';
        
        return {
          id: driver.id,
          name: driver.user?.firstName && driver.user?.lastName 
            ? `${driver.user.firstName} ${driver.user.lastName}` 
            : driver.fullName || 'Unknown',
          email: driver.user?.email || driver.email || 'N/A',
          status: driver.status,
          tier: latestPay?.tier || 1,
          safetyState,
          atFaultClaimsCount: atFaultCount,
          totalTrips: payRecords.reduce((sum: number, pr: any) => sum + (pr.totalTrips || 0), 0),
          market: driver.market,
          profilePhotoUrl: driver.profilePhotoUrl,
        };
      }));
      
      res.json(driverSummaries);
    } catch (error) {
      console.error("Error fetching driver summaries:", error);
      res.status(500).json({ message: "Failed to fetch driver summaries" });
    }
  });

  // Get pay periods summary
  app.get("/api/corporate/pay-periods", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      // Get all drivers and their pay records
      const drivers = await storage.getAllDrivers();
      const periodMap = new Map<string, any>();
      
      for (const driver of drivers) {
        const payRecords = await storage.getPayRecordsByDriverId(driver.id);
        
        for (const record of payRecords) {
          const periodKey = `${record.payPeriodStart}_${record.payPeriodEnd}`;
          
          if (!periodMap.has(periodKey)) {
            periodMap.set(periodKey, {
              id: periodKey,
              startDate: record.payPeriodStart,
              endDate: record.payPeriodEnd,
              status: record.status || 'open',
              driverCount: 0,
              totalGrossPay: 0,
              totalNetPay: 0,
              totalTrips: 0,
            });
          }
          
          const period = periodMap.get(periodKey);
          period.driverCount++;
          period.totalGrossPay += parseFloat(record.grossPay || '0');
          period.totalNetPay += parseFloat(record.netPay || '0');
          period.totalTrips += record.totalTrips || 0;
        }
      }
      
      const periods = Array.from(periodMap.values())
        .sort((a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime());
      
      res.json(periods);
    } catch (error) {
      console.error("Error fetching pay periods:", error);
      res.status(500).json({ message: "Failed to fetch pay periods" });
    }
  });

  // Authorized users for pay period lock actions (Will Walton + David Forman)
  const PAYROLL_LOCK_AUTHORIZED_USERS = [
    { firstName: 'Will', lastName: 'Walton' },
    { firstName: 'David', lastName: 'Forman' },
  ];

  function isPayrollLockAuthorized(user: any): boolean {
    if (!user) return false;
    const firstName = user.firstName?.toLowerCase() || '';
    const lastName = user.lastName?.toLowerCase() || '';
    return PAYROLL_LOCK_AUTHORIZED_USERS.some(
      auth => firstName.includes(auth.firstName.toLowerCase()) && lastName.includes(auth.lastName.toLowerCase())
    );
  }

  // Lock Pay Period: PROCESSING -> LOCKED (restricted to Will Walton + David Forman)
  // Uses canLockPayPeriod gate from eligibility service (INCREMENT 25B)
  app.post("/api/corporate/pay-periods/:id/lock", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      
      // Check if user is authorized to lock pay periods
      if (!isPayrollLockAuthorized(currentUser)) {
        return res.status(403).json({ 
          message: "Access denied", 
          reason: "Only Will Walton and David Forman can lock pay periods" 
        });
      }
      
      const payPeriodId = req.params.id; // UUID string, not numeric
      if (!payPeriodId) {
        return res.status(400).json({ message: "Invalid pay period ID" });
      }
      
      // Get the pay period
      const allPayPeriods = await storage.getAllPayPeriods();
      const payPeriod = allPayPeriods.find((p: any) => p.id === payPeriodId);
      
      if (!payPeriod) {
        return res.status(404).json({ message: "Pay period not found" });
      }
      
      // Use eligibility service to check lock preconditions (INCREMENT 25B)
      const { canLockPayPeriod, buildPayrollError } = await import('./services/eligibility');
      const lockCheck = canLockPayPeriod({
        id: payPeriod.id,
        status: payPeriod.status,
        lockedAt: payPeriod.lockedAt,
        exportedAt: payPeriod.exportedAt,
        exportStatus: payPeriod.exportStatus,
        // TODO: Add actual reconciliation checks
        movesReconciled: true, // Placeholder - wire to actual data
        expensesApproved: true, // Placeholder - wire to actual data
      });
      
      if (!lockCheck.allowed) {
        const errorResponse = buildPayrollError(lockCheck);
        return res.status(errorResponse.statusCode).json(errorResponse.body);
      }
      
      // Update pay period status to LOCKED (uppercase to match enum)
      await storage.updatePayPeriod(payPeriodId, { status: 'LOCKED', lockedAt: new Date() });
      
      res.json({ 
        success: true, 
        message: "Pay period locked successfully",
        payPeriodId 
      });
    } catch (error: any) {
      console.error("Error locking pay period:", error);
      const errorCode = error.message?.includes("already locked") ? 'PAY_PERIOD_ALREADY_LOCKED' : 'UNKNOWN_ERROR';
      res.status(500).json({ 
        message: "Failed to lock pay period",
        code: errorCode
      });
    }
  });

  // Generate Export: Create export package for ADP/OpenForce (restricted to Will Walton + David Forman)
  // Uses canExportPayroll gate from eligibility service (INCREMENT 25B)
  app.post("/api/corporate/pay-periods/:id/export", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      
      // Check if user is authorized to generate exports
      if (!isPayrollLockAuthorized(currentUser)) {
        return res.status(403).json({ 
          message: "Access denied", 
          reason: "Only Will Walton and David Forman can generate payroll exports" 
        });
      }
      
      const payPeriodId = req.params.id; // UUID string, not numeric
      if (!payPeriodId) {
        return res.status(400).json({ message: "Invalid pay period ID" });
      }
      
      // Get the pay period
      const allPayPeriods = await storage.getAllPayPeriods();
      const payPeriod = allPayPeriods.find((p: any) => p.id === payPeriodId);
      
      if (!payPeriod) {
        return res.status(404).json({ message: "Pay period not found" });
      }
      
      // Use eligibility service to check export preconditions (INCREMENT 25B)
      const { canExportPayroll, buildPayrollError } = await import('./services/eligibility');
      const exportCheck = canExportPayroll({
        id: payPeriod.id,
        status: payPeriod.status,
        lockedAt: payPeriod.lockedAt,
        exportedAt: payPeriod.exportedAt,
        exportStatus: payPeriod.exportStatus,
      });
      
      if (!exportCheck.allowed) {
        const errorResponse = buildPayrollError(exportCheck);
        return res.status(errorResponse.statusCode).json(errorResponse.body);
      }
      
      const exportType = req.body.exportType || 'ADP'; // ADP or OpenForce
      
      // Generate export data
      const drivers = await storage.getAllDriversWithUsers();
      const payRecords = [];
      
      for (const driver of drivers) {
        const records = await storage.getPayRecordsByDriverId(driver.id);
        const periodRecords = records.filter((r: any) => {
          const recordStart = new Date(r.payPeriodStart);
          const periodStart = new Date(payPeriod.periodStart);
          const periodEnd = new Date(payPeriod.periodEnd);
          return recordStart >= periodStart && recordStart <= periodEnd;
        });
        payRecords.push(...periodRecords.map((r: any) => ({
          ...r,
          driverName: `${driver.firstName || ''} ${driver.lastName || ''}`.trim(),
          driverNumber: driver.driverNumber,
          market: driver.market,
        })));
      }
      
      // Create export record (in production, this would generate actual files)
      const exportData = {
        payPeriodId,
        exportType,
        generatedAt: new Date().toISOString(),
        generatedBy: `${currentUser?.firstName || ''} ${currentUser?.lastName || ''}`.trim(),
        recordCount: payRecords.length,
        totalGrossPay: payRecords.reduce((sum: number, r: any) => sum + parseFloat(r.grossPay || '0'), 0),
        status: 'EXPORTED',
      };
      
      // Update pay period with export info
      await storage.updatePayPeriod(payPeriodId, { 
        exportedAt: new Date(),
        exportType,
        exportStatus: 'EXPORTED',
      });
      
      res.json({ 
        success: true, 
        message: `Export package generated for ${exportType}`,
        export: exportData,
        recordCount: payRecords.length,
      });
    } catch (error: any) {
      console.error("Error generating export:", error);
      const errorCode = error.message?.includes("No moves") ? 'PAY_PERIOD_EMPTY' : 'UNKNOWN_ERROR';
      res.status(500).json({ 
        message: "Failed to generate export",
        code: errorCode 
      });
    }
  });

  // Check if current user is authorized for payroll lock operations
  app.get("/api/corporate/pay-periods/authorized", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      
      const isAuthorized = isPayrollLockAuthorized(currentUser);
      
      res.json({ 
        isAuthorized,
        authorizedUsers: PAYROLL_LOCK_AUTHORIZED_USERS.map(u => `${u.firstName} ${u.lastName}`),
      });
    } catch (error) {
      console.error("Error checking authorization:", error);
      res.status(500).json({ message: "Failed to check authorization" });
    }
  });

  // ============================================
  // MOVE ASSIGNMENT ENDPOINT WITH HARD ENFORCEMENT (INCREMENT 25B)
  // ============================================
  
  // Assign driver to move - Uses canAssignWork gate
  // Returns 409 Conflict with {allowed: false, code, reasons[]} if ineligible
  app.post("/api/corporate/moves/:moveId/assign", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const moveId = req.params.moveId;
      const { driverId } = req.body;
      
      if (!moveId || !driverId) {
        return res.status(400).json({ message: "Both moveId and driverId are required" });
      }
      
      // Get driver info for eligibility check
      const driver = await storage.getDriver(driverId);
      if (!driver) {
        return res.status(404).json({ 
          allowed: false,
          code: 'DRIVER_NOT_FOUND',
          reasons: ['Driver not found'],
          driverId,
          moveId,
        });
      }
      
      // Build driver eligibility info
      // In production, this would be populated from driver qualification tables
      const { canAssignWork, buildWorkAssignmentError } = await import('./services/eligibility');
      
      const driverEligibility = {
        driverId: driver.id,
        safetyState: driver.safetyState || 'ACTIVE',
        eligibleMarkets: [driver.market].filter(Boolean) as string[],
        eligibleZones: [], // Would be populated from qualification tables
        eligibleWorkTypes: ['ON_DEMAND', 'SCHEDULED', 'MANUAL'], // Default eligible for all
        eligibleExecutionModes: ['COMPANY_VEHICLE', 'DRIVER_VEHICLE', 'CUSTOMER_VEHICLE'],
        blocks: [], // Would be populated from active blocks table
      };
      
      // Build move details (in production, would fetch from moves table)
      const moveDetails = {
        id: moveId,
        marketId: driver.market || 'unknown',
        workType: req.body.workType || 'ON_DEMAND',
        executionMode: req.body.executionMode || 'COMPANY_VEHICLE',
      };
      
      // Check eligibility using hard enforcement gate
      const assignmentCheck = canAssignWork(driverEligibility, moveDetails);
      
      if (!assignmentCheck.allowed) {
        const errorResponse = buildWorkAssignmentError(assignmentCheck);
        return res.status(errorResponse.statusCode).json(errorResponse.body);
      }
      
      // All checks passed - proceed with assignment
      // In production, this would update the moves table
      res.json({
        success: true,
        message: "Driver assigned to move successfully",
        assignment: {
          driverId,
          moveId,
          assignedAt: new Date().toISOString(),
          assignedBy: `${currentUser?.firstName || ''} ${currentUser?.lastName || ''}`.trim(),
        },
      });
    } catch (error) {
      console.error("Error assigning driver to move:", error);
      res.status(500).json({ message: "Failed to assign driver to move" });
    }
  });

  // Check work assignment eligibility without making assignment
  app.post("/api/corporate/moves/check-eligibility", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const { driverId, moveId, marketId, workType, executionMode } = req.body;
      
      if (!driverId) {
        return res.status(400).json({ message: "driverId is required" });
      }
      
      // Get driver info for eligibility check
      const driver = await storage.getDriver(driverId);
      if (!driver) {
        return res.status(404).json({ 
          allowed: false,
          code: 'DRIVER_NOT_FOUND',
          reasons: ['Driver not found'],
          driverId,
          moveId: moveId || 'check',
        });
      }
      
      const { canAssignWork } = await import('./services/eligibility');
      
      const driverEligibility = {
        driverId: driver.id,
        safetyState: driver.safetyState || 'ACTIVE',
        eligibleMarkets: [driver.market].filter(Boolean) as string[],
        eligibleZones: [],
        eligibleWorkTypes: ['ON_DEMAND', 'SCHEDULED', 'MANUAL'],
        eligibleExecutionModes: ['COMPANY_VEHICLE', 'DRIVER_VEHICLE', 'CUSTOMER_VEHICLE'],
        blocks: [],
      };
      
      const moveDetails = {
        id: moveId || 'eligibility-check',
        marketId: marketId || driver.market || 'unknown',
        workType: workType || 'ON_DEMAND',
        executionMode: executionMode || 'COMPANY_VEHICLE',
      };
      
      const eligibilityCheck = canAssignWork(driverEligibility, moveDetails);
      
      res.json(eligibilityCheck);
    } catch (error) {
      console.error("Error checking eligibility:", error);
      res.status(500).json({ message: "Failed to check eligibility" });
    }
  });

  // Check market hiring gate status
  app.get("/api/corporate/markets/:marketId/hiring-gate", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const marketId = req.params.marketId;
      const { canOpenHiring } = await import('./services/eligibility');
      
      // Try to fetch market by ID first, then by code
      let market = await storage.getMarket(marketId);
      if (!market) {
        market = await storage.getMarketByCode(marketId);
      }
      
      // Get driver counts for this market
      const drivers = await storage.getAllDriversWithUsers();
      const marketDrivers = drivers.filter((d: any) => 
        d.market === marketId || d.market === market?.code
      );
      const activeDrivers = marketDrivers.filter((d: any) => d.status === 'active').length;
      
      // Use real market data or defaults
      const maxCapacity = market?.maxCapacity ?? 100;
      const hiringGateStatus = (market?.hiringGateStatus as 'OPEN' | 'LIMITED' | 'FROZEN' | 'CLOSED') ?? 'OPEN';
      const throttleActive = market?.throttleActive ?? false;
      
      const hiringGate = {
        marketId: market?.id || marketId,
        marketCode: market?.code || marketId,
        marketName: market?.name || marketId,
        hiringGateStatus,
        throttleActive,
        throttleReason: market?.throttleReason || null,
        currentCapacity: marketDrivers.length,
        maxCapacity,
        utilizationRate: maxCapacity > 0 ? marketDrivers.length / maxCapacity : 0,
      };
      
      const hiringCheck = canOpenHiring(marketId, hiringGate);
      
      res.json({
        ...hiringCheck,
        hiringGate,
        activeDrivers,
        totalDrivers: marketDrivers.length,
        marketExists: !!market,
      });
    } catch (error) {
      console.error("Error checking hiring gate:", error);
      res.status(500).json({ message: "Failed to check hiring gate" });
    }
  });

  // Get markets summary (read-only view of market data)
  app.get("/api/corporate/markets", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      // Get unique markets from drivers
      const drivers = await storage.getAllDriversWithUsers();
      const marketCounts = new Map<string, { active: number; total: number }>();
      
      for (const driver of drivers) {
        const market = driver.market || 'Unknown';
        if (!marketCounts.has(market)) {
          marketCounts.set(market, { active: 0, total: 0 });
        }
        const counts = marketCounts.get(market)!;
        counts.total++;
        if (driver.status === 'active') {
          counts.active++;
        }
      }
      
      // Get trip counts by market
      const trips = await storage.getAllTrips();
      const tripsByMarket = new Map<string, number>();
      for (const trip of trips) {
        const market = trip.market || 'Unknown';
        tripsByMarket.set(market, (tripsByMarket.get(market) || 0) + 1);
      }
      
      const markets = Array.from(marketCounts.entries()).map(([name, counts]) => ({
        name,
        activeDrivers: counts.active,
        totalDrivers: counts.total,
        tripCount: tripsByMarket.get(name) || 0,
        status: counts.active > 0 ? 'active' : 'inactive',
      }));
      
      res.json(markets.sort((a, b) => b.activeDrivers - a.activeDrivers));
    } catch (error) {
      console.error("Error fetching markets:", error);
      res.status(500).json({ message: "Failed to fetch markets" });
    }
  });

  // ============================================
  // INCREMENT 25B: ROSTER EXPORT WITH ELIGIBILITY FILTERING
  // ============================================

  // Roster export - excludes non-eligible drivers (GATE 2) with real data enforcement
  app.get("/api/corporate/roster/export", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const { filterRosterExport } = await import('./services/eligibility');
      type DriverRosterInfo = { driverId: string; safetyState: string; eligibilityState?: string; hasActiveBlock: boolean; marketHiringGateStatus?: string; };
      
      const drivers = await storage.getAllDriversWithUsers();
      
      // Get all markets to build a lookup map for hiring gate status
      // Map by id, name, and code since driver.market could be any of these
      const allMarkets = await storage.getAllMarkets();
      const marketHiringGates = new Map<string, string>();
      for (const market of allMarkets) {
        const hiringStatus = market.hiringGateStatus || 'OPEN';
        // Map by all possible identifiers
        marketHiringGates.set(market.id, hiringStatus);
        marketHiringGates.set(market.name, hiringStatus);
        if (market.code) {
          marketHiringGates.set(market.code, hiringStatus);
        }
      }
      
      // Build roster info for each driver using REAL data
      const rosterInfos: DriverRosterInfo[] = drivers.map((d: any) => {
        const safetyState = d.safetyState || 'ACTIVE';
        // SUSPENDED or DISQUALIFIED safety states indicate an active block
        const hasActiveBlock = safetyState === 'SUSPENDED' || safetyState === 'DISQUALIFIED';
        // Get hiring gate status from driver's market
        const marketHiringGateStatus = d.market ? (marketHiringGates.get(d.market) || 'OPEN') : 'OPEN';
        
        return {
          driverId: d.id,
          safetyState,
          eligibilityState: d.status === 'active' ? 'ACTIVE' : 'INACTIVE',
          hasActiveBlock,
          marketHiringGateStatus,
        };
      });
      
      const result = filterRosterExport(rosterInfos);
      
      // Get full driver data for included drivers
      const includedDriverIds = new Set(result.included.map(d => d.driverId));
      const includedDrivers = drivers.filter((d: any) => includedDriverIds.has(d.id));
      
      res.json({
        exportedAt: new Date().toISOString(),
        totalDrivers: drivers.length,
        includedCount: result.included.length,
        excludedCount: result.excluded.length,
        drivers: includedDrivers.map((d: any) => ({
          id: d.id,
          name: d.user?.firstName + ' ' + d.user?.lastName,
          market: d.market,
          status: d.status,
          safetyState: d.safetyState || 'ACTIVE',
        })),
        exclusions: result.excluded,
      });
    } catch (error) {
      console.error("Error exporting roster:", error);
      res.status(500).json({ message: "Failed to export roster" });
    }
  });

  // ============================================
  // INCREMENT 25B: PAYROLL EXPORT WITH ELIGIBILITY ENFORCEMENT
  // ============================================

  // Get payroll exceptions for a pay period
  app.get("/api/corporate/payroll/:payPeriodId/exceptions", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const payPeriodId = req.params.payPeriodId;
      const exceptions = await storage.getPayrollExceptionsByPayPeriod(payPeriodId);
      
      res.json({
        payPeriodId,
        exceptions,
        totalCount: exceptions.length,
        pendingCount: exceptions.filter((e: any) => e.status === 'PENDING').length,
        approvedCount: exceptions.filter((e: any) => e.status === 'OVERRIDE_APPROVED').length,
      });
    } catch (error) {
      console.error("Error fetching payroll exceptions:", error);
      res.status(500).json({ message: "Failed to fetch payroll exceptions" });
    }
  });

  // Override payroll exception (ONLY Will Walton or David Forman)
  app.post("/api/corporate/payroll/exceptions/:exceptionId/override", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const { reason } = req.body;
      const exceptionId = req.params.exceptionId;
      
      if (!reason || reason.trim().length < 10) {
        return res.status(400).json({ 
          message: "Override reason is required and must be at least 10 characters" 
        });
      }
      
      const { approvePayrollException } = await import('./services/eligibility');
      
      // Get user email for authorization check
      const userEmail = currentUser?.email || '';
      
      const approvalResult = approvePayrollException(exceptionId, userEmail, reason);
      
      if (!approvalResult.allowed) {
        return res.status(403).json({
          allowed: false,
          code: approvalResult.code,
          message: approvalResult.message,
        });
      }
      
      // Update the exception in database
      const updatedException = await storage.updatePayrollException(exceptionId, {
        status: 'OVERRIDE_APPROVED',
        overrideApprovedBy: currentUserId,
        overrideReason: reason.trim(),
        overrideApprovedAt: new Date(),
      });
      
      if (!updatedException) {
        return res.status(404).json({ message: "Exception not found" });
      }
      
      res.json({
        message: "Override approved successfully",
        exception: updatedException,
        approvedBy: userEmail,
        approvedAt: approvalResult.approvedAt,
      });
    } catch (error) {
      console.error("Error approving payroll exception:", error);
      res.status(500).json({ message: "Failed to approve exception" });
    }
  });

  // Payroll export with eligibility enforcement (GATE 3)
  app.post("/api/corporate/payroll/:payPeriodId/export", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      // Only Will Walton and David Forman can export payroll
      const userEmail = currentUser?.email || '';
      const authorizedEmails = ['will.walton@driverhub360.com', 'david.forman@driverhub360.com'];
      if (!authorizedEmails.some(e => e.toLowerCase() === userEmail.toLowerCase())) {
        return res.status(403).json({ 
          message: "Only Will Walton or David Forman can export payroll" 
        });
      }
      
      const payPeriodId = req.params.payPeriodId;
      const payPeriods = await storage.getAllPayPeriods();
      const payPeriod = payPeriods.find((pp: any) => pp.id === payPeriodId);
      
      if (!payPeriod) {
        return res.status(404).json({ message: "Pay period not found" });
      }
      
      const { filterMovesForPayrollExport } = await import('./services/eligibility');
      type MoveForPayroll = { tripId: string; moveNumber: string; driverId: string; eligibilityStatus: 'PASS' | 'WARN' | 'FAIL' | null; eligibilityReasons: string[] | null; payRate?: string | number; };
      
      // Get trips for this pay period
      const trips = await storage.getTripsByPayPeriodWithEligibility(
        new Date(payPeriod.periodStart),
        new Date(payPeriod.periodEnd)
      );
      
      if (trips.length === 0) {
        return res.status(400).json({
          message: "No moves found for this pay period. Cannot generate export.",
          code: 'PAY_PERIOD_EMPTY',
        });
      }
      
      // Map to MoveForPayroll format
      const movesForPayroll: MoveForPayroll[] = trips.map((t: any) => ({
        tripId: t.id,
        moveNumber: t.moveNumber,
        driverId: t.driverId,
        eligibilityStatus: t.eligibilityStatus || null,
        eligibilityReasons: t.eligibilityReasons || null,
        payRate: t.payRate,
      }));
      
      // Filter moves using eligibility gate
      const exportResult = filterMovesForPayrollExport(
        { id: payPeriodId, status: payPeriod.status },
        movesForPayroll
      );
      
      if (!exportResult.allowed) {
        return res.status(409).json({
          allowed: false,
          code: exportResult.code,
          reasons: exportResult.reasons,
          payPeriodStatus: exportResult.payPeriodStatus,
        });
      }
      
      // Create payroll exceptions for excluded moves
      for (const exception of exportResult.exceptions) {
        await storage.createPayrollException({
          tripId: exception.tripId,
          payPeriodId,
          driverId: exception.driverId,
          moveNumber: exception.moveNumber,
          exceptionType: exception.exceptionType,
          eligibilityReasons: exception.eligibilityReasons,
          originalEligibilityStatus: exception.originalEligibilityStatus,
          status: 'PENDING',
        });
      }
      
      res.json({
        exportedAt: new Date().toISOString(),
        payPeriodId,
        payPeriodStatus: exportResult.payPeriodStatus,
        includedMoves: exportResult.includedMoves.length,
        exceptionsCreated: exportResult.exceptions.length,
        moves: exportResult.includedMoves,
        exceptions: exportResult.exceptions,
      });
    } catch (error) {
      console.error("Error exporting payroll:", error);
      res.status(500).json({ message: "Failed to export payroll" });
    }
  });

  // Get pending payroll exceptions across all pay periods
  app.get("/api/corporate/payroll/exceptions/pending", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const exceptions = await storage.getPendingPayrollExceptions();
      
      res.json({
        exceptions,
        count: exceptions.length,
      });
    } catch (error) {
      console.error("Error fetching pending exceptions:", error);
      res.status(500).json({ message: "Failed to fetch pending exceptions" });
    }
  });

  // ============ INCREMENT 27: PAY PERIOD MANAGEMENT ============

  // List pay periods with optional filters
  app.get("/api/payroll/pay-periods", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const { workerType, periodType } = req.query;
      
      let payPeriods = await storage.getAllPayPeriods();
      
      if (periodType) {
        payPeriods = payPeriods.filter((pp: any) => {
          // Direct match against periodType field (DRIVERS_WEEKLY or DRIVERS_BIWEEKLY)
          if (pp.periodType === periodType) return true;
          
          // Legacy support: check by date range if periodType field not set
          const start = new Date(pp.periodStart);
          const end = new Date(pp.periodEnd);
          const daysDiff = Math.ceil((end.getTime() - start.getTime()) / (1000 * 60 * 60 * 24));
          
          if (periodType === 'DRIVERS_WEEKLY' && daysDiff >= 6 && daysDiff <= 8) return true;
          if (periodType === 'DRIVERS_BIWEEKLY' && daysDiff >= 13 && daysDiff <= 15) return true;
          return false;
        });
      }
      
      if (workerType) {
        payPeriods = payPeriods.filter((pp: any) => 
          pp.payGroup?.toLowerCase().includes(workerType.toLowerCase())
        );
      }
      
      const payPeriodsWithCounts = await Promise.all(
        payPeriods.map(async (pp: any) => {
          const trips = await storage.getTripsByPayPeriodWithEligibility(
            new Date(pp.periodStart),
            new Date(pp.periodEnd)
          );
          
          const totalMoves = trips.length;
          const includedMoves = trips.filter((t: any) => 
            t.eligibilityStatus === 'PASS' || t.eligibilityStatus === null
          ).length;
          const excludedMoves = totalMoves - includedMoves;
          
          return {
            ...pp,
            summary: {
              totalMoves,
              includedMoves,
              excludedMoves,
            },
          };
        })
      );
      
      res.json({
        payPeriods: payPeriodsWithCounts,
        count: payPeriodsWithCounts.length,
      });
    } catch (error) {
      console.error("Error fetching pay periods:", error);
      res.status(500).json({ message: "Failed to fetch pay periods" });
    }
  });

  // Create a manual trip entry
  app.post("/api/corporate/trips/manual", async (req: any, res: Response) => {
    try {
      // Support both session-based (password) and OIDC auth
      const currentUserId = (req.session as any)?.userId || req.user?.claims?.sub;
      if (!currentUserId) {
        return res.status(401).json({ error: "UNAUTHORIZED", message: "Not authenticated" });
      }
      const currentUser = await storage.getUser(currentUserId);
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      const userEmail = currentUser?.email || req.user?.claims?.email || '';

      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const { 
        tripDate, 
        marketId, 
        estimatedMinutes, 
        notes, 
        driverId,
        customerId,
        referenceNumber
      } = req.body;

      if (!tripDate || !marketId || !notes || !estimatedMinutes) {
        return res.status(400).json({ message: "Missing required fields: tripDate, marketId, estimatedMinutes, notes" });
      }

      if (!driverId) {
        return res.status(400).json({ message: "Driver is required for manual move entry" });
      }

      if (!customerId) {
        return res.status(400).json({ message: "Customer is required for manual move entry" });
      }

      const moveNumber = referenceNumber || `MANUAL-${Date.now()}`;
      const moveData = {
        moveNumber,
        driverId: driverId,
        customerId: customerId,
        tripDate,
        origin: req.body.origin || 'Manual Entry',
        destination: req.body.destination || 'Manual Entry',
        marketId,
        notes,
        status: 'completed',
        estimatedMinutes: parseInt(estimatedMinutes, 10) || 0,
        duration: `${estimatedMinutes} min`
      };

      const { importMoves } = await import("./imports/importMoves");
      const context = {
        source: 'MANUAL' as const,
        ingestedBy: userEmail,
        storage: {
          getDriver: (id: string) => storage.getDriver(id),
          createTrip: (tripData: any) => storage.createTrip(tripData),
          getActivePolicyVersion: () => storage.getActivePolicyVersion ? storage.getActivePolicyVersion() : Promise.resolve(null),
        }
      };
      const results = await importMoves([moveData], context);

      // Find applicable pay period for this move's date
      const moveDate = new Date(tripDate);
      const allPayPeriods = await storage.getAllPayPeriods();
      const applicablePayPeriod = allPayPeriods.find((pp: any) => {
        const start = new Date(pp.periodStart);
        const end = new Date(pp.periodEnd);
        end.setHours(23, 59, 59, 999);
        return moveDate >= start && moveDate <= end;
      });

      // Log audit event with move_id and pay_period_id
      await storage.createPayPeriodAuditEvent({
        action: 'MOVE_CREATED_MANUAL' as any,
        userId: userEmail,
        payPeriodId: applicablePayPeriod?.id || null,
        metadata: {
          moveId: results.results[0]?.tripId,
          moveNumber: results.results[0]?.moveNumber,
          referenceNumber: moveNumber,
          marketId,
          driverId,
          customerId,
          serviceDate: tripDate,
          eligibilityStatus: results.results[0]?.eligibilityStatus,
          eligibilityReasons: results.results[0]?.eligibilityReasons,
        },
      });

      res.status(201).json({
        message: "Manual move created successfully",
        move: results.results[0],
        eligibility: {
          status: results.results[0]?.eligibilityStatus,
          reasons: results.results[0]?.eligibilityReasons
        }
      });
    } catch (error: any) {
      console.error("Error creating manual trip:", error);
      res.status(500).json({ message: error.message || "Failed to create manual trip" });
    }
  });

  // Open a new pay period
  // Authorized users for pay period operations
  // Note: These are now managed in server/services/payrollPermissions.ts
  // but kept here temporarily for any direct references not yet refactored.
  
  // Create a new pay period (POST /api/payroll/pay-periods)
  app.post("/api/payroll/pay-periods", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const userEmail = currentUser?.email || req.user?.claims?.email || '';
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      // Authorization check for creating pay periods
      if (!canOpenPayPeriod({ email: userEmail })) {
        return res.status(403).json({ 
          message: "Only Will Walton, David Forman, or Luis Valdez can create pay periods",
          code: 'UNAUTHORIZED_CREATOR',
        });
      }

      const { payGroup, periodType, periodStart, periodEnd } = req.body;
      
      if (!payGroup || !periodStart || !periodEnd) {
        return res.status(400).json({ 
          message: "payGroup, periodStart, and periodEnd are required" 
        });
      }

      // Validate periodType (DRIVERS_WEEKLY or DRIVERS_BIWEEKLY)
      const validPeriodType = periodType === 'DRIVERS_BIWEEKLY' ? 'DRIVERS_BIWEEKLY' : 'DRIVERS_WEEKLY';
      
      const newPayPeriod = await storage.createPayPeriod({
        payGroup,
        periodType: validPeriodType,
        periodStart,
        periodEnd,
        status: 'OPEN',
        createdBy: userEmail,
      });
      
      // Log audit event for pay period creation
      await storage.createPayPeriodAuditEvent({
        action: 'PAY_PERIOD_CREATED',
        userId: userEmail,
        payPeriodId: newPayPeriod.id,
        metadata: {
          payGroup,
          periodType: validPeriodType,
          periodStart,
          periodEnd,
        },
      });
      
      res.status(201).json({
        payPeriod: newPayPeriod,
        message: "Pay period created successfully",
      });
    } catch (error) {
      console.error("Error creating pay period:", error);
      res.status(500).json({ message: "Failed to create pay period" });
    }
  });

  // Legacy endpoint for backwards compatibility
  app.post("/api/payroll/pay-periods/open", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const userEmail = currentUser?.email || req.user?.claims?.email || '';
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const { payGroup, periodType, periodStart, periodEnd } = req.body;
      
      if (!payGroup || !periodStart || !periodEnd) {
        return res.status(400).json({ 
          message: "payGroup, periodStart, and periodEnd are required" 
        });
      }

      const validPeriodType = periodType === 'BIWEEKLY' ? 'BIWEEKLY' : 'WEEKLY';
      
      const newPayPeriod = await storage.createPayPeriod({
        payGroup,
        periodType: validPeriodType,
        periodStart,
        periodEnd,
        status: 'OPEN',
        createdBy: userEmail,
      });
      
      res.status(201).json({
        payPeriod: newPayPeriod,

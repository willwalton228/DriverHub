  // GET /api/recruiting/reason-codes/required/:stage - Check if reason is required for a stage
  app.get("/api/recruiting/reason-codes/required/:stage", async (req: any, res: Response) => {
    try {
      const { stage } = req.params;
      const { market } = req.query;
      
      const conditions: any[] = [
        eq(recruitingReasonCodes.stage, stage),
        eq(recruitingReasonCodes.isRequired, true),
        eq(recruitingReasonCodes.isActive, true),
      ];
      
      if (market) {
        conditions.push(or(eq(recruitingReasonCodes.market, market as string), isNull(recruitingReasonCodes.market)));
      }
      
      const requiredCodes = await db.select()
        .from(recruitingReasonCodes)
        .where(and(...conditions));

      res.json({
        required: requiredCodes.length > 0,
        codes: requiredCodes,
      });
    } catch (error: any) {
      console.error("Error checking required reason codes:", error);
      res.status(500).json({ message: "Failed to check required reason codes" });
    }
  });

  // ==================== Stage Reasons API ====================

  // POST /api/recruiting/applications/:id/stage-reason - Record a stage reason
  app.post("/api/recruiting/applications/:id/stage-reason", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Recruiting access required" });
      }

      const { id } = req.params;
      const { stage, reasonCodeId, notes } = req.body;
      
      if (!stage) {
        return res.status(400).json({ message: "Stage is required" });
      }

      // Verify application exists
      const [application] = await db.select().from(recruitingApplications).where(eq(recruitingApplications.id, id));
      
      if (!application) {
        return res.status(404).json({ message: "Application not found" });
      }

      // Get reason code details if provided
      let reasonCode: string | null = null;
      let reasonLabel: string | null = null;
      
      if (reasonCodeId) {
        const [reasonCodeRecord] = await db.select()
          .from(recruitingReasonCodes)
          .where(eq(recruitingReasonCodes.id, reasonCodeId));
        
        if (reasonCodeRecord) {
          reasonCode = reasonCodeRecord.code;
          reasonLabel = reasonCodeRecord.label;
        }
      }

      const [created] = await db.insert(recruitingStageReasons).values({
        applicationId: id,
        stage,
        reasonCodeId: reasonCodeId || null,
        reasonCode,
        reasonLabel,
        notes: notes || null,
        recordedBy: user.id,
        recordedByEmail: user.email,
      }).returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "STAGE_REASON_RECORDED",
        entityType: "application",
        entityId: id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        newValue: JSON.stringify({
          stage,
          reasonCode,
          reasonLabel,
          notes,
        }),
      });

      res.status(201).json(created);
    } catch (error: any) {
      console.error("Error recording stage reason:", error);
      res.status(500).json({ message: "Failed to record stage reason" });
    }
  });

  // GET /api/recruiting/applications/:id/stage-reasons - Get all stage reasons for an application
  app.get("/api/recruiting/applications/:id/stage-reasons", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user) {
        return res.status(403).json({ message: "Forbidden" });
      }

      const { id } = req.params;
      
      const reasons = await db.select()
        .from(recruitingStageReasons)
        .where(eq(recruitingStageReasons.applicationId, id))
        .orderBy(desc(recruitingStageReasons.recordedAt));

      res.json(reasons);
    } catch (error: any) {
      console.error("Error fetching stage reasons:", error);
      res.status(500).json({ message: "Failed to fetch stage reasons" });
    }
  });

  // ==================== Withdrawal & No-Show API ====================

  // POST /api/recruiting/applications/:id/withdraw - Record application withdrawal
  app.post("/api/recruiting/applications/:id/withdraw", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Recruiting access required" });
      }

      const { id } = req.params;
      const { reason, source, excludeFromMetrics, notes } = req.body;
      
      // Verify application exists
      const [application] = await db.select().from(recruitingApplications).where(eq(recruitingApplications.id, id));
      
      if (!application) {
        return res.status(404).json({ message: "Application not found" });
      }
      
      if (application.withdrawnAt) {
        return res.status(400).json({ message: "Application already withdrawn" });
      }

      // Update application with withdrawal info
      const [updated] = await db.update(recruitingApplications)
        .set({
          currentStage: "withdrawn",
          withdrawnAt: new Date(),
          withdrawnBy: user.id,
          withdrawnReason: reason || null,
          withdrawnSource: source || "recruiter",
          excludeFromMetrics: excludeFromMetrics || false,
          updatedAt: new Date(),
        })
        .where(eq(recruitingApplications.id, id))
        .returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "APPLICATION_WITHDRAWN",
        entityType: "application",
        entityId: id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        previousValue: JSON.stringify({ stage: application.currentStage }),
        newValue: JSON.stringify({
          stage: "withdrawn",
          reason,
          source: source || "recruiter",
          excludeFromMetrics: excludeFromMetrics || false,
          notes,
        }),
      });

      res.json(updated);
    } catch (error: any) {
      console.error("Error recording withdrawal:", error);
      res.status(500).json({ message: "Failed to record withdrawal" });
    }
  });


  app.use('/api/admin/users', adminUsersRouter);

  // ============================================
  // DRUG TEST NOTIFICATION WORKFLOW
  // ============================================

  // Zod schemas for drug test validation
  const drugTestTriggerTypes = ['ACCIDENT', 'INJURY', 'DOT_REQUIRED', 'RANDOM', 'POST_INCIDENT', 'REASONABLE_SUSPICION'] as const;
  const drugTestStatuses = ['PENDING', 'NOTIFIED', 'SCHEDULED', 'COMPLETED', 'CANCELLED', 'EXPIRED'] as const;
  const drugTestResults = ['NEGATIVE', 'POSITIVE', 'INCONCLUSIVE', 'REFUSED'] as const;

  const updateDrugTestSchema = z.object({
    status: z.enum(drugTestStatuses).optional(),
    scheduledDate: z.string().optional(),
    testLocation: z.string().optional(),
    testProvider: z.string().optional(),
    testResult: z.enum(drugTestResults).optional(),
    notes: z.string().optional(),
    notificationSentAt: z.string().optional(),
    completedAt: z.string().optional(),
  });

  const triggerDrugTestSchema = z.object({
    triggerType: z.enum(drugTestTriggerTypes).optional(),
    triggerReason: z.string().optional(),
    notificationRecipients: z.array(z.string()).optional(),
  });

  // Get all drug test notifications (with optional filters)
  app.get("/api/drug-tests", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const { status, driverId, claimId } = req.query;
      const results = await storage.getDrugTestNotifications({
        status: status as string | undefined,
        driverId: driverId as string | undefined,
        claimId: claimId as string | undefined,
      });
      
      res.json(results);
    } catch (error) {
      console.error("Error fetching drug test notifications:", error);
      res.status(500).json({ message: "Failed to fetch drug test notifications" });
    }
  });

  // Get drug test notifications for a specific claim
  app.get("/api/claims/:claimId/drug-tests", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const { claimId } = req.params;
      const results = await storage.getDrugTestNotificationsByClaimId(claimId);
      
      res.json(results);
    } catch (error) {
      console.error("Error fetching claim drug tests:", error);
      res.status(500).json({ message: "Failed to fetch claim drug tests" });
    }
  });

  // Create a drug test notification
  app.post("/api/drug-tests", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const validatedData = insertDrugTestNotificationSchema.parse({
        ...req.body,
        createdBy: currentUser?.id,
      });

      const notification = await storage.createDrugTestNotification(validatedData);

      res.status(201).json(notification);
    } catch (error) {
      console.error("Error creating drug test notification:", error);
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      res.status(500).json({ message: "Failed to create drug test notification" });
    }
  });

  // Trigger drug test from a claim (auto-detection based on claim type)
  app.post("/api/claims/:claimId/trigger-drug-test", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const { claimId } = req.params;
      
      // Validate request body
      const validatedBody = triggerDrugTestSchema.parse(req.body);

      // Get the claim to find the driver
      const claim = await storage.getAccidentById(claimId);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      const notification = await storage.createDrugTestNotification({
        claimId,
        driverId: claim.driverId || undefined,
        triggerType: validatedBody.triggerType || 'POST_INCIDENT',
        triggerReason: validatedBody.triggerReason || `Drug test triggered for claim ${claim.claimNumber || claimId}`,
        status: 'PENDING',
        notificationRecipients: JSON.stringify(validatedBody.notificationRecipients || []),
        createdBy: currentUser?.id,
      });

      res.status(201).json({
        message: "Drug test notification created",
        notification,
        deadline: notification.deadlineAt,
      });
    } catch (error) {
      console.error("Error triggering drug test:", error);
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      res.status(500).json({ message: "Failed to trigger drug test" });
    }
  });

  // Update drug test notification status
  app.patch("/api/drug-tests/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }

      const { id } = req.params;
      
      // Validate request body
      const validatedBody = updateDrugTestSchema.parse(req.body);

      const updateData: any = {};
      if (validatedBody.status) updateData.status = validatedBody.status;
      if (validatedBody.scheduledDate) updateData.scheduledDate = new Date(validatedBody.scheduledDate);
      if (validatedBody.testLocation) updateData.testLocation = validatedBody.testLocation;
      if (validatedBody.testProvider) updateData.testProvider = validatedBody.testProvider;
      if (validatedBody.testResult) updateData.testResult = validatedBody.testResult;
      if (validatedBody.notes !== undefined) updateData.notes = validatedBody.notes;
      if (validatedBody.notificationSentAt) updateData.notificationSentAt = new Date(validatedBody.notificationSentAt);
      if (validatedBody.completedAt) updateData.completedAt = new Date(validatedBody.completedAt);

      const updated = await storage.updateDrugTestNotification(id, updateData);

      if (!updated) {
        return res.status(404).json({ message: "Drug test notification not found" });
      }

      res.json(updated);
    } catch (error) {
      console.error("Error updating drug test notification:", error);
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      res.status(500).json({ message: "Failed to update drug test notification" });
    }
  });

  // Get drug test statistics
  app.get("/api/drug-tests/stats", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }

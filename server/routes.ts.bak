        eligibleRecruiters: eligibleRecruiters || [],
        requiredSkillTagIds: requiredSkillTagIds || [],
        priority: priority || 0,
        marketWeight: marketWeight ?? 40,
        skillWeight: skillWeight ?? 40,
        workloadWeight: workloadWeight ?? 20,
        createdBy: userId,
        updatedBy: userId,
      }).returning();
      res.json(rule);

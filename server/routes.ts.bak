      }
      
      if (!user) {
        return res.status(403).json({ message: "Forbidden" });
      }

      const { candidateId } = req.params;
      const { consentType, activeOnly } = req.query;
      
      const consents = await db.select()
        .from(recruitingConsents)
        .where(eq(recruitingConsents.candidateId, candidateId))
        .orderBy(desc(recruitingConsents.capturedAt));
      
      // Filter by consent type if specified
      let filtered = consents;
      if (consentType) {
        filtered = consents.filter(c => c.consentType === consentType);
      }
      
      // If activeOnly, get only the latest consent of each type
      if (activeOnly === 'true') {
        const latestByType = new Map<string, typeof consents[0]>();
        for (const consent of filtered) {
          if (!latestByType.has(consent.consentType) || 
              new Date(consent.capturedAt) > new Date(latestByType.get(consent.consentType)!.capturedAt)) {
            latestByType.set(consent.consentType, consent);
          }
        }
        filtered = Array.from(latestByType.values());
      }

      res.json(filtered);
    } catch (error: any) {
      console.error("Error fetching consents:", error);
      res.status(500).json({ message: "Failed to fetch consents" });
    }
  });

  // GET /api/recruiting/candidates/:candidateId/consents/summary - Get consent summary
  app.get("/api/recruiting/candidates/:candidateId/consents/summary", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }

      const { candidateId } = req.params;
      
      const consents = await db.select()
        .from(recruitingConsents)
        .where(eq(recruitingConsents.candidateId, candidateId))
        .orderBy(desc(recruitingConsents.capturedAt));

      // Build summary by consent type
      const summary: Record<string, {
        latestConsent: typeof consents[0] | null;
        hasActiveConsent: boolean;
        totalRecords: number;
        versions: string[];
      }> = {};

      const consentTypes = [
        "background_check", "drug_test", "mvr_check", "employment_verification",
        "reference_check", "electronic_signature", "sms_communication", "email_communication",
        "data_retention", "fcra_disclosure", "state_specific_disclosure", "arbitration_agreement"
      ];

      for (const type of consentTypes) {
        const typeConsents = consents.filter(c => c.consentType === type);
        const latestConsent = typeConsents[0] || null;
        summary[type] = {
          latestConsent,
          hasActiveConsent: latestConsent?.consentGiven === true,
          totalRecords: typeConsents.length,
          versions: [...new Set(typeConsents.map(c => c.consentVersion))],
        };
      }

      res.json({
        candidateId,
        summary,
        totalConsents: consents.length,
        lastUpdated: consents[0]?.capturedAt || null,
      });
    } catch (error: any) {
      console.error("Error fetching consent summary:", error);
      res.status(500).json({ message: "Failed to fetch consent summary" });
    }
  });

  // POST /api/recruiting/candidates/:candidateId/consents/:consentType/revoke - Revoke a consent
  app.post("/api/recruiting/candidates/:candidateId/consents/:consentType/revoke", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Recruiting access required" });
      }

      const { candidateId, consentType } = req.params;
      const { reason, source } = req.body;
      
      // Verify candidate exists
      const [candidate] = await db.select().from(recruitingCandidates).where(eq(recruitingCandidates.id, candidateId));
      
      if (!candidate) {
        return res.status(404).json({ message: "Candidate not found" });
      }

      // Create new revocation record (immutable - no updates)
      const [consent] = await db.insert(recruitingConsents).values({
        candidateId,
        consentType,
        consentVersion: "revoked",
        consentGiven: false,
        source: source || "recruiter_action",
        capturedAt: new Date(),
        capturedBy: user.id,
        revokedAt: new Date(),
        revokedBy: user.id,
        revocationReason: reason || null,
      }).returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "CONSENT_REVOKED",
        entityType: "candidate",
        entityId: candidateId,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        newValue: JSON.stringify({
          consentId: consent.id,
          consentType,
          reason,
        }),
      });

      // Trigger readiness regression check for consent revocation
      try {
        const apps = await db.select().from(recruitingApplications).where(eq(recruitingApplications.candidateId, candidateId));
        const { onConsentRevoked } = await import("./services/readinessRegressionService");
        for (const app of apps) {
          await onConsentRevoked(app.id, candidateId, consentType, user.id, user.email || "");
        }
      } catch (regressionErr) {
        console.error("[Regression] Error triggering consent regression:", regressionErr);
      }

      res.status(201).json(consent);
    } catch (error: any) {
      console.error("Error revoking consent:", error);
      res.status(500).json({ message: "Failed to revoke consent" });
    }
  });

  // GET /api/recruiting/consent-texts - Get consent text templates
  app.get("/api/recruiting/consent-texts", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }

      const { consentType, stateCode, activeOnly } = req.query;
      
      let texts = await db.select()
        .from(recruitingConsentTexts)
        .orderBy(desc(recruitingConsentTexts.effectiveDate));

      if (consentType) {
        texts = texts.filter(t => t.consentType === consentType);
      }
      
      if (stateCode) {
        texts = texts.filter(t => t.stateCode === stateCode || t.stateCode === null);
      }
      
      if (activeOnly === 'true') {
        texts = texts.filter(t => t.isActive);
      }

      res.json(texts);
    } catch (error: any) {
      console.error("Error fetching consent texts:", error);
      res.status(500).json({ message: "Failed to fetch consent texts" });
    }
  });

  // POST /api/recruiting/consent-texts - Create a new consent text version
  app.post("/api/recruiting/consent-texts", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Admin access required" });
      }

      const { 
        consentType,
        version,
        textContent,
        stateCode,
        effectiveDate,
        isActive
      } = req.body;
      
      if (!consentType || !version || !textContent) {
        return res.status(400).json({ message: "consentType, version, and textContent are required" });
      }

      // Generate SHA-256 hash of the text content
      const crypto = await import('crypto');
      const textHash = crypto.createHash('sha256').update(textContent).digest('hex');

      const [text] = await db.insert(recruitingConsentTexts).values({
        consentType,
        version,
        textContent,
        textHash,
        stateCode: stateCode || null,
        effectiveDate: effectiveDate ? new Date(effectiveDate) : new Date(),
        isActive: isActive !== false,
        createdBy: user.id,
      }).returning();

      res.status(201).json(text);
    } catch (error: any) {
      console.error("Error creating consent text:", error);
      res.status(500).json({ message: "Failed to create consent text" });
    }
  });


  // ============================================
  // CANDIDATE PORTAL - Token-Based Secure Access
  // ============================================

  // POST /api/recruiting/applications/:applicationId/portal-token - Generate portal token (recruiter action)
  app.post("/api/recruiting/applications/:applicationId/portal-token", async (req: any, res: Response) => {
    try {
      if (!req.user) return res.status(401).json({ message: "Authentication required" });
      const userId = req.user.id || req.user.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Authentication required" });

      const { applicationId } = req.params;
      const { inactivityWindowDays = 30 } = req.body || {};

      const [application] = await db.select()
        .from(recruitingApplications)
        .where(eq(recruitingApplications.id, applicationId))
        .limit(1);
      if (!application) return res.status(404).json({ message: "Application not found" });

      const crypto = await import('crypto');
      const rawToken = crypto.randomBytes(32).toString('hex');
      const tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');

      const expiresAt = new Date();
      expiresAt.setDate(expiresAt.getDate() + Math.max(inactivityWindowDays, 7));

      await db.update(candidatePortalTokens)
        .set({ isRevoked: true, revokedAt: new Date(), revokedBy: userId })
        .where(and(
          eq(candidatePortalTokens.applicationId, applicationId),
          eq(candidatePortalTokens.isRevoked, false)
        ));

      const [token] = await db.insert(candidatePortalTokens).values({
        tokenHash,
        candidateId: application.candidateId,
        applicationId,
        expiresAt,
        inactivityWindowDays,
        createdBy: userId,
      }).returning();

      res.json({ token: rawToken, id: token.id, expiresAt: token.expiresAt });
    } catch (error: any) {
      console.error("Error generating portal token:", error);
      res.status(500).json({ message: "Failed to generate portal token" });
    }
  });

  // GET /api/recruiting/applications/:applicationId/portal-token - Get portal token status (recruiter view)
  app.get("/api/recruiting/applications/:applicationId/portal-token", async (req: any, res: Response) => {
    try {
      if (!req.user) return res.status(401).json({ message: "Authentication required" });
      const { applicationId } = req.params;

      const tokens = await db.select({
        id: candidatePortalTokens.id,
        expiresAt: candidatePortalTokens.expiresAt,
        lastAccessedAt: candidatePortalTokens.lastAccessedAt,
        isRevoked: candidatePortalTokens.isRevoked,
        inactivityWindowDays: candidatePortalTokens.inactivityWindowDays,
        createdAt: candidatePortalTokens.createdAt,
      })
        .from(candidatePortalTokens)
        .where(eq(candidatePortalTokens.applicationId, applicationId))
        .orderBy(desc(candidatePortalTokens.createdAt))
        .limit(5);

      res.json(tokens);
    } catch (error: any) {
      console.error("Error fetching portal tokens:", error);
      res.status(500).json({ message: "Failed to fetch portal tokens" });
    }
  });

  // DELETE /api/recruiting/applications/:applicationId/portal-token/:tokenId - Revoke portal token
  app.delete("/api/recruiting/applications/:applicationId/portal-token/:tokenId", async (req: any, res: Response) => {

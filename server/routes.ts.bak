      if (!userId) return res.status(401).json({ message: "Not authenticated" });
      const user = await storage.getUser(userId);
      if (!user || (user.role !== "admin" && user.role !== "super_user" && user.role !== "recruiting_admin")) {
        return res.status(403).json({ message: "Admin or Recruiting Admin access required" });
      }
      const { reasonCode, notes } = req.body;
      if (!reasonCode) return res.status(400).json({ message: "Reason code is required" });
      if (!notes || notes.trim().length === 0) return res.status(400).json({ message: "Notes are required" });
      const { flagCandidateDnr } = await import("./recruitingService");
      const result = await flagCandidateDnr(req.params.id, reasonCode, notes.trim(), userId, user.email || "");
      if (!result.success) return res.status(400).json({ message: result.error });
      res.json({ message: "Candidate flagged as Do-Not-Rehire", success: true });
    } catch (error: any) {
      console.error("[DNR] Error flagging candidate:", error);
      res.status(500).json({ message: "Failed to flag candidate" });

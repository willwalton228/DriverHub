    }
  });

  // Update accident by ID (corporate only)
  app.patch("/api/corporate/accidents/:accidentId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      // Import claim state machine helpers
      const { isClaimEditable, canAddAdditionalInfo, CLAIM_STATUSES } = await import('./helpers/claimStateMachine');
      type ClaimStatus = typeof CLAIM_STATUSES[number];

      // Get current claim to check editability
      const currentAccident = await storage.getAccidentById(req.params.accidentId);
      if (!currentAccident) {
        return res.status(404).json({ message: "Claim not found" });
      }

      const currentStatus = (currentAccident.claimStatus || 'DRAFT') as ClaimStatus;

      // Block claim_status changes via generic PATCH - must use transition endpoint
      if (req.body.claimStatus !== undefined) {
        return res.status(400).json({ 
          message: "Cannot change claim status via this endpoint. Use POST /api/claims/:claimId/transition instead." 
        });
      }

      // Enforce claim editability after SUBMITTED
      if (!isClaimEditable(currentStatus)) {
        // Only allow limited fields when in ADDITIONAL_INFO_REQUESTED status
        if (canAddAdditionalInfo(currentStatus)) {
          const allowedFields = ['description', 'notesReceived', 'resolutionNotes'];
          const requestedFields = Object.keys(req.body);
          const disallowedFields = requestedFields.filter(f => !allowedFields.includes(f));
          
          if (disallowedFields.length > 0) {
            return res.status(403).json({ 
              message: `Claim is not editable in ${currentStatus} status. Only additional info fields (${allowedFields.join(', ')}) can be updated.`,
              disallowed_fields: disallowedFields
            });
          }
        } else {
          return res.status(403).json({ 
            message: `Claim cannot be edited in ${currentStatus} status. Claims can only be edited while in DRAFT status.` 
          });
        }
      }

      // Validate and coerce request body with Zod schema
      const validationResult = updateAccidentSchema.safeParse(req.body);
      if (!validationResult.success) {
        return res.status(400).json({ 
          message: "Invalid request data", 
          errors: validationResult.error.flatten().fieldErrors 
        });
      }
      
      const validatedData = validationResult.data;
      
      // Convert numbers to decimal strings for database storage
      const toDecimal = (val: number | null | undefined): string | null => {
        if (val === null || val === undefined) return null;
        return val.toFixed(2);
      };
      
      // Build update data from validated fields
      const updateData: Record<string, any> = { updatedAt: new Date() };
      
      // String fields
      if (validatedData.redcapId !== undefined) updateData.redcapId = validatedData.redcapId;
      if (validatedData.monthOfIncident !== undefined) updateData.monthOfIncident = validatedData.monthOfIncident;
      if (validatedData.yearOfIncident !== undefined) updateData.yearOfIncident = validatedData.yearOfIncident;
      if (validatedData.location !== undefined) updateData.location = validatedData.location;
      if (validatedData.injuries !== undefined) updateData.injuries = validatedData.injuries;
      if (validatedData.status !== undefined) updateData.status = validatedData.status;
      if (validatedData.dodAtFault !== undefined) updateData.dodAtFault = validatedData.dodAtFault;
      if (validatedData.notesReceived !== undefined) updateData.notesReceived = validatedData.notesReceived;
      if (validatedData.vehicleInvolved !== undefined) updateData.vehicleInvolved = validatedData.vehicleInvolved;
      if (validatedData.incidentType !== undefined) updateData.incidentType = validatedData.incidentType;
      if (validatedData.zendeskTicketNumber !== undefined) updateData.zendeskTicketNumber = validatedData.zendeskTicketNumber;
      if (validatedData.insuranceClaimNumber !== undefined) updateData.insuranceClaimNumber = validatedData.insuranceClaimNumber;
      if (validatedData.subrogationClaim !== undefined) updateData.subrogationClaim = validatedData.subrogationClaim;
      if (validatedData.insuranceFault !== undefined) updateData.insuranceFault = validatedData.insuranceFault;
      if (validatedData.insuranceComments !== undefined) updateData.insuranceComments = validatedData.insuranceComments;
      if (validatedData.policeReportNumber !== undefined) updateData.policeReportNumber = validatedData.policeReportNumber;
      if (validatedData.atFault !== undefined) updateData.atFault = validatedData.atFault;
      if (validatedData.description !== undefined) updateData.description = validatedData.description;
      if (validatedData.resolutionNotes !== undefined) updateData.resolutionNotes = validatedData.resolutionNotes;
      
      // Date fields (already coerced to Date by Zod)
      if (validatedData.accidentDate !== undefined) updateData.accidentDate = validatedData.accidentDate;
      if (validatedData.incidentDate !== undefined) updateData.incidentDate = validatedData.incidentDate;
      if (validatedData.insuranceDate !== undefined) updateData.insuranceDate = validatedData.insuranceDate;
      
      // Decimal fields (convert coerced numbers to decimal strings)
      if (validatedData.damageEst1 !== undefined) updateData.damageEst1 = toDecimal(validatedData.damageEst1);
      if (validatedData.damageEst2 !== undefined) updateData.damageEst2 = toDecimal(validatedData.damageEst2);
      if (validatedData.propertyDamage !== undefined) updateData.propertyDamage = toDecimal(validatedData.propertyDamage);
      if (validatedData.totalEstimate !== undefined) updateData.totalEstimate = toDecimal(validatedData.totalEstimate);
      if (validatedData.probableCost !== undefined) updateData.probableCost = toDecimal(validatedData.probableCost);
      if (validatedData.actualCost !== undefined) updateData.actualCost = toDecimal(validatedData.actualCost);
      if (validatedData.driverPaymentPercent !== undefined) updateData.driverPaymentPercent = toDecimal(validatedData.driverPaymentPercent);
      if (validatedData.insuranceReserve !== undefined) updateData.insuranceReserve = toDecimal(validatedData.insuranceReserve);
      if (validatedData.insurancePaid !== undefined) updateData.insurancePaid = toDecimal(validatedData.insurancePaid);
      if (validatedData.insuranceTotal !== undefined) updateData.insuranceTotal = toDecimal(validatedData.insuranceTotal);
      if (validatedData.repairCost !== undefined) updateData.repairCost = toDecimal(validatedData.repairCost);
      
      // Boolean fields (already coerced by Zod)
      if (validatedData.paidNotClosed !== undefined) updateData.paidNotClosed = validatedData.paidNotClosed;
      if (validatedData.insuranceClaimSubmitted !== undefined) updateData.insuranceClaimSubmitted = validatedData.insuranceClaimSubmitted;
      if (validatedData.policeReportFiled !== undefined) updateData.policeReportFiled = validatedData.policeReportFiled;
      if (validatedData.insuranceSubmitted !== undefined) updateData.insuranceSubmitted = validatedData.insuranceSubmitted;
      
      // New classification and relationship fields
      if (validatedData.driverClassification !== undefined) updateData.driverClassification = validatedData.driverClassification;
      if (validatedData.employeeId !== undefined) updateData.employeeId = validatedData.employeeId;
      if (validatedData.independentContractorId !== undefined) updateData.independentContractorId = validatedData.independentContractorId;
      if (validatedData.customerId !== undefined) updateData.customerId = validatedData.customerId;
      if (validatedData.paidNotClosedStatus !== undefined) updateData.paidNotClosedStatus = validatedData.paidNotClosedStatus;
      if (validatedData.incidentCommentsHistory !== undefined) updateData.incidentCommentsHistory = validatedData.incidentCommentsHistory;
      if (validatedData.executionSystem !== undefined) updateData.executionSystem = validatedData.executionSystem;
      if (validatedData.driverDrugTestRequested !== undefined) updateData.driverDrugTestRequested = validatedData.driverDrugTestRequested;
      if (validatedData.driverDrugTestResults !== undefined) updateData.driverDrugTestResults = validatedData.driverDrugTestResults;
      if (validatedData.driverDrugTestRequestedDate !== undefined) updateData.driverDrugTestRequestedDate = validatedData.driverDrugTestRequestedDate;
      if (validatedData.driverDrugTestResultsDate !== undefined) updateData.driverDrugTestResultsDate = validatedData.driverDrugTestResultsDate;
      if (validatedData.insuranceClaimSubmittedStatus !== undefined) updateData.insuranceClaimSubmittedStatus = validatedData.insuranceClaimSubmittedStatus;

      // IMMUTABLE SNAPSHOT: Create snapshot when claim transitions from DRAFT → SUBMITTED
      // Check if insuranceClaimSubmitted is transitioning to true
      if (validatedData.insuranceClaimSubmitted === true) {
        const existingAccident = await storage.getAccidentById(req.params.accidentId);
        
        // Determine the moveId to use for snapshot:
        // - Use moveId from the update payload if being set in this request
        // - Otherwise use existing accident's moveId
        const effectiveMoveId = validatedData.moveId !== undefined 
          ? validatedData.moveId 
          : existingAccident?.moveId;
        
        // Only create snapshot if:
        // 1. Claim wasn't already submitted (transitioning from false/null to true)
        // 2. Claim has a linked move (either existing or being set in this request)
        // 3. No snapshot exists yet for this claim
        if (existingAccident && 
            !existingAccident.insuranceClaimSubmitted && 
            effectiveMoveId && 
            !existingAccident.moveSnapshotId) {
          
          const userName = user?.firstName && user?.lastName 
            ? `${user.firstName} ${user.lastName}` 
            : user?.email || 'Unknown';
          
          const snapshot = await createClaimMoveSnapshot(
            effectiveMoveId,
            userId,
            userName
          );
          
          if (snapshot) {
            updateData.moveSnapshotId = snapshot.id;
            console.log(`[CLAIM SNAPSHOT] Created immutable snapshot ${snapshot.id} for accident ${req.params.accidentId}, move ${effectiveMoveId}`);
          } else {
            console.warn(`[CLAIM SNAPSHOT] Failed to create snapshot for accident ${req.params.accidentId}, move ${effectiveMoveId}`);
          }
        }
      }

      const accident = await storage.updateAccident(req.params.accidentId, updateData);
      if (!accident) {
        return res.status(404).json({ message: "Accident not found" });
      }

      // Auto-create driver incident if driver was just linked (driverId being set when it wasn't before)
      // This ensures incidents are created when a driver is linked via PATCH
      const driverWasLinked = accident.driverId && !currentAccident.driverId;
      if (driverWasLinked) {
        try {
          const { createDriverIncident, getIncidentForClaim } = await import("./remediationService");
          const existingIncident = await getIncidentForClaim(req.params.accidentId);
          if (!existingIncident) {
            const severity = accident.triageSeverity || "minor";
            const incidentDate = accident.incidentDate || accident.accidentDate || new Date();
            await createDriverIncident(
              req.params.accidentId,
              accident.driverId!,
              severity,
              incidentDate,
              false, // preventableFlag defaults to false
              userId,
              "Auto-created when driver was linked"
            );
            console.log(`[REMEDIATION] Auto-created incident for claim ${req.params.accidentId} when driver ${accident.driverId} was linked`);
          }
        } catch (incidentError) {
          console.error("Failed to auto-create incident on driver link:", incidentError);
        }
      }

      res.json(accident);
    } catch (error) {
      console.error("Error updating accident:", error);
      res.status(500).json({ message: "Failed to update accident" });
    }
  });

  // Get immutable move snapshot for a claim (corporate only)
  // Returns the point-in-time snapshot of move data captured when claim was submitted
  app.get("/api/corporate/accidents/:accidentId/snapshot", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const snapshot = await storage.getMoveSnapshotForClaim(req.params.accidentId);
      if (!snapshot) {
        return res.status(404).json({ 
          message: "No snapshot found", 
          reason: "Either the claim has no linked move, or the claim has not been submitted yet"
        });
      }

      res.json(snapshot);
    } catch (error) {
      console.error("Error fetching claim snapshot:", error);
      res.status(500).json({ message: "Failed to fetch claim snapshot" });
    }
  });

  // Get the move associated with a claim (Claim-Move Traceability)
  app.get("/api/claims/:claimId/move", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { claimId } = req.params;
      const move = await storage.getMoveByClaimId(claimId);
      
      if (!move) {
        return res.status(404).json({ 
          message: "No move found", 
          reason: "This claim is not linked to any move"
        });
      }

      res.json(move);
    } catch (error) {
      console.error("Error fetching move for claim:", error);
      res.status(500).json({ message: "Failed to fetch move for claim" });
    }
  });

  // ==========================================
  // CLAIMS TRIAGE & SEVERITY CLASSIFICATION
  // ==========================================

  // Get triage info for a claim
  app.get("/api/claims/:claimId/triage", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const claim = await storage.getAccidentById(req.params.claimId);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      // Get triage owner info if assigned
      let triageOwner = null;
      if (claim.triageOwnerUserId) {
        triageOwner = await storage.getUser(claim.triageOwnerUserId);
      }

      // Get override user info if there was an override
      let overrideBy = null;
      if (claim.triageOverrideByUserId) {
        overrideBy = await storage.getUser(claim.triageOverrideByUserId);
      }

      const { getTriageWorkflowDescription } = await import("./triageService");

      res.json({
        claimId: claim.id,
        triageSeverity: claim.triageSeverity || null,
        injuryFlag: claim.injuryFlag ?? false,
        drivableFlag: claim.drivableFlag ?? true,
        carrierNotificationRequired: claim.carrierNotificationRequired ?? false,
        triageDecisionAt: claim.triageDecisionAt,
        triageOwnerUserId: claim.triageOwnerUserId,
        triageOwner: triageOwner ? {
          id: triageOwner.id,
          firstName: triageOwner.firstName,
          lastName: triageOwner.lastName,
          email: triageOwner.email,
        } : null,
        workflow: claim.triageSeverity ? getTriageWorkflowDescription(claim.triageSeverity) : null,
        override: claim.triageOverrideReason ? {
          reason: claim.triageOverrideReason,
          overrideAt: claim.triageOverrideAt,
          overrideBy: overrideBy ? {
            id: overrideBy.id,
            firstName: overrideBy.firstName,
            lastName: overrideBy.lastName,
            email: overrideBy.email,
          } : null,
        } : null,
      });
    } catch (error) {
      console.error("Error fetching claim triage:", error);
      res.status(500).json({ message: "Failed to fetch claim triage" });
    }
  });

  // Update triage (Admin override)
  app.put("/api/claims/:claimId/triage", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      // Only admins can override triage
      if (!user || !['admin', 'super_admin'].includes(user.role)) {
        return res.status(403).json({ message: "Forbidden: Admin access required for triage override" });
      }

      const claim = await storage.getAccidentById(req.params.claimId);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      const { triageSeverity, injuryFlag, drivableFlag, triageOwnerUserId, overrideReason } = req.body;

      // Validate severity if provided
      if (triageSeverity) {
        const { isValidTriageSeverity } = await import("./triageService");
        if (!isValidTriageSeverity(triageSeverity)) {
          return res.status(400).json({ message: "Invalid triage severity. Must be: minor, moderate, or severe" });
        }
      }

      // Override reason is required for admin changes
      if (!overrideReason || overrideReason.trim().length < 10) {
        return res.status(400).json({ message: "Override reason is required (minimum 10 characters)" });
      }

      const previousSeverity = claim.triageSeverity;

      // Calculate carrier notification requirement
      const newInjuryFlag = injuryFlag ?? claim.injuryFlag ?? false;
      const newSeverity = triageSeverity || claim.triageSeverity;
      const carrierNotificationRequired = newSeverity === 'severe' || newInjuryFlag;

      const updateData: any = {
        triageOverrideReason: overrideReason,
        triageOverrideByUserId: userId,
        triageOverrideAt: new Date(),
        carrierNotificationRequired,
      };

      if (triageSeverity !== undefined) updateData.triageSeverity = triageSeverity;
      if (injuryFlag !== undefined) updateData.injuryFlag = injuryFlag;
      if (drivableFlag !== undefined) updateData.drivableFlag = drivableFlag;
      if (triageOwnerUserId !== undefined) updateData.triageOwnerUserId = triageOwnerUserId;

      await storage.updateClaimTriage(req.params.claimId, updateData);

      // Log the override
      await storage.createClaimAuditLog({
        claimId: req.params.claimId,
        userId: userId,
        eventType: 'triage_override',
        actionSummary: `Admin override: severity changed from ${previousSeverity || 'none'} to ${triageSeverity || previousSeverity}`,
        previousValue: previousSeverity || null,
        newValue: triageSeverity || previousSeverity,
        metadata: JSON.stringify({
          overrideReason,
          injuryFlag: newInjuryFlag,
          drivableFlag: drivableFlag ?? claim.drivableFlag,
          carrierNotificationRequired,
          overrideBy: `${user.firstName || ''} ${user.lastName || ''}`.trim() || user.email,
        }),
      });

      res.json({ 
        message: "Triage updated successfully",
        triageSeverity: triageSeverity || claim.triageSeverity,
        carrierNotificationRequired,
      });
    } catch (error) {
      console.error("Error updating claim triage:", error);
      res.status(500).json({ message: "Failed to update claim triage" });
    }
  });

  // Recalculate triage for a claim
  app.post("/api/claims/:claimId/triage/recalculate", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const claim = await storage.getAccidentById(req.params.claimId);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      const { calculateTriageSeverity } = await import("./triageService");
      const triageResult = calculateTriageSeverity({
        incidentType: claim.incidentType,
        injuries: claim.injuries,
        injuryFlag: req.body.injuryFlag ?? claim.injuryFlag,
        drivableFlag: req.body.drivableFlag ?? claim.drivableFlag,
        damageEst1: claim.damageEst1,
        totalEstimate: claim.totalEstimate,
        probableCost: claim.probableCost,
        claimType: claim.claimType,
      });

      const previousSeverity = claim.triageSeverity;

      await storage.updateClaimTriage(req.params.claimId, {
        triageSeverity: triageResult.triageSeverity,
        injuryFlag: triageResult.injuryFlag,
        drivableFlag: triageResult.drivableFlag,
        carrierNotificationRequired: triageResult.carrierNotificationRequired,
        triageDecisionAt: triageResult.triageDecisionAt,
      });

      // Log recalculation
      await storage.createClaimAuditLog({
        claimId: req.params.claimId,
        userId: userId,
        eventType: 'triage_recalculated',
        actionSummary: `Triage recalculated: ${previousSeverity || 'none'} → ${triageResult.triageSeverity}`,
        previousValue: previousSeverity || null,
        newValue: triageResult.triageSeverity,
        metadata: JSON.stringify({
          workflow: triageResult.workflow,
          injuryFlag: triageResult.injuryFlag,
          drivableFlag: triageResult.drivableFlag,
          carrierNotificationRequired: triageResult.carrierNotificationRequired,
        }),
      });

      // Auto-create driver incident if claim has a driver and no incident exists yet
      if (claim.driverId) {
        const { createDriverIncident, getIncidentForClaim } = await import("./remediationService");
        const existingIncident = await getIncidentForClaim(req.params.claimId);
        
        if (!existingIncident) {
          const incidentDate = claim.incidentDate || claim.accidentDate || new Date();
          await createDriverIncident(
            req.params.claimId,
            claim.driverId,
            triageResult.triageSeverity,
            incidentDate,
            false, // preventableFlag defaults to false, can be updated later
            userId,
            "Auto-created from triage calculation"
          );
          console.log(`[REMEDIATION] Auto-created incident for claim ${req.params.claimId}, driver ${claim.driverId}`);
        }
      }

      res.json({
        message: "Triage recalculated successfully",
        ...triageResult,
      });
    } catch (error) {
      console.error("Error recalculating claim triage:", error);
      res.status(500).json({ message: "Failed to recalculate claim triage" });
    }
  });

  // ==========================================
  // DRIVER COACHING & CORRECTIVE ACTIONS (Ticket 2)
  // ==========================================

  // Get incident and corrective actions for a claim
  app.get("/api/claims/:claimId/remediation", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const { getIncidentForClaim, getCorrectiveActionsForIncident } = await import("./remediationService");

      const incident = await getIncidentForClaim(claimId);
      if (!incident) {
        return res.json({ incident: null, correctiveActions: [] });
      }

      const correctiveActions = await getCorrectiveActionsForIncident(incident.id);
      res.json({ incident, correctiveActions });
    } catch (error) {
      console.error("Error fetching claim remediation:", error);
      res.status(500).json({ message: "Failed to fetch claim remediation" });
    }
  });

  // Create driver incident for a claim (manual or auto-triggered)
  app.post("/api/claims/:claimId/incident", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user.claims.sub;
      const { preventableFlag, notes } = req.body;

      const claim = await storage.getAccidentById(claimId);
      if (!claim) {
        return res.status(404).json({ message: "Claim not found" });
      }

      const { createDriverIncident, getIncidentForClaim } = await import("./remediationService");

      const existingIncident = await getIncidentForClaim(claimId);
      if (existingIncident) {
        return res.status(400).json({ message: "Incident already exists for this claim" });
      }

      const severity = claim.triageSeverity || "minor";
      const incidentDate = claim.incidentDate || claim.accidentDate || new Date();

      const incidentId = await createDriverIncident(
        claimId,
        claim.driverId,
        severity,
        incidentDate,
        preventableFlag ?? false,
        userId,
        notes
      );

      res.json({ message: "Incident created successfully", incidentId });
    } catch (error) {
      console.error("Error creating driver incident:", error);
      res.status(500).json({ message: "Failed to create driver incident" });
    }
  });

  // Update preventable flag for an incident
  app.patch("/api/incidents/:incidentId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { incidentId } = req.params;
      const { preventableFlag, notes } = req.body;

      await db.update(driverIncidents)
        .set({ 
          preventableFlag,
          notes,
          updatedAt: new Date()
        })
        .where(eq(driverIncidents.id, incidentId));

      res.json({ message: "Incident updated successfully" });
    } catch (error) {
      console.error("Error updating incident:", error);
      res.status(500).json({ message: "Failed to update incident" });
    }
  });

  // Create a new corrective action for an incident
  app.post("/api/incidents/:incidentId/corrective-actions", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { incidentId } = req.params;
      const userId = req.user.claims.sub;
      const { actionType, dueDate, assignedToUserId, notes } = req.body;

      const [incident] = await db.select().from(driverIncidents).where(eq(driverIncidents.id, incidentId));
      if (!incident) {
        return res.status(404).json({ message: "Incident not found" });
      }

      const { createManualCorrectiveAction } = await import("./remediationService");

      const actionId = await createManualCorrectiveAction(
        incidentId,
        incident.driverId,
        actionType,
        dueDate ? new Date(dueDate) : null,
        assignedToUserId || null,
        notes || null,
        userId
      );

      res.json({ message: "Corrective action created successfully", actionId });
    } catch (error) {
      console.error("Error creating corrective action:", error);
      res.status(500).json({ message: "Failed to create corrective action" });
    }
  });

  // Update corrective action status
  app.patch("/api/corrective-actions/:actionId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { actionId } = req.params;
      const userId = req.user.claims.sub;
      const { status, notes, waivedReason } = req.body;

      const { updateCorrectiveActionStatus } = await import("./remediationService");

      await updateCorrectiveActionStatus(actionId, status, userId, notes, waivedReason);

      res.json({ message: "Corrective action updated successfully" });
    } catch (error) {
      console.error("Error updating corrective action:", error);
      res.status(500).json({ message: "Failed to update corrective action" });
    }
  });

  // Get driver incident history
  app.get("/api/drivers/:driverId/incidents", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { driverId } = req.params;
      const { getDriverIncidentHistory, getCorrectiveActionsForDriver } = await import("./remediationService");

      const incidents = await getDriverIncidentHistory(driverId);
      const correctiveActions = await getCorrectiveActionsForDriver(driverId);

      res.json({ incidents, correctiveActions });
    } catch (error) {
      console.error("Error fetching driver incidents:", error);
      res.status(500).json({ message: "Failed to fetch driver incidents" });
    }
  });

  // Dashboard: Get repeat incident drivers
  app.get("/api/claims/dashboard/repeat-incident-drivers", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { getRepeatIncidentDrivers } = await import("./remediationService");
      const drivers = await getRepeatIncidentDrivers();

      // Enrich with driver names
      const enrichedDrivers = await Promise.all(drivers.map(async (d: any) => {
        const driver = await storage.getDriver(d.driver_id);
        return {
          ...d,
          driverName: driver ? `${driver.firstName || ''} ${driver.lastName || ''}`.trim() : 'Unknown',
          driverNumber: driver?.driverNumber,
        };
      }));

      res.json(enrichedDrivers);
    } catch (error) {
      console.error("Error fetching repeat incident drivers:", error);
      res.status(500).json({ message: "Failed to fetch repeat incident drivers" });
    }
  });

  // Dashboard: Get overdue corrective actions
  app.get("/api/claims/dashboard/overdue-actions", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { getOverdueActions } = await import("./remediationService");
      const actions = await getOverdueActions();

      // Enrich with driver names
      const enrichedActions = await Promise.all(actions.map(async (a: any) => {
        const driver = await storage.getDriver(a.driverId);
        return {
          ...a,
          driverName: driver ? `${driver.firstName || ''} ${driver.lastName || ''}`.trim() : 'Unknown',
          driverNumber: driver?.driverNumber,
        };
      }));

      res.json(enrichedActions);
    } catch (error) {
      console.error("Error fetching overdue actions:", error);
      res.status(500).json({ message: "Failed to fetch overdue actions" });
    }
  });

  // ==========================================
  // CUSTOMER RISK SCORING (Ticket 3)
  // ==========================================

  // Get customer risk score
  app.get("/api/customers/:customerId/risk-score", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { customerId } = req.params;
      const { getCustomerRiskScore } = await import("./customerRiskService");

      const score = await getCustomerRiskScore(customerId);
      res.json(score || { riskBand: "unknown", message: "No risk score calculated yet" });
    } catch (error) {
      console.error("Error fetching customer risk score:", error);
      res.status(500).json({ message: "Failed to fetch customer risk score" });
    }
  });

  // Recalculate customer risk score
  app.post("/api/customers/:customerId/risk-score/recalculate", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { customerId } = req.params;
      const { calculateCustomerRiskScore, getCustomerRiskScore } = await import("./customerRiskService");

      await calculateCustomerRiskScore(customerId);
      const score = await getCustomerRiskScore(customerId);

      res.json({ message: "Risk score recalculated successfully", score });
    } catch (error) {
      console.error("Error recalculating customer risk score:", error);
      res.status(500).json({ message: "Failed to recalculate customer risk score" });
    }
  });

  // Get claims for customer (for drill-down)
  app.get("/api/customers/:customerId/claims", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { customerId } = req.params;
      const days = parseInt(req.query.days as string) || 180;
      const { getClaimsForCustomer } = await import("./customerRiskService");

      const claims = await getClaimsForCustomer(customerId, days);
      res.json(claims);
    } catch (error) {
      console.error("Error fetching customer claims:", error);
      res.status(500).json({ message: "Failed to fetch customer claims" });
    }
  });

  // Dashboard: Get high-risk customers
  app.get("/api/claims/dashboard/high-risk-customers", isAuthenticated, async (req: any, res: Response) => {
    try {
      const limit = parseInt(req.query.limit as string) || 20;
      const { getHighRiskCustomers } = await import("./customerRiskService");

      const customers = await getHighRiskCustomers(limit);
      res.json(customers);
    } catch (error) {
      console.error("Error fetching high-risk customers:", error);
      res.status(500).json({ message: "Failed to fetch high-risk customers" });
    }
  });

  // Refresh all customer risk scores (admin only)
  app.post("/api/claims/dashboard/refresh-risk-scores", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!user || !['admin', 'super_user'].includes(user.role)) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { refreshAllCustomerRiskScores } = await import("./customerRiskService");
      const count = await refreshAllCustomerRiskScores();

      res.json({ message: `Risk scores refreshed for ${count} customers` });
    } catch (error) {
      console.error("Error refreshing risk scores:", error);
      res.status(500).json({ message: "Failed to refresh risk scores" });
    }
  });

  // ==========================================
  // CLAIM RECOVERY/SUBROGATION ENDPOINTS
  // ==========================================

  // Get recovery record for a claim
  app.get("/api/claims/:claimId/recovery", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const recovery = await db.select().from(claimRecoveries).where(eq(claimRecoveries.claimId, claimId)).limit(1);
      res.json(recovery[0] || null);
    } catch (error) {
      console.error("Error fetching claim recovery:", error);
      res.status(500).json({ message: "Failed to fetch claim recovery" });
    }
  });

  // Create or update recovery record for a claim
  app.post("/api/claims/:claimId/recovery", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user.claims.sub;
      const data = req.body;

      // Check if recovery record already exists
      const existing = await db.select().from(claimRecoveries).where(eq(claimRecoveries.claimId, claimId)).limit(1);

      if (existing.length > 0) {
        // Update existing record
        const oldData = existing[0];
        const updates: any = {
          updatedAt: new Date(),
          updatedByUserId: userId,
        };

        // Track changes for audit
        const changes: Array<{field: string, oldValue: string | null, newValue: string | null}> = [];

        if (data.thirdPartyFault !== undefined && data.thirdPartyFault !== oldData.thirdPartyFault) {
          updates.thirdPartyFault = data.thirdPartyFault;
          changes.push({ field: 'thirdPartyFault', oldValue: String(oldData.thirdPartyFault), newValue: String(data.thirdPartyFault) });
        }
        if (data.recoverableAmount !== undefined && data.recoverableAmount !== oldData.recoverableAmount) {
          updates.recoverableAmount = data.recoverableAmount;
          changes.push({ field: 'recoverableAmount', oldValue: oldData.recoverableAmount || '0', newValue: data.recoverableAmount });
        }
        if (data.recoveredAmount !== undefined && data.recoveredAmount !== oldData.recoveredAmount) {
          updates.recoveredAmount = data.recoveredAmount;
          changes.push({ field: 'recoveredAmount', oldValue: oldData.recoveredAmount || '0', newValue: data.recoveredAmount });
        }
        if (data.recoverySource !== undefined && data.recoverySource !== oldData.recoverySource) {
          updates.recoverySource = data.recoverySource;
          changes.push({ field: 'recoverySource', oldValue: oldData.recoverySource, newValue: data.recoverySource });
        }
        if (data.recoveryStatus !== undefined && data.recoveryStatus !== oldData.recoveryStatus) {
          updates.recoveryStatus = data.recoveryStatus;
          changes.push({ field: 'recoveryStatus', oldValue: oldData.recoveryStatus, newValue: data.recoveryStatus });
          
          // Auto-set timestamps based on status
          if (data.recoveryStatus === 'pursuing' && !oldData.recoveryStartedAt) {
            updates.recoveryStartedAt = new Date();
          }
          if (['fully_recovered', 'closed_unrecoverable'].includes(data.recoveryStatus) && !oldData.recoveryClosedAt) {
            updates.recoveryClosedAt = new Date();
          }
        }
        if (data.recoveryNotes !== undefined && data.recoveryNotes !== oldData.recoveryNotes) {
          updates.recoveryNotes = data.recoveryNotes;
          changes.push({ field: 'recoveryNotes', oldValue: oldData.recoveryNotes, newValue: data.recoveryNotes });
        }

        const [updated] = await db.update(claimRecoveries)
          .set(updates)
          .where(eq(claimRecoveries.id, oldData.id))
          .returning();

        // Create audit log entries for each change
        for (const change of changes) {
          await db.insert(claimRecoveryAuditLogs).values({
            claimRecoveryId: oldData.id,
            userId,
            actionType: 'UPDATED',
            fieldChanged: change.field,
            previousValue: change.oldValue,
            newValue: change.newValue,
          });
        }

        res.json(updated);
      } else {
        // Create new record
        const [created] = await db.insert(claimRecoveries).values({
          claimId,
          thirdPartyFault: data.thirdPartyFault || false,
          recoverableAmount: data.recoverableAmount || '0',
          recoveredAmount: data.recoveredAmount || '0',
          recoverySource: data.recoverySource,
          recoveryStatus: data.recoveryStatus || 'not_pursued',
          recoveryNotes: data.recoveryNotes,
          recoveryStartedAt: data.recoveryStatus === 'pursuing' ? new Date() : null,
          createdByUserId: userId,
          updatedByUserId: userId,
        }).returning();

        // Create audit log entry
        await db.insert(claimRecoveryAuditLogs).values({
          claimRecoveryId: created.id,
          userId,
          actionType: 'CREATED',
          newValue: JSON.stringify({
            thirdPartyFault: created.thirdPartyFault,
            recoverableAmount: created.recoverableAmount,
            recoveryStatus: created.recoveryStatus,
            recoverySource: created.recoverySource,
          }),
        });

        res.json(created);
      }
    } catch (error) {
      console.error("Error saving claim recovery:", error);
      res.status(500).json({ message: "Failed to save claim recovery" });
    }
  });

  // Get audit log for a recovery record
  app.get("/api/claims/:claimId/recovery/audit-log", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      
      // First get the recovery record
      const recovery = await db.select().from(claimRecoveries).where(eq(claimRecoveries.claimId, claimId)).limit(1);
      if (!recovery.length) {
        return res.json([]);
      }

      const auditLogs = await db
        .select({
          id: claimRecoveryAuditLogs.id,
          actionType: claimRecoveryAuditLogs.actionType,
          fieldChanged: claimRecoveryAuditLogs.fieldChanged,
          previousValue: claimRecoveryAuditLogs.previousValue,
          newValue: claimRecoveryAuditLogs.newValue,
          notes: claimRecoveryAuditLogs.notes,
          createdAt: claimRecoveryAuditLogs.createdAt,
          userName: sql<string>`CONCAT(${users.firstName}, ' ', ${users.lastName})`,
        })
        .from(claimRecoveryAuditLogs)
        .leftJoin(users, eq(claimRecoveryAuditLogs.userId, users.id))
        .where(eq(claimRecoveryAuditLogs.claimRecoveryId, recovery[0].id))
        .orderBy(desc(claimRecoveryAuditLogs.createdAt));

      res.json(auditLogs);
    } catch (error) {
      console.error("Error fetching recovery audit log:", error);
      res.status(500).json({ message: "Failed to fetch recovery audit log" });
    }
  });

  // Dashboard metrics: Recovery summary
  app.get("/api/claims/dashboard/recovery-metrics", isAuthenticated, async (req: any, res: Response) => {
    try {
      // Get all recoveries
      const recoveries = await db.select().from(claimRecoveries);
      
      // Get all claims for gross cost calculation
      const claims = await db.select({
        id: accidents.id,
        probableCost: accidents.probableCost,
        actualCost: accidents.actualCost,
      }).from(accidents);

      // Calculate metrics
      const totalRecovered = recoveries.reduce((sum, r) => sum + parseFloat(r.recoveredAmount || '0'), 0);
      const claimsWithRecoveryPursued = recoveries.filter(r => 
        r.recoveryStatus && r.recoveryStatus !== 'not_pursued'
      ).length;
      const totalClaims = claims.length;
      const percentWithRecoveryPursued = totalClaims > 0 ? (claimsWithRecoveryPursued / totalClaims) * 100 : 0;

      // Calculate gross and net costs
      const grossCost = claims.reduce((sum, c) => 
        sum + parseFloat(c.actualCost as string || c.probableCost as string || '0'), 0);
      const netCost = grossCost - totalRecovered;

      res.json({
        totalRecoveredAmount: totalRecovered,
        percentClaimsWithRecoveryPursued: Math.round(percentWithRecoveryPursued * 10) / 10,
        claimsWithRecoveryPursued,
        totalClaims,
        grossClaimsCost: grossCost,
        netClaimsCost: netCost,
        recoveryRate: grossCost > 0 ? Math.round((totalRecovered / grossCost) * 1000) / 10 : 0,
      });
    } catch (error) {
      console.error("Error fetching recovery metrics:", error);
      res.status(500).json({ message: "Failed to fetch recovery metrics" });
    }
  });

  // ==========================================
  // LITIGATION HOLD & LEGAL READINESS (Ticket 5)
  // ==========================================

  // Get litigation hold status for a claim
  app.get("/api/claims/:claimId/litigation-hold", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const claim = await db.select({
        litigationHoldActive: accidents.litigationHoldActive,
        litigationHoldReason: accidents.litigationHoldReason,
        litigationHoldTrigger: accidents.litigationHoldTrigger,
        litigationHoldActivatedAt: accidents.litigationHoldActivatedAt,
        litigationHoldActivatedByUserId: accidents.litigationHoldActivatedByUserId,
        litigationHoldReleasedAt: accidents.litigationHoldReleasedAt,
        litigationHoldReleasedByUserId: accidents.litigationHoldReleasedByUserId,
        litigationHoldReleaseReason: accidents.litigationHoldReleaseReason,
        attorneyLetterReceived: accidents.attorneyLetterReceived,
        attorneyLetterReceivedAt: accidents.attorneyLetterReceivedAt,
        injuryFlag: accidents.injuryFlag,
        triageSeverity: accidents.triageSeverity,
      }).from(accidents).where(eq(accidents.id, claimId)).limit(1);

      if (!claim.length) {
        return res.status(404).json({ message: "Claim not found" });
      }

      res.json(claim[0]);
    } catch (error) {
      console.error("Error fetching litigation hold status:", error);
      res.status(500).json({ message: "Failed to fetch litigation hold status" });
    }
  });

  // Activate litigation hold (manual or triggered by system)
  app.post("/api/claims/:claimId/litigation-hold/activate", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;
      const { reason, triggerType } = req.body;

      // Manual activation requires a reason
      if (triggerType === 'manual' && !reason) {
        return res.status(400).json({ message: "Reason is required for manual activation" });
      }

      // Check if already active
      const existing = await db.select({
        litigationHoldActive: accidents.litigationHoldActive
      }).from(accidents).where(eq(accidents.id, claimId)).limit(1);

      if (!existing.length) {
        return res.status(404).json({ message: "Claim not found" });
      }

      if (existing[0].litigationHoldActive) {
        return res.status(400).json({ message: "Litigation hold already active" });
      }

      // Activate hold
      const [updated] = await db.update(accidents)
        .set({
          litigationHoldActive: true,
          litigationHoldReason: reason,
          litigationHoldTrigger: triggerType || 'manual',
          litigationHoldActivatedAt: new Date(),
          litigationHoldActivatedByUserId: userId,
          updatedAt: new Date(),
        })
        .where(eq(accidents.id, claimId))
        .returning();

      // Create audit log
      await db.insert(litigationHoldAuditLogs).values({
        claimId,
        userId,
        actionType: 'HOLD_ACTIVATED',
        triggerType: triggerType || 'manual',
        reason,
      });

      res.json(updated);
    } catch (error) {
      console.error("Error activating litigation hold:", error);
      res.status(500).json({ message: "Failed to activate litigation hold" });
    }
  });

  // Release litigation hold (Admin only with required reason)
  app.post("/api/claims/:claimId/litigation-hold/release", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;
      const { reason } = req.body;

      // Admin-only enforcement (admin and super_user roles)
      const [currentUser] = await db.select({ role: users.role }).from(users).where(eq(users.id, userId)).limit(1);
      if (!currentUser || !['admin', 'super_user'].includes(currentUser.role || '')) {
        return res.status(403).json({ message: "Only administrators can release litigation holds" });
      }

      if (!reason) {
        return res.status(400).json({ message: "Reason is required to release litigation hold" });
      }

      // Check if hold is active
      const existing = await db.select({
        litigationHoldActive: accidents.litigationHoldActive
      }).from(accidents).where(eq(accidents.id, claimId)).limit(1);

      if (!existing.length) {
        return res.status(404).json({ message: "Claim not found" });
      }

      if (!existing[0].litigationHoldActive) {
        return res.status(400).json({ message: "No active litigation hold to release" });
      }

      // Release hold
      const [updated] = await db.update(accidents)
        .set({
          litigationHoldActive: false,
          litigationHoldReleasedAt: new Date(),
          litigationHoldReleasedByUserId: userId,
          litigationHoldReleaseReason: reason,
          updatedAt: new Date(),
        })
        .where(eq(accidents.id, claimId))
        .returning();

      // Create audit log
      await db.insert(litigationHoldAuditLogs).values({
        claimId,
        userId,
        actionType: 'HOLD_RELEASED',
        reason,
      });

      res.json(updated);
    } catch (error) {
      console.error("Error releasing litigation hold:", error);
      res.status(500).json({ message: "Failed to release litigation hold" });
    }
  });

  // Record attorney letter received (auto-triggers hold)
  app.post("/api/claims/:claimId/attorney-letter", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const userId = req.user?.claims?.sub;

      // Update attorney letter flag and activate hold
      const [updated] = await db.update(accidents)
        .set({
          attorneyLetterReceived: true,
          attorneyLetterReceivedAt: new Date(),
          litigationHoldActive: true,
          litigationHoldReason: 'Auto-triggered: Attorney letter received',
          litigationHoldTrigger: 'auto_attorney_letter',
          litigationHoldActivatedAt: new Date(),
          litigationHoldActivatedByUserId: userId,
          updatedAt: new Date(),
        })
        .where(eq(accidents.id, claimId))
        .returning();

      // Create audit logs
      await db.insert(litigationHoldAuditLogs).values({
        claimId,
        userId,
        actionType: 'ATTORNEY_LETTER_RECEIVED',
        triggerType: 'auto_attorney_letter',
        reason: 'Attorney letter received - automatic litigation hold triggered',
      });

      await db.insert(litigationHoldAuditLogs).values({
        claimId,
        userId,
        actionType: 'HOLD_ACTIVATED',
        triggerType: 'auto_attorney_letter',
        reason: 'Auto-triggered: Attorney letter received',
      });

      res.json(updated);
    } catch (error) {
      console.error("Error recording attorney letter:", error);
      res.status(500).json({ message: "Failed to record attorney letter" });
    }
  });

  // Get litigation hold audit log
  app.get("/api/claims/:claimId/litigation-hold/audit-log", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { claimId } = req.params;
      const logs = await db.select().from(litigationHoldAuditLogs)
        .where(eq(litigationHoldAuditLogs.claimId, claimId))
        .orderBy(desc(litigationHoldAuditLogs.createdAt));
      
      res.json(logs);
    } catch (error) {

  // GET /api/billing/candidates - List all invoice line candidates
  app.get("/api/billing/candidates", isAuthenticated, async (req: any, res: Response) => {
    try {
      const status = req.query.status as string | undefined;
      const customerId = req.query.customerId as string | undefined;

      let query = db.select().from(invoiceLineCandidates);
      
      const conditions: any[] = [];
      if (status) {
        conditions.push(eq(invoiceLineCandidates.status, status));
      }
      if (customerId) {
        conditions.push(eq(invoiceLineCandidates.customerId, customerId));
      }

      if (conditions.length > 0) {
        query = query.where(and(...conditions)) as any;
      }
      
      const candidates = await query.orderBy(desc(invoiceLineCandidates.createdAt));
      res.json(candidates);
    } catch (error) {
      console.error("[Billing] Error fetching candidates:", error);
      res.status(500).json({ message: "Failed to fetch invoice candidates" });
    }
  });

  // GET /api/billing/candidates/:id - Get single invoice candidate with details
  app.get("/api/billing/candidates/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const [candidate] = await db.select()
        .from(invoiceLineCandidates)
        .where(eq(invoiceLineCandidates.id, req.params.id))
        .limit(1);
      
      if (!candidate) {
        return res.status(404).json({ message: "Invoice candidate not found" });
      }

      // Get associated adjustments
      const adjustments = await db.select()
        .from(invoiceAdjustments)
        .where(eq(invoiceAdjustments.candidateId, req.params.id))
        .orderBy(desc(invoiceAdjustments.createdAt));

      res.json({ ...candidate, adjustments });
    } catch (error) {
      console.error("[Billing] Error fetching candidate:", error);
      res.status(500).json({ message: "Failed to fetch invoice candidate" });
    }
  });

  // POST /api/billing/candidates/:id/approve - Approve a draft candidate
  app.post("/api/billing/candidates/:id/approve", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }

      const [candidate] = await db.select()
        .from(invoiceLineCandidates)
        .where(eq(invoiceLineCandidates.id, req.params.id))
        .limit(1);
      
      if (!candidate) {
        return res.status(404).json({ message: "Invoice candidate not found" });
      }

      if (candidate.status !== 'draft') {
        return res.status(400).json({ message: "Only draft candidates can be approved" });
      }

      await db.update(invoiceLineCandidates)
        .set({
          status: 'approved',
          approvedBy: currentUser?.id,
          approvedAt: new Date(),
          updatedAt: new Date(),
        })
        .where(eq(invoiceLineCandidates.id, req.params.id));

      res.json({ message: "Candidate approved" });
    } catch (error) {
      console.error("[Billing] Error approving candidate:", error);
      res.status(500).json({ message: "Failed to approve candidate" });
    }
  });

  // POST /api/billing/candidates/:id/adjust - Create an adjustment for a candidate
  app.post("/api/billing/candidates/:id/adjust", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const userEmail = req.user?.claims?.email;
      let currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      if (!currentUser && userEmail) {
        currentUser = await storage.getUserByEmail(userEmail);
      }

      const { adjustmentType, amount, reason } = req.body;

      if (!adjustmentType || amount === undefined || !reason) {
        return res.status(400).json({ message: "adjustmentType, amount, and reason are required" });
      }

      const [candidate] = await db.select()
        .from(invoiceLineCandidates)
        .where(eq(invoiceLineCandidates.id, req.params.id))
        .limit(1);
      
      if (!candidate) {
        return res.status(404).json({ message: "Invoice candidate not found" });
      }

      const [adjustment] = await db.insert(invoiceAdjustments).values({
        candidateId: req.params.id,
        moveId: candidate.moveId,
        adjustmentType,
        amount: String(amount),
        reason,
        createdBy: currentUser?.id || 'system',
      }).returning();

      res.status(201).json(adjustment);
    } catch (error) {
      console.error("[Billing] Error creating adjustment:", error);
      res.status(500).json({ message: "Failed to create adjustment" });
    }
  });


      if (!req.user) return res.status(401).json({ message: "Authentication required" });
      const userId = req.user.id || req.user.claims?.sub;
      const { tokenId } = req.params;

      await db.update(candidatePortalTokens)
        .set({ isRevoked: true, revokedAt: new Date(), revokedBy: userId })
        .where(eq(candidatePortalTokens.id, tokenId));

      res.json({ message: "Token revoked" });
    } catch (error: any) {
      console.error("Error revoking portal token:", error);
      res.status(500).json({ message: "Failed to revoke portal token" });
    }
  });

  // POST /api/recruiting/applications/:applicationId/document-requests - Create document request (recruiter)
  app.post("/api/recruiting/applications/:applicationId/document-requests", async (req: any, res: Response) => {
    try {
      if (!req.user) return res.status(401).json({ message: "Authentication required" });
      const userId = req.user.id || req.user.claims?.sub;
      const { applicationId } = req.params;
      const { documentType, label, description, required } = req.body;

      if (!documentType || !label) {
        return res.status(400).json({ message: "documentType and label are required" });
      }

      const [docReq] = await db.insert(candidateDocumentRequests).values({
        applicationId,
        documentType,
        label,
        description: description || null,
        required: required !== false,
        createdBy: userId,
      }).returning();

      res.status(201).json(docReq);
    } catch (error: any) {
      console.error("Error creating document request:", error);
      res.status(500).json({ message: "Failed to create document request" });
    }
  });

  // GET /api/recruiting/applications/:applicationId/document-requests - List document requests (recruiter)
  app.get("/api/recruiting/applications/:applicationId/document-requests", async (req: any, res: Response) => {
    try {
      if (!req.user) return res.status(401).json({ message: "Authentication required" });
      const { applicationId } = req.params;

      const requests = await db.select()
        .from(candidateDocumentRequests)
        .where(eq(candidateDocumentRequests.applicationId, applicationId))
        .orderBy(candidateDocumentRequests.createdAt);

      res.json(requests);
    } catch (error: any) {

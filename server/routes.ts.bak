  // Create payment (manual entry for check/cash)
  app.post("/api/corporate/invoicing/payments", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const paymentNumber = await storage.generatePaymentNumber();
      const payment = await storage.createPayment({

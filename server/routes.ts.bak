  // Create accident/claim (corporate only) - general endpoint
  app.post("/api/corporate/accidents", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      if (!req.body.driverId) {
        return res.status(400).json({ message: "Driver is required" });
      }

      const validatedData = insertAccidentSchema.parse({
        driverId: req.body.driverId,
        reportedBy: userId,
        accidentDate: new Date(req.body.accidentDate),
        location: req.body.location,
        status: req.body.status || "open",
        policeReportFiled: req.body.policeReportFiled || false,
        policeReportNumber: req.body.policeReportNumber || null,
        dodAtFault: req.body.dodAtFault || null,
        vehicleInvolved: req.body.vehicleInvolved || null,
        zendeskTicketNumber: req.body.zendeskTicketNumber || null,
        incidentType: req.body.incidentType || null,
        notesReceived: req.body.notesReceived || null,
        description: req.body.description || null,
      });

      const accident = await storage.createAccident(validatedData);

      // Auto-triage the claim at creation
      try {
        const { calculateTriageSeverity } = await import("./triageService");
        const triageResult = calculateTriageSeverity({
          incidentType: req.body.incidentType,
          injuries: req.body.injuries,
          injuryFlag: req.body.injuryFlag,
          drivableFlag: req.body.drivableFlag,
          damageEst1: req.body.damageEst1,
          totalEstimate: req.body.totalEstimate,
          probableCost: req.body.probableCost,
          claimType: req.body.claimType,
        });

        await storage.updateClaimTriage(accident.id, {
          triageSeverity: triageResult.triageSeverity,
          injuryFlag: triageResult.injuryFlag,
          drivableFlag: triageResult.drivableFlag,
          carrierNotificationRequired: triageResult.carrierNotificationRequired,
          triageDecisionAt: triageResult.triageDecisionAt,
        });

        // Log triage decision
        await storage.createClaimAuditLog({
          claimId: accident.id,
          userId: userId,
          eventType: 'triage_auto_assigned',
          actionSummary: `Auto-triage assigned severity: ${triageResult.triageSeverity}`,
          newValue: triageResult.triageSeverity,
          metadata: JSON.stringify({
            workflow: triageResult.workflow,
            injuryFlag: triageResult.injuryFlag,
            drivableFlag: triageResult.drivableFlag,
            carrierNotificationRequired: triageResult.carrierNotificationRequired,
          }),
        });

        // Auto-create driver incident if claim has a driver (with idempotency check)
        if (req.body.driverId) {
          try {
            const { createDriverIncident, getIncidentForClaim } = await import("./remediationService");
            const existingIncident = await getIncidentForClaim(accident.id);
            if (!existingIncident) {
              const incidentDate = req.body.incidentDate || req.body.accidentDate || new Date();
              await createDriverIncident(
                accident.id,
                req.body.driverId,
                triageResult.triageSeverity,
                incidentDate,
                false, // preventableFlag defaults to false
                userId,
                "Auto-created on claim submission"
              );
              console.log(`[REMEDIATION] Auto-created incident for new claim ${accident.id}, driver ${req.body.driverId}`);
            }
          } catch (incidentError) {
            console.error("Failed to auto-create incident:", incidentError);
          }
        }
      } catch (triageError) {
        console.error("Failed to auto-triage claim:", triageError);
      }
      
      // Send email notification for new claim
      try {
        // Get driver name for the email
        const driver = await storage.getDriverById(req.body.driverId);
        const driverName = driver?.user 
          ? `${driver.user.firstName || ""} ${driver.user.lastName || ""}`.trim() || "Unknown Driver"
          : "Unknown Driver";
        
        // Get the user who created the claim
        const createdByName = user 
          ? `${user.firstName || ""} ${user.lastName || ""}`.trim() || user.email || "Unknown"
          : "Unknown";

        await sendNewClaimNotification({
          accidentDate: validatedData.accidentDate,
          status: validatedData.status || "open",
          driverName,
          location: validatedData.location,
          policeReportFiled: validatedData.policeReportFiled || false,
          dodAtFault: validatedData.dodAtFault || null,
          vehicleInvolved: validatedData.vehicleInvolved || null,
          zendeskTicketNumber: validatedData.zendeskTicketNumber || null,
          incidentType: validatedData.incidentType || null,
          notes: validatedData.notesReceived || validatedData.description || null,
          createdBy: createdByName,
        });
      } catch (emailError) {
        // Log email error but don't fail the claim creation
        console.error("Failed to send claim notification email:", emailError);
      }
      
      res.json(accident);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error creating accident:", error);
      res.status(500).json({ message: "Failed to create accident" });
    }
  });

  // CLAIMS MVP: Submit a new claim (requires move linkage)
  app.post("/api/corporate/claims", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { submitClaimSchema } = await import("@shared/schema");
      const validation = submitClaimSchema.safeParse(req.body);
      
      if (!validation.success) {
        return res.status(400).json({ 
          message: "Validation error", 
          errors: validation.error.errors 
        });
      }

      const data = validation.data;

      // Verify the move exists
      const [move] = await db.select().from(trips).where(eq(trips.id, data.moveId)).limit(1);
      if (!move) {
        return res.status(404).json({ message: "Move not found" });
      }

      // Map claim type to incident type
      const incidentTypeMap: Record<string, string> = {
        DAMAGE: "property_damage",
        ACCIDENT: "collision",
        INJURY: "injury",
        PROPERTY: "property_damage",
        OTHER: "other",
      };

      // Create the accident/claim record
      const accidentData = {
        driverId: data.driverId,
        reportedBy: userId,
        accidentDate: new Date(data.incidentDate),
        incidentDate: new Date(data.incidentDate),
        location: data.location || move.origin || "Unknown",
        status: "open",
        claimStatus: "DRAFT",
        incidentType: incidentTypeMap[data.claimType] || "other",
        claimType: data.claimType,
        claimSeverity: data.severity,
        marketId: move.marketId || null,
        description: data.description,
        notesReceived: data.description,
        moveId: data.moveId,
        customerId: data.customerId || move.customerId || null,
      };

      const accident = await storage.createAccident(accidentData);
      
      // Log audit event for claim creation
      await storage.createClaimAuditLog({
        claimId: accident.id,
        userId: userId,
        eventType: "CLAIM_CREATED",
        actionSummary: `Claim created for move ${move.moveNumber || data.moveId} - Type: ${data.claimType}, Severity: ${data.severity}`,
        metadata: JSON.stringify({
          moveId: data.moveId,
          moveNumber: move.moveNumber,
          claimType: data.claimType,
          severity: data.severity,
          incidentDate: data.incidentDate,
        }),
      });

      res.json(accident);
    } catch (error) {
      console.error("Error creating claim:", error);
      res.status(500).json({ message: "Failed to create claim" });
    }
  });

  // Get claims list with move info (for Claims MVP)
  app.get("/api/corporate/claims", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      // Get all accidents/claims with move info
      const claimsWithMoves = await db
        .select({
          id: accidents.id,
          driverId: accidents.driverId,
          customerId: accidents.customerId,
          moveId: accidents.moveId,
          incidentDate: accidents.incidentDate,
          accidentDate: accidents.accidentDate,
          incidentType: accidents.incidentType,
          status: accidents.status,
          claimStatus: accidents.claimStatus,
          description: accidents.description,
          notesReceived: accidents.notesReceived,
          location: accidents.location,
          totalEstimate: accidents.totalEstimate,
          createdAt: accidents.createdAt,
          // Move details
          moveNumber: trips.moveNumber,
          tripDate: trips.tripDate,
        })
        .from(accidents)
        .leftJoin(trips, eq(accidents.moveId, trips.id))
        .orderBy(sql`${accidents.createdAt} DESC`);

      // Enrich with driver names
      const enrichedClaims = await Promise.all(
        claimsWithMoves.map(async (claim) => {
          let driverName = "Unknown";
          if (claim.driverId) {
            const driver = await storage.getDriverById(claim.driverId);
            if (driver?.user) {
              driverName = `${driver.user.firstName || ""} ${driver.user.lastName || ""}`.trim() || "Unknown";
            }
          }
          return { ...claim, driverName };
        })
      );

      res.json(enrichedClaims);
    } catch (error) {
      console.error("Error fetching claims:", error);
      res.status(500).json({ message: "Failed to fetch claims" });
    }
  });


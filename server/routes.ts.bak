  // POST /api/recruiting/tags - Create a new tag (recruiters/admins only)
  app.post("/api/recruiting/tags", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      // RBAC: Only recruiters and admins can create tags
      if (!user || !['admin', 'recruiter', 'corporate'].includes(user.role || '')) {
        return res.status(403).json({ message: "Only recruiters and admins can manage tags" });
      }

      const { name, description, category, color } = req.body;
      if (!name || typeof name !== 'string' || name.trim().length === 0) {
        return res.status(400).json({ message: "Tag name is required" });
      }

      const { createRecruitingTag } = await import("./recruitingService");
      const tag = await createRecruitingTag(
        { name, description, category, color },
        userId,
        user.email
      );

      res.status(201).json(tag);
    } catch (error: any) {
      console.error("[Recruiting] Error creating tag:", error);
      if (error.message?.includes("already exists")) {
        return res.status(409).json({ message: error.message });
      }
      res.status(500).json({ message: error.message || "Failed to create tag" });
    }
  });


  // Create incident for a move (ops roles only)
  app.post("/api/moves/:moveId/incidents", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { moveId } = req.params;
      
      // Verify move exists
      const move = await db.select().from(trips).where(eq(trips.id, moveId)).limit(1);
      if (!move.length) {
        return res.status(404).json({ message: "Move not found" });
      }

      const { incident_type, occurred_at, description, severity, accident_id } = req.body;

      // Validate incident_type
      const validTypes = ['DAMAGE', 'ACCIDENT', 'INJURY', 'THEFT', 'CITATION', 'OTHER'];
      if (!incident_type || !validTypes.includes(incident_type)) {
        return res.status(400).json({ message: `Invalid incident_type. Must be one of: ${validTypes.join(', ')}` });
      }

      // Validate severity
      const validSeverities = ['LOW', 'MEDIUM', 'HIGH'];
      if (!severity || !validSeverities.includes(severity)) {
        return res.status(400).json({ message: `Invalid severity. Must be one of: ${validSeverities.join(', ')}` });
      }

      // Validate occurred_at
      if (!occurred_at) {
        return res.status(400).json({ message: "occurred_at is required" });
      }

      // Validate description
      if (!description || typeof description !== 'string' || description.trim().length === 0) {
        return res.status(400).json({ message: "description is required and must not be empty" });
      }

      // Get user's display name
      const reportedByName = user?.firstName && user?.lastName 
        ? `${user.firstName} ${user.lastName}`
        : user?.email || 'Unknown User';

      const incident = await storage.createMoveIncident({
        moveId,
        incidentType: incident_type,
        occurredAt: new Date(occurred_at),
        description: description.trim(),
        severity,
        reportedByUserId: userId,
        reportedByName,
        accidentId: accident_id || null,
      });

      res.status(201).json({
        id: incident.id,
        move_id: incident.moveId,
        incident_type: incident.incidentType,
        occurred_at: incident.occurredAt?.toISOString(),
        description: incident.description,
        severity: incident.severity,
        reported_by_user_id: incident.reportedByUserId,
        reported_by_name: incident.reportedByName,
        accident_id: incident.accidentId,
        created_at: incident.createdAt?.toISOString(),
      });
    } catch (error) {
      console.error("Error creating move incident:", error);
      res.status(500).json({ message: "Failed to create move incident" });
    }
  });


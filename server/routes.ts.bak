  // ==========================================
  // LATE FEE MANAGEMENT ROUTES
  // ==========================================

  // Get invoices eligible for late fees
  app.get("/api/invoices/late-fees/eligible", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const eligibleInvoices = await storage.getInvoicesEligibleForLateFee();
      res.json(eligibleInvoices);
    } catch (error) {
      console.error("Error fetching eligible invoices for late fees:", error);
      res.status(500).json({ message: "Failed to fetch eligible invoices" });
    }
  });

  // Apply late fee to invoice (manual trigger)
  app.post("/api/invoices/:invoiceId/late-fee/apply", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { invoiceId } = req.params;
      const invoice = await storage.getInvoice(invoiceId);
      
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }
      
      if (invoice.lateFeeAppliedAt) {
        return res.status(400).json({ message: "Late fee already applied to this invoice" });
      }
      
      const result = await storage.applyLateFeeToInvoice(invoiceId, user?.id || req.user.claims.sub);
      
      if (!result) {
        return res.status(400).json({ message: "Could not apply late fee - check customer billing profile settings" });
      }
      
      res.json({
        message: "Late fee applied successfully",
        invoice: result.invoice,
        lineItem: result.lineItem,
      });
    } catch (error: any) {
      console.error("Error applying late fee:", error);
      res.status(500).json({ message: error.message || "Failed to apply late fee" });
    }
  });

  // Reverse late fee on invoice
  app.post("/api/invoices/:invoiceId/late-fee/reverse", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { invoiceId } = req.params;
      const { reason } = req.body;
      
      if (!reason || typeof reason !== 'string' || reason.trim().length === 0) {
        return res.status(400).json({ message: "Reversal reason is required" });
      }
      
      const invoice = await storage.getInvoice(invoiceId);
      
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }
      
      if (!invoice.lateFeeAppliedAt) {
        return res.status(400).json({ message: "No late fee to reverse on this invoice" });
      }
      
      if (invoice.lateFeeReversedAt) {
        return res.status(400).json({ message: "Late fee has already been reversed" });
      }
      
      const updatedInvoice = await storage.reverseLateFee(invoiceId, user?.id || req.user.claims.sub, reason.trim());
      
      if (!updatedInvoice) {
        return res.status(400).json({ message: "Could not reverse late fee" });
      }
      
      res.json({
        message: "Late fee reversed successfully",
        invoice: updatedInvoice,
      });
    } catch (error: any) {
      console.error("Error reversing late fee:", error);
      res.status(500).json({ message: error.message || "Failed to reverse late fee" });
    }
  });

  // Get late fee line item for invoice
  app.get("/api/invoices/:invoiceId/late-fee", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { invoiceId } = req.params;
      const invoice = await storage.getInvoice(invoiceId);
      
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }
      
      const lineItem = await storage.getLateFeeLineItem(invoiceId);
      
      res.json({
        hasLateFee: !!invoice.lateFeeAppliedAt,
        lateFeeAppliedAt: invoice.lateFeeAppliedAt,
        lateFeeAmount: invoice.lateFeeAmount,
        lateFeeReversed: !!invoice.lateFeeReversedAt,
        lateFeeReversedAt: invoice.lateFeeReversedAt,
        lateFeeReversalReason: invoice.lateFeeReversalReason,
        lineItem,
      });
    } catch (error) {
      console.error("Error fetching late fee info:", error);
      res.status(500).json({ message: "Failed to fetch late fee info" });
    }
  });

  // Batch apply late fees to all eligible invoices
  app.post("/api/invoices/late-fees/batch-apply", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const eligibleInvoices = await storage.getInvoicesEligibleForLateFee();
      const results = {
        processed: 0,
        applied: 0,
        skipped: 0,
        errors: [] as string[],
      };
      
      for (const invoice of eligibleInvoices) {
        results.processed++;
        try {
          const result = await storage.applyLateFeeToInvoice(invoice.id, user?.id || req.user.claims.sub);
          if (result) {
            results.applied++;
          } else {
            results.skipped++;
          }
        } catch (err: any) {
          results.errors.push(`Invoice ${invoice.invoiceNumber}: ${err.message}`);
        }
      }
      
      res.json({
        message: `Late fee batch processing complete`,
        ...results,
      });
    } catch (error: any) {
      console.error("Error batch applying late fees:", error);
      res.status(500).json({ message: error.message || "Failed to batch apply late fees" });
    }
  });


  // GET /api/recruiting/candidates/search - Global candidate search with fuzzy matching
  app.get("/api/recruiting/candidates/search", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });
      const recruitingContext = await getUserRecruitingContext(userId, user?.role || "");
      
      if (!hasPermission(recruitingContext, "read")) {
        return res.status(403).json({ message: "No permission to search candidates" });
      }

      const { q, limit, offset, includeArchived } = req.query;
      
      if (!q || typeof q !== 'string' || q.trim().length < 2) {
        return res.json({ candidates: [], total: 0, query: q || '' });
      }

      const { searchCandidatesGlobal } = await import("./recruitingService");
      
      // Pass authorized markets for market isolation (null = admin access)
      const authorizedMarkets = recruitingContext.isAdmin ? null : recruitingContext.authorizedMarkets;
      
      const result = await searchCandidatesGlobal({
        query: q.trim(),
        authorizedMarkets,
        limit: limit ? parseInt(limit as string, 10) : 20,
        offset: offset ? parseInt(offset as string, 10) : 0,
        includeArchived: includeArchived === "true",
      });

      res.json(result);
    } catch (error) {
      console.error("[Recruiting] Error searching candidates:", error);
      res.status(500).json({ message: "Failed to search candidates" });
    }
  });
  // GET /api/recruiting/candidates - List candidates with filters (market-isolated)
  app.get("/api/recruiting/candidates", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Get user's recruiting permissions and authorized markets
      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });
      const recruitingContext = await getUserRecruitingContext(userId, user?.role || "");
      
      // Check read permission
      if (!hasPermission(recruitingContext, "read")) {
        return res.status(403).json({ message: "No permission to view candidates" });
      }

      const { status, search, limit, offset, includeArchived } = req.query;
      const { getCandidates } = await import("./recruitingService");

      // Pass authorized markets for filtering (null = admin access, [] = no access)
      const authorizedMarkets = recruitingContext.isAdmin ? null : recruitingContext.authorizedMarkets;

      const result = await getCandidates({
        status: status as string | undefined,
        search: search as string | undefined,
        limit: limit ? parseInt(limit as string) : undefined,
        offset: offset ? parseInt(offset as string) : undefined,
        includeArchived: includeArchived === 'true',
        authorizedMarkets,
      });

      res.json(result);
    } catch (error) {
      console.error("[Recruiting] Error fetching candidates:", error);
      res.status(500).json({ message: "Failed to fetch candidates" });
    }
  });
  // POST /api/recruiting/candidates - Create a new candidate
  app.post("/api/recruiting/candidates", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      const { createCandidate } = await import("./recruitingService");
      const candidate = await createCandidate(req.body, userId, user?.email || null);

      res.status(201).json(candidate);
    } catch (error: any) {
      console.error("[Recruiting] Error creating candidate:", error);
      if (error.message?.startsWith("Invalid authorization type")) {
        return res.status(400).json({ message: error.message });
      }
      res.status(500).json({ message: "Failed to create candidate" });
    }
  });


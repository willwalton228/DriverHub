  // Update customer flags
  app.put("/api/corporate/collections/customer/:customerId/flags", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasAdminAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Admin access only" });
      }
      
      const flagsSchema = z.object({
        achOnlyFlag: z.boolean().optional(),
        achOnlyReason: z.string().optional(),
        requirePrepayFlag: z.boolean().optional(),
        requirePrepayReason: z.string().optional(),
        escalatedToCollections: z.boolean().optional(),
        escalationReason: z.string().optional(),
        collectionsAgency: z.string().optional(),
      });
      
      const validatedData = flagsSchema.parse(req.body);
      const userId = req.user.claims.sub;
      const now = new Date();
      
      // Build the updates with timestamps
      const updates: any = { customerId: req.params.customerId };
      
      if (validatedData.achOnlyFlag !== undefined) {
        updates.achOnlyFlag = validatedData.achOnlyFlag;
        if (validatedData.achOnlyFlag) {
          updates.achOnlySetAt = now;
          updates.achOnlySetBy = userId;
        }
        if (validatedData.achOnlyReason) {
          updates.achOnlyReason = validatedData.achOnlyReason;
        }
      }
      
      if (validatedData.requirePrepayFlag !== undefined) {
        updates.requirePrepayFlag = validatedData.requirePrepayFlag;
        if (validatedData.requirePrepayFlag) {
          updates.requirePrepaySetAt = now;
          updates.requirePrepaySetBy = userId;
        }
        if (validatedData.requirePrepayReason) {
          updates.requirePrepayReason = validatedData.requirePrepayReason;
        }
      }
      
      if (validatedData.escalatedToCollections !== undefined) {
        updates.escalatedToCollections = validatedData.escalatedToCollections;
        if (validatedData.escalatedToCollections) {
          updates.escalatedAt = now;
          updates.escalatedBy = userId;
        }
        if (validatedData.escalationReason) {
          updates.escalationReason = validatedData.escalationReason;
        }
        if (validatedData.collectionsAgency) {
          updates.collectionsAgency = validatedData.collectionsAgency;
        }
      }
      
      const flags = await storage.upsertCollectionsCustomerFlags(updates);
      res.json(flags);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error updating customer flags:", error);
      res.status(500).json({ message: "Failed to update customer flags" });
    }
  });


  // ==========================================
  // PAYMENT COMMITMENT TRACKING ROUTES
  // ==========================================

  // List payment commitments (with filters)
  app.get("/api/corporate/invoicing/commitments", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { customerId, status, invoiceId } = req.query;
      let query = db.select().from(paymentCommitments).orderBy(desc(paymentCommitments.createdAt));
      
      const conditions: any[] = [];
      if (customerId) conditions.push(eq(paymentCommitments.customerId, customerId as string));
      if (status && status !== 'all') conditions.push(eq(paymentCommitments.status, status as string));
      
      let commitments;
      if (conditions.length > 0) {
        commitments = await db.select().from(paymentCommitments).where(and(...conditions)).orderBy(desc(paymentCommitments.createdAt));
      } else {
        commitments = await db.select().from(paymentCommitments).orderBy(desc(paymentCommitments.createdAt));
      }

      // If filtering by invoiceId, get commitment IDs linked to that invoice
      if (invoiceId) {
        const linkedCommitmentIds = await db.select({ commitmentId: paymentCommitmentInvoices.commitmentId })
          .from(paymentCommitmentInvoices)
          .where(eq(paymentCommitmentInvoices.invoiceId, invoiceId as string));
        const idSet = new Set(linkedCommitmentIds.map(l => l.commitmentId));
        commitments = commitments.filter(c => idSet.has(c.id));
      }

      // Batch enrich to avoid N+1 queries
      const commitmentIds = commitments.map(c => c.id);
      const customerIds = [...new Set(commitments.map(c => c.customerId))];
      const userIds = [...new Set(commitments.map(c => c.committedBy))];

      const allLinkedInvoices = commitmentIds.length > 0
        ? await db.select({
            commitmentId: paymentCommitmentInvoices.commitmentId,
            invoiceId: paymentCommitmentInvoices.invoiceId,
            allocatedAmount: paymentCommitmentInvoices.allocatedAmount,
            invoiceNumber: invoices.invoiceNumber,
            totalAmount: invoices.totalAmount,
            balanceDue: invoices.balanceDue,
          }).from(paymentCommitmentInvoices)
            .innerJoin(invoices, eq(paymentCommitmentInvoices.invoiceId, invoices.id))
        : [];

      const allCustomers = customerIds.length > 0
        ? await db.select({ id: customers.id, name: customers.name }).from(customers)
        : [];
      const customerMap = new Map(allCustomers.map(c => [c.id, c.name]));

      const allUsers = await Promise.all(userIds.map(uid => storage.getUser(uid)));
      const userMap = new Map(userIds.map((uid, i) => [uid, allUsers[i]]));

      const enriched = commitments.map(c => {
        const linked = allLinkedInvoices.filter(li => li.commitmentId === c.id);
        const committedByUser = userMap.get(c.committedBy);
        return {
          ...c,
          committedByName: committedByUser ? `${committedByUser.firstName} ${committedByUser.lastName}` : 'Unknown',
          customerName: customerMap.get(c.customerId) || 'Unknown',
          linkedInvoices: linked,
        };
      });

      res.json(enriched);
    } catch (error) {
      console.error("Error fetching commitments:", error);
      res.status(500).json({ message: "Failed to fetch commitments" });
    }
  });

  // Get single commitment by ID
  app.get("/api/corporate/invoicing/commitments/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const [commitment] = await db.select().from(paymentCommitments).where(eq(paymentCommitments.id, req.params.id));
      if (!commitment) return res.status(404).json({ message: "Commitment not found" });

      const linkedInvoices = await db.select({
        invoiceId: paymentCommitmentInvoices.invoiceId,
        allocatedAmount: paymentCommitmentInvoices.allocatedAmount,
        invoiceNumber: invoices.invoiceNumber,
        totalAmount: invoices.totalAmount,
        balanceDue: invoices.balanceDue,
      }).from(paymentCommitmentInvoices)
        .innerJoin(invoices, eq(paymentCommitmentInvoices.invoiceId, invoices.id))
        .where(eq(paymentCommitmentInvoices.commitmentId, commitment.id));

      const committedByUser = await storage.getUser(commitment.committedBy);
      const customerData = await db.select({ name: customers.name }).from(customers).where(eq(customers.id, commitment.customerId)).limit(1);

      res.json({
        ...commitment,
        committedByName: committedByUser ? `${committedByUser.firstName} ${committedByUser.lastName}` : 'Unknown',
        customerName: customerData[0]?.name || 'Unknown',
        linkedInvoices,
      });
    } catch (error) {
      console.error("Error fetching commitment:", error);
      res.status(500).json({ message: "Failed to fetch commitment" });
    }
  });

  // Create payment commitment
  app.post("/api/corporate/invoicing/commitments", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const bodySchema = z.object({
        customerId: z.string().min(1),
        promisedAmount: z.string().min(1),
        promisedDate: z.string().min(1),
        commitmentNotes: z.string().optional(),
        invoiceIds: z.array(z.string()).optional(),
        allocations: z.array(z.object({
          invoiceId: z.string(),
          allocatedAmount: z.string().optional(),
        })).optional(),
      });

      const validated = bodySchema.parse(req.body);
      const userId = req.user.claims.sub;

      const [commitment] = await db.insert(paymentCommitments).values({
        customerId: validated.customerId,
        promisedAmount: validated.promisedAmount,
        promisedDate: validated.promisedDate,
        commitmentNotes: validated.commitmentNotes || null,
        committedBy: userId,
        status: 'pending',
      }).returning();

      // Link invoices if provided
      const invoiceLinks = validated.allocations || (validated.invoiceIds || []).map(id => ({ invoiceId: id }));
      if (invoiceLinks.length > 0) {
        await db.insert(paymentCommitmentInvoices).values(
          invoiceLinks.map(link => ({
            commitmentId: commitment.id,
            invoiceId: link.invoiceId,
            allocatedAmount: ('allocatedAmount' in link && link.allocatedAmount) ? link.allocatedAmount : null,
          }))
        );
      }

      res.status(201).json(commitment);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error creating commitment:", error);
      res.status(500).json({ message: "Failed to create commitment" });
    }
  });

  // Update commitment (resolve: mark as kept/missed/partial/cancelled)
  app.patch("/api/corporate/invoicing/commitments/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const bodySchema = z.object({
        status: z.enum(['pending', 'kept', 'missed', 'partial', 'cancelled']).optional(),
        actualAmountReceived: z.string().optional(),
        actualPaymentDate: z.string().optional(),
        commitmentNotes: z.string().optional(),
      });

      const validated = bodySchema.parse(req.body);
      const userId = req.user.claims.sub;
      const now = new Date();

      const [existing] = await db.select().from(paymentCommitments).where(eq(paymentCommitments.id, req.params.id));
      if (!existing) return res.status(404).json({ message: "Commitment not found" });

      const updates: any = { updatedAt: now };
      if (validated.commitmentNotes !== undefined) updates.commitmentNotes = validated.commitmentNotes;
      if (validated.actualAmountReceived) updates.actualAmountReceived = validated.actualAmountReceived;
      if (validated.actualPaymentDate) updates.actualPaymentDate = validated.actualPaymentDate;
      
      if (validated.status && validated.status !== 'pending') {
        updates.status = validated.status;
        updates.resolvedAt = now;
        updates.resolvedBy = userId;

        // Calculate SLA metrics
        const promisedDate = new Date(existing.promisedDate);
        const actualDate = validated.actualPaymentDate ? new Date(validated.actualPaymentDate) : now;
        const diffDays = Math.floor((actualDate.getTime() - promisedDate.getTime()) / (1000 * 60 * 60 * 24));
        
        updates.committedOnTime = diffDays <= 0;
        updates.daysLateVsCommitment = Math.max(0, diffDays);
      } else if (validated.status === 'pending') {
        updates.status = 'pending';
        updates.resolvedAt = null;
        updates.resolvedBy = null;
        updates.committedOnTime = null;
        updates.daysLateVsCommitment = null;
      }

      const [updated] = await db.update(paymentCommitments)
        .set(updates)
        .where(eq(paymentCommitments.id, req.params.id))
        .returning();

      res.json(updated);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error updating commitment:", error);
      res.status(500).json({ message: "Failed to update commitment" });
    }
  });

  // Get commitment performance stats for a customer
  app.get("/api/corporate/invoicing/commitments/customer/:customerId/stats", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const allCommitments = await db.select().from(paymentCommitments)
        .where(eq(paymentCommitments.customerId, req.params.customerId))
        .orderBy(desc(paymentCommitments.createdAt));

      const total = allCommitments.length;
      const kept = allCommitments.filter(c => c.status === 'kept').length;
      const missed = allCommitments.filter(c => c.status === 'missed').length;
      const partial = allCommitments.filter(c => c.status === 'partial').length;
      const pending = allCommitments.filter(c => c.status === 'pending').length;
      const cancelled = allCommitments.filter(c => c.status === 'cancelled').length;
      const resolved = allCommitments.filter(c => ['kept', 'missed', 'partial'].includes(c.status));
      const onTimeCount = resolved.filter(c => c.committedOnTime).length;
      const onTimeRate = resolved.length > 0 ? Math.round((onTimeCount / resolved.length) * 100) : null;
      const avgDaysLate = resolved.length > 0
        ? Math.round(resolved.reduce((sum, c) => sum + (c.daysLateVsCommitment || 0), 0) / resolved.length)
        : null;
      const totalPromised = allCommitments.reduce((sum, c) => sum + parseFloat(c.promisedAmount || '0'), 0);
      const totalReceived = resolved.reduce((sum, c) => sum + parseFloat(c.actualAmountReceived || '0'), 0);

      // Check for overdue pending commitments (missed SLA)
      const today = new Date();
      const overdueCommitments = allCommitments.filter(c => {
        return c.status === 'pending' && new Date(c.promisedDate) < today;
      });

      res.json({
        total, kept, missed, partial, pending, cancelled,
        onTimeRate, avgDaysLate,
        totalPromised: totalPromised.toFixed(2),
        totalReceived: totalReceived.toFixed(2),
        overdueCount: overdueCommitments.length,
        commitments: allCommitments,
      });
    } catch (error) {
      console.error("Error fetching commitment stats:", error);
      res.status(500).json({ message: "Failed to fetch commitment stats" });
    }
  });

  // Get missed/overdue commitments (for Collections Workbench alerts)
  app.get("/api/corporate/invoicing/commitments/alerts/missed", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const today = new Date().toISOString().split('T')[0];
      
      // Get all pending commitments where promised_date has passed
      const overdueCommitments = await db.select().from(paymentCommitments)
        .where(and(
          eq(paymentCommitments.status, 'pending'),
          lte(paymentCommitments.promisedDate, today)
        ))
        .orderBy(asc(paymentCommitments.promisedDate));

      const enriched = await Promise.all(overdueCommitments.map(async (c) => {
        const customerData = await db.select({ name: customers.name }).from(customers).where(eq(customers.id, c.customerId)).limit(1);
        const committedByUser = await storage.getUser(c.committedBy);
        const daysOverdue = Math.floor((new Date().getTime() - new Date(c.promisedDate).getTime()) / (1000 * 60 * 60 * 24));
        
        const linkedInvoices = await db.select({
          invoiceId: paymentCommitmentInvoices.invoiceId,
          invoiceNumber: invoices.invoiceNumber,
        }).from(paymentCommitmentInvoices)
          .innerJoin(invoices, eq(paymentCommitmentInvoices.invoiceId, invoices.id))
          .where(eq(paymentCommitmentInvoices.commitmentId, c.id));
        
        return {
          ...c,
          customerName: customerData[0]?.name || 'Unknown',
          committedByName: committedByUser ? `${committedByUser.firstName} ${committedByUser.lastName}` : 'Unknown',
          daysOverdue,
          linkedInvoices,
        };
      }));

      res.json(enriched);
    } catch (error) {
      console.error("Error fetching missed commitments:", error);
      res.status(500).json({ message: "Failed to fetch missed commitments" });
    }
  });

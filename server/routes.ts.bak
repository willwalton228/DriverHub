  // ADMIN USER MANAGEMENT ROUTES (super_user and admin only)

  // Helper middleware for admin access
  const requireAdmin = async (req: any, res: Response, next: Function) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!user || (user.role !== "super_user" && user.role !== "admin")) {
        return res.status(403).json({ message: "Forbidden: Admin or Super User access only" });
      }

      req.adminUser = user;
      next();
    } catch (error) {
      console.error("Error checking admin access:", error);
      res.status(500).json({ message: "Failed to verify permissions" });
    }
  };

  // Get all users (admin/super_user only)
  app.get("/api/admin/users", isAuthenticated, requireAdmin, async (req: any, res: Response) => {
    try {
      const users = await storage.getAllUsers();

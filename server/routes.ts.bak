  app.get("/api/corporate/scheduling/ai-governance/seed-defaults/:entityId", isAuthenticated, async (req: any, res: Response) => {
    try {
      const { entityId } = req.params;
      const defaultFeatures = [
        {
          entityId,
          featureKey: "auto_scheduling",
          featureName: "Auto-Scheduling Suggestions",
          description: "Suggests optimal driver-to-shift assignments based on availability, skills, and historical performance patterns.",
          dataInputs: ["driver_availability", "shift_requirements", "driver_skills", "historical_assignment_patterns", "driver_preferences"],
          predictionTarget: "Optimal driver-shift assignment with coverage maximization",
          confidenceThreshold: 0.75,
          humanApprovalRequired: true,
          isEnabled: true,
          createdBy: req.user?.id || null,
        },
        {
          entityId,
          featureKey: "ot_prediction",
          featureName: "Overtime Risk Prediction",
          description: "Predicts likelihood of overtime based on current schedule patterns, planned shifts, and historical overtime trends.",
          dataInputs: ["current_schedule", "planned_shifts", "historical_ot_data", "labor_regulations", "driver_hours_worked"],
          predictionTarget: "Probability of overtime occurrence per driver per week",
          confidenceThreshold: 0.7,
          humanApprovalRequired: true,
          isEnabled: true,
          createdBy: req.user?.id || null,
        },
        {
          entityId,
          featureKey: "fatigue_risk",
          featureName: "Fatigue Risk Assessment",
          description: "Assesses driver fatigue risk based on consecutive working days, shift lengths, rest periods, and time-of-day patterns.",
          dataInputs: ["consecutive_days_worked", "shift_durations", "rest_periods", "time_of_day_patterns", "break_compliance"],
          predictionTarget: "Driver fatigue risk level (low/medium/high) with contributing factors",
          confidenceThreshold: 0.65,
          humanApprovalRequired: true,
          isEnabled: true,
          createdBy: req.user?.id || null,
        },
        {
          entityId,
          featureKey: "no_show_prediction",
          featureName: "No-Show Probability",
          description: "Predicts the likelihood a driver will not show up for a scheduled shift based on historical patterns and contextual signals.",
          dataInputs: ["historical_attendance", "day_of_week", "shift_timing", "weather_conditions", "driver_reliability_score"],
          predictionTarget: "No-show probability score (0-1) per assignment",
          confidenceThreshold: 0.6,
          humanApprovalRequired: false,
          isEnabled: true,
          createdBy: req.user?.id || null,
        },
        {
          entityId,
          featureKey: "demand_forecasting",
          featureName: "Labor Demand Forecasting",
          description: "Forecasts staffing needs based on historical demand, seasonal patterns, and client-specific schedules.",
          dataInputs: ["historical_demand", "seasonal_patterns", "client_schedules", "special_events", "growth_trends"],
          predictionTarget: "Required driver count per shift type per day (7/14/30-day forecast)",
          confidenceThreshold: 0.7,
          humanApprovalRequired: true,
          isEnabled: true,
          createdBy: req.user?.id || null,
        },
        {
          entityId,
          featureKey: "schedule_optimization",
          featureName: "Schedule Optimization Advisor",
          description: "Analyzes current schedules and suggests improvements to reduce costs, improve coverage, and balance workload.",
          dataInputs: ["current_schedules", "labor_costs", "coverage_gaps", "driver_utilization", "ot_costs"],
          predictionTarget: "Recommended schedule adjustments with estimated cost/coverage impact",
          confidenceThreshold: 0.7,
          humanApprovalRequired: true,
          isEnabled: true,
          createdBy: req.user?.id || null,
        },
      ];

      const results = [];
      for (const feature of defaultFeatures) {
        const result = await storage.upsertAiFeatureConfig(feature);
        results.push(result);
      }
      res.json(results);
    } catch (error: any) {
      console.error("[AIGovernance] Error seeding defaults:", error);
      res.status(500).json({ message: "Failed to seed default AI features" });
    }
  });
  // External insurer read-only access (token-based)
  app.get("/api/external/scheduling/insurance-report", async (req: any, res: Response) => {
    try {
      const token = req.query.token as string;
      if (!token) return res.status(401).json({ message: "Access token required" });
      
      const { db } = await import("./db");
      const { externalAccessGrants, externalAccessLogs } = await import("@shared/schema");
      const { eq } = await import("drizzle-orm");
      
      const [grant] = await db.select().from(externalAccessGrants).where(eq(externalAccessGrants.accessToken, token));
      if (!grant || !grant.isActive) return res.status(403).json({ message: "Invalid or expired access" });
      if (new Date(grant.expiresAt) < new Date()) return res.status(403).json({ message: "Access token expired" });
      if (!grant.allowedScopes.includes("scheduling_insurance")) {
        return res.status(403).json({ message: "Scope not authorized for scheduling insurance reports" });
      }
      
      const { periodType = "monthly", periodStart } = req.query as any;
      if (!periodStart) return res.status(400).json({ message: "periodStart is required (YYYY-MM-DD)" });
      
      const { generateFullInsuranceReport } = await import("./services/schedulingInsuranceService");
      const report = await generateFullInsuranceReport(null, periodType, periodStart);
      
      await db.insert(externalAccessLogs).values({
        grantId: grant.id,
        accessedResource: "scheduling_insurance",
        resourceScope: `${periodType}:${periodStart}`,
        requestMethod: "GET",
        requestPath: "/api/external/scheduling/insurance-report",
        ipAddress: req.ip || null,
        userAgent: req.headers["user-agent"] || null,
        responseStatus: 200,
      });
      
      res.json(report);
    } catch (error: any) {
      console.error("[External Insurance] Error:", error);
      res.status(500).json({ message: "Failed to generate report" });
    }
  });



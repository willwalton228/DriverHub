      const override = await createSlaProgramOverride({
        slaDefinitionId,
        customerId,
        durationMinutes,
        warningThresholdMinutes,
        criticalThresholdMinutes,
        configOverride: configOverride ? JSON.stringify(configOverride) : null,
        effectiveFrom: effectiveFrom ? new Date(effectiveFrom) : new Date(),
        createdBy: user.id,
      });

      res.status(201).json(override);
    } catch (error) {
      console.error("[SLA] Error creating override:", error);
      res.status(500).json({ message: "Failed to create SLA override" });

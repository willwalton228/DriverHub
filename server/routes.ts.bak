      const user = await storage.getUser(userId);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const existingApp = await storage.getApplication(req.params.id);
      if (!existingApp) {
        return res.status(404).json({ message: "Application not found" });
      }

      const application = await storage.updateApplication(req.params.id, req.body);

      // Log status change if applicable
      if (req.body.status && req.body.status !== existingApp.status) {
        await storage.createApplicationActivity({
          applicationId: application.id,
          activityType: "status_change",
          description: `Status changed from ${existingApp.status} to ${req.body.status}`,
          previousValue: existingApp.status,
          newValue: req.body.status,
          performedBy: userId,
        });
      }

      res.json(application);

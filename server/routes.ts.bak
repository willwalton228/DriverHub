      const existingOffer = await storage.getOffer(req.params.id);
      if (!existingOffer) {
        return res.status(404).json({ message: "Offer not found" });
      }

      const offer = await storage.updateOffer(req.params.id, req.body);

      // Log status change if applicable
      if (req.body.status && req.body.status !== existingOffer.status) {
        await storage.createApplicationActivity({
          applicationId: offer.applicationId,
          activityType: "offer_status_change",
          description: `Offer status changed from ${existingOffer.status} to ${req.body.status}`,
          previousValue: existingOffer.status,
          newValue: req.body.status,
          performedBy: userId,
        });

        // If offer accepted, update application status
        if (req.body.status === "accepted") {
          await storage.updateApplication(offer.applicationId, { 
            status: "hired", 
            hiredAt: new Date() 
          });
        }

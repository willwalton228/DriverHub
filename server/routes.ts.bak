          where: (users, { eq }) => eq(users.email, (req as any).user.claims.email),
        });
      }
      if (!user || (user.role !== 'admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { id } = req.params;
      const { archiveSlaDefinition } = await import("./slaService");
      
      const archived = await archiveSlaDefinition(id, userId);
      if (!archived) {
        return res.status(404).json({ message: "SLA definition not found" });
      }
      res.json({ success: true, message: "SLA definition archived" });
    } catch (error) {
      console.error("[SLA] Error archiving definition:", error);
      res.status(500).json({ message: "Failed to archive SLA definition" });
    }
  });


  // POST /api/recruiting/document-templates - Create a document template (Recruiting Admin only)
  app.post("/api/recruiting/document-templates", async (req: Request, res: Response) => {
    if (!req.isAuthenticated()) {
      return res.status(401).json({ message: "Authentication required" });
    }
    const user = req.user as any;
    if (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'recruiter') {
      return res.status(403).json({ message: "Permission denied. Recruiting Admin or Recruiter role required." });
    }
    try {
      const { createTemplate, validateTemplate } = await import("./services/documentGenerationService");
      
      const validation = validateTemplate(req.body.bodyHtml || '');
      if (!validation.valid) {
        return res.status(400).json({ 
          message: "Template contains unknown variables", 
          missingVariables: validation.missingVariables 
        });
      }
      
      const template = await createTemplate(req.body, user.id);
      res.status(201).json(template);
    } catch (error: any) {
      console.error("[Documents] Failed to create template:", error);
      res.status(500).json({ message: error.message || "Failed to create template" });
    }
  });


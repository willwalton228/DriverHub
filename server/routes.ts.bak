  // Get payment retry config by payment method
  app.get("/api/corporate/invoicing/payment-retry/config/:paymentMethod", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasFinanceAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Finance/Admin access only" });
      }
      
      const { paymentMethod } = req.params;
      const orgId = req.query.orgId as string | undefined;
      const config = await storage.getPaymentRetryConfigByMethod(paymentMethod, orgId);
      
      if (!config) {
        const defaultConfig = {
          paymentMethod,
          retryScheduleDays: paymentMethod === 'credit_card' ? [1, 3, 7] : [3],
          maxRetries: paymentMethod === 'credit_card' ? 3 : 1,
          sendFailureEmail: true,
          sendRetryNotice: true,
          includePayLink: true,
          autoRetry: true,
          escalateToCollections: false,
          markInvoiceOverdue: true,
        };
        return res.json(defaultConfig);
      }
      
      res.json(config);
    } catch (error) {
      console.error("Error fetching payment retry config:", error);
      res.status(500).json({ message: "Failed to fetch payment retry config" });
    }
  });


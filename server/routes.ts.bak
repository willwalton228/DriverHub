  // POST /api/recruiting/applications/:id/reactivate - Reactivate a withdrawn/no-show application
  app.post("/api/recruiting/applications/:id/reactivate", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Recruiting access required" });
      }

      const { id } = req.params;
      const { restoreToStage, notes } = req.body;
      
      // Verify application exists
      const [application] = await db.select().from(recruitingApplications).where(eq(recruitingApplications.id, id));
      
      if (!application) {
        return res.status(404).json({ message: "Application not found" });
      }
      
      if (!application.withdrawnAt && !application.noShowAt) {
        return res.status(400).json({ message: "Application is not withdrawn or marked no-show" });
      }

      const previousStage = application.currentStage;
      const targetStage = restoreToStage || "applied";

      // Clear withdrawal/no-show fields and restore
      const [updated] = await db.update(recruitingApplications)
        .set({
          currentStage: targetStage,
          withdrawnAt: null,
          withdrawnBy: null,
          withdrawnReason: null,
          withdrawnSource: null,
          noShowAt: null,
          noShowBy: null,
          noShowReason: null,
          noShowInterviewId: null,
          excludeFromMetrics: false,
          updatedAt: new Date(),
        })
        .where(eq(recruitingApplications.id, id))
        .returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "APPLICATION_REACTIVATED",
        entityType: "application",
        entityId: id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        previousValue: JSON.stringify({ stage: previousStage }),
        newValue: JSON.stringify({
          stage: targetStage,
          notes,
        }),
      });

      res.json(updated);
    } catch (error: any) {
      console.error("Error reactivating application:", error);
      res.status(500).json({ message: "Failed to reactivate application" });
    }
  });

  // PATCH /api/recruiting/applications/:id/metrics-exclusion - Update metrics exclusion flag
  app.patch("/api/recruiting/applications/:id/metrics-exclusion", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }
      
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }

      const { enforceApplicationLock: enforceMetricsLock } = await import("./recruitingService");
      const metricsLockResult = await enforceMetricsLock(req.params.id, userId);
      if (!metricsLockResult.allowed) {
        return res.status(409).json({
          message: "Application is locked by another user",
          conflict: metricsLockResult.conflict,
        });
      }
      
      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }
      
      if (!user || (user.role !== 'admin' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Admin access required" });
      }

      const { id } = req.params;
      const { excludeFromMetrics, reason } = req.body;
      
      if (typeof excludeFromMetrics !== 'boolean') {
        return res.status(400).json({ message: "excludeFromMetrics must be a boolean" });
      }

      const [application] = await db.select().from(recruitingApplications).where(eq(recruitingApplications.id, id));
      
      if (!application) {
        return res.status(404).json({ message: "Application not found" });
      }

      const [updated] = await db.update(recruitingApplications)
        .set({
          excludeFromMetrics,
          updatedAt: new Date(),
        })
        .where(eq(recruitingApplications.id, id))
        .returning();

      // Log audit event
      await db.insert(recruitingAuditEvents).values({
        actionType: "APPLICATION_UPDATED",
        entityType: "application",
        entityId: id,
        userId: user.id,
        userEmail: user.email,
        actorRole: user?.role || undefined,
        source: 'ui',
        previousValue: JSON.stringify({ excludeFromMetrics: application.excludeFromMetrics }),
        newValue: JSON.stringify({ excludeFromMetrics, reason }),
      });

      res.json(updated);
    } catch (error: any) {
      console.error("Error updating metrics exclusion:", error);
      res.status(500).json({ message: "Failed to update metrics exclusion" });
    }
  });

  // ==================== Consent & Disclosure API ====================

  // POST /api/recruiting/candidates/:candidateId/consents - Record a consent
  app.post("/api/recruiting/candidates/:candidateId/consents", async (req: any, res: Response) => {
    try {
      let userId: string | null = null;
      let userEmail: string | null = null;
      if ((req.session as any)?.userId) {
        userId = (req.session as any).userId;
      } else if (req.isAuthenticated?.() && req.user?.claims?.sub) {
        userId = req.user.claims.sub;
        userEmail = req.user.claims.email;
      }

      // Require authentication for all consent recording
      if (!userId) {
        return res.status(401).json({ message: "Unauthorized" });
      }

      let user = await storage.getUser(userId);
      if (!user && userEmail) {
        const [userByEmail] = await db.select().from(users).where(eq(users.email, userEmail));
        user = userByEmail;
      }

      if (!user || (user.role !== 'admin' && user.role !== 'recruiter' && user.role !== 'recruiting_admin' && user.role !== 'super_user')) {
        return res.status(403).json({ message: "Forbidden: Recruiting access required" });
      }
      const { candidateId } = req.params;
      const { 
        consentType,
        consentVersion,
        applicationId,
        source,
        consentGiven,
        ipAddress,
        userAgent,
        consentTextHash,
        stateCode,
        disclosureTextId,
        signatureData,
        metadata
      } = req.body;
      
      if (!consentType) {
        return res.status(400).json({ message: "consentType is required" });
      }

      // Verify candidate exists
      const [candidate] = await db.select().from(recruitingCandidates).where(eq(recruitingCandidates.id, candidateId));
      
      if (!candidate) {
        return res.status(404).json({ message: "Candidate not found" });
      }

      // Create immutable consent record
      const [consent] = await db.insert(recruitingConsents).values({
        candidateId,
        applicationId: applicationId || null,
        consentType,
        consentVersion: consentVersion || "1.0",
        consentGiven: consentGiven !== false,
        source: source || "web_form",
        capturedAt: new Date(),
        capturedBy: userId || null,
        ipAddress: ipAddress || null,
        userAgent: userAgent || null,
        consentTextHash: consentTextHash || null,
        stateCode: stateCode || null,
        disclosureTextId: disclosureTextId || null,
        signatureData: signatureData || null,
        metadata: metadata || null,
      }).returning();

      // Log audit event if user is authenticated
      if (userId) {
        await db.insert(recruitingAuditEvents).values({
          actionType: consentGiven !== false ? "CONSENT_RECORDED" : "CONSENT_REVOKED",
          entityType: "candidate",
          entityId: candidateId,
          userId,
          userEmail,
          newValue: JSON.stringify({
            consentId: consent.id,
            consentType,
            consentVersion: consentVersion || "1.0",
            consentGiven: consentGiven !== false,
            source: source || "web_form",
          }),
        });
      }

      res.status(201).json(consent);
    } catch (error: any) {
      console.error("Error recording consent:", error);
      res.status(500).json({ message: "Failed to record consent" });
    }
  });

  // GET /api/recruiting/candidates/:candidateId/consents - Get consent history for a candidate
  app.get("/api/recruiting/candidates/:candidateId/consents", async (req: any, res: Response) => {

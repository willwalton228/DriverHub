  // Get all invitations (admin/super_user only)
  app.get("/api/admin/invitations", isAuthenticated, requireAdmin, async (req: any, res: Response) => {
    try {
      const invitations = await storage.getAllInvitations();
      res.json(invitations);
    } catch (error) {
      console.error("Error fetching invitations:", error);

  // Union CBA Violations Routes
  app.get("/api/corporate/scheduling/union-violations", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const scheduleId = req.query.scheduleId as string | undefined;
      const ruleSetId = req.query.ruleSetId as string | undefined;
      const entityId = req.query.entityId as string | undefined;
      let violations = await storage.getUnionCbaViolations(scheduleId, ruleSetId);
      if (entityId) {
        const entityRuleSets = await storage.getUnionCbaRuleSets(entityId);
        const entityRuleSetIds = new Set(entityRuleSets.map((rs: any) => rs.id));
        violations = violations.filter((v: any) => entityRuleSetIds.has(v.ruleSetId));
      }
      res.json(violations);
    } catch (error) {
      console.error("Error fetching union CBA violations:", error);
      res.status(500).json({ message: "Failed to fetch union CBA violations" });
    }
  });


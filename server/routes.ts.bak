  // GET /api/recruiting/applications - List applications with filters (market-isolated)
  app.get("/api/recruiting/applications", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      const queryStartTime = performance.now();
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Get user's recruiting permissions and authorized markets
      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });
      const recruitingContext = await getUserRecruitingContext(userId, user?.role || "");
      
      // Check read permission
      if (!hasPermission(recruitingContext, "read")) {
        return res.status(403).json({ message: "No permission to view applications" });
      }

      const { requisitionId, market, stage, slaBreached, readinessStatus, tag, geoEligible, limit, offset, includeArchived } = req.query;
      const { getApplicationsWithSlaStatus } = await import("./recruitingService");

      // Pass authorized markets for filtering (null = admin access, [] = no access)
      const authorizedMarkets = recruitingContext.isAdmin ? null : recruitingContext.authorizedMarkets;

      const result = await getApplicationsWithSlaStatus({
        requisitionId: requisitionId as string | undefined,
        market: market as string | undefined,
        stage: stage as string | undefined,
        slaBreached: slaBreached === 'true' ? true : slaBreached === 'false' ? false : undefined,
        readinessStatus: readinessStatus as string | undefined,
        tag: tag as string | undefined,
        geoEligible: geoEligible === 'true' ? true : geoEligible === 'false' ? false : undefined,
        limit: limit ? parseInt(limit as string) : undefined,
        offset: offset ? parseInt(offset as string) : undefined,
        includeArchived: includeArchived === 'true',
        authorizedMarkets,
      });

      // Batch-fetch owner info for all applications
      const ownerIds = [...new Set(result.applications.map((app: any) => app.ownerId).filter(Boolean))];
      const ownerMap = new Map<string, { firstName: string | null; lastName: string | null; email: string | null }>();
      if (ownerIds.length > 0) {
        const owners = await db.query.users.findMany({
          where: (users, { inArray }) => inArray(users.id, ownerIds),
          columns: { id: true, firstName: true, lastName: true, email: true },
        });
        for (const owner of owners) {
          ownerMap.set(owner.id, { firstName: owner.firstName, lastName: owner.lastName, email: owner.email });
        }
      }

      const flattenedApplications = result.applications.map((app: any) => {
        const owner = app.ownerId ? ownerMap.get(app.ownerId) : null;
        const ownerName = owner ? `${owner.firstName || ''} ${owner.lastName || ''}`.trim() : null;
        return {
          ...app,
          candidateFirstName: app.candidate?.firstName || null,
          candidateLastName: app.candidate?.lastName || null,
          candidateEmail: app.candidate?.email || null,
          requisitionTitle: app.requisition?.title || null,
          requisitionScreeningFormTemplateId: app.requisition?.screeningFormTemplateId || null,
          screeningResponsesCount: 0,
          tags: app.tags || [],
          ownerName: ownerName || null,
          candidateAccessToVehicle: app.candidate?.accessToVehicle || null,
          candidateVehicleType: app.candidate?.vehicleType || null,
          candidateTrailerAccess: app.candidate?.trailerAccess || null,
          candidateAuthorizedToWork: app.candidate?.authorizedToWork ?? null,
          candidateAuthorizationType: app.candidate?.authorizationType || null,
          candidateAuthorizationExpiration: app.candidate?.authorizationExpiration || null,
          candidateMvrYearsLicensed: app.candidate?.mvrYearsLicensed ?? null,
          candidateMvrViolations3yr: app.candidate?.mvrViolations3yr ?? null,
          candidateMvrViolations5yr: app.candidate?.mvrViolations5yr ?? null,
          candidateMvrAtFaultAccidents: app.candidate?.mvrAtFaultAccidents ?? null,
          candidateMvrDuiDwi: app.candidate?.mvrDuiDwi ?? null,
          ownerEmail: owner?.email || null,
        };
      });
      // Log query timing for performance monitoring
      const { logQueryTiming } = await import("./services/queryTimingService");
      const queryDurationMs = Math.round(performance.now() - queryStartTime);
      logQueryTiming({ endpoint: "/api/recruiting/applications", queryName: "getApplicationsWithSlaStatus", method: "GET", durationMs: queryDurationMs, filters: { requisitionId, market, stage, slaBreached, readinessStatus, tag }, resultCount: flattenedApplications.length, userId });

      res.json({ applications: flattenedApplications, total: result.total });
    } catch (error) {
      console.error("[Recruiting] Error fetching applications:", error);
      res.status(500).json({ message: "Failed to fetch applications" });
    }
  });
  // POST /api/recruiting/applications - Create a new application
  app.post("/api/recruiting/applications", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      // Check if requisition or market is paused (hiring freeze)
      if (req.body.requisitionId) {
        const { recruitingPauseService } = await import("./services/recruitingSlaService");
        const pauseStatus = await recruitingPauseService.isRequisitionPaused(req.body.requisitionId);
        if (pauseStatus.isPaused) {
          return res.status(409).json({ 
            message: "Applications are temporarily paused for this position.",
            reason: pauseStatus.reason || "Hiring freeze in effect"
          });
        }
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });

      // Check DNR status if candidateId is provided
      if (req.body.candidateId) {
        const { checkCandidateDnrStatus } = await import("./recruitingService");
        const dnrStatus = await checkCandidateDnrStatus(req.body.candidateId);
        if (dnrStatus.isDnr && !dnrStatus.hasOverride) {
          return res.status(403).json({
            message: "This candidate is flagged as Do-Not-Rehire and cannot have new applications created.",
            dnr: true,
            dnrReasonCode: dnrStatus.dnrReasonCode,
          });
        }
      }

      const { createApplication } = await import("./recruitingService");
      const application = await createApplication(req.body, userId, user?.email || null);

      res.status(201).json(application);
    } catch (error: any) {
      console.error("[Recruiting] Error creating application:", error);
      if (error.message?.includes("open requisitions") || error.message?.includes("already exists")) {
        return res.status(400).json({ message: error.message });
      }
      res.status(500).json({ message: "Failed to create application" });
    }
  });

  // GET /api/recruiting/applications/:id - Get single application with details
  app.get("/api/recruiting/applications/:id", async (req: Request, res: Response) => {
    try {

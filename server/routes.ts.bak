  app.post("/api/corporate/invoicing/invoices/:id/dispute", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      
      const { reasonCategory, notes } = req.body;
      
      // Validate reason category
      const validCategories = ['pricing', 'service', 'damage', 'duplicate', 'other'];
      if (!reasonCategory || !validCategories.includes(reasonCategory)) {
        return res.status(400).json({ message: "Invalid or missing dispute reason category" });
      }
      
      const invoice = await storage.markInvoiceAsDisputed(req.params.id, {
        reasonCategory,
        notes,
        createdBy: user?.id || req.user.claims.sub,
      });
      
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }
      
      res.json(invoice);
    } catch (error) {
      console.error("Error marking invoice as disputed:", error);
      res.status(500).json({ message: "Failed to mark invoice as disputed" });
    }
  });

  // Resolve invoice dispute
  app.post("/api/corporate/invoicing/invoices/:id/resolve-dispute", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      
      const invoice = await storage.resolveInvoiceDispute(
        req.params.id,
        user?.id || req.user.claims.sub
      );
      
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }
      
      res.json(invoice);
    } catch (error: any) {
      console.error("Error resolving invoice dispute:", error);
      res.status(500).json({ message: error.message || "Failed to resolve invoice dispute" });
    }
  });

  // Send invoice
  app.post("/api/corporate/invoicing/invoices/:id/send", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const { toEmails, ccEmails } = req.body;

      // Get existing invoice with customer info
      const [existingInvoice] = await db.select()
        .from(invoices)
        .where(eq(invoices.id, req.params.id))
        .limit(1);

      if (!existingInvoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }

      // Duplicate send prevention - check if recently sent (within 60 seconds)
      if (existingInvoice.sentAt) {
        const timeSinceSent = Date.now() - new Date(existingInvoice.sentAt).getTime();
        const SEND_COOLDOWN_MS = 60000; // 60 second cooldown between sends
        if (timeSinceSent < SEND_COOLDOWN_MS) {
          const secondsRemaining = Math.ceil((SEND_COOLDOWN_MS - timeSinceSent) / 1000);
          console.log('[Invoice Send] Duplicate send prevented for invoice:', req.params.id, 'sent', Math.round(timeSinceSent/1000), 'seconds ago');
          await storage.logResilienceEvent({
            context: 'invoice_send',
            entityType: 'invoice',
            entityId: req.params.id,
            action: 'duplicate_send_blocked',
            status: 'blocked',
            metadata: { timeSinceSent, sentAt: existingInvoice.sentAt },
            createdBy: req.user.claims.sub,
          });
          return res.status(429).json({ 
            message: `Invoice was already sent recently. Please wait ${secondsRemaining} seconds before resending.`,
            code: 'DUPLICATE_SEND_PREVENTED',
            sentAt: existingInvoice.sentAt,
          });
        }
      }

      // Idempotency check for invoice send
      const sendIdempKey = req.headers['x-idempotency-key'] || req.headers['idempotency-key'];
      if (sendIdempKey) {
        const sendHash = hashRequestBody({ invoiceId: req.params.id, toEmails: req.body.toEmails });
        const sendIdempResult = await checkIdempotency('invoice_send', sendIdempKey, sendHash, req.user.claims.sub);
        if (!sendIdempResult.isNew && sendIdempResult.cachedResponse) {
          console.log('[Idempotency] Returning cached response for invoice send key:', sendIdempKey);
          return res.status(sendIdempResult.cachedResponse.status).json(sendIdempResult.cachedResponse.body);
        }
      }

      // Check if invoice is approved (only Finance/Admin can bypass)
      const approvalState = existingInvoice.approvalWorkflowState || 'draft';
      if (approvalState !== 'approved' && !['admin', 'finance'].includes(user?.role || '')) {
        return res.status(400).json({ 
          message: `Invoice must be approved before sending. Current state: ${approvalState}`,
          approvalWorkflowState: approvalState
        });
      }

      // Credit limit enforcement
      if (existingInvoice.customerId) {
        const billingProfile = await storage.getCustomerBillingProfile(existingInvoice.customerId);
        const creditLimit = billingProfile?.creditLimit ? parseFloat(billingProfile.creditLimit) : null;
        const creditLimitAction = billingProfile?.creditLimitAction || 'warn';
        if (creditLimit !== null && creditLimitAction === 'block') {
          const unpaidResult = await db.select({ total: sql`COALESCE(SUM(COALESCE(CAST(balance_due AS numeric), CAST(total_amount AS numeric))), 0)` })
            .from(invoices)
            .where(and(
              eq(invoices.customerId, existingInvoice.customerId),
              or(eq(invoices.status, 'sent'), eq(invoices.status, 'overdue'), eq(invoices.status, 'partial'))
            ));
          const currentExposure = parseFloat((unpaidResult[0] as any)?.total || '0');
          const invoiceAmount = parseFloat(existingInvoice.totalAmount || '0');
          const projectedExposure = currentExposure + invoiceAmount;
          if (projectedExposure > creditLimit) {
            const hasOverride = await db.select()
              .from(creditLimitOverrides)
              .where(eq(creditLimitOverrides.invoiceId, req.params.id))
              .limit(1);
            if (hasOverride.length === 0) {
              return res.status(400).json({
                message: 'Credit limit exceeded. An override is required before this invoice can be sent.',
                code: 'CREDIT_LIMIT_EXCEEDED',
                creditLimit,
                currentExposure: parseFloat(currentExposure.toFixed(2)),
                projectedExposure: parseFloat(projectedExposure.toFixed(2)),
                invoiceAmount,
              });
            }
          }
        }
      }

      // Get customer info for email
      let customerEmail = toEmails?.[0] || '';
      let customerName = 'Customer';
      if (existingInvoice.customerId) {
        const [customer] = await db.select()
          .from(customers)
          .where(eq(customers.id, existingInvoice.customerId))
          .limit(1);
        if (customer) {
          customerName = customer.name;
          customerEmail = toEmails?.[0] || customer.billingEmail || customer.email || '';
        }
      }

      // Get invoice line items
      const lineItems = await db.select()
        .from(invoiceLineItems)
        .where(eq(invoiceLineItems.invoiceId, req.params.id));

      // Generate payment access token if not exists
      let paymentAccessToken = existingInvoice.paymentAccessToken;
      let paymentLinkUrl = existingInvoice.paymentLinkUrl;
      if (!paymentAccessToken) {
        const tokenResult = await db.execute(sql`SELECT replace(gen_random_uuid()::text, '-', '') as token`);
        paymentAccessToken = (tokenResult.rows[0] as any).token;
        paymentLinkUrl = `/pay/${paymentAccessToken}`;
        
        await db.update(invoices)
          .set({
            paymentAccessToken,
            paymentLinkUrl,
            updatedAt: new Date(),
          })
          .where(eq(invoices.id, req.params.id));
      }

      // Build full payment link
      const baseUrl = process.env.REPLIT_DEPLOYMENT_URL || 
        (process.env.REPL_SLUG ? `https://${process.env.REPL_SLUG}.${process.env.REPL_OWNER?.toLowerCase()}.repl.co` : 'http://localhost:5000');
      const fullPaymentLink = `${baseUrl}/pay/${paymentAccessToken}`;

      // Send actual email if customer email available
      let emailResult = { success: false, error: 'No recipient email' };
      if (customerEmail) {
        emailResult = await sendInvoiceEmail({
          to: customerEmail,
          customerName,
          invoiceNumber: existingInvoice.invoiceNumber || '',
          invoiceDate: existingInvoice.invoiceDate || new Date().toISOString().split('T')[0],
          dueDate: existingInvoice.dueDate || new Date().toISOString().split('T')[0],
          totalAmount: existingInvoice.totalAmount || '0',
          balanceDue: existingInvoice.balanceDue || existingInvoice.totalAmount || '0',
          paymentLink: fullPaymentLink,
          lineItems: lineItems.map(item => ({
            description: item.description || '',
            quantity: Number(item.quantity) || 1,
            unitPrice: item.unitPrice || '0',
            amount: item.amount || '0',
          })),
          notes: existingInvoice.notes || undefined,
        });
      }

      const invoice = await storage.sendInvoice(
        req.params.id,
        req.user.claims.sub,
        toEmails || [customerEmail],
        ccEmails
      );
      
      // Create email log entry
      await storage.createInvoiceEmailLogEntry({
        invoiceId: req.params.id,
        toEmails: toEmails || [customerEmail],
        ccEmails,
        subject: `Invoice ${invoice?.invoiceNumber}`,
        status: emailResult.success ? 'sent' : 'failed',
        sentBy: req.user.claims.sub,
      });

      // Record delivery history event
      await storage.createInvoiceDeliveryEvent({
        invoiceId: req.params.id,
        eventType: 'sent',
        recipientEmail: customerEmail,
        sentBy: req.user.claims.sub,
        metadata: { emailSent: emailResult.success, isResend: false },
      });

      // Process autopay if enabled with on_send trigger
      let autopayResult = null;
      try {
        const billingProfile = await storage.getCustomerBillingProfile(invoice?.customerId);
        if (billingProfile?.autopayEnabled && billingProfile?.autopayTrigger === 'on_send') {
          console.log(`[Autopay] Processing on_send autopay for invoice ${invoice?.invoiceNumber}`);
          autopayResult = await processInvoiceAutopay(invoice?.id, 'on_send');
        }
      } catch (autopayError) {
        console.error('[Autopay] Error during on_send processing:', autopayError);
      }
      
      
      res.json({ 
        ...invoice, 
        paymentAccessToken, 
        paymentLinkUrl: fullPaymentLink,
        emailSent: emailResult.success,
        emailError: emailResult.error,
      });
    } catch (error) {
      console.error("Error sending invoice:", error);
      const sendIdempKeyErr = req.headers['x-idempotency-key'] || req.headers['idempotency-key'];
      if (sendIdempKeyErr) {
        try { await storage.finalizeIdempotencyKey('invoice_send', sendIdempKeyErr, 500, { message: 'Failed to send invoice' }); } catch (e) {}
      }
      res.status(500).json({ message: "Failed to send invoice" });
    }
  });

  // Resend invoice
  // Send manual payment reminder
  app.post("/api/corporate/invoicing/invoices/:id/reminder", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      
      const { sendManualReminder } = await import("./invoiceReminderService");
      const result = await sendManualReminder(req.params.id, user?.id || req.user.claims.sub);
      
      if (!result.success) {
        return res.status(400).json({ message: result.error || "Failed to send reminder" });
      }
      
      res.json({ success: true, message: "Reminder sent successfully" });
    } catch (error: any) {
      console.error("Error sending manual reminder:", error);
      res.status(500).json({ message: "Failed to send reminder" });
    }
  });

  app.post("/api/corporate/invoicing/invoices/:id/resend", isAuthenticated, async (req, res) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const { toEmails } = req.body;

      const [existingInvoice] = await db.select()
        .from(invoices)
        .where(eq(invoices.id, req.params.id))
        .limit(1);

      if (!existingInvoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }

      if (!existingInvoice.sentAt) {
        return res.status(400).json({ message: "Invoice has not been sent yet. Use send endpoint instead." });
      }

      let customerEmail = toEmails?.[0] || '';
      let customerName = 'Customer';
      if (existingInvoice.customerId) {
        const [customer] = await db.select()
          .from(customers)
          .where(eq(customers.id, existingInvoice.customerId))
          .limit(1);
        if (customer) {
          customerName = customer.name;
          customerEmail = toEmails?.[0] || customer.billingEmail || customer.email || '';
        }
      }

      const lineItems = await db.select()
        .from(invoiceLineItems)
        .where(eq(invoiceLineItems.invoiceId, req.params.id));

      const baseUrl = process.env.REPLIT_DEPLOYMENT_URL || 
        (process.env.REPL_SLUG ? `https://${process.env.REPL_SLUG}.${process.env.REPL_OWNER?.toLowerCase()}.repl.co` : 'http://localhost:5000');
      const fullPaymentLink = `${baseUrl}/pay/${existingInvoice.paymentAccessToken}`;

      let emailResult = { success: false, error: 'No recipient email' };
      if (customerEmail) {
        emailResult = await sendInvoiceEmail({
          to: customerEmail,
          customerName,
          invoiceNumber: existingInvoice.invoiceNumber || '',
          invoiceDate: existingInvoice.invoiceDate || new Date().toISOString().split('T')[0],
          dueDate: existingInvoice.dueDate || new Date().toISOString().split('T')[0],
          totalAmount: existingInvoice.totalAmount || '0',
          balanceDue: existingInvoice.balanceDue || existingInvoice.totalAmount || '0',
          paymentLink: fullPaymentLink,
          lineItems: lineItems.map(item => ({
            description: item.description || '',
            quantity: Number(item.quantity) || 1,
            unitPrice: item.unitPrice || '0',
            amount: item.totalPrice || '0',
          })),
          isResend: true,
        });
      }

      await db.update(invoices)
        .set({ lastSentAt: new Date(), updatedAt: new Date() })
        .where(eq(invoices.id, req.params.id));

      await storage.createInvoiceDeliveryEvent({
        invoiceId: req.params.id,
        eventType: 'resent',
        recipientEmail: customerEmail,
        sentBy: req.user.claims.sub,
        metadata: { emailSent: emailResult.success },
      });

      res.json({ success: true, emailSent: emailResult.success, emailError: emailResult.error });
    } catch (error) {
      console.error("Error resending invoice:", error);
      res.status(500).json({ message: "Failed to resend invoice" });
    }
  });

  // Invoice Approval Workflow Routes
  
  // Get invoices pending approval (Finance/Admin only)
  app.get("/api/corporate/invoicing/invoices/pending-approval", isAuthenticated, async (req, res) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!user || !['admin', 'finance', 'corporate'].includes(user.role || '')) {
        return res.status(403).json({ message: "Forbidden: Finance or Admin access required" });
      }
      
      const pendingInvoices = await storage.getInvoicesPendingApproval();
      res.json(pendingInvoices);
    } catch (error) {
      console.error("Error fetching pending approval invoices:", error);
      res.status(500).json({ message: "Failed to fetch pending invoices" });
    }
  });

  // Submit invoice for approval (Ops/Corporate can submit)
  app.post("/api/corporate/invoicing/invoices/:id/submit-for-approval", isAuthenticated, async (req, res) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const invoice = await storage.getInvoice(req.params.id);
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }

      const currentState = invoice.approvalWorkflowState || 'draft';
      if (!['draft', 'rejected'].includes(currentState)) {
        return res.status(400).json({ 
          message: `Cannot submit invoice for approval. Current state: ${currentState}` 
        });
      }

      const updated = await storage.submitInvoiceForApproval(req.params.id, req.user.claims.sub);
      
      const financeUsers = await db.select().from(users).where(
        or(eq(users.role, 'finance'), eq(users.role, 'admin'))
      );
      
      for (const financeUser of financeUsers) {
        await storage.createNotification({
          userId: financeUser.id,
          type: 'invoice_pending_approval',
          title: 'Invoice Approval Required',
          message: `Invoice ${invoice.invoiceNumber} requires your approval`,
          relatedEntityType: 'invoice',
          relatedEntityId: invoice.id,
        });
      }

      res.json(updated);
    } catch (error) {
      console.error("Error submitting invoice for approval:", error);
      res.status(500).json({ message: "Failed to submit invoice for approval" });
    }
  });

  // Approve invoice (Finance/Admin only)
  app.post("/api/corporate/invoicing/invoices/:id/approve", isAuthenticated, async (req, res) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!user || !['admin', 'finance'].includes(user.role || '')) {
        return res.status(403).json({ message: "Forbidden: Finance or Admin access required" });
      }

      const invoice = await storage.getInvoice(req.params.id);
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }

      if (invoice.approvalWorkflowState !== 'pending_approval') {
        return res.status(400).json({ 
          message: `Cannot approve invoice. Current state: ${invoice.approvalWorkflowState || 'draft'}` 
        });
      }

      const updated = await storage.approveInvoice(req.params.id, req.user.claims.sub);
      
      if (invoice.submittedForApprovalBy) {
        await storage.createNotification({
          userId: invoice.submittedForApprovalBy,
          type: 'invoice_approved',
          title: 'Invoice Approved',
          message: `Invoice ${invoice.invoiceNumber} has been approved and can now be sent`,
          relatedEntityType: 'invoice',
          relatedEntityId: invoice.id,
        });
      }

      res.json(updated);
    } catch (error) {
      console.error("Error approving invoice:", error);
      res.status(500).json({ message: "Failed to approve invoice" });
    }
  });

  // Reject invoice (Finance/Admin only)
  app.post("/api/corporate/invoicing/invoices/:id/reject", isAuthenticated, async (req, res) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!user || !['admin', 'finance'].includes(user.role || '')) {
        return res.status(403).json({ message: "Forbidden: Finance or Admin access required" });
      }

      const { reason, comment } = req.body;
      if (!reason || !comment) {
        return res.status(400).json({ message: "Rejection reason and comment are required" });
      }

      const validReasons = ['pricing_error', 'missing_info', 'incorrect_customer', 'duplicate', 'other'];
      if (!validReasons.includes(reason)) {
        return res.status(400).json({ message: `Invalid rejection reason. Must be one of: ${validReasons.join(', ')}` });
      }

      const invoice = await storage.getInvoice(req.params.id);
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }

      if (invoice.approvalWorkflowState !== 'pending_approval') {
        return res.status(400).json({ 
          message: `Cannot reject invoice. Current state: ${invoice.approvalWorkflowState || 'draft'}` 
        });
      }

      const updated = await storage.rejectInvoice(req.params.id, req.user.claims.sub, reason, comment);
      
      if (invoice.submittedForApprovalBy) {
        await storage.createNotification({
          userId: invoice.submittedForApprovalBy,
          type: 'invoice_rejected',
          title: 'Invoice Rejected',
          message: `Invoice ${invoice.invoiceNumber} was rejected: ${comment}`,
          relatedEntityType: 'invoice',
          relatedEntityId: invoice.id,
        });
      }

      res.json(updated);
    } catch (error) {
      console.error("Error rejecting invoice:", error);
      res.status(500).json({ message: "Failed to reject invoice" });
    }
  });

  // Return invoice to draft
  app.post("/api/corporate/invoicing/invoices/:id/return-to-draft", isAuthenticated, async (req, res) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const invoice = await storage.getInvoice(req.params.id);
      if (!invoice) {
        return res.status(404).json({ message: "Invoice not found" });
      }

      const currentState = invoice.approvalWorkflowState || 'draft';
      if (currentState === 'draft') {
        return res.status(400).json({ message: "Invoice is already in draft state" });
      }
      
      if (currentState === 'pending_approval' && !['admin', 'finance'].includes(user?.role || '')) {
        return res.status(403).json({ message: "Only Finance or Admin can cancel pending approvals" });
      }

      const updated = await storage.returnInvoiceToDraft(req.params.id, req.user.claims.sub);
      res.json(updated);
    } catch (error) {
      console.error("Error returning invoice to draft:", error);
      res.status(500).json({ message: "Failed to return invoice to draft" });
    }
  });


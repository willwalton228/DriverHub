  app.post("/api/corporate/invoicing/saved-views", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const { name, description, filters, sortBy, sortOrder, type, icon, color } = req.body;
      if (!name || !filters) {
        return res.status(400).json({ message: "Name and filters are required" });
      }
      const viewType = (type === 'shared' && (user?.role === 'admin' || user?.role === 'superadmin')) ? 'shared' : 'private';
      const view = await storage.createInvoiceSavedView({
        name,
        description,
        filters,
        sortBy: sortBy || 'createdAt',
        sortOrder: sortOrder || 'desc',
        type: viewType,
        icon,
        color,
        createdBy: req.user.claims.sub,
      });
      res.status(201).json(view);
    } catch (error) {
      console.error("Error creating saved view:", error);
      res.status(500).json({ message: "Failed to create saved view" });
    }
  });

  app.patch("/api/corporate/invoicing/saved-views/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const existing = await storage.getInvoiceSavedView(req.params.id);
      if (!existing) return res.status(404).json({ message: "View not found" });
      if (existing.createdBy !== req.user.claims.sub && existing.type !== 'shared') {
        return res.status(403).json({ message: "Cannot edit another user's private view" });
      }
      if (existing.type === 'shared' && user?.role !== 'admin' && user?.role !== 'superadmin') {
        return res.status(403).json({ message: "Only admins can edit shared views" });
      }
      const updated = await storage.updateInvoiceSavedView(req.params.id, req.body);
      res.json(updated);
    } catch (error) {
      console.error("Error updating saved view:", error);
      res.status(500).json({ message: "Failed to update saved view" });
    }
  });

  app.delete("/api/corporate/invoicing/saved-views/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const existing = await storage.getInvoiceSavedView(req.params.id);
      if (!existing) return res.status(404).json({ message: "View not found" });
      if (existing.type === 'system') {
        return res.status(403).json({ message: "Cannot delete system views" });
      }
      if (existing.createdBy !== req.user.claims.sub && user?.role !== 'admin' && user?.role !== 'superadmin') {
        return res.status(403).json({ message: "Cannot delete another user's view" });
      }
      await storage.deleteInvoiceSavedView(req.params.id);
      res.json({ success: true });
    } catch (error) {
      console.error("Error deleting saved view:", error);
      res.status(500).json({ message: "Failed to delete saved view" });
    }
  });


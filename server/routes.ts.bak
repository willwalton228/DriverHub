  // Admin override for photo gate
  app.post("/api/moves/:moveId/photo-gate-override", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      // Only admin/super_user can override
      if (!user || !["admin", "super_user"].includes(user.role || "")) {
        return res.status(403).json({ message: "Forbidden: Admin access required for photo gate override" });
      }

      const moveId = req.params.moveId;
      const { stage, reason } = req.body;

      if (!stage || !reason) {
        return res.status(400).json({ message: "Missing required fields: stage, reason" });
      }

      if (!["pickup", "dropoff"].includes(stage)) {
        return res.status(400).json({ message: "Invalid stage. Must be 'pickup' or 'dropoff'" });
      }

      if (reason.trim().length < 10) {
        return res.status(400).json({ message: "Override reason must be at least 10 characters" });
      }

      const trip = await storage.getTrip(moveId);
      if (!trip) {
        return res.status(404).json({ message: "Move not found" });
      }

      // Get current missing photos
      const photos = await storage.getMoveMediaByStage(moveId, stage);
      const capturedCategories = new Set(photos.filter(p => p.qualityPassed).map(p => p.category));
      const requiredPhotos = stage === "pickup" ? PICKUP_REQUIRED_PHOTOS : DROPOFF_REQUIRED_PHOTOS;
      const missingCategories = requiredPhotos.filter(cat => !capturedCategories.has(cat));

      // Create override record
      const override = await storage.createPhotoGateOverride({
        moveId,
        stage,
        overriddenByUserId: userId,
        overriddenByName: user.firstName && user.lastName 
          ? `${user.firstName} ${user.lastName}` 
          : user.email || "Unknown",
        reason: reason.trim(),
        missingCategories,
        previousStatus: stage === "pickup" 
          ? trip.pickupPhotoComplianceStatus 
          : trip.dropoffPhotoComplianceStatus,
      });

      res.status(201).json(override);
    } catch (error) {
      console.error("Error creating photo gate override:", error);
      res.status(500).json({ message: "Failed to create override" });
    }
  });

  // Check if move can transition (photo gate enforcement)
  app.get("/api/moves/:moveId/can-transition", isAuthenticated, async (req: any, res: Response) => {
    try {
      const moveId = req.params.moveId;
      const targetState = req.query.targetState as string;

      const trip = await storage.getTrip(moveId);
      if (!trip) {
        return res.status(404).json({ message: "Move not found" });
      }

      const overrides = await storage.getPhotoGateOverridesByMoveId(moveId);
      const hasPickupOverride = overrides.some(o => o.stage === "pickup");
      const hasDropoffOverride = overrides.some(o => o.stage === "dropoff");

      // States that require pickup photos
      const REQUIRES_PICKUP = ["EN_ROUTE_PICKUP", "AT_PICKUP", "EN_ROUTE_DESTINATION", "AT_DESTINATION", "COMPLETED"];
      // States that require dropoff photos
      const REQUIRES_DROPOFF = ["COMPLETED"];

      const pickupComplete = trip.pickupPhotoComplianceStatus === "complete" || hasPickupOverride;
      const dropoffComplete = trip.dropoffPhotoComplianceStatus === "complete" || hasDropoffOverride;

      const requiresPickup = REQUIRES_PICKUP.includes(targetState);
      const requiresDropoff = REQUIRES_DROPOFF.includes(targetState);

      const canTransition = (!requiresPickup || pickupComplete) && (!requiresDropoff || dropoffComplete);

      const blockers: string[] = [];
      if (requiresPickup && !pickupComplete) {
        blockers.push("Pickup photos required");
      }
      if (requiresDropoff && !dropoffComplete) {
        blockers.push("Dropoff photos required");
      }

      res.json({
        canTransition,
        blockers,
        pickupStatus: trip.pickupPhotoComplianceStatus,
        dropoffStatus: trip.dropoffPhotoComplianceStatus,
        hasPickupOverride,
        hasDropoffOverride,
      });
    } catch (error) {
      console.error("Error checking transition:", error);
      res.status(500).json({ message: "Failed to check transition" });
    }
  });

  // EXPENSE ROUTES

  // Expense Summary endpoint with average age and date range filtering
  app.get("/api/corporate/expenses/summary", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      // Get all expenses
      const allExpenses = await storage.getAllExpenses();
      const now = new Date();
      
      // Date range helpers
      const getStartOfMonth = () => new Date(now.getFullYear(), now.getMonth(), 1);
      const getStartOfQuarter = () => {
        const quarter = Math.floor(now.getMonth() / 3);
        return new Date(now.getFullYear(), quarter * 3, 1);
      };
      const getStartOfYear = () => new Date(now.getFullYear(), 0, 1);

      // Calculate average age in days
      const calculateAverageAge = (expenses: any[]) => {
        if (expenses.length === 0) return 0;
        const totalDays = expenses.reduce((sum, e) => {
          const createdDate = e.createdAt ? new Date(e.createdAt) : new Date(e.expenseDate);
          const ageMs = now.getTime() - createdDate.getTime();
          return sum + (ageMs / (1000 * 60 * 60 * 24));
        }, 0);
        return Math.round((totalDays / expenses.length) * 10) / 10; // Round to 1 decimal
      };

      // Filter by date range
      const filterByDateRange = (expenses: any[], startDate: Date) => {
        return expenses.filter(e => {
          const expenseDate = e.approvalDate ? new Date(e.approvalDate) : 
                             e.reimbursementDate ? new Date(e.reimbursementDate) :
                             new Date(e.createdAt || e.expenseDate);
          return expenseDate >= startDate;
        });
      };

      // Not-Submitted (drafts) - all time
      const drafts = allExpenses.filter(e => e.status === 'draft');
      const draftTotal = drafts.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0);
      const draftAvgAge = calculateAverageAge(drafts);

      // Pending Approval - expenses with approval stage other than Not-Submitted, Fully Approved, or Reimbursed
      const pending = allExpenses.filter(e => {
        // Exclude drafts (Not-Submitted)
        if (e.status === 'draft') return false;
        // Exclude Fully Approved (status approved or stage completed)
        if (e.status === 'approved' || e.currentApprovalStage === 'completed') return false;
        // Exclude Reimbursed
        if (e.status === 'reimbursed') return false;
        // Include if has an approval stage (manager, coo, executive, etc.)
        return e.currentApprovalStage && e.currentApprovalStage !== 'completed';
      });
      const pendingTotal = pending.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0);
      const pendingAvgAge = calculateAverageAge(pending);

      // Approved - with date range options (status === 'approved' OR currentApprovalStage === 'completed')
      const approved = allExpenses.filter(e => e.status === 'approved' || e.currentApprovalStage === 'completed');
      const approvedMTD = filterByDateRange(approved, getStartOfMonth());
      const approvedQTD = filterByDateRange(approved, getStartOfQuarter());
      const approvedYTD = filterByDateRange(approved, getStartOfYear());

      // Reimbursed - with date range options
      const reimbursed = allExpenses.filter(e => e.status === 'reimbursed');
      const reimbursedMTD = filterByDateRange(reimbursed, getStartOfMonth());
      const reimbursedQTD = filterByDateRange(reimbursed, getStartOfQuarter());
      const reimbursedYTD = filterByDateRange(reimbursed, getStartOfYear());

      // Calculate category breakdown for expenses
      const getCategoryBreakdown = (expenses: any[]) => {
        const categoryMap = new Map<string, number>();
        expenses.forEach(e => {
          const category = e.category || 'other';
          const amount = parseFloat(e.amount || '0');
          categoryMap.set(category, (categoryMap.get(category) || 0) + amount);
        });
        return Array.from(categoryMap.entries()).map(([category, amount]) => ({
          category,
          amount: Math.round(amount * 100) / 100,
        })).sort((a, b) => b.amount - a.amount);
      };

      res.json({
        draft: {
          count: drafts.length,
          total: draftTotal,
          avgAgeDays: draftAvgAge,
          expenses: drafts.map(e => e.id),
        },
        pending: {
          count: pending.length,
          total: pendingTotal,
          avgAgeDays: pendingAvgAge,
          expenses: pending.map(e => e.id),
        },
        approved: {
          all: { count: approved.length, total: approved.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0), expenses: approved.map(e => e.id), byCategory: getCategoryBreakdown(approved) },
          mtd: { count: approvedMTD.length, total: approvedMTD.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0), expenses: approvedMTD.map(e => e.id), byCategory: getCategoryBreakdown(approvedMTD) },
          qtd: { count: approvedQTD.length, total: approvedQTD.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0), expenses: approvedQTD.map(e => e.id), byCategory: getCategoryBreakdown(approvedQTD) },
          ytd: { count: approvedYTD.length, total: approvedYTD.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0), expenses: approvedYTD.map(e => e.id), byCategory: getCategoryBreakdown(approvedYTD) },
        },
        reimbursed: {
          all: { count: reimbursed.length, total: reimbursed.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0), expenses: reimbursed.map(e => e.id), byCategory: getCategoryBreakdown(reimbursed) },
          mtd: { count: reimbursedMTD.length, total: reimbursedMTD.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0), expenses: reimbursedMTD.map(e => e.id), byCategory: getCategoryBreakdown(reimbursedMTD) },
          qtd: { count: reimbursedQTD.length, total: reimbursedQTD.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0), expenses: reimbursedQTD.map(e => e.id), byCategory: getCategoryBreakdown(reimbursedQTD) },
          ytd: { count: reimbursedYTD.length, total: reimbursedYTD.reduce((sum, e) => sum + parseFloat(e.amount || '0'), 0), expenses: reimbursedYTD.map(e => e.id), byCategory: getCategoryBreakdown(reimbursedYTD) },
        },
      });
    } catch (error) {
      console.error("Error fetching expense summary:", error);
      res.status(500).json({ message: "Failed to fetch expense summary" });
    }
  });

  // DRAFT EXPENSE ROUTES (for current user)
  
  // Get current user's draft expenses
  app.get("/api/my/expenses/drafts", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const drafts = await storage.getDraftExpensesByUser(userId);
      res.json(drafts);
    } catch (error) {
      console.error("Error fetching draft expenses:", error);
      res.status(500).json({ message: "Failed to fetch draft expenses" });
    }
  });

  // Create a draft expense
  app.post("/api/my/expenses/drafts", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);
      
      // For employee expenses, automatically populate employeeId from authenticated user
      let employeeId = req.body.employeeId;
      if (req.body.expenseType === 'employee' && !employeeId) {
        const employee = await storage.getEmployeeByUserId(userId);
        if (employee) {
          employeeId = employee.id;
        }
      }

      // For driver expenses, automatically populate driverId from authenticated user
      let driverId = req.body.driverId;
      if (req.body.expenseType === 'driver' && !driverId) {
        const driver = await storage.getDriverByUserId(userId);
        if (driver) {
          driverId = driver.id;
        }
      }

      const validatedData = insertExpenseSchema.parse({
        ...req.body,
        submittedBy: userId,
        status: 'draft',
        employeeId: req.body.expenseType === 'employee' ? employeeId : null,
        driverId: req.body.expenseType === 'driver' ? driverId : null,
      });

      const expense = await storage.createExpense(validatedData);
      res.json(expense);
    } catch (error) {
      if (error instanceof z.ZodError) {
        const errorMessages = error.errors.map(e => e.message).join(', ');
        return res.status(400).json({ message: errorMessages || "Validation error", errors: error.errors });
      }
      console.error("Error creating draft expense:", error);
      res.status(500).json({ message: "Failed to create draft expense" });
    }
  });

  // Update a draft expense (only owner can update, only drafts can be updated)
  app.patch("/api/my/expenses/drafts/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const expenseId = req.params.id;
      
      // Check ownership and status
      const expense = await storage.getExpense(expenseId);
      if (!expense) {
        return res.status(404).json({ message: "Expense not found" });
      }
      if (expense.submittedBy !== userId) {
        return res.status(403).json({ message: "You can only edit your own expenses" });
      }
      if (expense.status !== 'draft') {
        return res.status(400).json({ message: "Only draft expenses can be edited" });
      }

      const updatedExpense = await storage.updateExpense(expenseId, req.body);
      res.json(updatedExpense);
    } catch (error) {
      console.error("Error updating draft expense:", error);
      res.status(500).json({ message: "Failed to update draft expense" });
    }
  });

  // Delete a draft expense (only owner can delete, only drafts can be deleted)
  app.delete("/api/my/expenses/drafts/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const expenseId = req.params.id;
      
      // Check ownership and status
      const expense = await storage.getExpense(expenseId);
      if (!expense) {
        return res.status(404).json({ message: "Expense not found" });
      }
      if (expense.submittedBy !== userId) {
        return res.status(403).json({ message: "You can only delete your own expenses" });
      }
      if (expense.status !== 'draft') {
        return res.status(400).json({ message: "Only draft expenses can be deleted" });
      }

      await storage.deleteExpense(expenseId);
      res.json({ success: true });
    } catch (error) {
      console.error("Error deleting draft expense:", error);
      res.status(500).json({ message: "Failed to delete draft expense" });
    }
  });

  // Submit all draft expenses (change status from 'draft' to 'pending')
  app.post("/api/my/expenses/drafts/submit", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const { expenseIds } = req.body;
      
      if (!expenseIds || !Array.isArray(expenseIds) || expenseIds.length === 0) {
        return res.status(400).json({ message: "No expense IDs provided" });
      }

      const submittedExpenses = [];
      for (const expenseId of expenseIds) {
        const expense = await storage.getExpense(expenseId);
        if (!expense) {
          continue;
        }
        if (expense.submittedBy !== userId) {
          continue; // Skip expenses not owned by user
        }
        if (expense.status !== 'draft') {
          continue; // Skip non-draft expenses
        }

        // Update status to pending
        const updated = await storage.updateExpenseStatus(expenseId, 'pending');
        if (updated) {
          submittedExpenses.push(updated);
        }
      }

      res.json({ 
        message: `${submittedExpenses.length} expense(s) submitted successfully`,
        submittedCount: submittedExpenses.length,
        expenses: submittedExpenses
      });
    } catch (error) {
      console.error("Error submitting draft expenses:", error);
      res.status(500).json({ message: "Failed to submit draft expenses" });
    }
  });

  // CORPORATE EXPENSE ROUTES

  // Get all expenses (corporate only) with enriched data
  app.get("/api/corporate/expenses", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const expenses = await storage.getAllExpenses();
      
      // Enrich expenses with submitter name and customer name
      const enrichedExpenses = await Promise.all(expenses.map(async (expense) => {
        let submitterName = "Unknown";
        let customerName = "";
        let driverClassification = "";
        let submissionDate = expense.createdAt;
        
        // Get submitter name
        if (expense.submittedBy) {
          const submitter = await storage.getUser(expense.submittedBy);
          if (submitter) {
            submitterName = `${submitter.firstName || ''} ${submitter.lastName || ''}`.trim() || submitter.email || "Unknown";
          }
        }
        
        // Get customer name from trip if available
        if (expense.tripId) {
          const trip = await storage.getTrip(expense.tripId);
          if (trip && trip.customerId) {
            const customer = await storage.getCustomer(trip.customerId);
            if (customer) {
              customerName = customer.customerName || "";
            }
          }
        }
        
        // Get driver classification if driver expense
        if (expense.driverId) {
          const driver = await storage.getDriver(expense.driverId);
          if (driver) {
            driverClassification = driver.driverClassification || "";
          }
        }
        
        return {
          ...expense,
          submitterName,
          customerName,
          driverClassification,
          submissionDate,
        };
      }));
      
      res.json(enrichedExpenses);
    } catch (error) {
      console.error("Error fetching expenses:", error);
      res.status(500).json({ message: "Failed to fetch expenses" });
    }
  });

  // Create expense (corporate only)
  app.post("/api/corporate/expenses", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      // For employee expenses, automatically populate employeeId from authenticated user
      let employeeId = req.body.employeeId;
      if (req.body.expenseType === 'employee' && !employeeId) {
        const employee = await storage.getEmployeeByUserId(userId);
        if (!employee) {
          return res.status(400).json({ 
            message: "No employee profile found for your account. Please contact an administrator to set up your employee profile." 
          });
        }
        employeeId = employee.id;
      }

      const validatedData = insertExpenseSchema.parse({
        ...req.body,
        submittedBy: userId,
        employeeId: req.body.expenseType === 'employee' ? employeeId : null,
        driverId: req.body.expenseType === 'driver' ? req.body.driverId : null,
      });

      const expense = await storage.createExpense(validatedData);
      res.json(expense);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Validation error", errors: error.errors });
      }
      console.error("Error creating expense:", error);
      res.status(500).json({ message: "Failed to create expense" });
    }
  });

  // Update expense status (corporate only - for approvals)
  app.patch("/api/corporate/expenses/:id/status", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { status } = req.body;
      if (!['pending', 'approved', 'rejected', 'reimbursed'].includes(status)) {
        return res.status(400).json({ message: "Invalid status" });
      }

      const expense = await storage.updateExpenseStatus(req.params.id, status, userId);
      if (!expense) {
        return res.status(404).json({ message: "Expense not found" });
      }
      res.json(expense);
    } catch (error) {
      console.error("Error updating expense status:", error);
      res.status(500).json({ message: "Failed to update expense status" });
    }
  });

  // Delete expense (corporate only - only submitter can delete pending expenses)
  app.delete("/api/corporate/expenses/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const expense = await storage.getExpense(req.params.id);
      if (!expense) {
        return res.status(404).json({ message: "Expense not found" });
      }

      // Only submitter can delete, and only if pending
      if (expense.submittedBy !== userId) {
        return res.status(403).json({ message: "Forbidden: You can only delete your own expenses" });
      }

      if (expense.status !== 'pending') {
        return res.status(400).json({ message: "Cannot delete expenses that are not pending" });
      }

      await storage.deleteExpense(req.params.id);
      res.json({ message: "Expense deleted successfully" });
    } catch (error) {
      console.error("Error deleting expense:", error);
      res.status(500).json({ message: "Failed to delete expense" });
    }
  });

  // EXPENSE APPROVAL WORKFLOW ROUTES

  // Get expenses pending my approval
  app.get("/api/corporate/expenses/pending-approval", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const expenses = await storage.getExpensesPendingApprovalByUser(userId);
      res.json(expenses);
    } catch (error) {
      console.error("Error fetching pending approvals:", error);
      res.status(500).json({ message: "Failed to fetch pending approvals" });
    }
  });

  // Get approval history for a specific expense
  app.get("/api/corporate/expenses/:id/approvals", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const approvals = await storage.getExpenseApprovalsByExpenseId(req.params.id);
      res.json(approvals);
    } catch (error) {
      console.error("Error fetching expense approvals:", error);
      res.status(500).json({ message: "Failed to fetch expense approvals" });
    }
  });

  // Approve an expense at the current approval stage
  app.post("/api/corporate/expenses/:id/approve", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { notes } = req.body;
      const expenseId = req.params.id;

      // Get the expense and current approval record
      const expense = await storage.getExpense(expenseId);
      if (!expense) {
        return res.status(404).json({ message: "Expense not found" });
      }

      if (expense.status !== 'pending') {
        return res.status(400).json({ message: "Expense is not pending approval" });
      }

      // Find the pending approval for current stage that this user can approve
      const approvals = await storage.getExpenseApprovalsByExpenseId(expenseId);
      const pendingApproval = approvals.find(a => 
        a.status === 'pending' && 
        a.stage === expense.currentApprovalStage &&
        a.approverUserId === userId
      );

      if (!pendingApproval) {
        return res.status(403).json({ message: "You are not authorized to approve this expense at the current stage" });
      }

      // Approve this stage
      const approval = await storage.approveExpense(expenseId, pendingApproval.id, userId, notes);
      
      // Advance to next stage
      const updatedExpense = await storage.advanceExpenseToNextStage(expenseId);

      // If the expense completed, and it's a driver expense, we'd create an invoice
      // For now, just return success
      res.json({ 
        message: "Expense approved successfully",
        approval,
        expense: updatedExpense
      });
    } catch (error) {
      console.error("Error approving expense:", error);
      res.status(500).json({ message: "Failed to approve expense" });
    }
  });

  // Reject an expense
  app.post("/api/corporate/expenses/:id/reject", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const { notes } = req.body;
      const expenseId = req.params.id;

      // Get the expense and current approval record
      const expense = await storage.getExpense(expenseId);
      if (!expense) {
        return res.status(404).json({ message: "Expense not found" });
      }

      if (expense.status !== 'pending') {
        return res.status(400).json({ message: "Expense is not pending approval" });
      }

      // Find the pending approval for current stage that this user can reject
      const approvals = await storage.getExpenseApprovalsByExpenseId(expenseId);
      const pendingApproval = approvals.find(a => 
        a.status === 'pending' && 
        a.stage === expense.currentApprovalStage &&
        a.approverUserId === userId
      );

      if (!pendingApproval) {
        return res.status(403).json({ message: "You are not authorized to reject this expense at the current stage" });
      }

      // Reject this stage (also updates expense status to rejected)
      const approval = await storage.rejectExpense(expenseId, pendingApproval.id, userId, notes);
      
      const updatedExpense = await storage.getExpense(expenseId);

      res.json({ 
        message: "Expense rejected",
        approval,
        expense: updatedExpense
      });
    } catch (error) {
      console.error("Error rejecting expense:", error);
      res.status(500).json({ message: "Failed to reject expense" });
    }
  });

  // Initialize approval workflow for an expense (called when expense is created)
  app.post("/api/corporate/expenses/:id/init-workflow", isAuthenticated, async (req: any, res: Response) => {
    try {
      const userId = req.user.claims.sub;
      const user = await storage.getUser(userId);

      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const expenseId = req.params.id;
      const expense = await storage.getExpense(expenseId);
      
      if (!expense) {
        return res.status(404).json({ message: "Expense not found" });
      }

      // Get COO employee
      const coo = await storage.getCOOEmployee();
      
      // Build approval chain based on expense type and submitter type
      const approvals: any[] = [];

      if (expense.expenseType === 'driver' && expense.driverId) {
        // Driver expense - need driver info to determine classification
        const driver = await storage.getDriver(expense.driverId);
        
        if (driver?.driverClassification === 'Employee' && driver.directManagerId) {
          // Employee driver: Manager → COO → Invoice
          const manager = await storage.getEmployee(driver.directManagerId);
          if (manager) {
            approvals.push({
              expenseId,
              stage: 'manager',
              level: 1,
              approverEmployeeId: manager.id,
              approverUserId: manager.userId,
              status: 'pending',
            });
          }
        } else if (driver?.driverClassification === 'Independent Contractor' && driver.driverAdvocateId) {
          // Independent Contractor: Driver Advocate → COO → Invoice
          const advocate = await storage.getEmployee(driver.driverAdvocateId);
          if (advocate) {
            approvals.push({
              expenseId,
              stage: 'manager',
              level: 1,
              approverEmployeeId: advocate.id,
              approverUserId: advocate.userId,
              status: 'pending',
            });
          }
        }
        
        // COO approval (level 2) for all driver expenses
        if (coo) {
          approvals.push({
            expenseId,
            stage: 'coo',
            level: 2,
            approverEmployeeId: coo.id,
            approverUserId: coo.userId,
            status: 'pending',
          });
        }

      } else if (expense.expenseType === 'employee' && expense.employeeId) {
        // Employee expense: Manager → COO → Will Walton → Reimbursement
        const employee = await storage.getEmployee(expense.employeeId);
        
        if (employee?.directManagerId) {
          const manager = await storage.getEmployee(employee.directManagerId);
          if (manager) {
            approvals.push({
              expenseId,
              stage: 'manager',
              level: 1,
              approverEmployeeId: manager.id,
              approverUserId: manager.userId,
              status: 'pending',
            });
          }
        }
        
        // COO approval (level 2)
        if (coo) {
          approvals.push({
            expenseId,
            stage: 'coo',
            level: 2,
            approverEmployeeId: coo.id,
            approverUserId: coo.userId,
            status: 'pending',
          });
        }

        // Will Walton approval (level 3) for employee expenses
        const willWalton = await storage.getWillWaltonEmployee();
        if (willWalton) {
          approvals.push({
            expenseId,
            stage: 'executive',
            level: 3,
            approverEmployeeId: willWalton.id,
            approverUserId: willWalton.userId,
            status: 'pending',
          });
        }
      }

      // Create all approval records
      const createdApprovals = [];
      for (const approvalData of approvals) {
        const created = await storage.createExpenseApproval(approvalData);
        createdApprovals.push(created);
      }

      res.json({
        message: "Approval workflow initialized",
        approvals: createdApprovals,
      });
    } catch (error) {
      console.error("Error initializing approval workflow:", error);
      res.status(500).json({ message: "Failed to initialize approval workflow" });
    }
  });

  // INVOICE ROUTES (corporate only)


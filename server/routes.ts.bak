  app.post("/api/carrier/mitigation-actions", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const validationSchema = insertRiskMitigationActionSchema.extend({
        title: z.string().min(1, "Title is required"),
        actionType: z.string().min(1, "Action type is required"),
      });
      
      const parseResult = validationSchema.safeParse(req.body);
      if (!parseResult.success) {
        return res.status(400).json({ message: "Validation failed", errors: parseResult.error.errors });
      }
      
      const actionData = {
        ...parseResult.data,
        createdByUserId: currentUserId,
        implementedByUserId: req.body.implementedByUserId || currentUserId,
      };
      
      console.log("Creating mitigation action with data:", JSON.stringify(actionData, null, 2));
      const action = await storage.createRiskMitigationAction(actionData);
      res.status(201).json(action);
    } catch (error: any) {
      console.error("Error creating mitigation action:", error);
      console.error("Error details:", error.message, error.stack);
      res.status(500).json({ message: "Failed to create mitigation action", error: error.message });
    }
  });
  
  app.patch("/api/carrier/mitigation-actions/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const currentUserId = req.user?.claims?.sub;
      const currentUser = currentUserId ? await storage.getUser(currentUserId) : null;
      const role = currentUser?.role || req.user?.claims?.metadata?.role;
      if (!hasCorporateAccess(role)) {
        return res.status(403).json({ message: "Access denied" });
      }
      
      const updateSchema = z.object({
        title: z.string().min(1).optional(),
        description: z.string().optional(),
        actionType: z.string().optional(),
        status: z.enum(['ACTIVE', 'COMPLETED', 'MONITORING', 'DEPRECATED']).optional(),
        triggerPattern: z.string().optional(),
        resultSummary: z.string().optional(),
        completedAt: z.string().datetime().optional(),
      });
      
      const parseResult = updateSchema.safeParse(req.body);
      if (!parseResult.success) {
        return res.status(400).json({ message: "Validation failed", errors: parseResult.error.errors });
      }
      
      const action = await storage.updateRiskMitigationAction(req.params.id, parseResult.data);
      if (!action) {
        return res.status(404).json({ message: "Mitigation action not found" });
      }
      res.json(action);
    } catch (error) {
      console.error("Error updating mitigation action:", error);
      res.status(500).json({ message: "Failed to update mitigation action" });
    }
  });
  
  app.delete("/api/carrier/mitigation-actions/:id", isAuthenticated, async (req: any, res: Response) => {

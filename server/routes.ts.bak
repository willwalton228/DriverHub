  // GET /api/driver-master-data - Query driver master data for Ops Console
  app.get("/api/driver-master-data", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { driverIds, status, market, includeInactive, limit, offset, updatedSince } = req.query;

      const { queryDriverMasterData } = await import("./driverMasterDataService");
      const result = await queryDriverMasterData({
        driverIds: driverIds ? (driverIds as string).split(',') : undefined,
        status: status as string | undefined,
        market: market as string | undefined,
        includeInactive: includeInactive === 'true',
        limit: limit ? parseInt(limit as string) : undefined,
        offset: offset ? parseInt(offset as string) : undefined,
        includeArchived: includeArchived === 'true',
        updatedSince: updatedSince ? new Date(updatedSince as string) : undefined,
      });

      res.json(result);
    } catch (error) {
      console.error("[Driver Master Data] Error querying drivers:", error);
      res.status(500).json({ message: "Failed to query driver master data" });
    }
  });

  // GET /api/driver-master-data/:driverId - Get single driver master data
  app.get("/api/driver-master-data/:driverId", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { driverId } = req.params;
      const { getDriverMasterData } = await import("./driverMasterDataService");
      
      const masterData = await getDriverMasterData(driverId);
      if (!masterData) {
        return res.status(404).json({ message: "Driver not found" });
      }
      res.json(masterData);

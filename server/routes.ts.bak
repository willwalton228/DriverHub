      if (!user) return res.status(401).json({ message: "Unauthorized" });
      const isAdmin = ['admin', 'super_user'].includes(user.role || '');
      if (isAdmin) {
        const entities = await storage.getAllSchedulingEntities();
        return res.json(entities.map((e: any) => ({ access: { entityId: e.id, accessLevel: 'admin', isActive: true }, entity: e })));
      }
      const access = await storage.getUserSchedulingEntityAccess(user.id);
      res.json(access);

  // ============================================================================
  // BULK ACTIONS API
  // ============================================================================

  // POST /api/recruiting/bulk/assign-recruiter - Bulk assign recruiter (permission-hardened)
  app.post("/api/recruiting/bulk/assign-recruiter", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });
      const recruitingContext = await getUserRecruitingContext(userId, user?.role || "");
      
      // Check write permission
      if (!hasPermission(recruitingContext, "write")) {
        return res.status(403).json({ message: "No permission to modify applications" });
      }

      const { applicationIds, recruiterId } = req.body;
      if (!applicationIds || !Array.isArray(applicationIds) || applicationIds.length === 0) {
        return res.status(400).json({ message: "applicationIds array is required" });
      }
      if (!recruiterId) {
        return res.status(400).json({ message: "recruiterId is required" });
      }

      const { enforceApplicationLock: enforceBulkAssignLock } = await import("./recruitingService");
      const lockedAssignIds: string[] = [];
      for (const appId of applicationIds) {
        const lr = await enforceBulkAssignLock(appId, userId);
        if (!lr.allowed) lockedAssignIds.push(appId);
      }
      if (lockedAssignIds.length > 0) {
        return res.status(409).json({
          message: `${lockedAssignIds.length} application(s) are locked by other users`,
          lockedApplicationIds: lockedAssignIds,
        });
      }

      // Check bulk action permission (validates all applications are in authorized markets)
      const bulkCheck = await checkBulkActionPermission(applicationIds, recruitingContext);
      if (!bulkCheck.allowed) {
        return res.status(403).json({ 
          message: bulkCheck.reason,
          unauthorizedCount: bulkCheck.unauthorizedIds?.length || 0
        });
      }

      const { bulkAssignRecruiter } = await import("./recruitingService");
      const result = await bulkAssignRecruiter(applicationIds, recruiterId, userId, user?.email || null);

      res.json(result);
    } catch (error: any) {
      console.error("[Recruiting] Error bulk assigning recruiter:", error);
      res.status(500).json({ message: error.message || "Failed to bulk assign recruiter" });
    }
  });
  // POST /api/recruiting/bulk/move-stage - Bulk move stage (permission-hardened)
  app.post("/api/recruiting/bulk/move-stage", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const user = await db.query.users.findFirst({
        where: (users, { eq }) => eq(users.id, userId),
      });
      const recruitingContext = await getUserRecruitingContext(userId, user?.role || "");
      
      // Check write permission
      if (!hasPermission(recruitingContext, "write")) {
        return res.status(403).json({ message: "No permission to modify applications" });
      }

      const { applicationIds, toStage, reason } = req.body;
      if (!applicationIds || !Array.isArray(applicationIds) || applicationIds.length === 0) {
        return res.status(400).json({ message: "applicationIds array is required" });
      }
      if (!toStage) {
        return res.status(400).json({ message: "toStage is required" });
      }

      const { enforceApplicationLock: enforceBulkMoveLock } = await import("./recruitingService");
      const lockedIds: string[] = [];
      for (const appId of applicationIds) {
        const lr = await enforceBulkMoveLock(appId, userId);
        if (!lr.allowed) lockedIds.push(appId);
      }
      if (lockedIds.length > 0) {
        return res.status(409).json({
          message: `${lockedIds.length} application(s) are locked by other users`,
          lockedApplicationIds: lockedIds,
        });
      }

      // Check bulk action permission (validates all applications are in authorized markets)
      const bulkCheck = await checkBulkActionPermission(applicationIds, recruitingContext);
      if (!bulkCheck.allowed) {
        return res.status(403).json({ 
          message: bulkCheck.reason,
          unauthorizedCount: bulkCheck.unauthorizedIds?.length || 0
        });
      }

      // Check compliance for each application before bulk move
      const { checkStageTransitionAllowed } = await import("./services/stateComplianceEngine");
      const complianceChecks = await Promise.all(
        applicationIds.map(async (id: string) => {
          const check = await checkStageTransitionAllowed(id, toStage);
          return { id, ...check };
        })
      );

      // Filter out applications blocked by compliance
      const blockedApps = complianceChecks.filter(c => !c.allowed);
      const allowedAppIds = complianceChecks.filter(c => c.allowed).map(c => c.id);

      if (allowedAppIds.length === 0) {
        return res.status(400).json({
          message: "All applications are blocked by compliance rules",
          blockedApplications: blockedApps.map(b => ({
            applicationId: b.id,
            reason: b.blockedReason
          }))
        });
      }

      const { bulkMoveStage } = await import("./recruitingService");
      const result = await bulkMoveStage(allowedAppIds, toStage, reason || null, userId, user?.email || null);

      // Add blocked applications to the result
      if (blockedApps.length > 0) {
        result.failureCount += blockedApps.length;
        for (const blocked of blockedApps) {
          result.results.push({
            applicationId: blocked.id,
            success: false,
            error: `Compliance blocked: ${blocked.blockedReason || 'Failed compliance check'}`
          });
        }
      }

      res.json(result);
    } catch (error: any) {
      console.error("[Recruiting] Error bulk moving stage:", error);
      res.status(500).json({ message: error.message || "Failed to bulk move stage" });
    }
  });

  // POST /api/recruiting/bulk/add-tags - Bulk add tags (permission-hardened)
  app.post("/api/recruiting/bulk/add-tags", async (req: Request, res: Response) => {

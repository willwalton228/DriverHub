  // GET /api/recruiting/pipeline-preferences - Get current user's pipeline column preferences
  app.get("/api/recruiting/pipeline-preferences", async (req: any, res: Response) => {
    try {
      const userId = (req as any).session?.userId || req.user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });

      const { recruitingPipelinePreferences, recruitingPipelineRequiredColumns, DEFAULT_VISIBLE_COLUMNS } = await import("@shared/schema");
      const { eq } = await import("drizzle-orm");

      const [prefs] = await db.select().from(recruitingPipelinePreferences).where(eq(recruitingPipelinePreferences.userId, userId)).limit(1);
      const [required] = await db.select().from(recruitingPipelineRequiredColumns).limit(1);

      const visibleColumns = prefs?.visibleColumns || [...DEFAULT_VISIBLE_COLUMNS];
      const requiredColumns = required?.requiredColumns || ["stage"];

      const effectiveColumns = [...new Set([...visibleColumns, ...requiredColumns])];

      res.json({
        visibleColumns,
        requiredColumns,
        effectiveColumns,
      });
    } catch (error: any) {
      console.error("Error fetching pipeline preferences:", error);
      res.status(500).json({ message: "Failed to fetch pipeline preferences" });
    }
  });

  // PUT /api/recruiting/pipeline-preferences - Save current user's pipeline column preferences
  app.put("/api/recruiting/pipeline-preferences", async (req: any, res: Response) => {
    try {
      const userId = (req as any).session?.userId || req.user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });

      const { visibleColumns } = req.body;
      if (!visibleColumns || !Array.isArray(visibleColumns)) {
        return res.status(400).json({ message: "visibleColumns array is required" });
      }

      const { recruitingPipelinePreferences, recruitingPipelineRequiredColumns, PIPELINE_COLUMN_KEYS } = await import("@shared/schema");
      const { eq } = await import("drizzle-orm");

      const validColumns = visibleColumns.filter((c: string) => (PIPELINE_COLUMN_KEYS as readonly string[]).includes(c));

      const [required] = await db.select().from(recruitingPipelineRequiredColumns).limit(1);
      const requiredColumns = required?.requiredColumns || ["stage"];

      const existing = await db.select().from(recruitingPipelinePreferences).where(eq(recruitingPipelinePreferences.userId, userId)).limit(1);

      if (existing.length > 0) {
        await db.update(recruitingPipelinePreferences)
          .set({ visibleColumns: validColumns, updatedAt: new Date() })
          .where(eq(recruitingPipelinePreferences.userId, userId));
      } else {
        await db.insert(recruitingPipelinePreferences).values({
          userId,
          visibleColumns: validColumns,
        });
      }

      const effectiveColumns = [...new Set([...validColumns, ...requiredColumns])];
      res.json({ visibleColumns: validColumns, requiredColumns, effectiveColumns });
    } catch (error: any) {
      console.error("Error saving pipeline preferences:", error);
      res.status(500).json({ message: "Failed to save pipeline preferences" });
    }
  });

  // GET /api/recruiting/pipeline-required-columns - Get admin-enforced required columns
  app.get("/api/recruiting/pipeline-required-columns", async (req: any, res: Response) => {
    try {
      const userId = (req as any).session?.userId || req.user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });

      const { recruitingPipelineRequiredColumns } = await import("@shared/schema");
      const [required] = await db.select().from(recruitingPipelineRequiredColumns).limit(1);

      res.json({ requiredColumns: required?.requiredColumns || ["stage"] });
    } catch (error: any) {
      console.error("Error fetching required columns:", error);
      res.status(500).json({ message: "Failed to fetch required columns" });
    }
  });

  // PUT /api/recruiting/pipeline-required-columns - Admin: set required columns
  app.put("/api/recruiting/pipeline-required-columns", async (req: any, res: Response) => {
    try {
      const userId = (req as any).session?.userId || req.user?.claims?.sub;
      if (!userId) return res.status(401).json({ message: "Not authenticated" });

      const user = await storage.getUser(userId);
      if (!user || (user.role !== "admin" && user.role !== "super_user" && user.role !== "recruiting_admin")) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { requiredColumns } = req.body;
      if (!requiredColumns || !Array.isArray(requiredColumns)) {
        return res.status(400).json({ message: "requiredColumns array is required" });
      }

      const { recruitingPipelineRequiredColumns, PIPELINE_COLUMN_KEYS } = await import("@shared/schema");
      const validColumns = requiredColumns.filter((c: string) => (PIPELINE_COLUMN_KEYS as readonly string[]).includes(c));

      if (!validColumns.includes("stage")) {
        validColumns.push("stage");
      }

      const existing = await db.select().from(recruitingPipelineRequiredColumns).limit(1);

      if (existing.length > 0) {
        const { eq } = await import("drizzle-orm");
        await db.update(recruitingPipelineRequiredColumns)
          .set({ requiredColumns: validColumns, updatedBy: userId, updatedAt: new Date() })
          .where(eq(recruitingPipelineRequiredColumns.id, existing[0].id));
      } else {
        await db.insert(recruitingPipelineRequiredColumns).values({
          requiredColumns: validColumns,
          updatedBy: userId,
        });
      }

      res.json({ requiredColumns: validColumns });
    } catch (error: any) {
      console.error("Error saving required columns:", error);
      res.status(500).json({ message: "Failed to save required columns" });
    }
  });

  // =====================================================================
  // RECRUITER PRODUCTIVITY METRICS
  // =====================================================================

  app.get("/api/recruiting/metrics/recruiter-productivity", async (req: any, res: Response) => {
    if (!req.user) return res.status(401).json({ message: "Not authenticated" });
    try {
      const userRecord = await db.query.users.findFirst({ where: eq(users.id, req.user.id) });
      if (!userRecord || !["admin", "super_user"].includes(userRecord.role || "")) {
        return res.status(403).json({ message: "Admin access required" });
      }
      const { startDate, endDate } = req.query;

      const metrics = await db.execute(sql`
        WITH recruiter_apps AS (
          SELECT
            ra.owner_id,
            u.first_name || ' ' || u.last_name AS recruiter_name,
            u.email AS recruiter_email,
            COUNT(*) AS total_applications,
            COUNT(*) FILTER (WHERE ra.current_stage = 'hired') AS hired_count,
            COUNT(*) FILTER (WHERE ra.current_stage = 'rejected') AS rejected_count,
            COUNT(*) FILTER (WHERE ra.current_stage = 'withdrawn') AS withdrawn_count,
            COUNT(*) FILTER (WHERE ra.readiness_status = 'ready') AS ready_count,
            COUNT(*) FILTER (WHERE ra.current_stage NOT IN ('hired','rejected','withdrawn','archived')) AS active_count
          FROM recruiting_applications ra
          JOIN users u ON ra.owner_id = u.id
          WHERE ra.owner_id IS NOT NULL
            AND ra.is_archived = false
            ${startDate ? sql`AND ra.created_at >= ${startDate}` : sql``}
            ${endDate ? sql`AND ra.created_at <= ${endDate}` : sql``}
          GROUP BY ra.owner_id, u.first_name, u.last_name, u.email
        ),
        avg_stage_time AS (
          SELECT
            ra.owner_id,
            COALESCE(AVG(rsh.time_in_previous_stage_minutes), 0) AS avg_time_in_stage_minutes
          FROM recruiting_applications ra
          JOIN recruiting_stage_history rsh ON ra.id = rsh.application_id
          WHERE ra.owner_id IS NOT NULL
            AND ra.is_archived = false
            ${startDate ? sql`AND ra.created_at >= ${startDate}` : sql``}
            ${endDate ? sql`AND ra.created_at <= ${endDate}` : sql``}
          GROUP BY ra.owner_id
        ),
        time_to_ready AS (
          SELECT
            ra.owner_id,
            AVG(EXTRACT(EPOCH FROM (
              CASE WHEN ra.readiness_status = 'ready' AND ra.readiness_last_calculated_at IS NOT NULL
                THEN ra.readiness_last_calculated_at - ra.created_at
                ELSE NULL END
            )) / 86400.0) AS avg_days_to_ready
          FROM recruiting_applications ra
          WHERE ra.owner_id IS NOT NULL
            AND ra.readiness_status = 'ready'
            AND ra.is_archived = false
            ${startDate ? sql`AND ra.created_at >= ${startDate}` : sql``}
            ${endDate ? sql`AND ra.created_at <= ${endDate}` : sql``}
          GROUP BY ra.owner_id
        )
        SELECT
          rap.owner_id,
          rap.recruiter_name,
          rap.recruiter_email,
          rap.total_applications,
          rap.hired_count,
          rap.rejected_count,
          rap.withdrawn_count,
          rap.ready_count,
          rap.active_count,
          COALESCE(ast.avg_time_in_stage_minutes, 0) AS avg_time_in_stage_minutes,
          COALESCE(ttr.avg_days_to_ready, 0) AS avg_days_to_ready
        FROM recruiter_apps rap
        LEFT JOIN avg_stage_time ast ON rap.owner_id = ast.owner_id
        LEFT JOIN time_to_ready ttr ON rap.owner_id = ttr.owner_id
        ORDER BY rap.total_applications DESC
      `);

      res.json(metrics.rows || []);
    } catch (error: any) {
      console.error("Error fetching recruiter productivity metrics:", error);
      res.status(500).json({ message: error.message || "Failed to fetch metrics" });
    }
  });



      }
      const schedPerm = await resolveSchedulingPermission(user!.id, user?.role);
      if (!hasSchedulingPermission(schedPerm, 'edit')) return res.status(403).json({ message: 'Insufficient scheduling permission: edit required' });
      const existingShift = await storage.getShiftWithAssignments(req.params.id);
      await storage.deleteShift(req.params.id);
      await logSchedulingAudit({ actorUserId: user!.id, actionType: 'shift_deleted', entityType: 'shift', entityId: req.params.id, locationId: existingShift?.locationId, previousData: existingShift, ipAddress: req.ip, userAgent: req.get('user-agent') });

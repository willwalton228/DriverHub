        appliedAmount: '0',
      });
      res.json(payment);
    } catch (error) {
      console.error("Error creating payment:", error);
      res.status(500).json({ message: "Failed to create payment" });
    }
  });

  // Record manual/offline payment (check, wire, ACH manual) - TICKET 26
  app.post("/api/corporate/invoicing/payments/manual", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      const {
        customerId,
        paymentMethod, // check, wire, ach_manual, other
        referenceNumber,
        receivedDate, // the date the payment was received
        amount,
        notes,
        checkNumber,
        checkDate,
        bankName,
        wireDetails,
        achManualDetails,
        attachmentUrl,
        attachmentFilename,
        allocations, // Array of { invoiceId, amount }
      } = req.body;

      // Validate required fields
      if (!customerId || !paymentMethod || !amount || !receivedDate) {
        return res.status(400).json({
          message: "Missing required fields: customerId, paymentMethod, amount, receivedDate"
        });
      }

      // Validate payment method
      const validMethods = ['check', 'wire', 'ach_manual', 'other'];
      if (!validMethods.includes(paymentMethod)) {
        return res.status(400).json({
          message: `Invalid payment method. Must be one of: ${validMethods.join(', ')}`,
        });
      }

      // Validate allocations if provided
      if (allocations && allocations.length > 0) {
        const totalAllocated = allocations.reduce((sum: number, a: { amount: string }) => sum + parseFloat(a.amount), 0);
        if (totalAllocated > parseFloat(amount)) {
          return res.status(400).json({
            message: `Total allocation ($${totalAllocated.toFixed(2)}) exceeds payment amount ($${parseFloat(amount).toFixed(2)})`,
          });
        }
      }

      // Create manual payment with allocations
      const payment = await storage.createManualPayment(
        {
          customerId,
          paymentMethod,
          paymentDate: receivedDate,
          amount,
          referenceNumber,
          memo: notes,
          checkNumber,
          checkDate,
          bankName,
          wireDetails,
          achManualDetails,
          attachmentUrl,
          attachmentFilename,
          allocations,
        },
        req.user.claims.sub
      );

      res.status(201).json(payment);
    } catch (error) {
      console.error("Error recording manual payment:", error);
      res.status(500).json({ message: "Failed to record manual payment" });
    }
  });

  app.post("/api/corporate/invoicing/payments/upload-attachment",
    isAuthenticated,
    express.raw({ type: ["image/*", "application/pdf", "application/octet-stream"], limit: "10mb" }),
    async (req: any, res: Response) => {
      try {
        const user = await storage.getUser(req.user.claims.sub);
        if (!hasCorporateAccess(user?.role)) {
          return res.status(403).json({ message: "Forbidden: Corporate access only" });
        }

        const contentType = req.headers["content-type"] || "application/octet-stream";
        const filename = req.headers["x-filename"] as string || "payment-attachment";

        let fileBuffer: Buffer;
        if (Buffer.isBuffer(req.body)) {
          fileBuffer = req.body;
        } else if (req.body instanceof ArrayBuffer) {
          fileBuffer = Buffer.from(req.body);
        } else {
          return res.status(400).json({ message: "No file data received" });
        }

        if (fileBuffer.length === 0) {
          return res.status(400).json({ message: "Empty file received" });
        }

        const objectStorageService = new ObjectStorageService();
        const result = await objectStorageService.uploadFile(fileBuffer, contentType, `payment_attachments/${Date.now()}_${filename}`);
        res.json({ url: result.objectPath, filename });
      } catch (error: any) {
        console.error("Error uploading payment attachment:", error);
        res.status(500).json({ message: "Failed to upload attachment" });
      }
    }
  );

  // Update payment
  app.patch("/api/corporate/invoicing/payments/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const payment = await storage.updatePayment(req.params.id, req.body);
      res.json(payment);
    } catch (error) {
      console.error("Error updating payment:", error);
      res.status(500).json({ message: "Failed to update payment" });
    }
  });

  // Apply payment to invoice
  app.post("/api/corporate/invoicing/payments/:paymentId/apply", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }
      const { invoiceId, amount } = req.body;

      // Idempotency check for payment application
      const paymentIdempKey = req.headers['x-idempotency-key'] || req.headers['idempotency-key'];
      if (paymentIdempKey) {
        const paymentHash = hashRequestBody({ paymentId: req.params.paymentId, invoiceId, amount });
        const payIdempResult = await checkIdempotency('payment_apply', paymentIdempKey, paymentHash, req.user.claims.sub);
        if (!payIdempResult.isNew && payIdempResult.cachedResponse) {
          console.log('[Idempotency] Returning cached response for payment apply key:', paymentIdempKey);
          return res.status(payIdempResult.cachedResponse.status).json(payIdempResult.cachedResponse.body);
        }
      }

      const application = await storage.applyPaymentToInvoice(
        req.params.paymentId,
        invoiceId,
        amount,
        req.user.claims.sub
      );

      if (paymentIdempKey) {
        await storage.finalizeIdempotencyKey('payment_apply', paymentIdempKey, 200, application, application.id);
      }

      res.json(application);
    } catch (error) {
      console.error("Error applying payment:", error);
      const payIdempKeyErr = req.headers['x-idempotency-key'] || req.headers['idempotency-key'];
      if (payIdempKeyErr) {
        try { await storage.finalizeIdempotencyKey('payment_apply', payIdempKeyErr, 500, { message: 'Failed to apply payment' }); } catch (e) {}
      }
      res.status(500).json({ message: "Failed to apply payment" });
    }
  });


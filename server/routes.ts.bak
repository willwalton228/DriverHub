  // Create payment intent for invoice payment (corporate access only)
  app.post("/api/stripe/payment-intent", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      if (!isStripeConfigured()) {
        return res.status(503).json({ message: "Stripe is not configured" });
      }

      const { amount, invoiceId, customerId, description } = req.body;

      if (!amount || parseFloat(amount) <= 0) {
        return res.status(400).json({ message: "Valid amount is required" });
      }

      // Verify invoice exists if provided
      if (invoiceId) {
        const invoice = await storage.getInvoice(invoiceId);
        if (!invoice) {
          return res.status(404).json({ message: "Invoice not found" });
        }
      }

      const result = await createPaymentIntent({
        amount: parseFloat(amount),
        invoiceId,
        customerId,
        description: description || `Payment for Invoice`,
        metadata: {
          userId: req.user.claims.sub,
        },
      });

      res.json(result);
    } catch (error) {
      console.error("Error creating payment intent:", error);
      res.status(500).json({ message: "Failed to create payment intent" });
    }
  });

  // Get payment intent status
  app.get("/api/stripe/payment-intent/:id", isAuthenticated, async (req: any, res: Response) => {
    try {
      if (!isStripeConfigured()) {
        return res.status(503).json({ message: "Stripe is not configured" });
      }

      const paymentIntent = await getPaymentIntent(req.params.id);
      res.json({
        id: paymentIntent.id,
        status: paymentIntent.status,
        amount: paymentIntent.amount / 100,
        currency: paymentIntent.currency,
        metadata: paymentIntent.metadata,
      });
    } catch (error) {
      console.error("Error getting payment intent:", error);
      res.status(500).json({ message: "Failed to get payment intent" });
    }
  });

  // Process successful payment and record it in the system (corporate access only)
  app.post("/api/stripe/payment-success", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      if (!isStripeConfigured()) {
        return res.status(503).json({ message: "Stripe is not configured" });
      }

      const { paymentIntentId, invoiceId, customerId } = req.body;

      if (!paymentIntentId) {
        return res.status(400).json({ message: "Payment intent ID is required" });
      }

      // Check for duplicate payment (idempotency)
      const existingPayment = await storage.getPaymentByStripeId(paymentIntentId);
      if (existingPayment) {
        return res.json({ 
          success: true, 
          payment: existingPayment,
          message: 'Payment already recorded',
          duplicate: true,
        });
      }

      const paymentIntent = await getPaymentIntent(paymentIntentId);
      
      if (paymentIntent.status !== 'succeeded') {
        return res.status(400).json({ message: "Payment has not succeeded" });
      }

      // Convert amount using integer math to avoid floating point issues
      const amountInCents = paymentIntent.amount;
      const amountInDollars = (amountInCents / 100).toFixed(2);

      // Verify invoice exists if provided
      let invoice = null;
      if (invoiceId) {
        invoice = await storage.getInvoice(invoiceId);
        if (!invoice) {
          return res.status(404).json({ message: "Invoice not found" });
        }
      }

      // Generate payment number and record the payment
      const paymentNumber = await storage.generatePaymentNumber();
      const payment = await storage.createPayment({
        customerId: customerId || paymentIntent.metadata?.customerId || invoice?.customerId,
        amount: amountInDollars,
        paymentNumber,
        paymentDate: new Date().toISOString().split('T')[0],
        paymentMethod: 'credit_card',
        status: 'completed',
        stripePaymentIntentId: paymentIntentId,
        referenceNumber: paymentIntent.id,
        receivedBy: req.user.claims.sub,
      });

      // If there's an invoice, apply the payment
      if (invoiceId && invoice) {
        await storage.applyPaymentToInvoice(payment.id, invoiceId, amountInDollars, req.user.claims.sub);
        
        // Recalculate using integer cents to avoid floating point issues
        const paidAmountCents = Math.round(parseFloat(invoice.paidAmount || '0') * 100) + amountInCents;
        const totalAmountCents = Math.round(parseFloat(invoice.totalAmount || '0') * 100);
        
        if (paidAmountCents >= totalAmountCents) {
          await storage.updateInvoice(invoiceId, { status: 'paid' });
        } else {
          await storage.updateInvoice(invoiceId, { status: 'partially_paid' });
        }
      }

      res.json({ 
        success: true, 
        payment,
        message: 'Payment recorded successfully',
      });
    } catch (error) {
      console.error("Error processing payment success:", error);
      res.status(500).json({ message: "Failed to process payment success" });
    }
  });

  // Refund a payment
  app.post("/api/stripe/refund", isAuthenticated, async (req: any, res: Response) => {
    try {
      const user = await storage.getUser(req.user.claims.sub);
      if (!hasCorporateAccess(user?.role)) {
        return res.status(403).json({ message: "Forbidden: Corporate access only" });
      }

      if (!isStripeConfigured()) {
        return res.status(503).json({ message: "Stripe is not configured" });
      }

      const { paymentIntentId, amount, reason } = req.body;

      if (!paymentIntentId) {
        return res.status(400).json({ message: "Payment intent ID is required" });
      }

      const refund = await refundPayment(
        paymentIntentId,
        amount ? parseFloat(amount) : undefined,
        reason as 'duplicate' | 'fraudulent' | 'requested_by_customer' | undefined
      );

      res.json({
        id: refund.id,
        amount: refund.amount ? refund.amount / 100 : 0,
        status: refund.status,
        reason: refund.reason,
      });
    } catch (error) {
      console.error("Error processing refund:", error);
      res.status(500).json({ message: "Failed to process refund" });
    }
  });


  // ============================================
  // STRIPE WEBHOOK ENDPOINT
  // ============================================

  // POST /api/webhooks/stripe - Handle Stripe webhook events
  app.post("/api/webhooks/stripe", async (req: Request, res: Response) => {
    const webhookSecret = process.env.STRIPE_WEBHOOK_SECRET;
    
    if (!webhookSecret) {
      console.warn('[Stripe Webhook] STRIPE_WEBHOOK_SECRET not configured');
      return res.status(500).json({ error: 'Webhook secret not configured' });
    }

    const signature = req.headers['stripe-signature'] as string;
    
    if (!signature) {
      return res.status(400).json({ error: 'Missing stripe-signature header' });
    }

    let event;
    try {
      const rawBody = (req as any).rawBody;
      event = constructWebhookEvent(rawBody, signature, webhookSecret);
    } catch (err: any) {
      console.error('[Stripe Webhook] Signature verification failed:', err.message);
      return res.status(400).json({ error: 'Webhook signature verification failed' });
    }

    console.log('[Stripe Webhook] Received event:', event.type);

    try {
      switch (event.type) {
        case 'payment_intent.succeeded': {
          const paymentIntent = event.data.object;
          const invoiceId = paymentIntent.metadata?.invoiceId;
          
          if (invoiceId) {
            console.log('[Stripe Webhook] Processing successful payment for invoice:', invoiceId);
            
            // Check if payment already recorded (idempotency)
            const [existingPayment] = await db.select()
              .from(payments)
              .where(eq(payments.stripePaymentIntentId, paymentIntent.id))
              .limit(1);

            if (existingPayment) {
              console.log('[Stripe Webhook] Payment already recorded, skipping');
              try {
                await storage.logResilienceEvent({
                  context: 'stripe_webhook',
                  entityType: 'payment',
                  entityId: existingPayment.id,
                  action: 'duplicate_webhook_skipped',
                  status: 'skipped',
                  idempotencyKey: paymentIntent.id,
                  metadata: { eventId: event.id, eventType: event.type },
                });
              } catch (logErr) { console.error('[Resilience] Log error:', logErr); }
              return res.json({ received: true, status: 'already_processed' });
            }

            // Get invoice
            const [invoice] = await db.select()
              .from(invoices)
              .where(eq(invoices.id, invoiceId))
              .limit(1);

            if (!invoice) {
              console.error('[Stripe Webhook] Invoice not found:', invoiceId);
              return res.json({ received: true, status: 'invoice_not_found' });
            }

            // Calculate payment amount
            const paymentAmount = paymentIntent.amount / 100;
            const currentPaid = parseFloat(invoice.paidAmount || '0');
            const newPaidAmount = currentPaid + paymentAmount;
            const totalAmount = parseFloat(invoice.totalAmount);
            const newBalanceDue = Math.max(0, totalAmount - newPaidAmount);
            
            // Determine payment method details
            const paymentMethod = paymentIntent.payment_method_types?.[0] || 'card';
            let cardLast4 = null;
            let cardBrand = null;
            let achAccountLast4 = null;

            if (paymentIntent.charges?.data?.[0]?.payment_method_details) {
              const details = paymentIntent.charges.data[0].payment_method_details;
              if (details.card) {
                cardLast4 = details.card.last4;
                cardBrand = details.card.brand;
              } else if (details.us_bank_account) {
                achAccountLast4 = details.us_bank_account.last4;
              }
            }

            // Determine new status
            let newStatus = invoice.status;
            if (newBalanceDue <= 0) {
              newStatus = 'paid';
            } else if (newPaidAmount > 0) {
              newStatus = 'partially_paid';
            }

            // Generate payment number
            const paymentCount = await db.select({ count: sql<number>`count(*)` })
              .from(payments);
            const paymentNumber = `PAY-${String((paymentCount[0]?.count || 0) + 1).padStart(6, '0')}`;

            // Create payment record
            const [payment] = await db.insert(payments).values({
              paymentNumber,
              customerId: invoice.customerId || '',
              paymentDate: new Date().toISOString().split('T')[0],
              amount: String(paymentAmount),
              paymentMethod,
              status: 'completed',
              stripePaymentIntentId: paymentIntent.id,
              stripeChargeId: paymentIntent.latest_charge || null,
              cardLast4,
              cardBrand,
              achAccountLast4,
              processorFee: paymentIntent.application_fee_amount ? String(paymentIntent.application_fee_amount / 100) : null,
              netAmount: String(paymentAmount - (paymentIntent.application_fee_amount || 0) / 100),
              appliedAmount: String(paymentAmount),
              unappliedAmount: '0',
              referenceNumber: invoice.invoiceNumber,
          draftSequence,
          invoiceNumberFinalized: false,
              memo: `Online payment for Invoice #${invoice.invoiceNumber}`,
            }).returning();

            // Create payment application
            await db.insert(paymentApplications).values({
              paymentId: payment.id,
              invoiceId: invoice.id,
              amount: String(paymentAmount),
              matchMethod: 'stripe_webhook',
              matchConfidence: '100',
            });

            // Update invoice
            await db.update(invoices)
              .set({
                paidAmount: String(newPaidAmount),
                balanceDue: String(newBalanceDue),
                status: newStatus,
                updatedAt: new Date(),
              })
              .where(eq(invoices.id, invoice.id));

            // Create AR ledger entry
            await db.insert(arLedgerEntries).values({
              customerId: invoice.customerId || '',
              entryType: 'payment',
              referenceType: 'payment',
              referenceId: payment.id,
              entryDate: new Date().toISOString().split('T')[0],
              description: `Online payment for Invoice #${invoice.invoiceNumber}`,
              amount: String(-paymentAmount),
              invoiceId: invoice.id,
            });

            console.log('[Stripe Webhook] Payment recorded successfully:', payment.paymentNumber);
          }
          break;
        }

        case 'payment_intent.payment_failed': {
          const paymentIntent = event.data.object;
          const invoiceId = paymentIntent.metadata?.invoiceId;
          
          if (invoiceId) {
            console.log('[Stripe Webhook] Payment failed for invoice:', invoiceId, paymentIntent.last_payment_error?.message);
          }
          break;
        }

        default:
          console.log('[Stripe Webhook] Unhandled event type:', event.type);
      }

      res.json({ received: true });
    } catch (error) {
      console.error('[Stripe Webhook] Error processing event:', error);
      res.status(500).json({ error: 'Webhook processing failed' });
    }
  });



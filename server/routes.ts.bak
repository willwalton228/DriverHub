          .limit(1);
        if (!userByEmail || !['admin', 'super_user'].includes(userByEmail.role || '')) {
          return res.status(403).json({ message: "Admin access required" });
        }
      } else if (!['admin', 'super_user'].includes(user.role || '')) {
        return res.status(403).json({ message: "Admin access required" });
      }

      const { customerId, marketId, days = "30" } = req.query;
      const daysNum = parseInt(days as string) || 30;
      
      const endDate = new Date();
      const startDate = new Date();
      startDate.setDate(startDate.getDate() - daysNum);

      const { getRISPSummaryMetrics, getRISPControlCoverage, generatePDFContent } = await import("./rispSummaryService");
      
      const metrics = await getRISPSummaryMetrics({
        customerId: customerId as string | undefined,

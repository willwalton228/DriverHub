  // POST /api/recruiting/retention/purge - Execute retention purge
  app.post("/api/recruiting/retention/purge", async (req: Request, res: Response) => {
    try {
      if (!req.isAuthenticated()) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      const { entityType } = req.body;

      if (!entityType || !['candidates', 'applications', 'requisitions'].includes(entityType)) {
        return res.status(400).json({ message: "Valid entity type required (candidates, applications, or requisitions)" });
      }

      const { executeRecruitingPurge } = await import("./recruitingService");
      const result = await executeRecruitingPurge(entityType, userId);
      res.json(result);
    } catch (error) {
      console.error("[Recruiting] Error executing purge:", error);
      res.status(500).json({ message: "Failed to execute purge" });
    }
  });

  // GET /api/recruiting/retention/applicable-rule - Get applicable retention rule for an entity
  app.get("/api/recruiting/retention/applicable-rule", async (req: Request, res: Response) => {
    try {

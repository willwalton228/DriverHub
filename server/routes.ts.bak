  app.get("/api/scheduling/schedules/:id/alerts", async (req: Request, res: Response) => {
    try {
      const userId = (req as any).session?.userId || (req as any).user?.claims?.sub;
      if (!userId) {
        return res.status(401).json({ message: "Not authenticated" });
      }

      const { getScheduleAlerts } = await import("./schedulingService");
      const alerts = await getScheduleAlerts(req.params.id);
      
      // Calculate summary from alerts
      const summary = {
        totalAlerts: alerts.length,
        warnings: alerts.filter((a: any) => a.severity === 'warning').length,
        errors: alerts.filter((a: any) => a.severity === 'error').length,
      };
      
      res.json({ alerts, summary });
    } catch (error: any) {
      console.error("[Scheduling] Error getting schedule alerts:", error);
      res.status(400).json({ message: error.message || "Failed to get schedule alerts" });
